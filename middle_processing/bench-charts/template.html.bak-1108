<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>
// 必须是 head 里第一段脚本：后面所有相对路径（图表 iframe、视频、surveys 预览）
// 都按 document.baseURI 解析，晚一步就来不及了。
//
// 站点常挂在 code-server 的 /proxy/<port>/ 前缀下。若访问的 URL 结尾既没有 `/`
// 也没有文件名（如 …/proxy/8891），浏览器会把最后一段当成兄弟资源，相对路径整体
// 少一层：surveys/x.html 解析成 /proxy/surveys/x.html —— code-server 把 "surveys"
// 当端口号解析，报 connect ECONNREFUSED 0.0.0.0:80。这里把 base 显式钉到当前目录，
// 带不带尾斜杠都一样。
(function () {
  var p = location.pathname;
  var lastSeg = p.slice(p.lastIndexOf('/') + 1);
  if (lastSeg && lastSeg.indexOf('.') === -1) p += '/';      // 没扩展名 = 是目录，补尾斜杠
  var dir = p.slice(0, p.lastIndexOf('/') + 1);
  var b = document.createElement('base');
  b.href = location.origin + dir;
  document.head.insertBefore(b, document.head.firstChild);
})();
</script>
<title>__TITLE__</title>
<style>
  :root{
    --bg:#ffffff; --bg-soft:#f6f7f9; --bg-band:#f0f2f5;
    --ink:#111418; --ink-soft:#5b636e; --line:#e4e7ec;
    --accent:#1a1a1a; --brand:#2f6bff; --brand-soft:#eaf0ff;
    --radius:14px; --maxw:1180px; --gutter:clamp(20px, 4vw, 56px);
    --mono:"SF Mono",ui-monospace,"JetBrains Mono",Menlo,Consolas,monospace;
    --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.65;-webkit-font-smoothing:antialiased}

  /* ---------- header ---------- */
  .header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.85);backdrop-filter:saturate(180%) blur(12px);border-bottom:1px solid var(--line)}
  .header-inner{max-width:var(--maxw);margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:14px var(--gutter)}
  .logo{font-weight:700;font-size:17px;letter-spacing:-.01em;display:flex;align-items:center;gap:9px}
  .logo .logo-img{height:26px;width:auto;display:block}
  .header-actions{display:flex;gap:10px;align-items:center}
  .btn{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;padding:7px 14px;border-radius:999px;text-decoration:none;border:1px solid var(--line);color:var(--ink);transition:.15s}
  .btn svg{width:15px;height:15px;flex:none}
  .btn:hover{background:var(--bg-soft)}
  .btn-primary{background:var(--accent);color:#fff;border-color:var(--accent)}
  .btn-primary:hover{opacity:.88;background:var(--accent)}

  /* ---------- hero ---------- */
  .hero-band{position:relative}
  .hero-band::before{content:"";position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(520px 260px at 18% 30%,rgba(47,107,255,.10),transparent 70%),
               radial-gradient(460px 240px at 50% 0%,rgba(124,58,237,.08),transparent 70%),
               radial-gradient(520px 260px at 84% 40%,rgba(234,88,12,.09),transparent 70%)}
  .hero-band::after{content:"";position:absolute;inset:0;pointer-events:none;
    background-image:radial-gradient(rgba(17,20,24,.11) 1px,transparent 1.2px);background-size:22px 22px;
    -webkit-mask-image:linear-gradient(#000 0%,transparent 92%);mask-image:linear-gradient(#000 0%,transparent 92%)}
  .hero{position:relative;z-index:1;max-width:var(--maxw);margin:0 auto;padding:72px var(--gutter) 30px;text-align:center}
  .hero .eyebrow{font-size:13px;color:var(--ink-soft);letter-spacing:.04em;text-transform:uppercase;font-weight:600}
  .hero h1{font-size:clamp(42px,7vw,76px);line-height:1.02;margin:14px 0 14px;letter-spacing:-.035em;font-weight:820}
  .hero .sub{font-size:clamp(16px,2.4vw,21px);color:var(--ink-soft);max-width:720px;margin:0 auto 26px}
  .hero-links{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .hero-links a{font-size:14.5px}
  .hero-links .btn{font-size:14.5px;font-weight:600;padding:10px 20px;background:#fff}
  .hero-links .btn:hover{transform:translateY(-1px)}
  .hero-links .btn-primary{background:var(--accent)}

  /* ---------- result showcase ---------- */
  .showcase{max-width:var(--maxw);margin:8px auto 10px;padding:0 var(--gutter)}
  .showcase-grid{display:grid;grid-template-columns:1fr;gap:22px}
  .result-card{background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--radius);padding:22px 22px 12px;overflow:hidden}
  .result-card h3{margin:0 0 4px;font-size:16px;font-weight:700}
  .result-card p{margin:0 0 14px;font-size:13.5px;color:var(--ink-soft)}
  .result-card img{width:100%;height:auto;border-radius:8px;display:block}
  .result-card iframe{width:100%;height:440px;border:none;border-radius:8px;display:block}

  /* ---------- tabs ---------- */
  .tabs-wrap{position:sticky;top:57px;z-index:40;background:rgba(255,255,255,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);margin-top:36px}
  .tabs{max-width:var(--maxw);margin:0 auto;display:flex;gap:4px;padding:0 var(--gutter);overflow-x:auto}
  .tab{appearance:none;border:0;background:none;font-family:inherit;font-size:14.5px;font-weight:600;color:var(--ink-soft);padding:15px 16px;cursor:pointer;border-bottom:2px solid transparent;white-space:nowrap;transition:.15s}
  .tab:hover{color:var(--ink)}
  .tab.active{color:var(--ink);border-bottom-color:var(--brand)}

  /* ---------- doc content ---------- */
  .doc-wrap{max-width:var(--maxw);margin:0 auto;padding:40px var(--gutter) 96px}
  .doc{display:none;animation:fade .25s ease}
  .doc.active{display:block}
  @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

  .breadcrumb{margin:0 0 8px}
  .breadcrumb a{font-size:13.5px;color:var(--ink-soft);text-decoration:none;font-weight:600}
  .breadcrumb a:hover{color:var(--brand)}

  .doc h1{font-size:32px;font-weight:800;letter-spacing:-.02em;margin:0 0 8px;padding-bottom:14px;border-bottom:1px solid var(--line)}
  .doc h2{font-size:23px;font-weight:750;margin:44px 0 14px;letter-spacing:-.01em}
  .doc h3{font-size:18px;font-weight:700;margin:28px 0 10px}
  .doc h4{font-size:15.5px;font-weight:700;margin:20px 0 8px;color:var(--ink-soft)}
  .doc p{margin:12px 0}
  .doc a{color:var(--brand);text-decoration:none}
  .doc a:hover{text-decoration:underline}
  .doc ul,.doc ol{padding-left:24px;margin:12px 0}
  .doc li{margin:6px 0}
  .doc img{max-width:100%;height:auto;border-radius:10px;border:1px solid var(--line);margin:8px 0}
  /* Inline logos inside tables: keep them text-sized (respect the tag's height attr), no border/margin */
  .doc td img,.doc th img{height:1.1em;width:auto;max-width:none;border:0;border-radius:0;margin:0 4px 0 0;vertical-align:-0.15em;display:inline-block}
  .doc div[align="center"]{text-align:center;margin:24px 0}
  /* Wide embeds: charts that need more room than the 1080px text column. Breaks out of
     .doc-wrap symmetrically and is capped to the viewport, so the page itself never
     gains a horizontal scrollbar. On narrow screens it degrades to the column width. */
  .doc .wide-embed{width:min(1440px,calc(100vw - 40px));margin-left:calc(50% - min(720px,50vw - 20px));margin-right:0}
  .doc .wide-embed iframe{width:100%;display:block}
  .doc code{font-family:var(--mono);font-size:.88em;background:var(--bg-band);padding:2px 6px;border-radius:5px}
  .doc pre{background:var(--bg-soft);border:1px solid var(--line);border-radius:10px;padding:16px;overflow-x:auto}
  .doc pre code{background:none;padding:0;font-size:13px;line-height:1.6}
  .doc blockquote{margin:16px 0;padding:8px 18px;border-left:3px solid var(--brand);background:var(--brand-soft);border-radius:0 8px 8px 0;color:var(--ink-soft)}
  .doc blockquote p{margin:4px 0}
  /* ── table — Kimi K3 Full Benchmark Table style ── */
  /* The card + horizontal scroll live on a wrapper div (injected in renderDoc),
     NOT on the table itself. A `display:block` table wraps its rows in an
     anonymous shrink-to-fit table box that ignores the block's min-width:100%,
     so the card stretched full width while the rows stopped at their content
     width — that gap was the blank block. A real display:table honours
     width:100%, and the wrapper gives position:sticky a scrollport. */
  /* ---------- 目录块 ----------
     Contents 原本就是一个 h2 加一个 ul，混在正文里跟普通小节长得一样。
     渲染后把这两个元素包进 <nav class="toc">，做成一块明显分离的卡片。 */
  .doc .toc{margin:0 0 40px;padding:18px 22px 16px;background:var(--bg-soft,#f7f8fa);
            border:1px solid var(--line,#e4e7ec);border-radius:14px}
  .doc .toc > h2{margin:0 0 10px;padding:0;border:0;font-size:12px;font-weight:800;
                 letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft,#5b636e)}
  .doc .toc ul{margin:0;padding-left:18px}
  .doc .toc ul ul{margin:2px 0}
  .doc .toc li{margin:3px 0;font-size:14.5px}
  .doc .toc a{text-decoration:none}
  .doc .toc a:hover{text-decoration:underline}

  .doc .tbl-scroll{margin:32px 0;overflow-x:auto;background:#fff;border-radius:12px;
    box-shadow:0 0 0 1px var(--line),0 2px 12px rgba(0,0,0,.05);
    scrollbar-width:thin;scrollbar-color:var(--line) transparent}
  .doc .tbl-scroll::-webkit-scrollbar{height:4px}
  .doc .tbl-scroll::-webkit-scrollbar-track{background:transparent}
  .doc .tbl-scroll::-webkit-scrollbar-thumb{background:var(--line);border-radius:2px}
  .doc table{border-collapse:collapse;display:block;width:fit-content;max-width:100%;overflow-x:auto;margin:0 auto;font-size:13.5px;background:#fff}
  .doc th{background:#f7f8fa;font-size:11px;font-weight:600;color:var(--ink-soft);letter-spacing:.05em;text-transform:uppercase;padding:11px 16px;text-align:left;white-space:nowrap;border-bottom:1px solid var(--line)}
  .doc td{padding:10px 16px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top;line-height:1.55;background:#fff}
  .doc tr:last-child td{border-bottom:none}
  /* sticky first column */
  .doc th:nth-child(1),.doc td:nth-child(1){position:sticky;left:0;z-index:2;border-right:1px solid var(--line);white-space:nowrap}
  .doc th:nth-child(1){background:#f7f8fa}
  .doc td:nth-child(1){background:#fff;font-weight:500}
  /* hover row */
  .doc tbody tr:hover td{background:#f9fafb}
  .doc tbody tr:hover td:nth-child(1){background:#f3f4f6}
  /* compact columns */
  /* Column widths are decided per table at render time (see the classifier in the
     render pass): columns whose cells are all short get .c-tight and hug their
     content, prose columns get .c-prose and absorb the leftover width. A table whose
     every column is tight hugs its container instead of stretching — otherwise a
     10-column metrics table pads each number out to a tenth of the page. */
  .doc th.c-tight,.doc td.c-tight{white-space:nowrap;width:1px}
  .doc td.c-prose{white-space:normal;min-width:160px}
  .doc .tbl-scroll.hug{width:fit-content;max-width:100%}
  .doc .tbl-scroll.hug table{width:auto}
  .doc table a{color:var(--brand);text-decoration:none}
  .doc table a:hover{text-decoration:underline}
  .doc hr{border:0;border-top:1px solid var(--line);margin:36px 0}

  .doc .toc{position:relative}
  .doc .fold-all{position:absolute;top:15px;right:16px;font-family:inherit;font-size:11.5px;
    color:var(--ink-soft);background:#fff;border:1px solid var(--line);border-radius:999px;
    padding:3px 11px;cursor:pointer;transition:.15s}
  .doc .fold-all:hover{color:var(--ink);border-color:#c5cad3}

  /* ---------- foldable sections ---------- */
  .doc h2.foldable{cursor:pointer;padding-left:26px;position:relative;transition:color .15s}
  .doc h2.foldable:hover{color:var(--brand)}
  .doc h2.foldable::before{content:"";position:absolute;left:5px;top:calc(50% - 5px);
    border-left:6px solid currentColor;border-top:5px solid transparent;border-bottom:5px solid transparent;
    opacity:.4;transform:rotate(90deg);transform-origin:30% 50%;transition:transform .18s,opacity .15s}
  .doc h2.foldable:hover::before{opacity:.9}
  .doc h2.folded::before{transform:rotate(0deg)}
  .doc .fold-body.folded{display:none}
  .doc .fold-body.opening{animation:fade .22s ease}

  .footer{border-top:1px solid var(--line);padding:28px var(--gutter);text-align:center;color:var(--ink-soft);font-size:13px}

  /* KaTeX display blocks: give them breathing room and horizontal scroll on overflow */
  .doc .katex-display{margin:20px 0;overflow-x:auto;overflow-y:hidden;padding:2px 0}
  .doc .katex{font-size:1.05em}
</style>
<style>
/*__KATEX_CSS__*/
</style>
</head>
<body>

<header class="header">
  <div class="header-inner">
    <div class="logo"><img src="assets/figures/abc-logo.png" alt="ABC" class="logo-img">__TITLE__</div>
    <div class="header-actions">
      <a class="btn btn-primary" href="https://app.abcai.com/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.9 5.6L19.5 9l-5.6 1.9L12 16.5l-1.9-5.6L4.5 9l5.6-1.4z"/><path d="M18.5 14l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9z"/></svg>Try ABC ↗</a>
    </div>
  </div>
</header>

<main>
  <div class="hero-band">
  <section class="hero">
    <h1>__TITLE__</h1>
    <div class="hero-links">
      <a class="btn btn-primary" href="__TRY__" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>Try ABC-Critic</a>
      <a class="btn" href="https://forge.coreweave.com/wandb/544546495-ustc/video-rl/workspace?nw=nwuser544546495" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="4" cy="5" r="2.1"/><rect x="2.3" y="10" width="3.4" height="11" rx="1.7"/><rect x="10.3" y="3" width="3.4" height="12" rx="1.7"/><circle cx="12" cy="20" r="2.1"/><rect x="18.3" y="8" width="3.4" height="13" rx="1.7"/></svg>W&amp;B Training Runs ↗</a>
    </div>
  </section>
  </div>

  <div class="tabs-wrap">
    <div class="tabs" id="tabs"></div>
  </div>

  <div class="doc-wrap" id="docs"></div>
</main>

<footer class="footer">
  ABC-Critic V1.0 · built from local markdown
</footer>

<script>/*__MARKED__*/</script>
<script>/*__KATEX_JS__*/</script>
<script>
  // ---- constants -----------------------------------------------------------
  // Combined height of the two sticky bars (header + tabs-wrap) in pixels.
  // scrollTo subtracts this so the newly-activated section isn't hidden behind them.
  const STICKY_HEADER_HEIGHT = 60;
  // Max parent hops when walking up to the nearest tab ancestor.
  // Guards against cycles if the doc graph is somehow malformed.
  const MAX_ANCESTOR_DEPTH = 50;

  // ---- data ----------------------------------------------------------------
  const DOCS   = __DOCS__;
  const tabsEl = document.getElementById('tabs');
  const docsEl = document.getElementById('docs');

  /** Map doc id → doc object for O(1) lookup. */
  const byId = {};
  DOCS.forEach(doc => { byId[doc.id] = doc; });

  const firstId = DOCS[0].id;

  marked.setOptions({ gfm: true, breaks: false });

  // ---- heading id (TOC anchor support) -------------------------------------
  // Inject GitHub-style slug ids so TOC links like #1-system-architecture work.
  marked.use({
    renderer: {
      // marked changed this hook's signature across majors: older builds pass
      // (text, level), newer ones a token object. setup-assets.sh pulls the
      // latest marked, so accept both rather than pin to one.
      heading(arg, level) {
        const text  = typeof arg === 'string' ? arg : (arg.text ?? '');
        const depth = typeof arg === 'string' ? level : arg.depth;
        // Strip any HTML tags (e.g. <strong>) to get plain text for slug
        const plain = String(text).replace(/<[^>]+>/g, '').trim();
        const slug = plain
          .toLowerCase()
          .replace(/[^\w一-鿿\s\-]/g, '') // keep alphanum, CJK, space, hyphen
          .trim()
          .replace(/\s+/g, '-');
        return `<h${depth} id="${slug}">${text}</h${depth}>\n`;
      }
    }
  });

  // ---- math-safe markdown render -------------------------------------------
  // marked would mangle LaTeX ($a_t$ → emphasis, \frac → lost backslash), so
  // we stash code spans/blocks first (never treat $ inside code as math), pull
  // math out to indexed sentinels, run marked, then restore raw $…$/$$…$$ for KaTeX.
  //
  // Sentinels wrap the index in Private-Use-Area chars (U+E000…U+E001) that
  // never occur in real prose or markdown. An earlier scheme used space-padded
  // " C<n> " / " M<n> " tokens, which collided with ordinary text such as
  // "美团 M17 fully async" — the restore step then looked up a nonexistent math
  // entry and threw, aborting the render loop and hiding every later tab.
  const _S0 = '', _S1 = '';
  const _CODE_RE = new RegExp(_S0 + 'C(\\d+)' + _S1, 'g');
  const _MATH_RE = new RegExp(_S0 + 'M(\\d+)' + _S1, 'g');
  function renderDoc(md) {
    const codeStash = [];
    const codeTok = m => { codeStash.push(m); return _S0 + 'C' + (codeStash.length - 1) + _S1; };
    md = md.replace(/```[\s\S]*?```/g, codeTok);
    md = md.replace(/`[^`\n]*`/g,      codeTok);

    const mathStash = [];
    md = md.replace(/\$\$([\s\S]+?)\$\$/g, (_, x) => { mathStash.push({ display: true,  tex: x }); return _S0 + 'M' + (mathStash.length - 1) + _S1; });
    md = md.replace(/\$([^\$\n]+?)\$/g,    (_, x) => { mathStash.push({ display: false, tex: x }); return _S0 + 'M' + (mathStash.length - 1) + _S1; });

    md = md.replace(_CODE_RE, (_, i) => codeStash[+i]);   // restore code before marked
    let html = marked.parse(md);
    html = html.replace(_MATH_RE, (_, i) => {
      const entry = mathStash[+i];
      // HTML-escape < > & so the browser doesn't parse LaTeX as HTML tags when
      // assigned to innerHTML. KaTeX's renderMathInElement reads textContent and
      // will decode these back to the correct LaTeX characters automatically.
      const tex = entry.tex.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return entry.display ? ('$$' + tex + '$$') : ('$' + tex + '$');
    });
    return html;
  }

  function typesetMath(el) {
    if (window.renderMathInElement) renderMathInElement(el, {
      delimiters: [
        { left: '$$', right: '$$', display: true  },
        { left: '$',  right: '$',  display: false },
      ],
      throwOnError: false,
      ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
    });
  }

  // ---- contents card + foldable sections -----------------------------------
  // Each doc opens with "## Contents" plus a link list; that pair becomes a card.
  // Every other h2 owns the nodes after it until the next h1/h2, wrapped in
  // .fold-body so the heading can collapse its own section.

  function setFold(heading, folded) {
    const body = heading.nextElementSibling;
    if (!body || !body.classList.contains('fold-body')) return;
    heading.classList.toggle('folded', folded);
    body.classList.toggle('folded', folded);
    heading.setAttribute('aria-expanded', String(!folded));
    if (!folded) { body.classList.remove('opening'); void body.offsetWidth; body.classList.add('opening'); }
  }

  function enhanceDoc(body) {
    // The contents card is built earlier in the render pass; reuse it.
    const toc = body.querySelector('nav.toc');

    const foldable = [];
    body.querySelectorAll('h2').forEach(heading => {
      if (heading.closest('nav, table, details')) return;
      const wrap = document.createElement('div');
      wrap.className = 'fold-body';
      let node = heading.nextSibling;
      while (node && !(node.nodeType === 1 && /^H[12]$/.test(node.tagName))) {
        const next = node.nextSibling;
        wrap.appendChild(node);
        node = next;
      }
      if (!wrap.childNodes.length) return;
      heading.parentNode.insertBefore(wrap, heading.nextSibling);
      heading.classList.add('foldable');
      heading.tabIndex = 0;
      heading.setAttribute('aria-expanded', 'true');
      heading.title = '点击收起 / 展开本节';
      heading.addEventListener('click', e => {
        if (e.target.closest('a[href]')) return;
        if (String(window.getSelection())) return;
        setFold(heading, !heading.classList.contains('folded'));
      });
      heading.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setFold(heading, !heading.classList.contains('folded'));
        }
      });
      foldable.push(heading);
    });

    if (toc && foldable.length) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'fold-all';
      btn.textContent = '全部收起';
      btn.onclick = () => {
        const anyOpen = foldable.some(h => !h.classList.contains('folded'));
        foldable.forEach(h => setFold(h, anyOpen));
        btn.textContent = anyOpen ? '全部展开' : '全部收起';
      };
      toc.appendChild(btn);
    }
  }

  // A link into a collapsed section opens it first.
  function revealTarget(id) {
    const target = id && document.getElementById(id);
    if (!target) return;
    if (target.classList.contains('foldable') && target.classList.contains('folded')) setFold(target, false);
    let folded = target.closest('.fold-body.folded');
    while (folded) {
      setFold(folded.previousElementSibling, false);
      folded = folded.parentElement && folded.parentElement.closest('.fold-body.folded');
    }
  }
  document.addEventListener('click', e => {
    const a = e.target.closest && e.target.closest('a[href^="#"]');
    if (!a) return;
    const href = a.getAttribute('href');
    if (href.startsWith('#doc:')) return;
    revealTarget(decodeURIComponent(href.slice(1)));
  }, true);

  // ---- doc-graph traversal -------------------------------------------------

  /** Walk parent links upward to find the nearest tab ancestor of `id`. */
  function tabAncestor(id) {
    let doc = byId[id], depth = 0;
    while (doc && !doc.tab && doc.parent && depth++ < MAX_ANCESTOR_DEPTH) {
      doc = byId[doc.parent];
    }
    return doc ? doc.id : id;
  }

  // ---- DOM construction ----------------------------------------------------

  DOCS.forEach(docData => {
    // Tab button (only for top-level tab docs)
    if (docData.tab) {
      const btn       = document.createElement('button');
      btn.className   = 'tab' + (docData.id === firstId ? ' active' : '');
      btn.textContent = docData.label;
      btn.dataset.target = docData.id;
      btn.onclick     = () => activate(docData.id);
      tabsEl.appendChild(btn);
    }

    // Article element that holds the rendered markdown
    const article     = document.createElement('article');
    article.className = 'doc' + (docData.id === firstId ? ' active' : '');
    article.id        = 'doc-' + docData.id;

    // Breadcrumb link for sub-docs
    if (docData.parent && byId[docData.parent]) {
      const breadcrumb     = document.createElement('div');
      breadcrumb.className = 'breadcrumb';
      breadcrumb.innerHTML = '<a href="#">← 返回 ' + byId[docData.parent].label + '</a>';
      breadcrumb.querySelector('a').onclick = (e) => { e.preventDefault(); activate(docData.parent); };
      article.appendChild(breadcrumb);
    }

    // Rendered markdown body
    const body     = document.createElement('div');
    body.innerHTML = renderDoc(docData.md);

    // Wrap every table in a scroll container. The card styling and overflow live
    // on the wrapper (see .tbl-scroll) so the table can stay a real display:table.
    // Done on the DOM rather than by regex so raw <table> blocks written directly
    // in markdown are wrapped too.
    //
    // Then size the columns from their actual content: a column of numbers or short
    // labels hugs its text, prose columns take what's left, and an all-short table
    // stops stretching to full width (a 10-column P/R/F1 table used to spread four
    // characters across a tenth of the page each).
    const TIGHT_MAX = 12;   // longest cell, in characters, that still counts as short
    // 目录：h2#contents 与其后的 ul 抽成一块 nav.toc，跟正文隔开
    const cH = body.querySelector('h2#contents');
    if (cH && cH.nextElementSibling && cH.nextElementSibling.tagName === 'UL') {
      const nav = document.createElement('nav');
      nav.className = 'toc';
      cH.parentNode.insertBefore(nav, cH);
      nav.appendChild(cH);
      nav.appendChild(nav.nextElementSibling);   // 上一步之后 ul 正好紧跟在 nav 后面
    }

    body.querySelectorAll('table').forEach(t => {
      let w = t.parentElement;
      if (!w || !w.classList.contains('tbl-scroll')) {
        w = document.createElement('div');
        w.className = 'tbl-scroll';
        t.parentNode.insertBefore(w, t);
        w.appendChild(t);
      }
      const rows = Array.prototype.slice.call(t.rows);
      const ncol = rows.reduce((m, r) => Math.max(m, r.cells.length), 0);
      let allTight = ncol > 0;
      for (let c = 0; c < ncol; c++) {
        let longest = 0, wrapped = false;
        rows.forEach(r => {
          const cell = r.cells[c];
          if (!cell || cell.tagName === 'TH') return;   // headers don't decide the class
          longest = Math.max(longest, (cell.textContent || '').trim().length);
          if (cell.querySelector('br,ul,ol,p,pre')) wrapped = true;
        });
        const tight = !wrapped && longest > 0 && longest <= TIGHT_MAX;
        if (!tight) allTight = false;
        rows.forEach(r => {
          const cell = r.cells[c];
          if (cell) cell.classList.add(tight ? 'c-tight' : 'c-prose');
        });
      }
      if (allTight) w.classList.add('hug');
    });

    // External links open in a new tab; local .md links were rewritten by
    // build.py to #doc:<id> and are handled by the click interceptor below.
    body.querySelectorAll('a[href]').forEach(a => {
      const href = a.getAttribute('href') || '';
      if (/^(https?:|mailto:)/.test(href)) { a.target = '_blank'; a.rel = 'noopener'; }
    });

    enhanceDoc(body);
    typesetMath(body);
    article.appendChild(body);
    docsEl.appendChild(article);
  });

  // ---- navigation ----------------------------------------------------------

  // Never stretch a table past its natural width. The class pass above sizes
  // columns, but a table with three short columns and one 20-char prose column
  // still gets width:100% — the prose column then absorbs ~700px of leftover for
  // 20 characters, which reads as a broken layout (评测维度 / 视频数 was exactly
  // that). So measure each table once at width:auto: if its content comfortably
  // fits the column, let the wrapper hug it (same .hug path all-tight tables take);
  // otherwise it keeps width:100% and wraps as before. Deferred to activate()
  // because .doc is display:none until then, and clientWidth would read 0 — hence
  // the dataset.fit latch, which is only set once a real width was measured.
  function fitTables(scope) {
    scope.querySelectorAll('.tbl-scroll').forEach(w => {
      if (w.dataset.fit || !w.clientWidth) return;
      w.dataset.fit = '1';
      const t = w.querySelector('table');
      if (!t || w.classList.contains('hug')) return;
      const avail = w.clientWidth;
      t.style.width = 'auto';
      const natural = t.scrollWidth;
      t.style.width = '';
      if (natural <= avail * 0.94) w.classList.add('hug');
    });
  }
  document.querySelectorAll('.doc.active').forEach(fitTables);

  function activate(id) {
    const doc = byId[id];
    if (!doc) return;

    const tabId = tabAncestor(id);
    document.querySelectorAll('.tab').forEach(
      tab => tab.classList.toggle('active', tab.dataset.target === tabId)
    );
    document.querySelectorAll('.doc').forEach(
      docEl => docEl.classList.toggle('active', docEl.id === 'doc-' + id)
    );
    document.querySelectorAll('.doc.active').forEach(fitTables);

    if (location.hash.slice(1) !== id) history.replaceState(null, '', '#' + id);
    window.scrollTo({
      top: document.querySelector('.tabs-wrap').offsetTop - STICKY_HEADER_HEIGHT,
      behavior: 'smooth',
    });
  }

  // Intercept in-page doc links (build.py rewrites local .md links to #doc:<id>).
  docsEl.addEventListener('click', (e) => {
    const a = e.target.closest('a');
    if (!a) return;
    const href  = a.getAttribute('href') || '';
    const match = href.match(/^#doc:(.+)$/);
    if (match && byId[match[1]]) { e.preventDefault(); activate(match[1]); }
    // External links (target=_blank) and plain #anchors fall through to default.
  });

  // Deep-link support: accepts both #<id> and #doc:<id> in the URL hash.
  const initial = location.hash.slice(1).replace(/^doc:/, '');
  if (initial && byId[initial]) activate(initial);
</script>

<!-- kc-expand: tag-system iframe 内打开 modal 时，把发消息的那个 iframe 放大到全屏，
     modal 悬浮其上；背后铺一层「模糊 + 变暗」遮罩，真实博客页面透过来（不再是图表
     自己的白底），符合「背景该是什么还是什么，只是模糊一些」。iframe 本身透明，只显示
     居中的 modal。关闭时精确还原，用占位符保持文档流不跳动。 -->
<script>
(function(){
  var expanded = null;      // 当前被放大的 iframe
  var savedCss = '';        // 它放大前的 style
  var placeholder = null;   // 占位符：iframe 变 fixed 后顶住它原来的空间，防止页面回流
  var scrim = null;         // 变暗 + 模糊遮罩层（盖在博客页面上，iframe 之下）
  var revealTimer = null;   // 兜底：子页不回 kc-modal-ready 时也要把 iframe 显影
  var finishTimer = null;   // 兜底：子页不回 kc-revealed 时也要撤遮罩收尾
  function frameOf(win){
    var ifr = document.getElementsByTagName('iframe');
    for (var i = 0; i < ifr.length; i++){
      if (ifr[i].contentWindow === win) return ifr[i];
    }
    return null;
  }
  function expand(win){
    var fr = frameOf(win);
    if (!fr || expanded) return;
    expanded = fr; savedCss = fr.getAttribute('style') || '';
    // 占位符撑住原空间，避免 iframe 脱离文档流导致下方内容上跳
    var r = fr.getBoundingClientRect();
    placeholder = document.createElement('div');
    placeholder.style.cssText = 'height:' + r.height + 'px';
    fr.parentNode.insertBefore(placeholder, fr);
    // scrim：模糊+变暗真实页面
    scrim = document.createElement('div');
    scrim.style.cssText = 'position:fixed;inset:0;z-index:9998;background:rgba(12,15,20,.5);'
                        + '-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);';
    document.body.appendChild(scrim);
    // iframe 透明铺满，但先 opacity:0 藏起来 —— 放大后的这一两帧里，子页面画的
    // 还是「行内尺寸的图表」，不藏就会看到那块背景以全屏尺寸闪一下（flash.png）。
    // 等子页 modal 成形后回 kc-modal-ready，再显影。
    fr.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;'
                     + 'z-index:9999;border:0;border-radius:0;background:transparent;opacity:0;';
    document.body.style.overflow = 'hidden';
    // 等两帧确保 iframe 的新尺寸已生效，再通知子页面开 modal（消除小→大跳动）
    requestAnimationFrame(function(){ requestAnimationFrame(function(){
      fr.contentWindow.postMessage({type: 'kc-expand-ack', vw: window.innerWidth, vh: window.innerHeight}, '*');
    }); });
    // 兜底：子页面若不回 kc-modal-ready（旧版图表），也不能永远隐身
    revealTimer = setTimeout(reveal, 600);
  }
  // 显影。这里必须再等几帧，不能收到消息就 opacity:1。
  // iframe 是独立进程：子页在自己进程里 double-rAF 只能证明「子页画完了」，不能证明
  // 父页的合成器已经取到那一帧。抢跑的结果是父页把 iframe 显影出来，而合成器手上
  // 还是子页的上一帧 —— 刚按全屏重排、classes 还没生效的标签树，清晰地盖在模糊页面
  // 上。这就是 flash.png。多等 3 帧（~50ms）让新的子页面帧确定被合成，用户感知不到，
  // 但闪烁彻底消失。
  function revealSoon(fn){
    var n = 0;
    (function step(){
      if (++n >= 3) { fn(); return; }
      requestAnimationFrame(step);
    })();
    setTimeout(fn, 150);          // rAF 不跑（后台标签页）时的兜底
  }
  function reveal(){
    clearTimeout(revealTimer); revealTimer = null;
    var fr = expanded;
    if (!fr) return;
    var done = false;
    revealSoon(function(){
      if (done || expanded !== fr) return;
      done = true;
      fr.style.opacity = '1';
    });
  }
  // 关闭分三步，几何还原和子页恢复内容全部发生在 opacity:0 之下：
  //   ① collapse(): 先把 iframe 按成透明，再还原几何，然后请子页恢复图表内容。
  //      这两件事顺序颠倒过来就是上一版残留的 bug —— setAttribute(style, savedCss)
  //      同时还原了「尺寸」和「不透明」，而子页要等 ack 才恢复内容，中间必然有一帧
  //      「行内尺寸的空白矩形」。
  //   ② 子页恢复完内容回 kc-revealed。
  //   ③ finish(): 同一帧里撤遮罩 + 显影。中间态一帧都不上屏。
  function collapse(){
    if (!expanded) return;
    var fr = expanded;
    clearTimeout(revealTimer); revealTimer = null;
    // 隐身 + 还原几何，一次写完：位置、尺寸、边框圆角回到行内，但仍然不可见。
    // 此时用户看到的还是「模糊的页面」（遮罩还在），iframe 里发生什么都不上屏。
    fr.setAttribute('style', savedCss + ';opacity:0');
    // 等两帧确保 iframe 已按行内尺寸重新布局，再让子页把图表放出来 —— 否则子页会
    // 以全屏尺寸画一两帧。子页恢复完会回 kc-revealed，由 finish() 收尾。
    requestAnimationFrame(function(){ requestAnimationFrame(function(){
      try { fr.contentWindow.postMessage({type: 'kc-collapse-ack'}, '*'); } catch(_){}
    }); });
    finishTimer = setTimeout(finish, 400);   // 子页不回 kc-revealed 时的兜底
  }
  // 撤遮罩 + 显影，同一帧完成。
  function finish(){
    clearTimeout(finishTimer); finishTimer = null;
    if (!expanded) return;
    var fr = expanded;
    // 同理：子页说「我恢复好了」不等于父页合成器已经拿到那一帧。抢跑会露出
    // 「行内尺寸的空白矩形」。等几帧再撤遮罩+显影。
    revealSoon(function(){
      if (fr !== expanded) return;
      if (placeholder) placeholder.remove();
      if (scrim) scrim.remove();
      fr.setAttribute('style', savedCss);    // 去掉 opacity:0，恢复原样
      expanded = null; savedCss = ''; placeholder = null; scrim = null;
      document.body.style.overflow = '';
    });
  }
  // kc-height: 子页报告自己内容的真实高度，父页把 iframe 高度贴合过去 —— 图表在窄屏
  // 折行后会变高，写死的行内 height 会把它裁掉（变成 iframe 内的竖向滚动条）。
  // 放大态的 iframe 是 fixed inset:0，此时不能动它的高度。
  function fitHeight(win, h){
    var fr = frameOf(win);
    if (!fr || fr === expanded || !(h > 0)) return;
    fr.style.height = Math.ceil(h) + 'px';
  }
  window.addEventListener('message', function(e){
    if (!e.data) return;
    if (e.data.type === 'kc-expand')      expand(e.source);
    if (e.data.type === 'kc-modal-ready') reveal();
    if (e.data.type === 'kc-collapse')    collapse();
    if (e.data.type === 'kc-revealed')    finish();
    if (e.data.type === 'kc-height')      fitHeight(e.source, e.data.h);
  });
})();
</script>
</body>
</html>

