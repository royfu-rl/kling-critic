" vertex="1" parent="1"><mxGeometry x="630.0" y="730.0" width="272.0" height="22.0" as="geometry"/></mxCell><mxCell id="c131" value="&lt;div style=&quot;line-height:14.2px;letter-spacing:0.0px&quot;&gt;No extra cost · better precision and recall&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#0f6b41;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="630.0" y="730.0" width="272.0" height="22.0" as="geometry"/></mxCell><mxCell id="c132" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#1f9d63;strokeWidth=1.6;shadow=0;opacity=100;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="1146.0" y="578.0" width="500.0" height="186.0" as="geometry"/></mxCell><mxCell id="c133" value="&lt;div style=&quot;line-height:18.2px;letter-spacing:0.0px&quot;&gt;Collapse, split by defect type&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13.5;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1164.0" y="594.0" width="464.0" height="22.0" as="geometry"/></mxCell><mxCell id="c134" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;the split the verifier would route on&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#5b636e;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1164.0" y="616.0" width="464.0" height="18.0" as="geometry"/></mxCell><mxCell id="c135" value="" style="rounded=1;absoluteArcSize=1;arcSize=9;fillColor=#e2f5ec;strokeColor=none;strokeWidth=1.6;shadow=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="1164.0" y="644.0" width="148.0" height="30.0" as="geometry"/></mxCell><mxCell id="c136" value="&lt;div style=&quot;line-height:15.5px;letter-spacing:0.0px&quot;&gt;Human body&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11.5;fontColor=#0f6b41;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1176.0" y="644.0" width="134.0" height="30.0" as="geometry"/></mxCell><mxCell id="c137" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;torso · hands&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#8d96a3;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1324.0" y="644.0" width="302.0" height="30.0" as="geometry"/></mxCell><mxCell id="c138" value="" style="rounded=1;absoluteArcSize=1;arcSize=9;fillColor=#e2f5ec;strokeColor=none;strokeWidth=1.6;shadow=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="1164.0" y="680.0" width="148.0" height="30.0" as="geometry"/></mxCell><mxCell id="c139" value="&lt;div style=&quot;line-height:15.5px;letter-spacing:0.0px&quot;&gt;Creature&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11.5;fontColor=#0f6b41;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1176.0" y="680.0" width="134.0" height="30.0" as="geometry"/></mxCell><mxCell id="c140" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;anatomy&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#8d96a3;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1324.0" y="680.0" width="302.0" height="30.0" as="geometry"/></mxCell><mxCell id="c141" value="" style="rounded