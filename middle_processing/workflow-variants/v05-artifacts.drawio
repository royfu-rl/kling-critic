m=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="564.0" width="530.0" height="20.0" as="geometry"/></mxCell><mxCell id="c103" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— One clip now visits several recallers&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="586.0" width="530.0" height="20.0" as="geometry"/></mxCell><mxCell id="c104" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#fdeaec;strokeColor=none;strokeWidth=1.6;shadow=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="96.0" y="608.0" width="128.0" height="22.0" as="geometry"/></mxCell><mxCell id="c105" value="&lt;div style=&quot;line-height:14.2px;letter-spacing:0.0px&quot;&gt;Costs more rollouts&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#9b2430;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="608.0" width="128.0" height="22.0" as="geometry"/></mxCell><mxCell id="c106" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#1f9d63;strokeWidth=1.6;shadow=0;opacity=100;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="678.0" y="466.0" width="566.0" height="176.0" as="geometry"/></mxCell><mxCell id="c107" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="696.0" y="482.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="c108" value="&lt;div style=&quot;line-height:20.2px;letter-spacing:0.0px&quot;&gt;MoE Verifier&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;