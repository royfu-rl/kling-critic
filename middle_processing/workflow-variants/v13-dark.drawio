"><mxGeometry x="1458.0" y="216.0" width="276.0" height="28.0" as="geometry"/></mxCell><mxCell id="c60" value="&lt;div style=&quot;line-height:15.5px;letter-spacing:0.0px&quot;&gt;Roll surviving evidence into a verdict&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11.5;fontColor=#9aa5b1;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1458.0" y="318.0" width="276.0" height="32.0" as="geometry"/></mxCell><mxCell id="c61" value="" style="line;strokeColor=#2b323c;strokeWidth=1.2;html=1;" vertex="1" parent="1"><mxGeometry x="1458.0" y="354.0" width="276.0" height="8.0" as="geometry"/></mxCell><mxCell id="c62" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— Score and status&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#d6dde4;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1458.0" y="366.0" width="276.0" height="26.0" as="geometry"/></mxCell><mxCell id="c63" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— Hard failures&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#d6dde4;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1458.0" y="396.0" width="276.0" height="26.0" as="geometry"/></mxCell><mxCell id="c64" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— Annotated evidence frames&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#d6dde4;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1458.0" y="426.0" width="276.0" height="26.0" as="geometry"/></mxCell><mxCell id="c65" value="&lt;div style=&quot;line-height:14.2px;letter-spacing:1.3px&quot;&gt;CANDIDATE UPGRADES · NOT YET SHIPPED&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#6f7a87;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="48.0" y="512.0" width="500.0" height="14.0" as="geometry"/></mxCell><mxCell id="c66" value="" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#12161b;strokeColor=#2b323c;strokeWidth=1.6;shadow=0;opacity=100;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="48.0" y="536.0" width="1704.0" height="222.0" as="geometry"/></mxCell><mxCell id="c67" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#161b22;strokeColor=#ff8f9b;strokeWidth=1.6;shadow=0;opacity=100;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="78.0" y="562.0" width="520.0" height="172.0" as="geometry"/></mxCell><mxCell id="c68" value="&lt;div style=&quot;line-height:20.2px;letter-spacing:0.0px&quot;&gt;MoE Recall&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#ff8f9b;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="98.0" y="578.0" width="300.0" height="22.0" as="geometry"/></mxCell><mxCell id="c69" value="&lt;div style=&quot;line-height:15.5px;letter-spacing:0.0px&quot;&gt;Split one broad question across specialist recallers&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11.5;fontColor=#9aa5b1;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="98.0" y="600.0" width="480.0" height="18.0" as="geometry"/></mxCell><mxCell id="c70" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— Each recaller owns a narrow question&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#d6dde4;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="98.0" y="626.0" width="480.0" height="20.0" as="geometry"/></mxCell><mxCell id="c71" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— Fewer missed spans on rare defects&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#d6dde4;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="98.0" y="648.0" width="480.0" height="20.0" as="geometry"/></mxCell><mxCell id="c72" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— One clip now visits several recallers&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#d6dde4;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="98.0" y="670.0" width="480.0" height="20.0" as="geometry"/></mxCell><mxCell id="c73" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#1d242c;strokeColor=none;strokeWidth=1.6;shadow=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="98.0" y="700.0" width="128.0" height="22.0" as="geometry"/></mxCell><mxCell id="c74" value="&lt;div style=&quot;line-height:14.2px;letter-spacing:0.0px&quot;&gt;Costs more rollouts&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#ff8f9b;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="98.0" y="700.0" width="128.0" height="22.0" as="geometry"/></mxCell><mxCell id="c75" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#161b22;strokeColor=#5ef08a;strokeWidth=1.6;shadow=0;opacity=100;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="632.0" y="562.0" width="520.0" height="172.0" as="geometry"/></mxCell><mxCell id="c76" value="&lt;div style=&quot;line-height:20.2px;letter-spacing:0.0px&quot;&gt;MoE Verifier&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#5ef08a;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="652.0" y="578.0" width="300.0" height="22.0" as="geometry"/></mxCell><mxCell id="c77" value="&lt;div style=&quot;line-height:15.5px;letter-spacing:0.0px&quot;&gt;Route each defect type to its own specialist&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11.5;fontColor=#9aa5b1;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="652.0" y="600.0" width="480.0" height="18.0" as="geometry"/></mxCell><mxCell id="c78" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— A specialist stops guessing outside its family&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#d6dde4;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="652.0" y="626.0" width="480.0" height="20.0" as="geometry"/></mxCell><mxCell id="c79" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— Rare sub-types stop being drowned by common ones&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#d6dde4;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="652.0" y="648.0" width="480.0" height="20.0" as="geometry"/></mxCell><mxCell id="c80" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— One clip still visits exactly one verifier&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#d6dde4;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="652.0" y="670.0" width="480.0" height="20.0" as="geometry"/></mxCell><mxCell id="c81" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#1d242c;strokeColor=none;strokeWidth=1.6;shadow=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="652.0" y="700.0" width="272.0" height="22.0" as="geometry"/></mxCell><mxCell id="c82" value="&lt;div style=&quot;line-height:14.2px;letter-spacing:0.0px&quot;&gt;No extra cost · better precision and recall&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#5ef08a;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="652.0" y="700.0" width="272.0" height="22.0" as="geometry"/></mxCell><mxCell id="c83" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#161b22;strokeColor=#2b323c;strokeWidth=1.6;shadow=0;opacity=100;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="1186.0" y="562.0" width="520.0" height="172.0" as="geometry"/></mxCell><mxCell id="c84" value="&lt;div style=&quot;line-height:18.2px;letter-spacing:0.0px&quot;&gt;Collapse, split by defect type&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13.5;fontColor=#ffffff;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1206.0" y="578.0" width="400.0" height="22.0" as="geometry"/></mxCell><mxCell id="c85" value="" style="rounded=1;absol