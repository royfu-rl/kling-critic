" parent="1"><mxGeometry x="96.0" y="720.0" width="484.0" height="20.0" as="geometry"/></mxCell><mxCell id="c110" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— One clip now visits several recallers&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="742.0" width="484.0" height="20.0" as="geometry"/></mxCell><mxCell id="c111" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#fdeaec;strokeColor=none;strokeWidth=1.6;shadow=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="96.0" y="768.0" width="128.0" height="22.0" as="geometry"/></mxCell><mxCell id="c112" value="&lt;div style=&quot;line-height:14.2px;letter-spacing:0.0px&quot;&gt;Costs more rollouts&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#9b2430;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="768.0" width="128.0" height="22.0" as="geometry"/></mxCell><mxCell id="c113" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#1f9d63;strokeWidth=1.6;shadow=0;opacity=100;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="632.0" y="622.0" width="520.0" height="180.0" as="geometry"/></mxCell><mxCell id="c114" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="650.0" y="638.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="c115" value="&lt;div style=&quot;line-height:20.2px;letter-spacing:0.0px&quot;&gt;MoE Verifier&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#0f6b41;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="686.0" y="638.0" width="448.0" height="22.0" as="geometry"/></mxCell><mxCell id="c116" value="&lt;div style=&quot;line-height:15.5px;letter-spacing:0.0px&quot;&gt;Route each defect type to its own specialist&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11.5;fontColor=#5b636e;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="686.0" y="660.0" width="444.0" height="18.0" as="geometry"/></mxCell><mxCell id="c117" value="" style="line;strokeColor=#e2f5ec;strokeWidth=1.2;html=1;" vertex="1" parent="1"><mxGeometry x="650.0" y="684.0" width="484.0" height="8.0" as="geometry"/></mxCell><mxCell id="c118" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— A specialist stops guessing outside its family&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="650.0" y="698.0" width="484.0" height="20.0" as="geometry"/></mxCell><mxCell id="c119" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— Rare sub-types stop being drowned by common ones&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="650.0" y="720.0" width="484.0" height="20.0" as="geometry"/></mxCell><mxCell id="c120" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— One clip still visits exactly one verifier&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="650.0" y="742.0" width="484.0" height="20.0" as="geometry"/></mxCell><mxCell id="c121" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#e2f5ec;strokeColor=none;strokeWidth=1.6;shadow=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="650.0" y="768.0" width="272.0" height="22.0" as="geometry"/></mxCell><mxCell id="c122" value="&lt;div style=&quot;line-height:14.2px;letter-spacing:0.0px&quot;&gt;No extra cost · better precision and recall&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#0f6b41;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="650.0" y="768.0" width="272.0" height="22.0" as="geometry"/></mxCell><mxCell id="c123" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#1f9d63;strokeWidth=1.6;shadow=0;opacity=100;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="1186.0" y="622.0" width="520.0" height="180.0" as="geometry"/></mxCell><mxCell id="c124" value="&lt;div style=&quot;line-height:18.2px;letter-spacing:0.0px&quot;&gt;Collapse, split by defect type&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13.5;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1204.0" y="638.0" width="484.0" height="22.0" as="geometry"/></mxCell><mxCell id="c125" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;the split the verifier would route on&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#5b636e;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;