ontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="630.0" y="678.0" width="464.0" height="20.0" as="geometry"/></mxCell><mxCell id="c128" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— One clip still visits exactly one verifier&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="630.0" y="700.0" width="464.0" height="20.0" as="geometry"/></mxCell><mxCell id="c129" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#e2f5ec;strokeColor=none;strokeWidth=1.6;shadow=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="630.0" y="726.0" width="272.0" height="22.0" as="geometry"/></mxCell><mxCell id="c130" value="&lt;div style=&quot;line-height:14.2px;letter-spacing:0.0px&quot;&gt;No extra cost · better precision and recall&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#0f6b41;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="630.0" y="726.0" width="272.0" height="22.0" as="geometry"/></mxCell><mxCell id="c131" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#1f9d63;strokeWidth=1.6;shadow=0;opacity=100;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="1146.0" y="580.0" width="500.0" height="180.0" as="geometry"/></mxCell><mxCell id="c132" value="&lt;div style=&quot;line-height:18.2px;letter-spacing:0.0px&quot;&gt;Collapse, split by defect type&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13.5;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;s