/mxCell><mxCell id="c111" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#d94452;strokeWidth=1.6;shadow=0;opacity=100;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="78.0" y="580.0" width="500.0" height="180.0" as="geometry"/></mxCell><mxCell id="c112" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="96.0" y="596.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="c113" value="&lt;div style=&quot;line-height:20.2px;letter-spacing:0.0px&quot;&gt;MoE Recall&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#9b2430;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="132.0" y="596.0" width="428.0" height="22.0" as="geometry"/></mxCell><mxCell id="c114" value="&lt;div style=&quot;line-height:15.5px;letter-spacing:0.0px&quot;&gt;Split one broad question across specialist recallers&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11.5;fontColor=#5b636e;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="132.0" y="618.0" width="424.0" height="18.0" as="geometry"/></mxCell><mxCell id="c115" value="" style="line;strokeColor=#fdeaec;strokeWidth=1.2;html=1;" vertex="1" parent="1"><mxGeometry x="96.0" y="642.0" width="464.0" height="8.0" as="geometry"/></mxCell><mxCell id="c116" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— Each recaller owns a narrow question&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="656.0" width="464.0" height="20.0" as="geometry"/></mxCell><mxCell id="c117" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— Fewer missed spans on rare defects&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="678.0" width="464.0" height="20.0" as="geometry"/></mxCell><mxCell id="c118" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— One clip now visits several recallers&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="700.0" width="464.0" height="20.0" as="geometry"/></mxCell><mxCell id="c119" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#fdeaec;strokeColor=none;strokeWidth=1.6;shadow=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="96.0" y="726.0" width="128.0" height="22.0" as="geometry"/></mxCell><mxCell id="c120" value="&lt;div style=&quot;line-height:14.2px;letter-spacing:0.0px&quot;&gt;Costs more rollouts&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#9b2430;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="726.0" width="128.0" height="22.0" as="geometry"/></mxCell><mxCell id="c121" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#1f9d63;strokeWidth=1.6;shadow=0;opacity=100;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="612.0" y="580.0" width="500.0" height="180.0" as="geometry"/></mxCell><mxCell id="c122" value="" styl