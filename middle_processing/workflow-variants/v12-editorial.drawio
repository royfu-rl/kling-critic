e=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="656.0" width="478.0" height="20.0" as="geometry"/></mxCell><mxCell id="c70" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— Fewer missed spans on rare defects&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="678.0" width="478.0" height="20.0" as="geometry"/></mxCell><mxCell id="c71" value="&lt;div style=&quot;line-height:14.9px;letter-spacing:0.0px&quot;&gt;— One clip now visits several recallers&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#14181d;align=left;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="700.0" width="478.0" height="20.0" as="geometry"/></mxCell><mxCell id="c72" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;fillColor=#fdeaec;strokeColor=none;strokeWidth=1.6;shadow=0;opacity=100;" vertex="1" parent="1"><mxGeometry x="96.0" y="726.0" width="128.0" height="22.0" as="geometry"/></mxCell><mxCell id="c73" value="&lt;div style=&quot;line-height:14.2px;letter-spacing:0.0px&quot;&gt;Costs more rollouts&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#9b2430;align=center;verticalAlign=middle;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="96.0" y="726.0" width="128.0" height="22.0" as="geometry"/></mxCell><mxCell id="c74" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#1f9d63;strokeWidth=1.6;shadow=0;opa