<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1700 780" width="100%" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,PingFang SC,Microsoft YaHei,sans-serif">
<rect width="1700" height="780" fill="#ffffff"/>
<defs>
<marker id="a-main" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 1L9 5L0 9z" fill="#2f6bff"/></marker>
<marker id="a-thin" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 1L9 5L0 9z" fill="#9aa2ad"/></marker>
</defs>
<rect x="40" y="60" width="1620" height="280" rx="12" fill="none" stroke="#e4e7ec"/>
<text x="56" y="82" font-size="12" font-weight="700" fill="#8a929e">主干：五个阶段，左到右</text>
<rect x="40" y="400" width="1620" height="300" rx="12" fill="none" stroke="#c7ccd4" stroke-dasharray="8 6"/>
<text x="56" y="422" font-size="12" font-weight="700" fill="#8a929e">备选增强：尚未确定是否采用</text>
<path d="M240 193.0 L297 193.0" fill="none" stroke="#9aa2ad" stroke-width="1.5" marker-end="url(#a-thin)"/>
<path d="M510 193.0 L567 193.0" fill="none" stroke="#2f6bff" stroke-width="1.8" marker-end="url(#a-main)"/>
<path d="M800 193.0 L857 193.0" fill="none" stroke="#2f6bff" stroke-width="1.8" marker-end="url(#a-main)"/>
<path d="M1060 193.0 L1117 193.0" fill="none" stroke="#2f6bff" stroke-width="1.8" marker-end="url(#a-main)"/>
<path d="M1320 193.0 L1377 193.0" fill="none" stroke="#2f6bff" stroke-width="1.8" marker-end="url(#a-main)"/>
<path d="M685.0 236 V447" fill="none" stroke="#2f6bff" stroke-width="1.4" stroke-dasharray="6 4" marker-end="url(#a-main)"/>
<path d="M1220.0 236 V447" fill="none" stroke="#2f6bff" stroke-width="1.4" stroke-dasharray="6 4" marker-end="url(#a-main)"/>
<path d="M1220.0 524 H1197.5 V568 H1175.0" fill="none" stroke="#c7ccd4" stroke-width="1.2" stroke-dasharray="6 4"/>
<path d="M1220 585.0 H1255.0 V552.0 H1290" fill="none" stroke="#c7ccd4" stroke-width="1.2" stroke-dasharray="6 4"/>
<path d="M1220 585.0 H1255.0 V600.0 H1290" fill="none" stroke="#c7ccd4" stroke-width="1.2" stroke-dasharray="6 4"/>
<path d="M1220 585.0 H1255.0 V648.0 H1290" fill="none" stroke="#c7ccd4" stroke-width="1.2" stroke-dasharray="6 4"/>
<rect x="70" y="150" width="170" height="86" rx="12" fill="#ffffff" stroke="#c7ccd4" stroke-width="1"/>
<text x="155.0" y="181.0" text-anchor="middle" font-size="13" font-weight="700" fill="#111418">Input</text>
<text x="155.0" y="198.0" text-anchor="middle" font-size="11.5" fill="#5b636e">生成视频 + Caption Prompt</text>
<text x="155.0" y="215.0" text-anchor="middle" font-size="11.5" fill="#5b636e">参考图 / 音轨</text>
<rect x="300" y="150" width="210" height="86" rx="12" fill="#eef3ff" stroke="#2f6bff" stroke-width="1.5"/>
<text x="405.0" y="181.0" text-anchor="middle" font-size="13" font-weight="700" fill="#111418">1 · Preprocess</text>
<text x="405.0" y="198.0" text-anchor="middle" font-size="11.5" fill="#5b636e">Prompt 结构化为可验证约束</text>
<text x="405.0" y="215.0" text-anchor="middle" font-size="11.5" fill="#5b636e">CV tool 预处理出结构化信息</text>
<rect x="570" y="150" width="230" height="86" rx="12" fill="#eef3ff" stroke="#2f6bff" stroke-width="1.5"/>
<text x="685.0" y="181.0" text-anchor="middle" font-size="13" font-weight="700" fill="#111418">2 · Recall</text>
<text x="685.0" y="198.0" text-anchor="middle" font-size="11.5" fill="#5b636e">VLM 结合结构化信息做时空定位</text>
<text x="685.0" y="215.0" text-anchor="middle" font-size="11.5" fill="#5b636e">召回疑似问题片段 + 推理解释</text>
<rect x="860" y="150" width="200" height="86" rx="12" fill="#eef3ff" stroke="#2f6bff" stroke-width="1.5"/>
<text x="960.0" y="181.0" text-anchor="middle" font-size="13" font-weight="700" fill="#111418">3 · Postprocess</text>
<text x="960.0" y="198.0" text-anchor="middle" font-size="11.5" fill="#5b636e">对召回证据做后处理</text>
<text x="960.0" y="215.0" text-anchor="middle" font-size="11.5" fill="#5b636e">CV tool 提取增强信息</text>
<rect x="1120" y="150" width="200" height="86" rx="12" fill="#eef3ff" stroke="#2f6bff" stroke-width="1.5"/>
<text x="1220.0" y="181.0" text-anchor="middle" font-size="13" font-weight="700" fill="#111418">4 · Verifier</text>
<text x="1220.0" y="198.0" text-anchor="middle" font-size="11.5" fill="#5b636e">逐条复核校验证据</text>
<text x="1220.0" y="215.0" text-anchor="middle" font-size="11.5" fill="#5b636e">采纳 / 驳回 + 严重度</text>
<rect x="1380" y="150" width="200" height="86" rx="12" fill="#111418" stroke="#111418" stroke-width="1"/>
<text x="1480.0" y="181.0" text-anchor="middle" font-size="13" font-weight="700" fill="#ffffff">5 · Aggregate</text>
<text x="1480.0" y="198.0" text-anchor="middle" font-size="11.5" fill="#c8ccd3">Rubric 聚合，给出结论</text>
<text x="1480.0" y="215.0" text-anchor="middle" font-size="11.5" fill="#c8ccd3">分数 / status / 证据图</text>
<rect x="570" y="450" width="230" height="74" rx="12" fill="#ffffff" stroke="#2f6bff" stroke-width="1" stroke-dasharray="8 5"/>
<text x="685.0" y="483.0" text-anchor="middle" font-size="13" font-weight="700" fill="#111418">MoE Recall</text>
<text x="685.0" y="500.0" text-anchor="middle" font-size="11.5" fill="#5b636e">把一个大问题拆给多个召回专家</text>
<rect x="1105" y="450" width="230" height="74" rx="12" fill="#ffffff" stroke="#2f6bff" stroke-width="1" stroke-dasharray="8 5"/>
<text x="1220.0" y="483.0" text-anchor="middle" font-size="13" font-weight="700" fill="#111418">MoE Verifier</text>
<text x="1220.0" y="500.0" text-anchor="middle" font-size="11.5" fill="#5b636e">按缺陷类型拆给多个复核专家</text>
<rect x="1130" y="568" width="90" height="34" rx="12" fill="#ffffff" stroke="#c7ccd4" stroke-width="1" stroke-dasharray="8 5"/>
<text x="1175.0" y="589.0" text-anchor="middle" font-size="12" font-weight="700" fill="#111418">崩坏</text>
<rect x="1290" y="536" width="104" height="32" rx="12" fill="#ffffff" stroke="#c7ccd4" stroke-width="1" stroke-dasharray="8 5"/>
<text x="1342.0" y="556.0" text-anchor="middle" font-size="12" font-weight="700" fill="#111418">人体崩坏</text>
<rect x="1290" y="584" width="104" height="32" rx="12" fill="#ffffff" stroke="#c7ccd4" stroke-width="1" stroke-dasharray="8 5"/>
<text x="1342.0" y="604.0" text-anchor="middle" font-size="12" font-weight="700" fill="#111418">生物崩坏</text>
<rect x="1290" y="632" width="104" height="32" rx="12" fill="#ffffff" stroke="#c7ccd4" stroke-width="1" stroke-dasharray="8 5"/>
<text x="1342.0" y="652.0" text-anchor="middle" font-size="12" font-weight="700" fill="#111418">非生物崩坏</text>
<rect x="820" y="474" width="132" height="26" rx="13" fill="#fff4ed" stroke="#e8a87c"/>
<text x="886.0" y="491.0" text-anchor="middle" font-size="11" fill="#9a5b2a">代价：成本上升</text>
<rect x="1355" y="474" width="170" height="26" rx="13" fill="#edf7f0" stroke="#7cc49a"/>
<text x="1440.0" y="491.0" text-anchor="middle" font-size="11" fill="#2b6b45">不增加成本，准召双升</text>
<text x="405" y="253" text-anchor="middle" font-size="11" fill="#8a929e">CV tools：抽帧 · OCR · 检测 · 光流 · 深度</text>
<text x="685" y="253" text-anchor="middle" font-size="11" fill="#8a929e">Perception · 召回优先</text>
<text x="960" y="253" text-anchor="middle" font-size="11" fill="#8a929e">CV tools：裁剪放大 · 分割 · 追踪</text>
<text x="1220" y="253" text-anchor="middle" font-size="11" fill="#8a929e">Human Alignment · 精度优先</text>
<text x="1175" y="625" text-anchor="middle" font-size="11" fill="#8a929e">按缺陷类型细分的一个例子</text>
<text x="1406" y="556" font-size="11" fill="#8a929e">躯干 · 手部</text>
<text x="1406" y="652" font-size="11" fill="#8a929e">刚性物体 · 柔性物体</text>
</svg>
