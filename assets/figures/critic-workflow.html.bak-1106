<!doctype html>
<html lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ABC-Critic Workflow</title>
<style>
  :root{--bg:#fff;--bg-soft:#f6f7f9;--ink:#111418;--ink-soft:#5b636e;--line:#e4e7ec;--brand:#2f6bff;--warn:#b45309}
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);
    font:13px/1.4 -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif}
  .wrap{display:flex;flex-direction:column;height:100%;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--bg)}
  body.full .wrap{border-radius:0;border:0}
  .bar{display:flex;align-items:center;gap:6px;padding:7px 10px;background:var(--bg-soft);border-bottom:1px solid var(--line);flex-wrap:wrap}
  .bar b{font-weight:700;margin-right:6px}
  .st{color:var(--ink-soft);margin-right:auto;min-width:0}
  .st.dirty{color:var(--warn)}
  button{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:4px 12px;cursor:pointer}
  button:hover{border-color:var(--brand);color:var(--brand)}
  button:disabled{opacity:.45;cursor:default;border-color:var(--line);color:var(--ink)}
  .stage{position:relative;flex:1;min-height:0}
  .stage iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .fallback{position:absolute;inset:0;display:none;overflow:auto;padding:12px;background:var(--bg)}
  .fallback p{margin:0 0 10px;color:var(--warn)}
  .fallback img{width:100%;height:auto;display:block}
  body.offline .fallback{display:block}
</style>
</head>
<body>
<div class="wrap">
  <div class="bar">
    <b>ABC-Critic Workflow</b>
    <span class="st" id="st">正在加载 draw.io 编辑器…</span>
    <button id="full">全屏编辑</button>
    <button id="dl" disabled>下载 .drawio</button>
    <button id="png" disabled>导出 PNG</button>
    <button id="svg" disabled>导出 SVG</button>
    <button id="reset" disabled>恢复原图</button>
  </div>
  <div class="stage">
    <iframe id="ed" title="draw.io 编辑器" allow="clipboard-read; clipboard-write"
      src="https://embed.diagrams.net/?embed=1&proto=json&spin=1&ui=min&lang=zh&saveAndExit=0&noExitBtn=1&libraries=1"></iframe>
    <div class="fallback">
      <p>draw.io 编辑器还没加载出来（需要浏览器能访问 embed.diagrams.net；网络慢时要一两分钟，好了会自动切换），下面是静态预览。</p>
      <img alt="ABC-Critic Workflow" src="data:image/jpeg;base64," >
    </div>
  </div>
</div>
<script>
(function () {
  var NAME = "critic-workflow";
  var ORIGINAL = "<mxfile host=\"app.diagrams.net\" type=\"device\">\n  <diagram name=\"ABC-Critic Workflow\" id=\"critic-workflow\">\n    <mxGraphModel dx=\"1640\" dy=\"900\" grid=\"0\" gridSize=\"10\" guides=\"1\" tooltips=\"1\" connect=\"1\" arrows=\"1\" fold=\"1\" page=\"1\" pageScale=\"1\" pageWidth=\"1700\" pageHeight=\"860\" math=\"0\" shadow=\"0\">\n      <root>\n        <mxCell id=\"0\" />\n        <mxCell id=\"1\" parent=\"0\" />\n        <mxCell id=\"lane0\" value=\"主干：五个阶段，左到右\" style=\"rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#e4e7ec;dashed=0;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=12;fontColor=#8a929e;fontStyle=1\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"40\" y=\"60\" width=\"1620\" height=\"280\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"lane1\" value=\"备选增强：尚未确定是否采用\" style=\"rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c7ccd4;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=12;fontColor=#8a929e;fontStyle=1\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"40\" y=\"400\" width=\"1620\" height=\"300\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"input\" value=\"&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;生成视频 + Caption Prompt&lt;br&gt;参考图 / 音轨&lt;/font&gt;\" style=\"rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7ccd4;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"70\" y=\"150\" width=\"170\" height=\"86\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"s1\" value=\"&lt;b&gt;1 · Preprocess&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;Prompt 结构化为可验证约束&lt;br&gt;CV tool 预处理出结构化信息&lt;/font&gt;\" style=\"rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#2f6bff;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"300\" y=\"150\" width=\"210\" height=\"86\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"s2\" value=\"&lt;b&gt;2 · Recall&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;VLM 结合结构化信息做时空定位&lt;br&gt;召回疑似问题片段 + 推理解释&lt;/font&gt;\" style=\"rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#2f6bff;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"570\" y=\"150\" width=\"230\" height=\"86\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"s3\" value=\"&lt;b&gt;3 · Postprocess&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;对召回证据做后处理&lt;br&gt;CV tool 提取增强信息&lt;/font&gt;\" style=\"rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#2f6bff;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"860\" y=\"150\" width=\"200\" height=\"86\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"s4\" value=\"&lt;b&gt;4 · Verifier&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;逐条复核校验证据&lt;br&gt;采纳 / 驳回 + 严重度&lt;/font&gt;\" style=\"rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#2f6bff;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"1120\" y=\"150\" width=\"200\" height=\"86\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"s5\" value=\"&lt;b&gt;5 · Aggregate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;Rubric 聚合，给出结论&lt;br&gt;分数 / status / 证据图&lt;/font&gt;\" style=\"rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#111418;strokeColor=#111418;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=6\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"1380\" y=\"150\" width=\"200\" height=\"86\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"moeR\" value=\"&lt;b&gt;MoE Recall&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;把一个大问题拆给多个召回专家&lt;/font&gt;\" style=\"rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6bff;dashed=1;dashPattern=8 5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"570\" y=\"450\" width=\"230\" height=\"74\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"moeV\" value=\"&lt;b&gt;MoE Verifier&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;按缺陷类型拆给多个复核专家&lt;/font&gt;\" style=\"rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6bff;dashed=1;dashPattern=8 5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"1105\" y=\"450\" width=\"230\" height=\"74\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"split\" value=\"&lt;b&gt;崩坏&lt;/b&gt;\" style=\"rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7ccd4;dashed=1;dashPattern=8 5;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"1130\" y=\"568\" width=\"90\" height=\"34\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"hum\" value=\"&lt;b&gt;人体崩坏&lt;/b&gt;\" style=\"rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7ccd4;dashed=1;dashPattern=8 5;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"1290\" y=\"536\" width=\"104\" height=\"32\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"bio\" value=\"&lt;b&gt;生物崩坏&lt;/b&gt;\" style=\"rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7ccd4;dashed=1;dashPattern=8 5;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"1290\" y=\"584\" width=\"104\" height=\"32\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"obj\" value=\"&lt;b&gt;非生物崩坏&lt;/b&gt;\" style=\"rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7ccd4;dashed=1;dashPattern=8 5;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"1290\" y=\"632\" width=\"104\" height=\"32\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"note820\" value=\"代价：成本上升\" style=\"rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff4ed;strokeColor=#e8a87c;fontSize=11;fontColor=#9a5b2a;align=center;verticalAlign=middle\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"820\" y=\"474\" width=\"132\" height=\"26\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"note1355\" value=\"不增加成本，准召双升\" style=\"rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#edf7f0;strokeColor=#7cc49a;fontSize=11;fontColor=#2b6b45;align=center;verticalAlign=middle\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"1355\" y=\"474\" width=\"170\" height=\"26\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"cap405_253\" value=\"CV tools：抽帧 · OCR · 检测 · 光流 · 深度\" style=\"text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#8a929e\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"285\" y=\"243\" width=\"240\" height=\"20\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"cap685_253\" value=\"Perception · 召回优先\" style=\"text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#8a929e\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"565\" y=\"243\" width=\"240\" height=\"20\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"cap960_253\" value=\"CV tools：裁剪放大 · 分割 · 追踪\" style=\"text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#8a929e\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"840\" y=\"243\" width=\"240\" height=\"20\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"cap1220_253\" value=\"Human Alignment · 精度优先\" style=\"text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#8a929e\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"1100\" y=\"243\" width=\"240\" height=\"20\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"cap1175_625\" value=\"按缺陷类型细分的一个例子\" style=\"text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#8a929e\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"1055\" y=\"615\" width=\"240\" height=\"20\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"cap1496_556\" value=\"躯干 · 手部\" style=\"text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#8a929e\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"1376\" y=\"546\" width=\"240\" height=\"20\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"cap1496_652\" value=\"刚性物体 · 柔性物体\" style=\"text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#8a929e\" vertex=\"1\" parent=\"1\">\n          <mxGeometry x=\"1376\" y=\"642\" width=\"240\" height=\"20\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"e0\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9aa2ad;strokeWidth=1.5;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5\" edge=\"1\" parent=\"1\" source=\"input\" target=\"s1\">\n          <mxGeometry relative=\"1\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"e1\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f6bff;strokeWidth=1.8;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5\" edge=\"1\" parent=\"1\" source=\"s1\" target=\"s2\">\n          <mxGeometry relative=\"1\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"e2\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f6bff;strokeWidth=1.8;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5\" edge=\"1\" parent=\"1\" source=\"s2\" target=\"s3\">\n          <mxGeometry relative=\"1\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"e3\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f6bff;strokeWidth=1.8;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5\" edge=\"1\" parent=\"1\" source=\"s3\" target=\"s4\">\n          <mxGeometry relative=\"1\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"e4\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f6bff;strokeWidth=1.8;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5\" edge=\"1\" parent=\"1\" source=\"s4\" target=\"s5\">\n          <mxGeometry relative=\"1\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"e5\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f6bff;strokeWidth=1.4;dashed=1;dashPattern=6 4;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0\" edge=\"1\" parent=\"1\" source=\"s2\" target=\"moeR\">\n          <mxGeometry relative=\"1\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"e6\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f6bff;strokeWidth=1.4;dashed=1;dashPattern=6 4;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0\" edge=\"1\" parent=\"1\" source=\"s4\" target=\"moeV\">\n          <mxGeometry relative=\"1\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"e7\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c7ccd4;strokeWidth=1.2;dashed=1;dashPattern=6 4;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0\" edge=\"1\" parent=\"1\" source=\"moeV\" target=\"split\">\n          <mxGeometry relative=\"1\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"e8\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c7ccd4;strokeWidth=1.2;dashed=1;dashPattern=6 4;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5\" edge=\"1\" parent=\"1\" source=\"split\" target=\"hum\">\n          <mxGeometry relative=\"1\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"e9\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c7ccd4;strokeWidth=1.2;dashed=1;dashPattern=6 4;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5\" edge=\"1\" parent=\"1\" source=\"split\" target=\"bio\">\n          <mxGeometry relative=\"1\" as=\"geometry\" />\n        <\/mxCell>\n        <mxCell id=\"e10\" style=\"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c7ccd4;strokeWidth=1.2;dashed=1;dashPattern=6 4;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5\" edge=\"1\" parent=\"1\" source=\"split\" target=\"obj\">\n          <mxGeometry relative=\"1\" as=\"geometry\" />\n        <\/mxCell>\n      <\/root>\n    <\/mxGraphModel>\n  <\/diagram>\n<\/mxfile>\n";
  var KEY = 'vc-blog:drawio:' + NAME + ':' + "23a17fd9ac";
  var ed = document.getElementById('ed');
  var st = document.getElementById('st');
  var btn = function (id) { return document.getElementById(id); };
  var embedded = window.parent !== window;
  var xml = ORIGINAL, ready = false, full = false;

  // ?editor=<url> 换一个 draw.io 实例（自建镜像，或本地协议桩做自测）；默认用官方 embed
  var override = (location.search.match(/[?&]editor=([^&]+)/) || [])[1];
  if (override) ed.src = decodeURIComponent(override);

  function store(get, val) {           // localStorage 在 file:// 或隐私模式下可能抛错，失败就当没有草稿
    try { return get ? localStorage.getItem(KEY) : (val == null ? localStorage.removeItem(KEY) : localStorage.setItem(KEY, val)); }
    catch (e) { return null; }
  }
  function status(text, dirty) { st.textContent = text; st.className = 'st' + (dirty ? ' dirty' : ''); }
  function post(msg) { ed.contentWindow.postMessage(JSON.stringify(msg), '*'); }
  function save(name, href) {
    var a = document.createElement('a'); a.href = href; a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
  }
  function saveXml() {
    var url = URL.createObjectURL(new Blob([xml], { type: 'application/xml' }));
    save(NAME + '.drawio', url); setTimeout(function () { URL.revokeObjectURL(url); }, 2000);
  }
  function load(src) { post({ action: 'load', xml: src, autosave: 1, fit: 1, border: 16, maxFitScale: 1 }); }

  window.addEventListener('message', function (e) {
    // 博客父页的 kc-expand 协议：父页放大 / 还原好 iframe 后回 ack，我们确认
    if (e.source === window.parent && e.data && typeof e.data === 'object') {
      if (e.data.type === 'kc-expand-ack') { window.parent.postMessage({ type: 'kc-modal-ready' }, '*'); }
      if (e.data.type === 'kc-collapse-ack') { window.parent.postMessage({ type: 'kc-revealed' }, '*'); }
      return;
    }
    if (e.source !== ed.contentWindow || typeof e.data !== 'string') return;
    var m; try { m = JSON.parse(e.data); } catch (_) { return; }
    if (m.event === 'init') {
      ready = true; document.body.classList.remove('offline');
      ['dl', 'png', 'svg', 'reset'].forEach(function (id) { btn(id).disabled = false; });
      var draft = store(true);
      if (draft && draft !== ORIGINAL) { xml = draft; status('已恢复本浏览器里上次的修改（还没下载）', true); }
      else status('可直接编辑；改动自动存在本浏览器，要留档请点「下载 .drawio」', false);
      load(xml);
    } else if (m.event === 'autosave') {
      xml = m.xml; store(false, xml); status('有修改，已暂存在本浏览器；要留档请点「下载 .drawio」', true);
    } else if (m.event === 'save') {
      xml = m.xml; store(false, xml); saveXml();
      post({ action: 'status', message: '已下载到本地', modified: false });
      status('已下载 ' + NAME + '.drawio', false);
    } else if (m.event === 'export' && m.data) {
      save(NAME + (m.format.indexOf('svg') >= 0 ? '.svg' : '.png'), m.data);
    }
  });

  btn('dl').onclick = saveXml;
  btn('png').onclick = function () { post({ action: 'export', format: 'xmlpng', spinKey: 'export', scale: 2, border: 12 }); };
  btn('svg').onclick = function () { post({ action: 'export', format: 'xmlsvg', spinKey: 'export', border: 12 }); };
  btn('reset').onclick = function () {
    if (!confirm('丢掉本浏览器里的修改，恢复原图？')) return;
    store(false, null); xml = ORIGINAL; load(xml); status('已恢复原图', false);
  };
  btn('full').onclick = function () {
    full = !full;
    document.body.classList.toggle('full', full);
    btn('full').textContent = full ? '退出全屏' : '全屏编辑';
    if (embedded) window.parent.postMessage({ type: full ? 'kc-expand' : 'kc-collapse' }, '*');
    else if (full) document.documentElement.requestFullscreen && document.documentElement.requestFullscreen();
    else document.fullscreenElement && document.exitFullscreen();
  };
  setTimeout(function () {           // 网络慢时编辑器要一两分钟；先给静态预览，init 到了会自动切回编辑器
    if (!ready) { document.body.classList.add('offline'); status('编辑器还在加载，先显示静态预览；加载好会自动切换', true); }
  }, 45000);
})();
</script>
</body>
</html>

