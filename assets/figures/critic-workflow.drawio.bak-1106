        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1 · Preprocess&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;Prompt 结构化为可验证约束&lt;br&gt;CV tool 预处理出结构化信息&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#2f6bff;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 · Recall&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;VLM 结合结构化信息做时空定位&lt;br&gt;召回疑似问题片段 + 推理解释&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#2f6bff;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418" vertex="1" parent="1">
          <mxGeometry x="570" y="150" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 · Postprocess&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;对召回证据做后处理&lt;br&gt;CV tool 提取增强信息&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#2f6bff;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418" vertex="1" parent="1">
          <mxGeometry x="860" y="150" width="200" height="86" as="geometry" />
