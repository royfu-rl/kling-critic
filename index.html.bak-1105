e=\\&quot;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c7ccd4;strokeWidth=1.2;dashed=1;dashPattern=6 4;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0\\&quot; edge=\\&quot;1\\&quot; parent=\\&quot;1\\&quot; source=\\&quot;moeV\\&quot; target=\\&quot;split\\&quot;&gt;\\n          &lt;mxGeometry relative=\\&quot;1\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;e8\\&quot; style=\\&quot;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c7ccd4;strokeWidth=1.2;dashed=1;dashPattern=6 4;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5\\&quot; edge=\\&quot;1\\&quot; parent=\\&quot;1\\&quot; source=\\&quot;split\\&quot; target=\\&quot;hum\\&quot;&gt;\\n          &lt;mxGeometry relative=\\&quot;1\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;e9\\&quot; style=\\&quot;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c7ccd4;strokeWidth=1.2;dashed=1;dashPattern=6 4;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5\\&quot; edge=\\&quot;1\\&quot; parent=\\&quot;1\\&quot; source=\\&quot;split\\&quot; target=\\&quot;bio\\&quot;&gt;\\n          &lt;mxGeometry relative=\\&quot;1\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;e10\\&quot; style=\\&quot;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c7ccd4;strokeWidth=1.2;dashed=1;dashPattern=6 4;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5\\&quot; edge=\\&quot;1\\&quot; parent=\\&quot;1\\&quot; source=\\&quot;split\\&quot; target=\\&quot;obj\\&quot;&gt;\\n          &lt;mxGeometry relative=\\&quot;1\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n      &lt;\\/root&gt;\\n    &lt;\\/mxGraphModel&gt;\\n  &lt;\\/diagram&gt;\\n&lt;\\/mxfile&gt;\\n&quot;;&#10;  var KEY = 'vc-blog:drawio:' + NAME + ':' + &quot;23a17fd9ac&quot;;&#10;  var ed = document.getElementById('ed');&#10;  var st = document.getElementById('st');&#10;  var btn = function (id) { return document.getElementById(id); };&#10;  var embedded = window.parent !== window;&#10;  var xml = ORIGINAL, ready = false, full = false;&#10;&#10;  // ?editor=&lt;url&gt; 换一个 draw.io 实例（自建镜像，或本地协议桩做自测）；默认用官方 embed&#10;  var override = (location.search.match(/[?&amp;]editor=([^&amp;]+)/) || [])[1];&#10;  if (override) ed.src = decodeURIComponent(override);&#10;&#10;  function store(get, val) {           // localStorage 在 file:// 或隐私模式下可能抛错，失败就当没有草稿&#10;    try { return get ? localStorage.getItem(KEY) : (val == null ? localStorage.removeItem(KEY) : localStorage.setItem(KEY, val)); }&#10;    catch (e) { return null; }&#10;  }&#10;  function status(text, dirty) { st.textContent = text; st.className = 'st' + (dirty ? ' dirty' : ''); }&#10;  function post(msg) { ed.contentWindow.postMessage(JSON.stringify(msg), '*'); }&#10;  function save(name, href) {&#10;    var a = document.createElement('a'); a.href = href; a.download = name;&#10;    document.body.appendChild(a); a.click(); a.remove();&#10;  }&#10;  function saveXml() {&#10;    var url = URL.createObjectURL(new Blob([xml], { type: 'application/xml' }));&#10;    save(NAME + '.drawio', url); setTimeout(function () { URL.revokeObjectURL(url); }, 2000);&#10;  }&#10;  function load(src) { post({ action: 'load', xml: src, autosave: 1, fit: 1, border: 16, maxFitScale: 1 }); }&#10;&#10;  window.addEventListener('message', function (e) {&#10;    // 博客父页的 kc-expand 协议：父页放大 / 还原好 iframe 后回 ack，我们确认&#10;    if (e.source === window.parent &amp;&amp; e.data &amp;&amp; typeof e.data === 'object') {&#10;      if (e.data.type === 'kc-expand-ack') { window.parent.postMessage({ type: 'kc-modal-ready' }, '*'); }&#10;      if (e.data.type === 'kc-collapse-ack') { window.parent.postMessage({ type: 'kc-revealed' }, '*'); }&#10;      return;&#10;    }&#10;    if (e.source !== ed.contentWindow || typeof e.data !== 'string') return;&#10;    var m; try { m = JSON.parse(e.data); } catch (_) { return; }&#10;    if (m.event === 'init') {&#10;      ready = true; document.body.classList.remove('offline');&#10;      ['dl', 'png', 'svg', 'reset'].forEach(function (id) { btn(id).disabled = false; });&#10;      var draft = store(true);&#10;      if (draft &amp;&amp; draft !== ORIGINAL) { xml = draft; status('已恢复本浏览器里上次的修改（还没下载）', true); }&#10;      else status('可直接编辑；改动自动存在本浏览器，要留档请点「下载 .drawio」', false);&#10;      load(xml);&#10;    } else if (m.event === 'autosave') {&#10;      xml = m.xml; store(false, xml); status('有修改，已暂存在本浏览器；要留档请点「下载 .drawio」', true);&#10;    } else if (m.event === 'save') {&#10;      xml = m.xml; store(false, xml); saveXml();&#10;      post({ action: 'status', message: '已下载到本地', modified: false });&#10;      status('已下载 ' + NAME + '.drawio', false);&#10;    } else if (m.event === 'export' &amp;&amp; m.data) {&#10;      save(NAME + (m.format.indexOf('svg') &gt;= 0 ? '.svg' : '.png'), m.data);&#10;    }&#10;  });&#10;&#10;  btn('dl').onclick = saveXml;&#10;  btn('png').onclick = function () { post({ action: 'export', format: 'xmlpng', spinKey: 'export', scale: 2, border: 12 }); };&#10;  btn('svg').onclick = function () { post({ action: 'export', format: 'xmlsvg', spinKey: 'export', border: 12 }); };&#10;  btn('reset').onclick = function () {&#10;    if (!confirm('丢掉本浏览器里的修改，恢复原图？')) return;&#10;    store(false, null); xml = ORIGINAL; load(xml); status('已恢复原图', false);&#10;  };&#10;  btn('full').onclick = function () {&#10;    full = !full;&#10;    document.body.classList.toggle('full', full);&#10;    btn('full').textContent = full ? '退出全屏' : '全屏编辑';&#10;    if (embedded) window.parent.postMessage({ type: full ? 'kc-expand' : 'kc-collapse' }, '*');&#10;    else if (full) document.documentElement.requestFullscreen &amp;&amp; document.documentElement.requestFullscreen();&#10;    else document.fullscreenElement &amp;&amp; document.exitFullscreen();&#10;  };&#10;  setTimeout(function () {           // 网络慢时编辑器要一两分钟；先给静态预览，init 到了会自动切回编辑器&#10;    if (!ready) { document.body.classList.add('offline'); status('编辑器还在加载，先显示静态预览；加载好会自动切换', true); }&#10;  }, 45000);&#10;})();&#10;&lt;/script&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;&#10;\"></iframe>\n</div>\n\nPipline：\n- Video Preprocess\n  - 视频文件检查：读取视频文件，产出 metadata 与完整性判断\n  - 运动感知抽帧：基于视频与 metadata，抽出关键帧、运动窗口与 contact sheet\n  - 拆解提示约束：VLM 读取提示词文本与参考图，产出可验证的约束清单\n- Evidence Recaller(Perception)：\n  - VLM Agent 处理含音轨的整段视频与参考图，产出 observations、issues 与需要重点复核的时间区间\n- Evidence Preprocess\n- Evidence Verifier(Human Alignment)\n  - 逐条核对：VLM 拿约束清单、observations 与 zoom 结论逐条比对，产出 evaluations、scores、rubric 判定与 status\n- Summary：Rubric 聚合 verifier 输出与专项扫描，产出最终分数、status、hard failures，并生成带红框的证据图\n\n### Harness\n\nHarness 是视频质检的脚手架，包含 Tools、Rubric、Trajectory 三类环境资产。\n\n#### Tools\n\n| 工具 | 谁在用 | 负责什么判定 | 为什么不交给 VLM |\n| :--- | :--- | :--- | :--- |\n| **垂域小模型** | ABC-Critic（自研） | 专门用于质检部分通用模型较难识别的顽固垂类标签 | 通用模型在这些垂类上较难识别 |\n| **Grounding DINO**（开放词表检测器） | VideoScience-Judge | 按开放词表验证实体是否存在、属性对不对 | 给的是带坐标的确定答案；VLM 生成坐标不可靠 |\n| **ByteTrack**（多目标追踪） | VideoScience-Judge | 身份关联，量化时空一致性 | 跨帧关联同一实例，VLM 的稀疏帧输入做不到 |\n| **追踪**（未指明具体实现） | VideoArgus | 主体身份、源保留 | 同上 |\n| **RAFT / SEA-RAFT**（光流） | VideoScience-Judge、VideoGen-Eval | 运动方向与幅度；动态程度 | 纯运动统计量，VLM 只能给主观印象 |\n| **CLIP4Clip / CLIP** | VideoScience-Judge、VideoGen-Eval | 文视对齐 | 便宜的稠密相似度 |\n| **DINO 特征** | VideoGen-Eval | 时序一致性 | 特征空间距离 |\n| **LPIPS**（感知相似度） | VideoScience-Judge（有参考视频时） | 与参考的感知差异 | 有参考时比语义判断更准 |\n| **OCR** | VideoArgus、TRACE | 可见文字是否正确 | 给出逐字符读数与位置，可与参考文案逐字比对 |\n| **深度估计** | VideoArgus、VideoGen-Eval | 空间结构合理性 | 几何量，VLM 无法量化 |\n| **感知质量评估（IQA）** | VideoArgus | 画面质量 | 专用模型小三个数量级、相关性不输 |\n| **SAM / SAM2**（分割） | VideoGen-Eval、DirectorBench | 区域切分 | 给出精确边界 |\n| **目标检测**（未指明） | TRACE | 建立可检索的实体时间线 | 同 Grounding DINO |\n| **裁剪 / 放大 / 轮廓叠加** | PriVE-Tools、Skyra（自驱动 probe） | 小区域细看 | 把小目标放大到 VLM 能看清的尺度 |\n| **动态帧采样** | AIGVE-MACS | 按内容变化选关键帧 | 降低帧预算，把算力花在有信息的帧上 |\n\n#### Rubric\n- 蒸馏业务评测的培训文档 -> 沉淀 rubric -> 在金标评测集上超过人评的准召\n\n  在 Harness 中提供可检索的高质量质检案例，其中蒸馏了评测团队的高质量偏好，可从已标注的训练数据 / 评测数据中精筛少量得到。\n\n  - Memory 是 Harness 的核心迭代组件：In-Context Learning 本质上是对 VLM 的输出分布作微调，使其收敛到满足业务偏好的分布。ICL 的作用是挖掘业务理解，持续注入 Few-Shot。\n\n#### Trajectory\n上线 Agentic Critic 评测系统后，人机协同评测，评测人员对机评的结果进行校验修正甚至推翻。从而挖掘难负样本 / 沉淀高质量轨迹。\n\n回流的高质量轨迹为 Critic Agent 在 Harness 中进行 planning 的多轮交互数据，包含了 vlm 视频理解召回证据（recaller），vlm 复核证据对齐评测皮偏好，vlm 调用工具对视频进行预处理 / 对证据进行后处理等数据。因此这部分数据分别可以进行用于训练基础感知，偏好对齐，工具调用，多轮决策规划。这部分数据的核心价值：\n\n1. 基础感知能力增强所需要的数据量级较大，这部分数据的价值更多在于 auto planning 能力的后训练。\n2. 偏好对齐数据可用于训练进行证据复核的 verifier model，也可以构造 pairwise trajectory，对正负轨迹进行对比蒸馏，优化 Harness 中的 Rubric / Skill 文档。\n\n\n> ICL 是一种特殊的 SFT，依据 [*Exploring the Relationship between In-Context Learning and Instruction Tuning*](https://arxiv.org/abs/2311.10367)：\n>\n> - ICL 与 SFT 的 hidden states 相似度很高。\n> - ICL 与 Anchor、SFT 与 Anchor 的 hidden states 相似度都很低。\n\n\n### Insights\n\n- **Auto-Planning Agent**：调用工具的 VLM xxx。选型，尺寸。\n- **Perception VLM**：证据召回的 VLM xxx\n- **Verifier VLM**：对齐评测偏好的 VLM xxx\n"}, {"id": "training", "label": "Training", "tab": true, "parent": null, "md": "## Contents\n\n- [Perception](#perception)\n- [Temporal Spatial Grouding](#temporal-spatial-grouding)\n- [Human Alignment](#human-alignment)\n\n涉及模型训练的部分，包括 VLM 基础感知能力的增强（通用世界知识到视频帧中像素 pixel 的对齐），增强视频理解的时空定位能力，对齐评测人员的偏好。\n\n### Perception\n\n### Temporal Spatial Grouding\n\n时空定位走 RLVR，奖励函数的形状由任务的对应结构决定：预测区间与真值实例之间的对应 σ 是被给定还是要被求解、基数是否已知，把任务分成四格。判错格，模型总能找到一条绕过去的路，而训练曲线看起来完全正常。完整推导、奖励公式与实测数据在 [RL for Spatio-Temporal Video Grounding](surveys/survey.html)，下面是预览：\n\n<div align=\"center\">\n  <iframe\n          data-src=\"surveys/survey.html\"\n          data-name=\"RL for Spatio-Temporal Video Grounding\"\n          data-path=\"surveys/survey.html\"\n          style=\"width:100%;height:620px;border:1px solid #e4e7ec;border-radius:12px;\" title=\"RL for Spatio-Temporal Video Grounding · 预览\" srcdoc=\"&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;zh&quot;&gt;&#10;&lt;head&gt;&#10;&lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#10;&lt;title&gt;文档预览&lt;/title&gt;&#10;&lt;style&gt;&#10;  :root{&#10;    --bg:#ffffff; --bg-soft:#f6f7f9; --ink:#111418; --ink-soft:#5b636e; --ink-faint:#8b929c;&#10;    --line:#e4e7ec; --brand:#2f6bff; --brand-soft:#eaf0ff;&#10;    --sans:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,&quot;PingFang SC&quot;,&quot;Hiragino Sans GB&quot;,&quot;Microsoft YaHei&quot;,sans-serif;&#10;    --mono:&quot;SF Mono&quot;,ui-monospace,Menlo,Consolas,monospace;&#10;  }&#10;  *{box-sizing:border-box}&#10;  html,body{margin:0;height:100%}&#10;  body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:14px;&#10;       -webkit-font-smoothing:antialiased;display:flex;flex-direction:column}&#10;&#10;  /* ── toolbar ── */&#10;  .bar{flex:none;display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid var(--line);&#10;       background:var(--bg-soft)}&#10;  .file{display:flex;align-items:center;gap:8px;min-width:0}&#10;  .ico{width:22px;height:22px;border-radius:5px;background:var(--brand);color:#fff;font-size:10px;font-weight:800;&#10;       display:flex;align-items:center;justify-content:center;flex:none}&#10;  .name{font-size:13px;font-weight:700;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}&#10;  .path{font-family:var(--mono);font-size:10.5px;color:var(--ink-faint);white-space:nowrap}&#10;  .spacer{flex:1 1 auto}&#10;  .zoom{display:flex;align-items:center;gap:4px;flex:none}&#10;  .zoom button{appearance:none;width:26px;height:26px;border:1px solid var(--line);background:#fff;border-radius:7px;&#10;        font-family:inherit;font-size:14px;font-weight:700;color:var(--ink-soft);cursor:pointer;padding:0;&#10;        display:flex;align-items:center;justify-content:center;transition:.12s}&#10;  .zoom button:hover{border-color:var(--brand);color:var(--brand)}&#10;  .zval{font-family:var(--mono);font-size:11px;color:var(--ink-soft);min-width:42px;text-align:center}&#10;  .open{font-size:12px;font-weight:700;color:#fff;background:var(--brand);text-decoration:none;&#10;        padding:6px 13px;border-radius:8px;white-space:nowrap;flex:none;transition:.14s}&#10;  .open:hover{background:#1f57d8}&#10;&#10;  /* ── page viewport ──────────────────────────────────────────────────────&#10;     预览 = 真实页面装在一个「桌面视口」大小的 iframe 里，再整体缩小，跟&#10;     PDF/PPT 预览窗一个意思。&#10;     iframe 高度必须是一个真实视口高度（900px），不能按文档总高去撑：survey 那边&#10;     有 min-height:100vh 的区块，iframe 高 16000px 时这些区块就跟着变成 16000px，&#10;     第一屏把正文全顶到看不见的地方，预览里只剩一根侧栏目录。 */&#10;  .view{flex:1 1 auto;min-height:0;overflow:auto;background:#eceef1;padding:14px;position:relative}&#10;  /* transform:scale 不改变布局占位，所以缩放要分两层：外层 .wrap 拿缩放后的&#10;     实际尺寸（决定居中与滚动条），内层 .sheet 保持 1240px 原始宽度再整体缩小。&#10;     只用一层的话，元素照 1240px 占位，容器窄于它就会往右溢出被裁掉。 */&#10;  .wrap{margin:0 auto;overflow:hidden;background:#fff;box-shadow:0 2px 14px rgba(17,20,24,.13);border-radius:3px}&#10;  .sheet{transform-origin:top left;position:relative}&#10;  .sheet iframe{display:block;width:100%;border:0;background:#fff}&#10;  .loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;&#10;           color:var(--ink-faint);font-size:12.5px;background:#eceef1;z-index:4}&#10;  @media (max-width:640px){ .path{display:none} }&#10;&lt;/style&gt;&#10;&lt;/head&gt;&#10;&lt;body&gt;&#10;  &lt;div class=&quot;bar&quot;&gt;&#10;    &lt;div class=&quot;file&quot;&gt;&#10;      &lt;span class=&quot;ico&quot;&gt;HTML&lt;/span&gt;&#10;      &lt;span class=&quot;name&quot; id=&quot;fname&quot;&gt;…&lt;/span&gt;&#10;    &lt;/div&gt;&#10;    &lt;span class=&quot;path&quot; id=&quot;fpath&quot;&gt;&lt;/span&gt;&#10;    &lt;span class=&quot;spacer&quot;&gt;&lt;/span&gt;&#10;    &lt;div class=&quot;zoom&quot;&gt;&#10;      &lt;button id=&quot;zo&quot; title=&quot;缩小&quot;&gt;−&lt;/button&gt;&#10;      &lt;span class=&quot;zval&quot; id=&quot;zv&quot;&gt;45%&lt;/span&gt;&#10;      &lt;button id=&quot;zi&quot; title=&quot;放大&quot;&gt;＋&lt;/button&gt;&#10;    &lt;/div&gt;&#10;    &lt;a class=&quot;open&quot; id=&quot;open&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;打开完整页面 ↗&lt;/a&gt;&#10;  &lt;/div&gt;&#10;&#10;  &lt;div class=&quot;view&quot; id=&quot;view&quot;&gt;&#10;    &lt;div class=&quot;wrap&quot; id=&quot;wrap&quot;&gt;&#10;      &lt;div class=&quot;sheet&quot; id=&quot;sheet&quot;&gt;&#10;        &lt;iframe id=&quot;frame&quot; title=&quot;预览&quot; scrolling=&quot;yes&quot;&gt;&lt;/iframe&gt;&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;&#10;    &lt;div class=&quot;loading&quot; id=&quot;loading&quot;&gt;正在载入预览…&lt;/div&gt;&#10;  &lt;/div&gt;&#10;&#10;&lt;script&gt;&#10;// 目标页面与显示名可以外部传入，同一个壳复用给多个文档。&#10;// 取值顺序：宿主 &lt;iframe&gt; 上的 data-* → URL query → 缺省。&#10;// data-* 这条是主路径：build.py 会把本文件整个内联成 srcdoc，srcdoc 没有&#10;// query string，但 srcdoc 与父页同源，所以能从 window.frameElement 读属性。&#10;const host = (()=&gt;{ try { return window.frameElement || null; } catch(e) { return null; } })();&#10;const ds   = (host &amp;&amp; host.dataset) || {};&#10;const q    = new URLSearchParams(location.search);&#10;const SRC  = ds.src  || q.get('src')  || 'surveys/survey.html';&#10;const NAME = ds.name || q.get('name') || 'RL for Spatio-Temporal Video Grounding';&#10;const PATH = ds.path || q.get('path') || SRC;&#10;&#10;// 按桌面视口渲染再整体缩小 —— 否则窄容器里页面会走响应式布局，&#10;// 预览出来的不是真实版式。高度取真实视口高度，见上面样式里的说明。&#10;const PAGE_W = 1240, PAGE_H = 900;&#10;const STEPS = [0.35,0.45,0.6,0.75,0.9,1];&#10;let si = 2;&#10;&#10;const view=document.getElementById('view'), sheet=document.getElementById('sheet'),&#10;      wrap=document.getElementById('wrap'), frame=document.getElementById('frame'),&#10;      loading=document.getElementById('loading');&#10;&#10;document.getElementById('fname').textContent = NAME;&#10;document.getElementById('fpath').textContent = PATH;&#10;document.getElementById('open').href = SRC;&#10;&#10;sheet.style.width = PAGE_W + 'px';&#10;frame.style.height = PAGE_H + 'px';&#10;frame.src = SRC;&#10;&#10;function applyZoom(){&#10;  const k = STEPS[si];&#10;  document.getElementById('zv').textContent = Math.round(k*100) + '%';&#10;  sheet.style.transform = 'scale(' + k + ')';&#10;  wrap.style.width  = (PAGE_W * k) + 'px';&#10;  wrap.style.height = (PAGE_H * k) + 'px';&#10;}&#10;document.getElementById('zi').onclick = ()=&gt;{ if(si&lt;STEPS.length-1){si++;applyZoom();} };&#10;document.getElementById('zo').onclick = ()=&gt;{ if(si&gt;0){si--;applyZoom();} };&#10;&#10;frame.addEventListener('load', ()=&gt;{ loading.style.display='none'; });&#10;// 页签从 display:none 变可见时重摆一次（隐藏时容器宽度是 0，居中算不准）&#10;if (window.ResizeObserver) new ResizeObserver(applyZoom).observe(view);&#10;window.addEventListener('resize', applyZoom);&#10;applyZoom();&#10;&lt;/script&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;&#10;\"></iframe>\n</div>\n\n### Human Alignment\n\n<div align=\"center\">\n  <iframe\n          data-src=\"https://my.feishu.cn/docx/NL19dLyjXochYYxAdkUch4GBngf\"\n          data-name=\"[Post-Train] On-Policy vs Off-Policy\"\n          data-path=\"my.feishu.cn/docx/NL19dLyj…\"\n          style=\"width:100%;height:620px;border:1px solid #e4e7ec;border-radius:12px;\" title=\"On-Policy vs Off-Policy · 预览\" srcdoc=\"&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;zh&quot;&gt;&#10;&lt;head&gt;&#10;&lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#10;&lt;title&gt;文档预览&lt;/title&gt;&#10;&lt;style&gt;&#10;  :root{&#10;    --bg:#ffffff; --bg-soft:#f6f7f9; --ink:#111418; --ink-soft:#5b636e; --ink-faint:#8b929c;&#10;    --line:#e4e7ec; --brand:#2f6bff; --brand-soft:#eaf0ff;&#10;    --sans:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,&quot;PingFang SC&quot;,&quot;Hiragino Sans GB&quot;,&quot;Microsoft YaHei&quot;,sans-serif;&#10;    --mono:&quot;SF Mono&quot;,ui-monospace,Menlo,Consolas,monospace;&#10;  }&#10;  *{box-sizing:border-box}&#10;  html,body{margin:0;height:100%}&#10;  body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:14px;&#10;       -webkit-font-smoothing:antialiased;display:flex;flex-direction:column}&#10;&#10;  /* ── toolbar ── */&#10;  .bar{flex:none;display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid var(--line);&#10;       background:var(--bg-soft)}&#10;  .file{display:flex;align-items:center;gap:8px;min-width:0}&#10;  .ico{width:22px;height:22px;border-radius:5px;background:var(--brand);color:#fff;font-size:10px;font-weight:800;&#10;       display:flex;align-items:center;justify-content:center;flex:none}&#10;  .name{font-size:13px;font-weight:700;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}&#10;  .path{font-family:var(--mono);font-size:10.5px;color:var(--ink-faint);white-space:nowrap}&#10;  .spacer{flex:1 1 auto}&#10;  .zoom{display:flex;align-items:center;gap:4px;flex:none}&#10;  .zoom button{appearance:none;width:26px;height:26px;border:1px solid var(--line);background:#fff;border-radius:7px;&#10;        font-family:inherit;font-size:14px;font-weight:700;color:var(--ink-soft);cursor:pointer;padding:0;&#10;        display:flex;align-items:center;justify-content:center;transition:.12s}&#10;  .zoom button:hover{border-color:var(--brand);color:var(--brand)}&#10;  .zval{font-family:var(--mono);font-size:11px;color:var(--ink-soft);min-width:42px;text-align:center}&#10;  .open{font-size:12px;font-weight:700;color:#fff;background:var(--brand);text-decoration:none;&#10;        padding:6px 13px;border-radius:8px;white-space:nowrap;flex:none;transition:.14s}&#10;  .open:hover{background:#1f57d8}&#10;&#10;  /* ── page viewport ──────────────────────────────────────────────────────&#10;     预览 = 真实页面装在一个「桌面视口」大小的 iframe 里，再整体缩小，跟&#10;     PDF/PPT 预览窗一个意思。&#10;     iframe 高度必须是一个真实视口高度（900px），不能按文档总高去撑：survey 那边&#10;     有 min-height:100vh 的区块，iframe 高 16000px 时这些区块就跟着变成 16000px，&#10;     第一屏把正文全顶到看不见的地方，预览里只剩一根侧栏目录。 */&#10;  .view{flex:1 1 auto;min-height:0;overflow:auto;background:#eceef1;padding:14px;position:relative}&#10;  /* transform:scale 不改变布局占位，所以缩放要分两层：外层 .wrap 拿缩放后的&#10;     实际尺寸（决定居中与滚动条），内层 .sheet 保持 1240px 原始宽度再整体缩小。&#10;     只用一层的话，元素照 1240px 占位，容器窄于它就会往右溢出被裁掉。 */&#10;  .wrap{margin:0 auto;overflow:hidden;background:#fff;box-shadow:0 2px 14px rgba(17,20,24,.13);border-radius:3px}&#10;  .sheet{transform-origin:top left;position:relative}&#10;  .sheet iframe{display:block;width:100%;border:0;background:#fff}&#10;  .loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;&#10;           color:var(--ink-faint);font-size:12.5px;background:#eceef1;z-index:4}&#10;  @media (max-width:640px){ .path{display:none} }&#10;&lt;/style&gt;&#10;&lt;/head&gt;&#10;&lt;body&gt;&#10;  &lt;div class=&quot;bar&quot;&gt;&#10;    &lt;div class=&quot;file&quot;&gt;&#10;      &lt;span class=&quot;ico&quot;&gt;HTML&lt;/span&gt;&#10;      &lt;span class=&quot;name&quot; id=&quot;fname&quot;&gt;…&lt;/span&gt;&#10;    &lt;/div&gt;&#10;    &lt;span class=&quot;path&quot; id=&quot;fpath&quot;&gt;&lt;/span&gt;&#10;    &lt;span class=&quot;spacer&quot;&gt;&lt;/span&gt;&#10;    &lt;div class=&quot;zoom&quot;&gt;&#10;      &lt;button id=&quot;zo&quot; title=&quot;缩小&quot;&gt;−&lt;/button&gt;&#10;      &lt;span class=&quot;zval&quot; id=&quot;zv&quot;&gt;45%&lt;/span&gt;&#10;      &lt;button id=&quot;zi&quot; title=&quot;放大&quot;&gt;＋&lt;/button&gt;&#10;    &lt;/div&gt;&#10;    &lt;a class=&quot;open&quot; id=&quot;open&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;打开完整页面 ↗&lt;/a&gt;&#10;  &lt;/div&gt;&#10;&#10;  &lt;div class=&quot;view&quot; id=&quot;view&quot;&gt;&#10;    &lt;div class=&quot;wrap&quot; id=&quot;wrap&quot;&gt;&#10;      &lt;div class=&quot;sheet&quot; id=&quot;sheet&quot;&gt;&#10;        &lt;iframe id=&quot;frame&quot; title=&quot;预览&quot; scrolling=&quot;yes&quot;&gt;&lt;/iframe&gt;&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;&#10;    &lt;div class=&quot;loading&quot; id=&quot;loading&quot;&gt;正在载入预览…&lt;/div&gt;&#10;  &lt;/div&gt;&#10;&#10;&lt;script&gt;&#10;// 目标页面与显示名可以外部传入，同一个壳复用给多个文档。&#10;// 取值顺序：宿主 &lt;iframe&gt; 上的 data-* → URL query → 缺省。&#10;// data-* 这条是主路径：build.py 会把本文件整个内联成 srcdoc，srcdoc 没有&#10;// query string，但 srcdoc 与父页同源，所以能从 window.frameElement 读属性。&#10;const host = (()=&gt;{ try { return window.frameElement || null; } catch(e) { return null; } })();&#10;const ds   = (host &amp;&amp; host.dataset) || {};&#10;const q    = new URLSearchParams(location.search);&#10;const SRC  = ds.src  || q.get('src')  || 'surveys/survey.html';&#10;const NAME = ds.name || q.get('name') || 'RL for Spatio-Temporal Video Grounding';&#10;const PATH = ds.path || q.get('path') || SRC;&#10;&#10;// 按桌面视口渲染再整体缩小 —— 否则窄容器里页面会走响应式布局，&#10;// 预览出来的不是真实版式。高度取真实视口高度，见上面样式里的说明。&#10;const PAGE_W = 1240, PAGE_H = 900;&#10;const STEPS = [0.35,0.45,0.6,0.75,0.9,1];&#10;let si = 2;&#10;&#10;const view=document.getElementById('view'), sheet=document.getElementById('sheet'),&#10;      wrap=document.getElementById('wrap'), frame=document.getElementById('frame'),&#10;      loading=document.getElementById('loading');&#10;&#10;document.getElementById('fname').textContent = NAME;&#10;document.getElementById('fpath').textContent = PATH;&#10;document.getElementById('open').href = SRC;&#10;&#10;sheet.style.width = PAGE_W + 'px';&#10;frame.style.height = PAGE_H + 'px';&#10;frame.src = SRC;&#10;&#10;function applyZoom(){&#10;  const k = STEPS[si];&#10;  document.getElementById('zv').textContent = Math.round(k*100) + '%';&#10;  sheet.style.transform = 'scale(' + k + ')';&#10;  wrap.style.width  = (PAGE_W * k) + 'px';&#10;  wrap.style.height = (PAGE_H * k) + 'px';&#10;}&#10;document.getElementById('zi').onclick = ()=&gt;{ if(si&lt;STEPS.length-1){si++;applyZoom();} };&#10;document.getElementById('zo').onclick = ()=&gt;{ if(si&gt;0){si--;applyZoom();} };&#10;&#10;frame.addEventListener('load', ()=&gt;{ loading.style.display='none'; });&#10;// 页签从 display:none 变可见时重摆一次（隐藏时容器宽度是 0，居中算不准）&#10;if (window.ResizeObserver) new ResizeObserver(applyZoom).observe(view);&#10;window.addEventListener('resize', applyZoom);&#10;applyZoom();&#10;&lt;/script&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;&#10;\"></iframe>\n</div>\n"}];
  const tabsEl = document.getElementById('tabs');
  const docsEl = document.getElementById('docs');

  /** Map doc id → doc object for O(1) lookup. */
  const byId = {};
  DOCS.forEach(doc => { byId[doc.id] = doc; });

  const firstId = DOCS[0].id;

  marked.setOptions({ gfm: true, breaks: false });

  // ---- heading id (TOC anchor support) -------------------------------------
  // Inject GitHub-style slug ids so TOC links like #1-system-architecture work.
  marked.use({
    renderer: {
      // marked changed this hook's signature across majors: older builds pass
      // (text, level), newer ones a token object. setup-assets.sh pulls the
      // latest marked, so accept both rather than pin to one.
      heading(arg, level) {
        const text  = typeof arg === 'string' ? arg : (arg.text ?? '');
        const depth = typeof arg === 'string' ? level : arg.depth;
        // Strip any HTML tags (e.g. <strong>) to get plain text for slug
        const plain = String(text).replace(/<[^>]+>/g, '').trim();
        const slug = plain
          .toLowerCase()
          .replace(/[^\w一-鿿\s\-]/g, '') // keep alphanum, CJK, space, hyphen
          .trim()
          .replace(/\s+/g, '-');
        return `<h${depth} id="${slug}">${text}</h${depth}>\n`;
      }
    }
  });

  // ---- math-safe markdown render -------------------------------------------
  // marked would mangle LaTeX ($a_t$ → emphasis, \frac → lost backslash), so
  // we stash code spans/blocks first (never treat $ inside code as math), pull
  // math out to indexed sentinels, run marked, then restore raw $…$/$$…$$ for KaTeX.
  //
  // Sentinels wrap the index in Private-Use-Area chars (U+E000…U+E001) that
  // never occur in real prose or markdown. An earlier scheme used space-padded
  // " C<n> " / " M<n> " tokens, which collided with ordinary text such as
  // "美团 M17 fully async" — the restore step then looked up a nonexistent math
  // entry and threw, aborting the render loop and hiding every later tab.
  const _S0 = '', _S1 = '';
  const _CODE_RE = new RegExp(_S0 + 'C(\\d+)' + _S1, 'g');
  const _MATH_RE = new RegExp(_S0 + 'M(\\d+)' + _S1, 'g');
  function renderDoc(md) {
    const codeStash = [];
    const codeTok = m => { codeStash.push(m); return _S0 + 'C' + (codeStash.length - 1) + _S1; };
    md = md.replace(/```[\s\S]*?```/g, codeTok);
    md = md.replace(/`[^`\n]*`/g,      codeTok);

    const mathStash = [];
    md = md.replace(/\$\$([\s\S]+?)\$\$/g, (_, x) => { mathStash.push({ display: true,  tex: x }); return _S0 + 'M' + (mathStash.length - 1) + _S1; });
    md = md.replace(/\$([^\$\n]+?)\$/g,    (_, x) => { mathStash.push({ display: false, tex: x }); return _S0 + 'M' + (mathStash.length - 1) + _S1; });

    md = md.replace(_CODE_RE, (_, i) => codeStash[+i]);   // restore code before marked
    let html = marked.parse(md);
    html = html.replace(_MATH_RE, (_, i) => {
      const entry = mathStash[+i];
      // HTML-escape < > & so the browser doesn't parse LaTeX as HTML tags when
      // assigned to innerHTML. KaTeX's renderMathInElement reads textContent and
      // will decode these back to the correct LaTeX characters automatically.
      const tex = entry.tex.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return entry.display ? ('$$' + tex + '$$') : ('$' + tex + '$');
    });
    return html;
  }

  function typesetMath(el) {
    if (window.renderMathInElement) renderMathInElement(el, {
      delimiters: [
        { left: '$$', right: '$$', display: true  },
        { left: '$',  right: '$',  display: false },
      ],
      throwOnError: false,
      ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
    });
  }

  // ---- contents card + foldable sections -----------------------------------
  // Each doc opens with "## Contents" plus a link list; that pair becomes a card.
  // Every other h2 owns the nodes after it until the next h1/h2, wrapped in
  // .fold-body so the heading can collapse its own section.

  function setFold(heading, folded) {
    const body = heading.nextElementSibling;
    if (!body || !body.classList.contains('fold-body')) return;
    heading.classList.toggle('folded', folded);
    body.classList.toggle('folded', folded);
    heading.setAttribute('aria-expanded', String(!folded));
    if (!folded) { body.classList.remove('opening'); void body.offsetWidth; body.classList.add('opening'); }
  }

  function enhanceDoc(body) {
    // The contents card is built earlier in the render pass; reuse it.
    const toc = body.querySelector('nav.toc');

    const foldable = [];
    body.querySelectorAll('h2').forEach(heading => {
      if (heading.closest('nav, table, details')) return;
      const wrap = document.createElement('div');
      wrap.className = 'fold-body';
      let node = heading.nextSibling;
      while (node && !(node.nodeType === 1 && /^H[12]$/.test(node.tagName))) {
        const next = node.nextSibling;
        wrap.appendChild(node);
        node = next;
      }
      if (!wrap.childNodes.length) return;
      heading.parentNode.insertBefore(wrap, heading.nextSibling);
      heading.classList.add('foldable');
      heading.tabIndex = 0;
      heading.setAttribute('aria-expanded', 'true');
      heading.title = '点击收起 / 展开本节';
      heading.addEventListener('click', e => {
        if (e.target.closest('a[href]')) return;
        if (String(window.getSelection())) return;
        setFold(heading, !heading.classList.contains('folded'));
      });
      heading.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setFold(heading, !heading.classList.contains('folded'));
        }
      });
      foldable.push(heading);
    });

    if (toc && foldable.length) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'fold-all';
      btn.textContent = '全部收起';
      btn.onclick = () => {
        const anyOpen = foldable.some(h => !h.classList.contains('folded'));
        foldable.forEach(h => setFold(h, anyOpen));
        btn.textContent = anyOpen ? '全部展开' : '全部收起';
      };
      toc.appendChild(btn);
    }
  }

  // A link into a collapsed section opens it first.
  function revealTarget(id) {
    const target = id && document.getElementById(id);
    if (!target) return;
    if (target.classList.contains('foldable') && target.classList.contains('folded')) setFold(target, false);
    let folded = target.closest('.fold-body.folded');
    while (folded) {
      setFold(folded.previousElementSibling, false);
      folded = folded.parentElement && folded.parentElement.closest('.fold-body.folded');
    }
  }
  document.addEventListener('click', e => {
    const a = e.target.closest && e.target.closest('a[href^="#"]');
    if (!a) return;
    const href = a.getAttribute('href');
    if (href.startsWith('#doc:')) return;
    revealTarget(decodeURIComponent(href.slice(1)));
  }, true);

  // ---- doc-graph traversal -------------------------------------------------

  /** Walk parent links upward to find the nearest tab ancestor of `id`. */
  function tabAncestor(id) {
    let doc = byId[id], depth = 0;
    while (doc && !doc.tab && doc.parent && depth++ < MAX_ANCESTOR_DEPTH) {
      doc = byId[doc.parent];
    }
    return doc ? doc.id : id;
  }

  // ---- DOM construction ----------------------------------------------------

  DOCS.forEach(docData => {
    // Tab button (only for top-level tab docs)
    if (docData.tab) {
      const btn       = document.createElement('button');
      btn.className   = 'tab' + (docData.id === firstId ? ' active' : '');
      btn.textContent = docData.label;
      btn.dataset.target = docData.id;
      btn.onclick     = () => activate(docData.id);
      tabsEl.appendChild(btn);
    }

    // Article element that holds the rendered markdown
    const article     = document.createElement('article');
    article.className = 'doc' + (docData.id === firstId ? ' active' : '');
    article.id        = 'doc-' + docData.id;

    // Breadcrumb link for sub-docs
    if (docData.parent && byId[docData.parent]) {
      const breadcrumb     = document.createElement('div');
      breadcrumb.className = 'breadcrumb';
      breadcrumb.innerHTML = '<a href="#">← 返回 ' + byId[docData.parent].label + '</a>';
      breadcrumb.querySelector('a').onclick = (e) => { e.preventDefault(); activate(docData.parent); };
      article.appendChild(breadcrumb);
    }

    // Rendered markdown body
    const body     = document.createElement('div');
    body.innerHTML = renderDoc(docData.md);

    // Wrap every table in a scroll container. The card styling and overflow live
    // on the wrapper (see .tbl-scroll) so the table can stay a real display:table.
    // Done on the DOM rather than by regex so raw <table> blocks written directly
    // in markdown are wrapped too.
    //
    // Then size the columns from their actual content: a column of numbers or short
    // labels hugs its text, prose columns take what's left, and an all-short table
    // stops stretching to full width (a 10-column P/R/F1 table used to spread four
    // characters across a tenth of the page each).
    const TIGHT_MAX = 12;   // longest cell, in characters, that still counts as short
    // 目录：h2#contents 与其后的 ul 抽成一块 nav.toc，跟正文隔开
    const cH = body.querySelector('h2#contents');
    if (cH && cH.nextElementSibling && cH.nextElementSibling.tagName === 'UL') {
      const nav = document.createElement('nav');
      nav.className = 'toc';
      cH.parentNode.insertBefore(nav, cH);
      nav.appendChild(cH);
      nav.appendChild(nav.nextElementSibling);   // 上一步之后 ul 正好紧跟在 nav 后面
    }

    body.querySelectorAll('table').forEach(t => {
      let w = t.parentElement;
      if (!w || !w.classList.contains('tbl-scroll')) {
        w = document.createElement('div');
        w.className = 'tbl-scroll';
        t.parentNode.insertBefore(w, t);
        w.appendChild(t);
      }
      const rows = Array.prototype.slice.call(t.rows);
      const ncol = rows.reduce((m, r) => Math.max(m, r.cells.length), 0);
      let allTight = ncol > 0;
      for (let c = 0; c < ncol; c++) {
        let longest = 0, wrapped = false;
        rows.forEach(r => {
          const cell = r.cells[c];
          if (!cell || cell.tagName === 'TH') return;   // headers don't decide the class
          longest = Math.max(longest, (cell.textContent || '').trim().length);
          if (cell.querySelector('br,ul,ol,p,pre')) wrapped = true;
        });
        const tight = !wrapped && longest > 0 && longest <= TIGHT_MAX;
        if (!tight) allTight = false;
        rows.forEach(r => {
          const cell = r.cells[c];
          if (cell) cell.classList.add(tight ? 'c-tight' : 'c-prose');
        });
      }
      if (allTight) w.classList.add('hug');
    });

    // External links open in a new tab; local .md links were rewritten by
    // build.py to #doc:<id> and are handled by the click interceptor below.
    body.querySelectorAll('a[href]').forEach(a => {
      const href = a.getAttribute('href') || '';
      if (/^(https?:|mailto:)/.test(href)) { a.target = '_blank'; a.rel = 'noopener'; }
    });

    enhanceDoc(body);
    typesetMath(body);
    article.appendChild(body);
    docsEl.appendChild(article);
  });

  // ---- navigation ----------------------------------------------------------

  // Never stretch a table past its natural width. The class pass above sizes
  // columns, but a table with three short columns and one 20-char prose column
  // still gets width:100% — the prose column then absorbs ~700px of leftover for
  // 20 characters, which reads as a broken layout (评测维度 / 视频数 was exactly
  // that). So measure each table once at width:auto: if its content comfortably
  // fits the column, let the wrapper hug it (same .hug path all-tight tables take);
  // otherwise it keeps width:100% and wraps as before. Deferred to activate()
  // because .doc is display:none until then, and clientWidth would read 0 — hence
  // the dataset.fit latch, which is only set once a real width was measured.
  function fitTables(scope) {
    scope.querySelectorAll('.tbl-scroll').forEach(w => {
      if (w.dataset.fit || !w.clientWidth) return;
      w.dataset.fit = '1';
      const t = w.querySelector('table');
      if (!t || w.classList.contains('hug')) return;
      const avail = w.clientWidth;
      t.style.width = 'auto';
      const natural = t.scrollWidth;
      t.style.width = '';
      if (natural <= avail * 0.94) w.classList.add('hug');
    });
  }
  document.querySelectorAll('.doc.active').forEach(fitTables);

  function activate(id) {
    const doc = byId[id];
    if (!doc) return;

    const tabId = tabAncestor(id);
    document.querySelectorAll('.tab').forEach(
      tab => tab.classList.toggle('active', tab.dataset.target === tabId)
    );
    document.querySelectorAll('.doc').forEach(
      docEl => docEl.classList.toggle('active', docEl.id === 'doc-' + id)
    );
    document.querySelectorAll('.doc.active').forEach(fitTables);

    if (location.hash.slice(1) !== id) history.replaceState(null, '', '#' + id);
    window.scrollTo({
      top: document.querySelector('.tabs-wrap').offsetTop - STICKY_HEADER_HEIGHT,
      behavior: 'smooth',
    });
  }

  // Intercept in-page doc links (build.py rewrites local .md links to #doc:<id>).
  docsEl.addEventListener('click', (e) => {
    const a = e.target.closest('a');
    if (!a) return;
    const href  = a.getAttribute('href') || '';
    const match = href.match(/^#doc:(.+)$/);
    if (match && byId[match[1]]) { e.preventDefault(); activate(match[1]); }
    // External links (target=_blank) and plain #anchors fall through to default.
  });

  // Deep-link support: accepts both #<id> and #doc:<id> in the URL hash.
  const initial = location.hash.slice(1).replace(/^doc:/, '');
  if (initial && byId[initial]) activate(initial);
</script>

<!-- kc-expand: tag-system iframe 内打开 modal 时，把发消息的那个 iframe 放大到全屏，
     modal 悬浮其上；背后铺一层「模糊 + 变暗」遮罩，真实博客页面透过来（不再是图表
     自己的白底），符合「背景该是什么还是什么，只是模糊一些」。iframe 本身透明，只显示
     居中的 modal。关闭时精确还原，用占位符保持文档流不跳动。 -->
<script>
(function(){
  var expanded = null;      // 当前被放大的 iframe
  var savedCss = '';        // 它放大前的 style
  var placeholder = null;   // 占位符：iframe 变 fixed 后顶住它原来的空间，防止页面回流
  var scrim = null;         // 变暗 + 模糊遮罩层（盖在博客页面上，iframe 之下）
  var revealTimer = null;   // 兜底：子页不回 kc-modal-ready 时也要把 iframe 显影
  var finishTimer = null;   // 兜底：子页不回 kc-revealed 时也要撤遮罩收尾
  function frameOf(win){
    var ifr = document.getElementsByTagName('iframe');
    for (var i = 0; i < ifr.length; i++){
      if (ifr[i].contentWindow === win) return ifr[i];
    }
    return null;
  }
  function expand(win){
    var fr = frameOf(win);
    if (!fr || expanded) return;
    expanded = fr; savedCss = fr.getAttribute('style') || '';
    // 占位符撑住原空间，避免 iframe 脱离文档流导致下方内容上跳
    var r = fr.getBoundingClientRect();
    placeholder = document.createElement('div');
    placeholder.style.cssText = 'height:' + r.height + 'px';
    fr.parentNode.insertBefore(placeholder, fr);
    // scrim：模糊+变暗真实页面
    scrim = document.createElement('div');
    scrim.style.cssText = 'position:fixed;inset:0;z-index:9998;background:rgba(12,15,20,.5);'
                        + '-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);';
    document.body.appendChild(scrim);
    // iframe 透明铺满，但先 opacity:0 藏起来 —— 放大后的这一两帧里，子页面画的
    // 还是「行内尺寸的图表」，不藏就会看到那块背景以全屏尺寸闪一下（flash.png）。
    // 等子页 modal 成形后回 kc-modal-ready，再显影。
    fr.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;'
                     + 'z-index:9999;border:0;border-radius:0;background:transparent;opacity:0;';
    document.body.style.overflow = 'hidden';
    // 等两帧确保 iframe 的新尺寸已生效，再通知子页面开 modal（消除小→大跳动）
    requestAnimationFrame(function(){ requestAnimationFrame(function(){
      fr.contentWindow.postMessage({type: 'kc-expand-ack', vw: window.innerWidth, vh: window.innerHeight}, '*');
    }); });
    // 兜底：子页面若不回 kc-modal-ready（旧版图表），也不能永远隐身
    revealTimer = setTimeout(reveal, 600);
  }
  // 显影。这里必须再等几帧，不能收到消息就 opacity:1。
  // iframe 是独立进程：子页在自己进程里 double-rAF 只能证明「子页画完了」，不能证明
  // 父页的合成器已经取到那一帧。抢跑的结果是父页把 iframe 显影出来，而合成器手上
  // 还是子页的上一帧 —— 刚按全屏重排、classes 还没生效的标签树，清晰地盖在模糊页面
  // 上。这就是 flash.png。多等 3 帧（~50ms）让新的子页面帧确定被合成，用户感知不到，
  // 但闪烁彻底消失。
  function revealSoon(fn){
    var n = 0;
    (function step(){
      if (++n >= 3) { fn(); return; }
      requestAnimationFrame(step);
    })();
    setTimeout(fn, 150);          // rAF 不跑（后台标签页）时的兜底
  }
  function reveal(){
    clearTimeout(revealTimer); revealTimer = null;
    var fr = expanded;
    if (!fr) return;
    var done = false;
    revealSoon(function(){
      if (done || expanded !== fr) return;
      done = true;
      fr.style.opacity = '1';
    });
  }
  // 关闭分三步，几何还原和子页恢复内容全部发生在 opacity:0 之下：
  //   ① collapse(): 先把 iframe 按成透明，再还原几何，然后请子页恢复图表内容。
  //      这两件事顺序颠倒过来就是上一版残留的 bug —— setAttribute(style, savedCss)
  //      同时还原了「尺寸」和「不透明」，而子页要等 ack 才恢复内容，中间必然有一帧
  //      「行内尺寸的空白矩形」。
  //   ② 子页恢复完内容回 kc-revealed。
  //   ③ finish(): 同一帧里撤遮罩 + 显影。中间态一帧都不上屏。
  function collapse(){
    if (!expanded) return;
    var fr = expanded;
    clearTimeout(revealTimer); revealTimer = null;
    // 隐身 + 还原几何，一次写完：位置、尺寸、边框圆角回到行内，但仍然不可见。
    // 此时用户看到的还是「模糊的页面」（遮罩还在），iframe 里发生什么都不上屏。
    fr.setAttribute('style', savedCss + ';opacity:0');
    // 等两帧确保 iframe 已按行内尺寸重新布局，再让子页把图表放出来 —— 否则子页会
    // 以全屏尺寸画一两帧。子页恢复完会回 kc-revealed，由 finish() 收尾。
    requestAnimationFrame(function(){ requestAnimationFrame(function(){
      try { fr.contentWindow.postMessage({type: 'kc-collapse-ack'}, '*'); } catch(_){}
    }); });
    finishTimer = setTimeout(finish, 400);   // 子页不回 kc-revealed 时的兜底
  }
  // 撤遮罩 + 显影，同一帧完成。
  function finish(){
    clearTimeout(finishTimer); finishTimer = null;
    if (!expanded) return;
    var fr = expanded;
    // 同理：子页说「我恢复好了」不等于父页合成器已经拿到那一帧。抢跑会露出
    // 「行内尺寸的空白矩形」。等几帧再撤遮罩+显影。
    revealSoon(function(){
      if (fr !== expanded) return;
      if (placeholder) placeholder.remove();
      if (scrim) scrim.remove();
      fr.setAttribute('style', savedCss);    // 去掉 opacity:0，恢复原样
      expanded = null; savedCss = ''; placeholder = null; scrim = null;
      document.body.style.overflow = '';
    });
  }
  // kc-height: 子页报告自己内容的真实高度，父页把 iframe 高度贴合过去 —— 图表在窄屏
  // 折行后会变高，写死的行内 height 会把它裁掉（变成 iframe 内的竖向滚动条）。
  // 放大态的 iframe 是 fixed inset:0，此时不能动它的高度。
  function fitHeight(win, h){
    var fr = frameOf(win);
    if (!fr || fr === expanded || !(h > 0)) return;
    fr.style.height = Math.ceil(h) + 'px';
  }
  window.addEventListener('message', function(e){
    if (!e.data) return;
    if (e.data.type === 'kc-expand')      expand(e.source);
    if (e.data.type === 'kc-modal-ready') reveal();
    if (e.data.type === 'kc-collapse')    collapse();
    if (e.data.type === 'kc-revealed')    finish();
    if (e.data.type === 'kc-height')      fitHeight(e.source, e.data.h);
  });
})();
</script>
</body>
</html>

