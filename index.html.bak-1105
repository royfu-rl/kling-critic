:&quot;P0&quot;},{&quot;n&quot;:&quot;音色指代错误&quot;,&quot;prio&quot;:&quot;P0&quot;}]}]}];&#10;const TAX_AFTER = [{&quot;name&quot;:&quot;动态质量&quot;,&quot;rules&quot;:[],&quot;subs&quot;:[{&quot;name&quot;:&quot;动态基础质量（物理层）&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;细节纹理抖动仅限帧间位移；单帧纹理不真实 → 画面质量·纹理虚假&quot;,&quot;for&quot;:[&quot;细节纹理抖动&quot;]},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;结构异常仅限运动形变；静态边缘光晕 → 画面质量·主体边缘异常&quot;,&quot;for&quot;:[&quot;生物结构异常&quot;,&quot;非生物结构异常&quot;]},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;速度异常仅限违反物理速率；符合物理但违反 Prompt → 指令遵循·播放速度不符&quot;,&quot;for&quot;:[&quot;速度异常&quot;]},{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;动态时序不一致管长程逻辑（&gt;3秒），卡顿掉帧感管微观插值平滑度&quot;,&quot;for&quot;:[&quot;动态时序不一致&quot;,&quot;卡顿掉帧感&quot;]},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;转场异变若由切镜导致且属主体/道具穿帮 → 指令遵循·镜头间内容混淆；仅单镜头内无理由突现才归动态基础质量&quot;,&quot;for&quot;:[&quot;转场异变&quot;]},{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;瑕疵同时涉及运动与静态画面时优先归动态质量；仅当静止单帧完全可复现且与运动无关才归画面质量&quot;}],&quot;tags&quot;:[{&quot;n&quot;:&quot;生物结构异常&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;合理性（+生物类结构异常）&quot;,&quot;why&quot;:&quot;5 个 facet 提升为独立三级标签——facet 无法独立分配优先级，也无法独立统计召回。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;人物 / 动物的身体在运动过程中出现解剖学上不可能的结构错误。&quot;,&quot;symptoms&quot;:[&quot;反关节扭曲&quot;,&quot;多指或少指&quot;,&quot;四肢交叉融化粘连&quot;,&quot;面部肌肉走向诡异&quot;],&quot;requires&quot;:&quot;主体整体仍可辨识，错误局限在局部结构&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体已整体撕裂 / 溶解到不可辨识 → `崩坏`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;结构正确但动作姿态生硬不自然 → `运动不真实`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;静止单帧就能复现的抠图感 / 边缘光晕 → 画面质量 `主体边缘异常`&quot;}],&quot;demoKey&quot;:&quot;生物类结构异常&quot;},{&quot;n&quot;:&quot;非生物结构异常&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;合理性（+非生物结构异常）&quot;,&quot;why&quot;:&quot;5 个 facet 提升为独立三级标签——facet 无法独立分配优先级，也无法独立统计召回。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;物体 / 建筑 / 载具在运动过程中出现结构性形变、断裂或自穿插。&quot;,&quot;symptoms&quot;:[&quot;桌椅车辆建筑在运动中形变断裂&quot;,&quot;车轮陷入地面&quot;,&quot;方向盘穿透仪表台&quot;],&quot;requires&quot;:&quot;错误在物体自身结构内，主体仍可辨识&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;错误发生在两个主体之间（手嵌进另一只手）→ `主体间穿模`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体不可辨识 → `崩坏`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;静态单帧即可复现的边缘瑕疵 → 画面质量 `主体边缘异常`&quot;}]},{&quot;n&quot;:&quot;主体间穿模&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;合理性（+主体间交互）&quot;,&quot;why&quot;:&quot;5 个 facet 提升为独立三级标签——facet 无法独立分配优先级，也无法独立统计召回。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;两个主体之间、或主体与道具之间发生穿透、重叠、接触失效。&quot;,&quot;symptoms&quot;:[&quot;握手时两只手互相嵌入&quot;,&quot;人物穿过桌面&quot;,&quot;刀切进苹果但苹果未裂&quot;,&quot;脚陷入地面&quot;],&quot;requires&quot;:&quot;判定对象是两个主体之间的交界处&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;仅限主体与主体 / 道具之间的穿插、重叠、接触失效&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;形变发生在单个主体自身结构内 → `生物结构异常` / `非生物结构异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;接触正确但受力反馈不合物理（撞墙后加速）→ `不符合物理规律`&quot;}]},{&quot;n&quot;:&quot;不符合物理规律&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;合理性（+不符合物理规律）&quot;,&quot;why&quot;:&quot;5 个 facet 提升为独立三级标签——facet 无法独立分配优先级，也无法独立统计召回。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;运动违反重力、惯性、碰撞等可量化的物理规律。&quot;,&quot;symptoms&quot;:[&quot;物体无支撑悬浮&quot;,&quot;急刹车时身体不前倾&quot;,&quot;球撞墙后反而加速&quot;,&quot;液体逆流&quot;],&quot;requires&quot;:&quot;违反的是可量化的物理规律（重力 / 惯性 / 碰撞）&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;违反重力 / 惯性 / 碰撞等物理规律；速率类异常 → `速度异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;物理成立但违背生活常识（雪地走路无脚印）→ `不符合现实常识`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅速率忽快忽慢 → `速度异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;穿透接触失效 → `主体间穿模`&quot;}]},{&quot;n&quot;:&quot;不符合现实常识&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;合理性（+不符合现实常识）&quot;,&quot;why&quot;:&quot;5 个 facet 提升为独立三级标签——facet 无法独立分配优先级，也无法独立统计召回。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;物理规律上说得通，但违背现实世界的常识与因果。&quot;,&quot;symptoms&quot;:[&quot;水面倒影比本体动作快&quot;,&quot;雪地里走路不留脚印&quot;,&quot;火焰不产生阴影&quot;,&quot;镜中影像与本体不一致&quot;],&quot;requires&quot;:&quot;物理规律成立，但违背现实世界的常识与因果&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;物理上可成立但违反现实常识（如雪地赤脚无痕）&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;直接违反重力 / 惯性 / 碰撞 → `不符合物理规律`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;属于结构错误 → `生物结构异常` / `非生物结构异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;属于叙事逻辑断裂 → `叙事混乱与不完整`&quot;}]},{&quot;n&quot;:&quot;合理性&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;why&quot;:&quot;5 个 facet 提升为独立三级标签——facet 无法独立分配优先级，也无法独立统计召回。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;崩坏&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;from&quot;:&quot;明显崩坏 + 轻微崩坏&quot;,&quot;why&quot;:&quot;程度副词作标签区隔导致主观阈值漂移，合并为单一标签，程度另记。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;画面主体出现结构性撕裂、局部溶解或消失，主体已不可辨识。&quot;,&quot;symptoms&quot;:[&quot;主体轮廓溶解&quot;,&quot;拓扑撕裂&quot;,&quot;局部消失后重建错位&quot;],&quot;requires&quot;:&quot;主体身份已无法辨认。程度轻重不再用标签区分，另记严重度分数&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体仍可辨识、仅局部结构错误 → `生物结构异常` / `非生物结构异常`（两者与本标签互斥，不可并打）&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体正常但纹理在帧间抖动 → `细节纹理抖动`&quot;}],&quot;demoKey&quot;:&quot;崩坏&quot;},{&quot;n&quot;:&quot;速度异常&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;运动速率违反物理规律地忽快忽慢。&quot;,&quot;symptoms&quot;:[&quot;「缓缓飘落」的树叶像石头一样砸下&quot;,&quot;动作在同一镜头内无理由加速或减速&quot;],&quot;requires&quot;:&quot;速率变化找不到物理解释&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;速度符合物理但不符 Prompt 设定的慢动作 / 延时 → 指令遵循 `播放速度不符`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体关节运动速率不符 Prompt → 指令遵循 `动作速度不符`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;镜头移动速率不符 Prompt → 指令遵循 `运镜速度不符`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;运动不平滑呈幻灯片跳跃 → `卡顿掉帧感`&quot;}]},{&quot;n&quot;:&quot;转场异变&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;单镜头内主体无理由突变为另一形态。&quot;,&quot;symptoms&quot;:[&quot;走路的人瞬间变成一棵树&quot;,&quot;主体或前景物体形态剧烈改变&quot;],&quot;requires&quot;:&quot;发生在单镜头内，且无任何转场动机&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;变化由切镜导致且属主体 / 道具穿帮 → 指令遵循 `镜头间内容混淆`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;转场手法本身不符 Prompt → 指令遵循 `转场方式错误`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体溶解而非替换 → `崩坏`&quot;}]},{&quot;n&quot;:&quot;细节纹理抖动&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;from&quot;:&quot;明显细节纹理抖动 + 轻微细节纹理抖动&quot;,&quot;why&quot;:&quot;同上，程度副词不作标签区隔。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;纹理在相邻帧之间像水波一样位移或闪烁。&quot;,&quot;symptoms&quot;:[&quot;衣服花纹&quot;,&quot;地面砖缝&quot;,&quot;发丝在帧间持续位移抖动&quot;],&quot;requires&quot;:&quot;程度轻重不再用标签区分，另记严重度分数&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;单帧静止就能看出纹理不真实（塑料感、糊成一团）→ 画面质量 `纹理虚假`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;抖动表现为整体亮度忽明忽暗 → `明暗闪烁`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;表现为色彩污染拖影 → `帧间颜色染色`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;表现为果冻状流体扭曲 → `波动扭曲`&quot;}]},{&quot;n&quot;:&quot;帧间颜色染色&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;明显帧间颜色染色或伪影&quot;,&quot;why&quot;:&quot;去掉程度副词，收敛表述。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;相邻帧之间出现色彩污染或压缩伪影。&quot;,&quot;symptoms&quot;:[&quot;红色拖影&quot;,&quot;青色溢出&quot;,&quot;过曝残影式的块状伪影&quot;],&quot;requires&quot;:&quot;颜色在帧间相互污染&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;单帧即可复现的整体色偏 / 过曝 → 画面质量 `曝光光影或色彩异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;整体亮度忽明忽暗而非染色 → `明暗闪烁`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;属编解码块效应且静帧可见 → 画面质量 `类似编解码画质现象`&quot;}]},{&quot;n&quot;:&quot;波动扭曲&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;背景或物体边缘出现果冻效应式的类流体扭曲。&quot;,&quot;symptoms&quot;:[&quot;画面局部像透过火焰或水面观看&quot;,&quot;边缘呈波浪状起伏&quot;],&quot;requires&quot;:&quot;通常由帧插值失败引起&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;扭曲导致主体结构错误 → `生物结构异常` / `非生物结构异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅纹理在帧间位移而无流体感 → `细节纹理抖动`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;单帧即可见的镜头畸变 → 画面质量 `主体边缘异常`&quot;}],&quot;demoKey&quot;:&quot;波动扭曲&quot;},{&quot;n&quot;:&quot;明暗闪烁&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;画面整体或局部亮度在连续帧间剧烈忽明忽暗。&quot;,&quot;symptoms&quot;:[&quot;连续帧之间亮度跳变&quot;,&quot;呈频闪感&quot;],&quot;requires&quot;:&quot;找不到画面内的光源变化依据&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;亮度 / 色调随时间缓慢漂移而非闪烁 → `光影风格时序不一致`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;单帧即可复现的过曝 → 画面质量 `曝光光影或色彩异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;伴随色彩污染 → `帧间颜色染色`&quot;}]},{&quot;n&quot;:&quot;卡顿掉帧感&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;运动不平滑，呈幻灯片式跳跃，缺少中间帧过渡。&quot;,&quot;symptoms&quot;:[&quot;运动轨迹断续&quot;,&quot;有明显跳格感&quot;],&quot;requires&quot;:&quot;判定尺度是帧到帧的平滑度——微观层面帧间插值失败&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;长程（&gt;3 秒）物体位置 / 状态前后不一致 → `动态时序不一致`（两者按作用尺度互斥）&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;速率忽快忽慢但画面平滑 → `速度异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体完全僵死不动 → `异常静止`&quot;}]},{&quot;n&quot;:&quot;动态时序不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;动态时序一致性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式——「一致性」本身不是问题，其反面才是。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;长程范围内物体的位置或状态前后不连贯。&quot;,&quot;symptoms&quot;:[&quot;先前放在桌上的杯子后来凭空消失&quot;,&quot;瞬移&quot;,&quot;状态改变&quot;],&quot;requires&quot;:&quot;跨 3 秒以上观察，长程逻辑断裂&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅帧间插值不平滑的微观跳跃 → `卡顿掉帧感`（两者按作用尺度互斥）&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;不一致发生在跨镜头之间 → 一致性维度对应标签&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;属光照色调漂移 → `光影风格时序不一致`&quot;}]},{&quot;n&quot;:&quot;光影风格时序不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;光影风格时序一致性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;随时间推进，画面的色调、光照方向或风格发生漂移。&quot;,&quot;symptoms&quot;:[&quot;同一场景上一秒正午硬光下一秒阴天黑云&quot;,&quot;光源方向无理由改变&quot;,&quot;画风在镜头内逐渐漂移&quot;],&quot;requires&quot;:&quot;色调 / 光照随时间缓慢漂移，而非逐帧频闪&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签管帧间色调 / 光照跳动；单帧整体偏色 / 过曝 → 画面质量 `曝光光影或色彩异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;亮度剧烈频闪而非缓慢漂移 → `明暗闪烁`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;不一致发生在跨镜头之间 → 一致性 `风格不一致` / `颜色不一致`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;单帧即可复现的色彩问题 → 画面质量 `曝光光影或色彩异常`&quot;}]},{&quot;n&quot;:&quot;镜头晃动&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;Prompt 未要求的情况下镜头出现非预期摇晃。&quot;,&quot;symptoms&quot;:[&quot;画面持续抖动&quot;,&quot;令人眩晕的摇晃&quot;],&quot;requires&quot;:&quot;Prompt 没有「手持」「晃动」等描述&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;Prompt 要求了手持感 → 不打本标签&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;晃动幅度 / 类型不符 Prompt 的运镜要求 → 指令遵循 `运镜类型错误`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;画面平移但主体僵死 → `异常静止`&quot;}]},{&quot;n&quot;:&quot;异常静止&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;理应运动的主体完全僵死不动，与环境脱节。&quot;,&quot;symptoms&quot;:[&quot;风中的旗帜完全静止&quot;,&quot;人物头发完全静止&quot;,&quot;水面完全静止&quot;],&quot;requires&quot;:&quot;主体在应当有动作的时段内一帧不动&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体有动作但幅度整体偏小 → `动态幅度更大`（对比场景）&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;运动断续跳跃而非静止 → `卡顿掉帧感`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;Prompt 明确要求静止 → 不打本标签&quot;}]},{&quot;n&quot;:&quot;文字未保持&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;画面文字在运动过程中扭曲、模糊消失或变形。&quot;,&quot;symptoms&quot;:[&quot;文字随运动逐渐扭曲&quot;,&quot;抖动&quot;,&quot;消失&quot;],&quot;requires&quot;:&quot;文字在静止首帧可读，但动起来就坏掉&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;文字从一开始就不可读 → 画面质量 `画面文字不可读`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;文字内容 / 拼写与 Prompt 不符 → 指令遵循 `文字生成错误`&quot;}]},{&quot;n&quot;:&quot;其他动态质量问题&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P2&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;兜底标签：确属动态质量缺陷，但不属于本子维度任何已有标签。&quot;,&quot;symptoms&quot;:[],&quot;requires&quot;:&quot;仅当穷举本子维度全部标签后仍无法归类时使用，并在备注里写明具体现象&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;能归入任何已有标签时一律不打本标签&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;属画面 / 指令 / 一致性 / 音频维度的问题应归各自维度&quot;}]},{&quot;n&quot;:&quot;明显崩坏&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;why&quot;:&quot;并入「崩坏」。&quot;,&quot;gone&quot;:true,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;主体已不可辨识 → `崩坏`；主体可辨识但局部结构错误 → `生物结构异常` / `非生物结构异常`。两者互斥&quot;}],&quot;demoKey&quot;:&quot;崩坏&quot;},{&quot;n&quot;:&quot;轻微崩坏&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;why&quot;:&quot;并入「崩坏」。&quot;,&quot;gone&quot;:true,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;主体已不可辨识 → `崩坏`；主体可辨识但局部结构错误 → `生物结构异常` / `非生物结构异常`。两者互斥&quot;}]},{&quot;n&quot;:&quot;明显细节纹理抖动&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;why&quot;:&quot;并入「细节纹理抖动」。&quot;,&quot;gone&quot;:true,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签仅限帧间位移 / 闪烁；单帧纹理不真实 → 画面质量 `纹理虚假`&quot;}]},{&quot;n&quot;:&quot;轻微细节纹理抖动&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;why&quot;:&quot;并入「细节纹理抖动」。&quot;,&quot;gone&quot;:true,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签仅限帧间位移 / 闪烁；单帧纹理不真实 → 画面质量 `纹理虚假`&quot;}]}]},{&quot;name&quot;:&quot;动态美学及视听叙事（艺术层）&quot;,&quot;subj&quot;:true,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;创意性为正向加分标签（非缺陷），rubric 中须标明其打标方向与其余标签相反&quot;,&quot;for&quot;:[&quot;创意性&quot;]}],&quot;tags&quot;:[{&quot;n&quot;:&quot;运动不真实&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;运动真实性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;动作不穿帮，但运动方式不像真实人 / 物。&quot;,&quot;symptoms&quot;:[&quot;机器人式走路&quot;,&quot;奔跑时摆臂幅度不对&quot;,&quot;肢体协调性失真&quot;],&quot;requires&quot;:&quot;结构与物理都没错，问题只在「像不像真的」这一层&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;凡运动相关的瑕疵优先归动态质量；仅当瑕疵在静止单帧中完全可复现时才归画面质量&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;出现解剖结构错误 → `生物结构异常`；违反重力惯性 → `不符合物理规律`&quot;},{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;视频以动态为首要特征，运动相关的瑕疵优先归本维度，不归画面美学&quot;}]},{&quot;n&quot;:&quot;表演不真实&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;表演真实性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;角色的情绪表达与其当下心理状态不符。&quot;,&quot;symptoms&quot;:[&quot;「惊喜」演成瞪眼呆滞&quot;,&quot;微表情缺失&quot;,&quot;眼神与台词情绪脱节&quot;,&quot;肢体语言与情境冲突&quot;],&quot;requires&quot;:&quot;判定对象是情绪表达，而非动作的物理真实度&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;凡运动相关的瑕疵优先归动态质量；仅当瑕疵在静止单帧中完全可复现时才归画面质量&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;问题在动作自然度而非情绪 → `运动不真实`；表情不符 Prompt 指定情绪 → 指令遵循 `表情不符`&quot;}]},{&quot;n&quot;:&quot;叙事节奏较差&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;整段视频的推进速度不恰当，观感拖沓或仓促。&quot;,&quot;symptoms&quot;:[&quot;吃个早餐用了 15 秒慢镜头&quot;,&quot;关键情节一闪而过&quot;,&quot;信息密度与时长严重不匹配&quot;],&quot;requires&quot;:&quot;判定对象是整段叙事的时间分配&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;镜头推拉摇移速度不当 → `运镜节奏较差`；镜头停留时长与信息量不匹配 → `剪辑节奏较差`&quot;}]},{&quot;n&quot;:&quot;叙事混乱与不完整&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;多镜头叙事的事件逻辑断裂或没有收束。&quot;,&quot;symptoms&quot;:[&quot;镜头A在打架镜头B突然在喝茶&quot;,&quot;毫无承接关系&quot;,&quot;事件缺少结局&quot;],&quot;requires&quot;:&quot;镜头之间的因果链断裂，而非单个镜头内部的问题&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅最后一镜没收尾 → 指令遵循 `尾镜叙事缺失`；镜头间毫无关联且跳跃过大 → 指令遵循 `镜头混乱`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;Prompt 本身就是碎片化无因果的剧本时，模型如实生成不算缺陷，不打本标签&quot;}]},{&quot;n&quot;:&quot;景别视角不当&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;景别视角维度&quot;,&quot;why&quot;:&quot;陈述式改缺陷式，标注员原先无法判断打了是好还是坏。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;景别与拍摄视角的选择没有服务于叙事。&quot;,&quot;symptoms&quot;:[&quot;呆板套用同一景别&quot;,&quot;视角选择与情绪相悖&quot;,&quot;该特写时用全景&quot;],&quot;requires&quot;:&quot;Prompt 未指定景别，纯粹是艺术选择欠佳&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;Prompt 指定了景别 / 视角而未实现 → 指令遵循 `景别与拍摄视角错误`&quot;}]},{&quot;n&quot;:&quot;运镜节奏较差&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;镜头推拉摇移的速度与当下情绪不匹配。&quot;,&quot;symptoms&quot;:[&quot;恐怖氛围镜头移动太快&quot;,&quot;温馨场景镜头忽快忽慢&quot;],&quot;requires&quot;:&quot;运镜类型本身正确，问题只在速度与情绪的配合&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;运镜速度不符 Prompt → 指令遵循 `运镜速度不符`；速度违反物理 → `速度异常`&quot;}]},{&quot;n&quot;:&quot;剪辑节奏较差&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;镜头停留时长与其信息量不匹配。&quot;,&quot;symptoms&quot;:[&quot;信息量大但闪得太快&quot;,&quot;信息量小但固定太久&quot;],&quot;requires&quot;:&quot;多镜头场景；判定对象是每个镜头的时长分配&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;切镜时间点不符 Prompt → 指令遵循 `切镜时间点错误`；整段推进快慢失当 → `叙事节奏较差`&quot;}]},{&quot;n&quot;:&quot;创意性&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;why&quot;:&quot;加分项而非缺陷，不作缺陷化重命名，须在 rubric 中标明为正向标签。&quot;,&quot;prio&quot;:&quot;P2&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;正向加分标签：动态表现有意料之外的艺术想象力。&quot;,&quot;symptoms&quot;:[&quot;富有想象力的运动设计&quot;,&quot;巧妙的转场创意&quot;,&quot;超出预期的视听表达&quot;],&quot;requires&quot;:&quot;打标方向与其余标签相反——这是加分项，表现出色才打，不是缺陷&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;本标签为正向加分项，打标方向与其余缺陷标签相反——表现出色才打&quot;},{&quot;kind&quot;:&quot;需禁用&quot;,&quot;r&quot;:&quot;不得当作缺陷标签使用；缺乏创意不打本标签，不打即为无加分&quot;}]},{&quot;n&quot;:&quot;音频基础质量差&quot;,&quot;act&quot;:&quot;移出&quot;,&quot;why&quot;:&quot;与音频评测维度完全重复（P1 级冲突），强制归口到音频·音质。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;音画不同步&quot;,&quot;act&quot;:&quot;移出&quot;,&quot;why&quot;:&quot;强制归口到音频评测维度·音画同步。&quot;,&quot;gone&quot;:true,&quot;demoKey&quot;:&quot;音画不同步&quot;},{&quot;n&quot;:&quot;音画不匹配&quot;,&quot;act&quot;:&quot;移出&quot;,&quot;why&quot;:&quot;强制归口到音频评测维度·音画同步。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;风格适配性&quot;,&quot;act&quot;:&quot;移出&quot;,&quot;why&quot;:&quot;音频类标签全部迁移至音频评测维度。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;情绪准确性&quot;,&quot;act&quot;:&quot;移出&quot;,&quot;why&quot;:&quot;音频类标签全部迁移至音频评测维度。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;节奏配合度&quot;,&quot;act&quot;:&quot;移出&quot;,&quot;why&quot;:&quot;音频类标签全部迁移至音频评测维度。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;声音丰富与融合自然度&quot;,&quot;act&quot;:&quot;移出&quot;,&quot;why&quot;:&quot;音频类标签全部迁移至音频评测维度。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;声音切换自然流畅&quot;,&quot;act&quot;:&quot;移出&quot;,&quot;why&quot;:&quot;音频类标签全部迁移至音频评测维度。&quot;,&quot;gone&quot;:true}]},{&quot;name&quot;:&quot;动态幅度（对比专用）&quot;,&quot;rules&quot;:[],&quot;tags&quot;:[{&quot;n&quot;:&quot;动态幅度更大&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;note&quot;:&quot;仅双模型对比场景&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;双模型对比专用：客观标注哪一个动得更猛。&quot;,&quot;symptoms&quot;:[&quot;主体运动范围更广&quot;,&quot;位移距离更远&quot;,&quot;动作激烈程度更高&quot;],&quot;requires&quot;:&quot;仅在 A/B 双视频对比场景使用；不涉及好坏，只量长短&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需禁用&quot;,&quot;r&quot;:&quot;单视频评测场景不得使用本标签&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体完全僵死不动 → `异常静止`（那是缺陷，本标签不是）&quot;}]}]}]},{&quot;name&quot;:&quot;画面质量&quot;,&quot;rules&quot;:[],&quot;subs&quot;:[{&quot;name&quot;:&quot;基础画质&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;类似编解码画质现象仅限块状噪点/蚊式噪声&quot;,&quot;for&quot;:[&quot;类似编解码画质现象&quot;]}],&quot;tags&quot;:[{&quot;n&quot;:&quot;清晰度低&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;画面整体模糊、缺乏细节纹理，锐度不足。&quot;,&quot;symptoms&quot;:[&quot;头发丝糊成一片&quot;,&quot;远景一片浆糊&quot;,&quot;肉感明显&quot;],&quot;requires&quot;:&quot;成因是分辨率不足或对焦不实导致的整体锐度缺失&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;块状 / 蚊式压缩伪影 → `类似编解码画质现象`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅焦平面位置错误而非整体失锐 → `景深与焦点问题`&quot;}]},{&quot;n&quot;:&quot;类似编解码画质现象&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;画面出现视频压缩伪影。&quot;,&quot;symptoms&quot;:[&quot;色块（马赛克）&quot;,&quot;蚊式噪点（边缘蠕动）&quot;,&quot;拖影模糊&quot;],&quot;requires&quot;:&quot;成因是高压缩率 / 低码率，呈「网络流媒体低清感」&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;仅限压缩伪影（块状噪点 / 蚊式噪声）；生成渲染错误（平铺 / 塑料感）→ `纹理虚假`&quot;},{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;仅限压缩伪影；纹理像平铺 / 塑料感 → `纹理虚假`；整体失锐 → `清晰度低`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;色彩污染发生在帧之间 → 动态质量 `帧间颜色染色`&quot;},{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;非预期的脏点 / 孤立像素块而非压缩伪影 → `画面杂质`&quot;}]}]},{&quot;name&quot;:&quot;画面基础内容&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;画面文字不可读管视觉扭曲模糊，指令遵循·文字生成错误管拼写/语言正误&quot;,&quot;for&quot;:[&quot;画面文字不可读&quot;]},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;纹理虚假仅限静态单帧渲染错误（平铺/塑料），与类似编解码画质现象互斥&quot;,&quot;for&quot;:[&quot;纹理虚假&quot;]},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;曝光光影或色彩异常仅限单帧整体偏色/过曝；帧间亮度或色调跳动 → 动态·明暗闪烁 / 光影风格时序不一致&quot;,&quot;for&quot;:[&quot;曝光光影或色彩异常&quot;]},{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;构图不符 Prompt → 指令遵循·景别与拍摄视角错误；Prompt 无要求且裁切怪异 → 异常构图&quot;,&quot;for&quot;:[&quot;异常构图&quot;]},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;景深与焦点问题仅限光学虚化错误；运动导致的边缘撕裂归动态质量&quot;,&quot;for&quot;:[&quot;景深与焦点问题&quot;]}],&quot;tags&quot;:[{&quot;n&quot;:&quot;曝光光影或色彩异常&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;曝光过度 / 不足，或白平衡严重偏移。&quot;,&quot;symptoms&quot;:[&quot;整体或局部过曝死白&quot;,&quot;欠曝死黑&quot;,&quot;整体偏绿偏紫偏黄&quot;,&quot;与 Prompt 光照设定相悖&quot;],&quot;requires&quot;:&quot;单帧静止即可复现&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅限单帧或静态画面整体偏色 / 过曝；帧间亮度 / 色调跳动 → 动态质量 `明暗闪烁` 或 `光影风格时序不一致`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;亮度在帧间忽明忽暗 → 动态质量 `明暗闪烁`；色调随时间漂移 → 动态质量 `光影风格时序不一致`；帧间色彩污染 → 动态质量 `帧间颜色染色`&quot;}],&quot;demoKey&quot;:&quot;曝光光影或色彩异常&quot;},{&quot;n&quot;:&quot;油腻感&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;表面过度平滑、反光异常，呈塑料蜡像感。&quot;,&quot;symptoms&quot;:[&quot;皮肤缺乏毛孔肌理&quot;,&quot;过度磨皮滤镜感&quot;,&quot;物体表面反光油腻&quot;],&quot;requires&quot;:&quot;AI 生成的典型通病，单帧即可判定&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;纹理像人工绘制或重复平铺 → `纹理虚假`；材质物理属性表现不佳（金属无金属感）不在本体系内&quot;}]},{&quot;n&quot;:&quot;异常构图&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;主体裁切位置违背基本摄影构图法则。&quot;,&quot;symptoms&quot;:[&quot;头部被切掉一半&quot;,&quot;地平线严重歪斜&quot;,&quot;主体被挤到角落&quot;],&quot;requires&quot;:&quot;Prompt 未提出构图要求，纯粹是画面裁切失当&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;构图不符 Prompt → 指令遵循 `景别与拍摄视角错误`；Prompt 无要求且裁切怪异 → 本标签&quot;}]},{&quot;n&quot;:&quot;画面杂质&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;画面存在非预期的脏点、噪点或孤立像素块。&quot;,&quot;symptoms&quot;:[&quot;随机脏点坏点&quot;,&quot;闪烁噪点&quot;,&quot;背景中来历不明的孤立像素块&quot;],&quot;requires&quot;:&quot;杂质与画面内容无关，不是主体本身的缺陷&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;呈块状 / 蚊式压缩伪影 → `类似编解码画质现象`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;噪点在帧间闪动为主 → 动态质量 `细节纹理抖动`&quot;}]},{&quot;n&quot;:&quot;主体边缘异常&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;主体与背景交界处出现抠图未净的瑕疵。&quot;,&quot;symptoms&quot;:[&quot;半透明光晕&quot;,&quot;毛边锯齿&quot;,&quot;闪烁虚影&quot;,&quot;边缘生硬融不进背景&quot;],&quot;requires&quot;:&quot;静态合成瑕疵，静止单帧即可复现&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅限静态合成边缘瑕疵（抠图感 / 光晕）；运动导致的形变 → 动态质量 `生物结构异常` / `非生物结构异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;运动导致的形变 → 动态质量 `生物结构异常` / `非生物结构异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;边缘虚化源于焦平面错误 → `景深与焦点问题`&quot;}]},{&quot;n&quot;:&quot;景深与焦点问题&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;焦平面位置错误或景深虚化不符光学规律。&quot;,&quot;symptoms&quot;:[&quot;近处主体虚化而远景清晰&quot;,&quot;虚化过渡生硬&quot;,&quot;光斑形状怪异&quot;],&quot;requires&quot;:&quot;判定对象是焦点与景深的光学正确性&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅限光学虚化错误；运动导致的边缘撕裂 / 锯齿 → 动态质量&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;整体失锐而非焦平面错位 → `清晰度低`；边缘瑕疵源于合成抠图 → `主体边缘异常`&quot;}]},{&quot;n&quot;:&quot;纹理虚假&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P2&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;表面纹理像人工绘制或重复平铺，缺乏自然随机性。&quot;,&quot;symptoms&quot;:[&quot;木纹布料编织纹重复平铺（Tiling）&quot;,&quot;皮肤毛孔像贴图&quot;,&quot;纹理缺乏随机性&quot;],&quot;requires&quot;:&quot;单帧静止即可复现的渲染错误&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅限静态单帧渲染错误（平铺 / 塑料感），与 `类似编解码画质现象` 互斥；帧间位移 / 闪烁 → 动态质量 `细节纹理抖动`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;纹理在帧间位移 / 闪烁 → 动态质量 `细节纹理抖动`&quot;},{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;呈块状 / 蚊式压缩伪影 → `类似编解码画质现象`&quot;}]},{&quot;n&quot;:&quot;画面文字不可读&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;文字不可读&quot;,&quot;why&quot;:&quot;加「画面」前缀标明是视觉层，与指令遵循的语义层文字问题区隔。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;画面中的文字扭曲变形、笔画粘连，无法辨认。&quot;,&quot;symptoms&quot;:[&quot;招牌书本衣物上的字母汉字扭曲&quot;,&quot;拼写残缺&quot;,&quot;笔画粘连&quot;],&quot;requires&quot;:&quot;视觉层面的不可读——看不清&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签管视觉扭曲 / 模糊；拼写 / 语言正误 → 指令遵循 `文字生成错误`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;能看清但拼写 / 语言错误 → 指令遵循 `文字生成错误`（语义层）&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;首帧可读、动起来才坏掉 → 动态质量 `文字未保持`&quot;}],&quot;demoKey&quot;:&quot;文字不可读&quot;}]},{&quot;name&quot;:&quot;画面美学&quot;,&quot;subj&quot;:true,&quot;rules&quot;:[],&quot;tags&quot;:[{&quot;n&quot;:&quot;材质质感较差&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;主观性过强、无客观锚点，方差过大，整节不纳入体系。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;空间层次与构图布局欠佳&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;同上，整节删除。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;色彩搭配与光影表现欠佳&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;同上，整节删除。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;环境布景欠佳&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;同上，整节删除。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;主体美感不足(服化)&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;同上，整节删除。&quot;,&quot;gone&quot;:true}]}]},{&quot;name&quot;:&quot;指令遵循&quot;,&quot;rules&quot;:[],&quot;subs&quot;:[{&quot;name&quot;:&quot;基础内容指令遵循&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;主宾语被交换 → 响应混淆与指代错误；仅距离/角度/左右数值错 → 空间关系与方向错误&quot;,&quot;for&quot;:[&quot;响应混淆与指代错误&quot;,&quot;空间关系与方向错误&quot;]},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;动作 / 运镜时序顺序错误判各自分步顺序，动作与运镜时序错位判两者同步性；先后颠倒一律归前者&quot;,&quot;for&quot;:[&quot;动作时序顺序错误&quot;,&quot;运镜时序顺序错误&quot;,&quot;动作与运镜时序错位&quot;]},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;动作速度不符限主体关节运动速率，运镜速度不符限镜头移动速率，播放速度不符限全局帧率抽帧 / 插帧&quot;,&quot;for&quot;:[&quot;动作速度不符&quot;,&quot;运镜速度不符&quot;,&quot;播放速度不符&quot;]},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;文字生成错误管拼写/语言正误，画面质量·画面文字不可读管扭曲模糊&quot;,&quot;for&quot;:[&quot;文字生成错误&quot;]},{&quot;kind&quot;:&quot;需降级&quot;,&quot;r&quot;:&quot;复杂文本理解错误仅当 Prompt 无法拆解为具体标签且模型整体跑偏时启用&quot;,&quot;for&quot;:[&quot;复杂文本理解错误&quot;]}],&quot;tags&quot;:[{&quot;n&quot;:&quot;动作缺失&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;动作文本响应（+动作）&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签——产品对 6 个 facet 逐条给了不同优先级，facet 承载不了。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;Prompt 指定的动作没有被触发。&quot;,&quot;symptoms&quot;:[&quot;要求「跳跃」但主体始终没跳&quot;,&quot;指定动作完全未出现&quot;],&quot;requires&quot;:&quot;动作整体未发生&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;动作发生了但细节不到位 → `动作细节不足`；多步动作只漏其中一步 → `动作时序遗漏`&quot;}]},{&quot;n&quot;:&quot;动作细节不足&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;动作文本响应（+动作细节）&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签——产品对 6 个 facet 逐条给了不同优先级，facet 承载不了。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;动作被触发了，但幅度、轨迹或肢体协调性不细腻。&quot;,&quot;symptoms&quot;:[&quot;「挥手」但手指不摆动&quot;,&quot;动作幅度不足&quot;,&quot;肢体协调性粗糙&quot;],&quot;requires&quot;:&quot;动作已发生，问题只在完成质量&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;动作整体未发生 → `动作缺失`；动作发生但细节不到位 → 本标签&quot;},{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;动作整体未发生 → `动作缺失`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;动作不像真人 / 真物的自然感问题 → 动态质量 `运动不真实`&quot;}]},{&quot;n&quot;:&quot;表情不符&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;动作文本响应（+表情）&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签——产品对 6 个 facet 逐条给了不同优先级，facet 承载不了。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;人物 / 动物的面部情绪不符 Prompt 指定。&quot;,&quot;symptoms&quot;:[&quot;要求「悲伤地哭泣」但面无表情&quot;,&quot;情绪与指令相反&quot;],&quot;requires&quot;:&quot;Prompt 明确指定了情绪&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;Prompt 未指定情绪、纯粹表演不到位 → 动态质量 `表演不真实`&quot;}]},{&quot;n&quot;:&quot;动作时序遗漏&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;动作文本响应（+时序遗漏）&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签——产品对 6 个 facet 逐条给了不同优先级，facet 承载不了。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;多步动作中漏掉了某一步。&quot;,&quot;symptoms&quot;:[&quot;「坐下→躺下」只生成了坐下&quot;,&quot;多步动作缺环&quot;],&quot;requires&quot;:&quot;Prompt 描述了多个连续动作步骤&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;各步都在但先后颠倒 → `动作时序顺序错误`&quot;}]},{&quot;n&quot;:&quot;动作时序顺序错误&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;动作文本响应（+时序顺序错误）&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签——产品对 6 个 facet 逐条给了不同优先级，facet 承载不了。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;动作发生的先后顺序颠倒。&quot;,&quot;symptoms&quot;:[&quot;要求「先蹲下再起跳」实际先跳后蹲&quot;,&quot;多步动作顺序错乱&quot;],&quot;requires&quot;:&quot;各步动作都在，只是顺序错了；判定对象是动作自身的分步顺序&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quo