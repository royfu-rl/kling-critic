序；动作与镜头是否同时间戳对齐 → `动作与运镜时序错位`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;动作与镜头变化是否在同一时间戳对齐 → `动作与运镜时序错位`；先后顺序颠倒一律归本标签&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;缺步而非乱序 → `动作时序遗漏`&quot;}]},{&quot;n&quot;:&quot;动作速度不符&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;动作文本响应（+速度）&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签——产品对 6 个 facet 逐条给了不同优先级，facet 承载不了。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;主体动作的快慢不符 Prompt 描述。&quot;,&quot;symptoms&quot;:[&quot;要求「缓慢地挥手」实际正常速度&quot;,&quot;动作节奏与指令不符&quot;],&quot;requires&quot;:&quot;判定对象仅限主体关节运动速率&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅限主体关节运动速率；全局帧率抽帧 / 插帧 → `播放速度不符`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;全局帧率抽帧 / 插帧效果 → `播放速度不符`；镜头移动速率 → `运镜速度不符`；速度违反物理规律 → 动态质量 `速度异常`&quot;}]},{&quot;n&quot;:&quot;动作未响应&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签——产品对 6 个 facet 逐条给了不同优先级，facet 承载不了。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;运镜类型错误&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;运镜文本响应（+类型）&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签，与 `动作未响应` 同步拆平。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;未实现 Prompt 指定的运镜方式。&quot;,&quot;symptoms&quot;:[&quot;要求「推」实际「摇」&quot;,&quot;要求环绕实际固定&quot;,&quot;要求跟拍实际未跟&quot;],&quot;requires&quot;:&quot;Prompt 明确指定了推 / 拉 / 摇 / 移 / 跟 / 环绕等类型&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;Prompt 未要求晃动但画面抖动 → 动态质量 `镜头晃动`&quot;}]},{&quot;n&quot;:&quot;运镜速度不符&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;运镜文本响应（+速度）&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签，与 `动作未响应` 同步拆平。&quot;,&quot;prio&quot;:&quot;P2&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;镜头移动的快慢不匹配 Prompt。&quot;,&quot;symptoms&quot;:[&quot;要求缓慢推近实际急推&quot;,&quot;镜头移动速率与指令不符&quot;],&quot;requires&quot;:&quot;运镜类型正确，仅速度不符；判定对象仅限镜头移动速率&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅限镜头移动速率；全局帧率抽帧 / 插帧 → `播放速度不符`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体关节运动速率 → `动作速度不符`；全局帧率效果 → `播放速度不符`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;Prompt 未指定速度、纯粹与情绪不搭 → 动态质量 `运镜节奏较差`&quot;}]},{&quot;n&quot;:&quot;运镜时序遗漏&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;运镜文本响应（+时序遗漏）&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签，与 `动作未响应` 同步拆平。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;多段运镜中漏掉了某一段。&quot;,&quot;symptoms&quot;:[&quot;要求「先推近再环绕」只做了推近&quot;,&quot;多段运镜缺环&quot;],&quot;requires&quot;:&quot;Prompt 描述了多段连续运镜&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;各段都在但先后颠倒 → `运镜时序顺序错误`&quot;}]},{&quot;n&quot;:&quot;运镜时序顺序错误&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;运镜文本响应（+时序顺序错误）&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签，与 `动作未响应` 同步拆平。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;多段运镜的先后顺序颠倒。&quot;,&quot;symptoms&quot;:[&quot;要求「先摇后推」实际先推后摇&quot;,&quot;多段运镜顺序错乱&quot;],&quot;requires&quot;:&quot;各段运镜都在，只是顺序错了；判定对象是运镜自身的分段顺序&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;判多段运镜自身先后顺序；与动作的时间戳对齐 → `动作与运镜时序错位`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;运镜与动作是否同时间戳对齐 → `动作与运镜时序错位`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;缺段而非乱序 → `运镜时序遗漏`&quot;}]},{&quot;n&quot;:&quot;景别与拍摄视角错误&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;from&quot;:&quot;运镜文本响应（+景别与拍摄视角）&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签，与 `动作未响应` 同步拆平。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;未准确呈现 Prompt 指定的景别或拍摄视角。&quot;,&quot;symptoms&quot;:[&quot;要求特写实际全景&quot;,&quot;要求俯视实际平视&quot;,&quot;第一人称视角未实现&quot;],&quot;requires&quot;:&quot;Prompt 明确指定了景别或视角&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;Prompt 无构图要求、纯粹裁切怪异 → 画面质量 `异常构图`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;Prompt 未指定、纯粹艺术选择欠佳 → 动态质量 `景别视角不当`&quot;}]},{&quot;n&quot;:&quot;运镜未响应&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签，与 `动作未响应` 同步拆平。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;动作与运镜时序错位&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;动作与运镜时序&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;动作发生点与镜头变化点没有在同一时间戳对齐。&quot;,&quot;symptoms&quot;:[&quot;要求「人物转身时镜头同时拉远」实际转身后镜头才动&quot;,&quot;动作与运镜不同步&quot;],&quot;requires&quot;:&quot;动作和运镜都实现了、顺序也对，问题只在两者的时间戳对齐&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;本标签判同步性（动作发生点与镜头变化点是否在同一时间戳对齐）；先后顺序颠倒一律归 `动作时序顺序错误` / `运镜时序顺序错误`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;判同步性；先后顺序颠倒一律归 `动作时序顺序错误` / `运镜时序顺序错误`&quot;}]},{&quot;n&quot;:&quot;播放速度不符&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;播放速度响应&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P2&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;整体视频的播放速率不符 Prompt。&quot;,&quot;symptoms&quot;:[&quot;要求慢动作实际正常速率&quot;,&quot;要求延时摄影实际正常&quot;,&quot;全局帧率抽帧 / 插帧效果错误&quot;],&quot;requires&quot;:&quot;判定对象是全局帧率效果，不是主体动作速率&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅限全局帧率抽帧 / 插帧效果；主体关节运动速率 → `动作速度不符`；镜头移动速率 → `运镜速度不符`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体关节运动速率 → `动作速度不符`；镜头移动速率 → `运镜速度不符`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;速度符合物理但违反 Prompt → 本标签；速度违反物理规律 → 动态质量 `速度异常`&quot;}]},{&quot;n&quot;:&quot;响应混淆与指代错误&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;主宾语颠倒或指代关系错误的严重语义失误。&quot;,&quot;symptoms&quot;:[&quot;「苹果在碗里」生成「碗在苹果里」&quot;,&quot;「男人追女人」生成「女人追男人」&quot;],&quot;requires&quot;:&quot;参考系被错误解析——主语 / 宾语发生了交换&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;主宾语被交换 → 本标签；正确识别主宾语但方位 / 距离 / 角度数值错 → `空间关系与方向错误`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;正确识别主宾语但方位数值错 → `空间关系与方向错误`；交换了主宾语 → 本标签&quot;}]},{&quot;n&quot;:&quot;主体未响应&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;主体文本响应&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;主要角色 / 物体的外观、数量或属性不符 Prompt。&quot;,&quot;symptoms&quot;:[&quot;数量不对（要三只猫给两只）&quot;,&quot;颜色材质错误&quot;,&quot;外观特征不符&quot;],&quot;requires&quot;:&quot;Prompt 明确描述了主体的外观 / 数量 / 属性&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体正确但环境背景不符 → `环境未响应`；主体正确但风格跑偏 → `风格错误`&quot;}],&quot;demoKey&quot;:&quot;主体未响应&quot;},{&quot;n&quot;:&quot;文字生成错误&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;文字生成响应&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;画面文字的拼写或语言不正确。&quot;,&quot;symptoms&quot;:[&quot;英文单词拼错&quot;,&quot;要求中文却生成英文&quot;,&quot;文字内容与 Prompt 不符&quot;],&quot;requires&quot;:&quot;文字能看清，问题在语义层——拼写 / 语言对不对&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签管语义层（拼写 / 语言正误）；视觉层扭曲模糊 → 画面质量 `画面文字不可读`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;文字扭曲模糊到看不清 → 画面质量 `画面文字不可读`（视觉层）&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;首帧可读、动起来坏掉 → 动态质量 `文字未保持`&quot;}]},{&quot;n&quot;:&quot;否定词未响应&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;否定词响应&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;模型忽视了 Prompt 中的否定表述。&quot;,&quot;symptoms&quot;:[&quot;「不要有树木」仍生成树木&quot;,&quot;忽视「没有」「除了」等否定词&quot;],&quot;requires&quot;:&quot;Prompt 含明确的否定约束&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;并非否定约束、只是主体属性错 → `主体未响应`&quot;}]},{&quot;n&quot;:&quot;环境未响应&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;环境文本响应&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;背景环境不符 Prompt 设定。&quot;,&quot;symptoms&quot;:[&quot;天气不符（要雨天给晴天）&quot;,&quot;地形错误&quot;,&quot;室内外装饰不符&quot;,&quot;时间点错误（要黄昏给正午）&quot;],&quot;requires&quot;:&quot;Prompt 明确描述了环境要素&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体本身不符 → `主体未响应`；整体美学风格跑偏 → `风格错误`&quot;}]},{&quot;n&quot;:&quot;风格错误&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;视觉美学风格跑偏，不符 Prompt 指定。&quot;,&quot;symptoms&quot;:[&quot;要求赛博朋克生成写实摄影&quot;,&quot;要求水墨风生成 3D 渲染&quot;,&quot;风格与指令不符&quot;],&quot;requires&quot;:&quot;Prompt 明确指定了风格&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签管整体风格是否符合指令；镜头间风格突变 → 一致性 `风格不一致`。两者允许共存&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;多镜头之间风格突变（各镜头风格都对但互不一致）→ 一致性 `风格不一致`；两者可同时打&quot;}]},{&quot;n&quot;:&quot;空间关系与方向错误&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;物体相对位置或运动方向出错。&quot;,&quot;symptoms&quot;:[&quot;左右前后上下关系颠倒&quot;,&quot;要求向左走实际向右&quot;,&quot;方向指令未遵循&quot;],&quot;requires&quot;:&quot;主宾语识别正确，仅方位数值 / 方向错误&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;仅距离 / 角度 / 左右数值错 → 本标签；主宾语被交换 → `响应混淆与指代错误`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;交换了主语 / 宾语 → `响应混淆与指代错误`；正确识别主宾语但方位错 → 本标签&quot;}]},{&quot;n&quot;:&quot;复杂文本理解错误&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;复杂文字理解&quot;,&quot;why&quot;:&quot;陈述式改缺陷式，并降级为兜底标签。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;兜底标签：复杂 Prompt 整体跑偏且无法拆解到具体标签。&quot;,&quot;symptoms&quot;:[&quot;多重逻辑长从句整体未理解&quot;,&quot;抽象比喻完全落空&quot;],&quot;requires&quot;:&quot;仅当 Prompt 无法拆解为具体标签、且模型整体跑偏时启用&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需降级&quot;,&quot;r&quot;:&quot;仅当 Prompt 无法拆解为具体标签、且模型整体跑偏时启用，不作为常规兜底&quot;},{&quot;kind&quot;:&quot;需降级&quot;,&quot;r&quot;:&quot;能归入任何具体标签时一律不打本标签，不作为常规兜底&quot;}]}]},{&quot;name&quot;:&quot;多镜头指令遵循&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;镜头混乱仅限单镜头内无意义突变；镜头时序问题 / 镜头间内容混淆 / 切镜时间点错误仅限镜头间衔接。四者禁止同时打标&quot;,&quot;for&quot;:[&quot;镜头混乱&quot;,&quot;镜头时序问题&quot;,&quot;镜头间内容混淆&quot;,&quot;切镜时间点错误&quot;]}],&quot;tags&quot;:[{&quot;n&quot;:&quot;shot数量遗漏&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;实际生成的镜头数少于 Prompt 要求。&quot;,&quot;symptoms&quot;:[&quot;要求 3 个镜头只生成 2 个&quot;,&quot;镜头数量不足&quot;],&quot;requires&quot;:&quot;Prompt 明确要求了镜头数量&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;完全没有切镜、一镜到底 → `无切镜`；多生成了镜头 → `shot数量新增`&quot;}]},{&quot;n&quot;:&quot;shot数量新增&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;模型多生成了 Prompt 未要求的镜头。&quot;,&quot;symptoms&quot;:[&quot;未要求多镜头却切了镜&quot;,&quot;超出指定数量&quot;],&quot;requires&quot;:&quot;Prompt 未要求或指定了更少的镜头数&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;镜头数不足 → `shot数量遗漏`&quot;}]},{&quot;n&quot;:&quot;无切镜&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;Prompt 要求多镜头叙事，实际输出一镜到底。&quot;,&quot;symptoms&quot;:[&quot;要求多镜头但全程单镜头&quot;,&quot;完全没有镜头切换&quot;],&quot;requires&quot;:&quot;一次切镜都没有发生&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;有切镜但数量不足 → `shot数量遗漏`&quot;}]},{&quot;n&quot;:&quot;切镜时间点错误&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P2&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;镜头切换的时间点过早或过晚。&quot;,&quot;symptoms&quot;:[&quot;要求「3 秒后切换」实际 1 秒就切&quot;,&quot;切换时机未对齐 Prompt&quot;],&quot;requires&quot;:&quot;Prompt 指定了切镜时间点&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;仅限镜头与镜头之间的接续问题，不与 `镜头混乱` 同时打标&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;镜头停留时长与信息量不匹配但 Prompt 未指定时间点 → 动态质量 `剪辑节奏较差`&quot;},{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;本标签管镜头之间的接续时机；单镜头内无意义突变 → `镜头混乱`&quot;}]},{&quot;n&quot;:&quot;镜头时序问题&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;多个镜头的叙事顺序混乱。&quot;,&quot;symptoms&quot;:[&quot;先发生的事放在了后面的镜头里&quot;,&quot;镜头顺序与剧本顺序不符&quot;],&quot;requires&quot;:&quot;各镜头内容都对，只是排列顺序错了&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;仅限镜头与镜头之间的接续问题，不与 `镜头混乱` 同时打标&quot;},{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;本标签管镜头之间的顺序；单镜头内无意义突变 → `镜头混乱`。两者互斥&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;A 镜头的主体错误出现在 B → `镜头间内容混淆`&quot;}]},{&quot;n&quot;:&quot;转场方式错误&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;转场手法不符 Prompt 指定。&quot;,&quot;symptoms&quot;:[&quot;要求淡入淡出生成硬切&quot;,&quot;要求瞬间切换生成缓慢溶解&quot;],&quot;requires&quot;:&quot;Prompt 明确指定了转场方式&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;单镜头内主体无理由突变 → 动态质量 `转场异变`&quot;}]},{&quot;n&quot;:&quot;镜头间内容混淆&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;镜头 A 的主体 / 道具错误地出现在镜头 B 中。&quot;,&quot;symptoms&quot;:[&quot;跳轴&quot;,&quot;道具穿帮&quot;,&quot;前一镜的主体串到后一镜&quot;],&quot;requires&quot;:&quot;判定对象是镜头之间的内容串台&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;仅限镜头与镜头之间的接续问题，不与 `镜头混乱` 同时打标&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;变化由切镜导致且属穿帮 → 本标签；单镜头内无理由突现 → 动态质量 `转场异变`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;变化发生在单镜头内且无理由突现 → 动态质量 `转场异变`&quot;},{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;本标签管镜头之间；单镜头内无意义突变 → `镜头混乱`&quot;}]},{&quot;n&quot;:&quot;尾镜叙事缺失&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P2&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;最后一个镜头没有完成 Prompt 要求的收尾。&quot;,&quot;symptoms&quot;:[&quot;结局动作未出现&quot;,&quot;叙事戛然而止&quot;,&quot;尾镜提前结束&quot;],&quot;requires&quot;:&quot;仅限最后一个镜头的收尾问题&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;整段事件逻辑断裂而非仅尾镜 → 动态质量 `叙事混乱与不完整`&quot;}]},{&quot;n&quot;:&quot;镜头混乱&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;单镜头内出现无意义突变，整体无法理解。&quot;,&quot;symptoms&quot;:[&quot;镜头之间毫无逻辑关联&quot;,&quot;跳跃性过大无法理解剧情&quot;],&quot;requires&quot;:&quot;仅用于单镜头内的无意义突变&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;仅限单镜头内无意义突变；镜头间衔接问题 → `镜头时序问题` / `镜头间内容混淆` / `切镜时间点错误`。四者禁止同时打标&quot;},{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;与 `镜头时序问题` / `镜头间内容混淆` / `切镜时间点错误` 四者互斥，禁止同时打标——那三个管镜头与镜头之间的接续&quot;}]}]},{&quot;name&quot;:&quot;音频指令遵循&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本子维度管「有无/类型匹配」，音频评测维度管「质量好不好」，两者互不替代、允许共存&quot;}],&quot;tags&quot;:[{&quot;n&quot;:&quot;通用指令未遵循&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;通用指令&quot;,&quot;why&quot;:&quot;原标签是检查对象而非缺陷，统一加「未遵循」后缀。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;整体音频氛围、音量或有无声音不符 Prompt。&quot;,&quot;symptoms&quot;:[&quot;要求有声音实际静音&quot;,&quot;整体氛围与指令不符&quot;,&quot;音量大小要求未遵循&quot;],&quot;requires&quot;:&quot;判定对象是「有没有按指令生成」，不是音质好坏&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本子维度管有无 / 类型匹配；声音质量好坏 → 音频评测维度。两者互不替代、允许共存&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;声音存在且类型对、只是质量差 → 音频评测维度 `噪声感知` / `音量异常` / `音频失真（爆音/断音）`。两者互不替代，允许同时打&quot;}]},{&quot;n&quot;:&quot;语音指令未遵循&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;语音指令&quot;,&quot;why&quot;:&quot;同上。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;人声旁白 / 对话不符 Prompt 要求。&quot;,&quot;symptoms&quot;:[&quot;要求旁白实际无人声&quot;,&quot;语种错误&quot;,&quot;语速或情绪不符&quot;],&quot;requires&quot;:&quot;Prompt 明确要求了语音内容或属性；判定存在性与类型匹配&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本子维度管有无 / 类型匹配；声音质量好坏 → 音频评测维度。两者互不替代、允许共存&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;人声存在但音质差 → 音频评测维度对应标签；口型与声音不同步 → `口型不匹配`&quot;}]},{&quot;n&quot;:&quot;音效指令未遵循&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;音效指令&quot;,&quot;why&quot;:&quot;同上。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;环境音 / 拟音缺失或未在正确节点响起。&quot;,&quot;symptoms&quot;:[&quot;要求脚步声实际无&quot;,&quot;关门声未在关门瞬间响起&quot;,&quot;雨声爆炸声缺失&quot;],&quot;requires&quot;:&quot;Prompt 明确要求了音效；判定存在性与触发节点&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本子维度管有无 / 类型匹配；声音质量好坏 → 音频评测维度。两者互不替代、允许共存&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;音效存在但与画面动作时间点错位 → 音频评测维度 `音画不同步`&quot;}]},{&quot;n&quot;:&quot;音乐指令未遵循&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;音乐指令&quot;,&quot;why&quot;:&quot;同上。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;BGM 的流派、情绪或乐器不匹配 Prompt。&quot;,&quot;symptoms&quot;:[&quot;要求钢琴实际吉他&quot;,&quot;要求欢快实际低沉&quot;,&quot;流派不符&quot;],&quot;requires&quot;:&quot;Prompt 明确要求了音乐属性；判定类型匹配，与音质无关&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本子维度管有无 / 类型匹配；声音质量好坏 → 音频评测维度。两者互不替代、允许共存&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;即使音质极好，只要类型不符指令仍打本标签；音质问题另归音频评测维度&quot;}]}]}]},{&quot;name&quot;:&quot;一致性&quot;,&quot;rules&quot;:[],&quot;subs&quot;:[{&quot;name&quot;:&quot;输入图一致性（I2V）&quot;,&quot;rules&quot;:[],&quot;tags&quot;:[{&quot;n&quot;:&quot;首帧画风偏离&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;from&quot;:&quot;首帧画风明显偏离 + 首帧画风轻微偏离&quot;,&quot;why&quot;:&quot;明显/轻微作标签区隔导致阈值主观漂移，合并为单一缺陷标签，程度另记。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;生成首帧的画风偏离输入参考图。&quot;,&quot;symptoms&quot;:[&quot;输入写实图生成动漫感首帧&quot;,&quot;笔触质感与参考图不符&quot;],&quot;requires&quot;:&quot;I2V 场景；对照物是用户输入的参考图。程度轻重不再用标签区分，另记严重度分数&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;色调偏移为主 → `首帧色偏`；人物身份特征偏离 → `首帧ID偏离`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;风格不符 Prompt 文本描述 → 指令遵循 `风格错误`；镜头之间风格突变 → `风格不一致`&quot;}]},{&quot;n&quot;:&quot;首帧色偏&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;from&quot;:&quot;首帧明显色偏 + 首帧轻微色偏&quot;,&quot;why&quot;:&quot;同上。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;生成首帧的色调偏离输入参考图。&quot;,&quot;symptoms&quot;:[&quot;参考图暖调生成冷调&quot;,&quot;整体色温漂移&quot;,&quot;饱和度明显不符&quot;],&quot;requires&quot;:&quot;I2V 场景；对照物是输入参考图。程度轻重不再用标签区分，另记严重度分数&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;画风整体不符而非仅色调 → `首帧画风偏离`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;与参考图无关的过曝 / 白平衡问题 → 画面质量 `曝光光影或色彩异常`&quot;}]},{&quot;n&quot;:&quot;首帧ID偏离&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;首帧ID明显偏离&quot;,&quot;why&quot;:&quot;去掉程度副词，与其余两项对齐。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;生成首帧的人物身份特征偏离输入参考图。&quot;,&quot;symptoms&quot;:[&quot;脸型五官与参考图不同&quot;,&quot;发色发型改变&quot;,&quot;看起来换了个人&quot;],&quot;requires&quot;:&quot;I2V 场景；对照物是输入参考图的主体身份&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;首帧 ID 对但后续镜头漂移 → `主体不一致`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;偏离的是画风而非身份 → `首帧画风偏离`&quot;}]},{&quot;n&quot;:&quot;首帧画风明显偏离&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;why&quot;:&quot;并入「首帧画风偏离」。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;首帧画风轻微偏离&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;why&quot;:&quot;并入「首帧画风偏离」。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;首帧明显色偏&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;why&quot;:&quot;并入「首帧色偏」。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;首帧轻微色偏&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;why&quot;:&quot;并入「首帧色偏」。&quot;,&quot;gone&quot;:true}]},{&quot;name&quot;:&quot;多镜头间连贯性（逻辑层）&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;方位不连贯限左右前后朝向，空间位置不连贯限主体间相对坐标/距离，两者不合并&quot;,&quot;for&quot;:[&quot;方位不连贯&quot;,&quot;空间位置不连贯&quot;]},{&quot;kind&quot;:&quot;需禁用&quot;,&quot;r&quot;:&quot;若 Prompt 自身叙事碎片化，叙事不连贯禁用（不因剧本混乱惩罚模型）&quot;,&quot;for&quot;:[&quot;叙事不连贯&quot;]},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;动作或表演不连贯仅管跨镜头动作是否接得上；单镜头内「动作像不像真的」归动态质量&quot;,&quot;for&quot;:[&quot;动作或表演不连贯&quot;]}],&quot;tags&quot;:[{&quot;n&quot;:&quot;动作或表演不连贯&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;动作或表演连贯性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式，仅加否定词，语义不动。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;跨镜头的动作或表演衔接断裂。&quot;,&quot;symptoms&quot;:[&quot;前一镜跑步后一镜瞬移到终点&quot;,&quot;动作在切镜处跳跃&quot;,&quot;表演情绪在镜头间断层&quot;],&quot;requires&quot;:&quot;判定对象是镜头之间的动作衔接逻辑&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅管跨镜头主体动作是否接得上（镜头 A 到 B）；单镜头内动作像不像真的 → 动态质量 `运动不真实`&quot;},{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;瞬移等违反物理的现象若发生在单镜头内 → 动态质量 `不符合物理规律`；跨镜头衔接断裂 → 本标签&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;同一镜头内运动不平滑 → 动态质量 `卡顿掉帧感`&quot;}]},{&quot;n&quot;:&quot;方位不连贯&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;方位连贯性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;主体的朝向 / 方位在镜头之间发生无理由改变。&quot;,&quot;symptoms&quot;:[&quot;前一镜面朝左后一镜面朝右&quot;,&quot;朝向在切镜处翻转&quot;],&quot;requires&quot;:&quot;判定对象是主体自身的朝向；与其在场景中的坐标无关&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签仅限左右前后朝向；主体间相对坐标 / 距离 → `空间位置不连贯`。两者不合并&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体在场景中的相对坐标改变 → `空间位置不连贯`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;方向不符 Prompt 指定 → 指令遵循 `空间关系与方向错误`&quot;}]},{&quot;n&quot;:&quot;空间位置不连贯&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;空间位置连贯性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;主体在场景中的相对位置在镜头之间跳变。&quot;,&quot;symptoms&quot;:[&quot;前一镜在门口后一镜突然在窗边&quot;,&quot;主体间相对坐标改变&quot;],&quot;requires&quot;:&quot;判定对象是主体在场景内的位置关系；与主体自身朝向无关&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签仅限主体间相对坐标 / 距离；左右前后朝向 → `方位不连贯`。两者不合并&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体自身朝向改变 → `方位不连贯`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;位置跳变发生在单镜头内 → 动态质量 `动态时序不一致`&quot;}]},{&quot;n&quot;:&quot;叙事不连贯&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;叙事连贯性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;跨镜头的事件因果链断裂。&quot;,&quot;symptoms&quot;:[&quot;镜头之间事件无承接关系&quot;,&quot;因果逻辑跳跃&quot;],&quot;requires&quot;:&quot;Prompt 本身有连贯剧本时才判定&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需禁用&quot;,&quot;r&quot;:&quot;若 Prompt 自身叙事碎片化，本标签禁用——不因剧本混乱惩罚模型&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;Prompt 本身就是碎片化、无因果的剧本，模型如实生成不算缺陷，不打本标签&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;同时涉及事件不完整 / 无收束 → 动态质量 `叙事混乱与不完整`&quot;}]},{&quot;n&quot;:&quot;镜头连贯性&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;与指令遵循·镜头时序问题 / 镜头间内容混淆高度重叠，且与叙事不连贯强耦合。&quot;,&quot;gone&quot;:true}]},{&quot;name&quot;:&quot;多镜头间一致性（不变性）&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;风格不一致管镜头间是否突变，指令遵循·风格错误管整体风格是否符合指令，两者允许共存&quot;,&quot;for&quot;:[&quot;风格不一致&quot;]}],&quot;tags&quot;:[{&quot;n&quot;:&quot;场景不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;场景一致性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式，仅加否定词，不合并、不改语义。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;同一场景在不同镜头间发生无理由改变。&quot;,&quot;symptoms&quot;:[&quot;同一房间的家具布局变了&quot;,&quot;场景陈设在镜头间改变&quot;,&quot;地点特征不一致&quot;],&quot;requires&quot;:&quot;Prompt 未要求场景变化&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;环境不符 Prompt 设定 → 指令遵循 `环境未响应`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体身份改变 → `主体不一致`&quot;}]},{&quot;n&quot;:&quot;主体不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;主体一致性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;同一主体的身份特征在镜头间漂移。&quot;,&quot;symptoms&quot;:[&quot;切镜后换脸&quot;,&quot;发色服装改变&quot;,&quot;同一角色看起来是两个人&quot;],&quot;requires&quot;:&quot;跨镜头判定；对照物是该主体在前序镜头中的样子&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;首帧就偏离输入参考图 → `首帧ID偏离`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体属性不符 Prompt → 指令遵循 `主体未响应`；单镜头内主体突变 → 动态质量 `转场异变`&quot;}],&quot;demoKey&quot;:&quot;主体一致性&quot;},{&quot;n&quot;:&quot;颜色不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;颜色一致性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;画面整体色调在镜头之间跳变。&quot;,&quot;symptoms&quot;:[&quot;镜头 A 暖调镜头 B 冷调&quot;,&quot;同一物体颜色在镜头间改变&quot;],&quot;requires&quot;:&quot;Prompt 未要求色调变化&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;色调在单镜头内随时间漂移 → 动态质量 `光影风格时序不一致`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;单帧的白平衡 / 过曝问题 → 画面质量 `曝光光影或色彩异常`&quot;}]},{&quot;n&quot;:&quot;风格不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;风格一致性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;画面美学风格在镜头之间突变。&quot;,&quot;symptoms&quot;:[&quot;镜头 A 水墨风镜头 B 赛博朋克&quot;,&quot;风格在切镜处改变&quot;],&quot;requires&quot;:&quot;各镜头自身风格可能都对，问题在互不一致&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签管镜头间是否突变；整体风格是否符合指令 → 指令遵循 `风格错误`。两者允许共存&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;所有镜头风格一致但都不符 Prompt → 指令遵循 `风格错误`。两者可同时打&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;风格在单镜头内逐渐漂移 → 动态质量 `光影风格时序不一致`&quot;}]},{&quot;n&quot;:&quot;音乐音效不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;音乐音效一致连贯性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;音乐或音效在镜头 / 场景切换时突变。&quot;,&quot;symptoms&quot;:[&quot;BGM 在切镜处突然换曲&quot;,&quot;音效音色突变&quot;,&quot;从室内切室外混响突然消失&quot;],&quot;requires&quot;:&quot;判定对象是音乐 / 音效的跨镜头连贯性&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;音乐类型不符 Prompt → 指令遵循 `音乐指令未遵循`；音质本身有缺陷 → 音频评测维度对应标签&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;人声的连贯性问题 → `人声不一致`&quot;}]},{&quot;n&quot;:&quot;人声不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;人声一致连贯性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;同一角色的音色在镜头之间改变。&quot;,&quot;symptoms&quot;:[&quot;同一角色前后音色不同&quot;,&quot;像换了配音演员&quot;,&quot;语调特征在镜头间跳变&quot;],&quot;requires&quot;:&quot;判定对象是人声音色的跨镜头一致性&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;语音不符 Prompt 要求 → 指令遵循 `语音指令未遵循`；人声与口型不同步 → `口型不匹配`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;音乐音效的连贯性问题 → `音乐音效不一致`&quot;}]}]}]},{&quot;name&quot;:&quot;音频评测维度&quot;,&quot;rules&quot;:[],&quot;subs&quot;:[{&quot;name&quot;:&quot;音质（底层物理）&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;凡音频类物理缺陷仅归此维度；动态维度的音频基础质量差已移出并归入此处&quot;}],&quot;tags&quot;:[{&quot;n&quot;:&quot;噪声感知&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;音频存在可察觉的底噪。&quot;,&quot;symptoms&quot;:[&quot;持续的嘶嘶底噪&quot;,&quot;电流声&quot;,&quot;环境噪声本底过高&quot;],&quot;requires&quot;:&quot;判定对象是音频的物理质量，与内容是否符合指令无关&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;凡音频类物理缺陷仅归本子维度，不与视觉失真（`波动扭曲` / `明暗闪烁`）混打&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;声音类型 / 有无不符 Prompt → 指令遵循 `通用指令未遵循`。两者互不替代，允许同时打&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;爆音 / 断音 → `音频失真（爆音/断音）`；音量整体过大过小 → `音量异常`&quot;}]},{&quot;n&quot;:&quot;音量异常&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;音量感知&quot;,&quot;why&quot;:&quot;「感知」不指向缺陷，改为可判定的异常表述。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;音频整体音量过大、过小或忽高忽低。&quot;,&quot;symptoms&quot;:[&quot;音量过小几乎听不见&quot;,&quot;音量爆表&quot;,&quot;音量无理由起伏&quot;],&quot;requires&quot;:&quot;判定对象是音量的物理表现&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;Prompt 明确要求了音量大小而未遵循 → 指令遵循 `通用指令未遵循`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;削波导致的爆音 → `音频失真（爆音/断音）`；切换时的音量突变 → `音乐音效不一致`&quot;}]},{&quot;n&quot;:&quot;音频失真（爆音/断音）&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;失真感知&quot;,&quot;why&quot;:&quot;明确失真的具体表现，避免与视觉失真类标签混淆。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;音频出现削波爆音、断音或码率过低的失真。&quot;,&quot;symptoms&quot;:[&quot;爆音削波&quot;,&quot;突然断音&quot;,&quot;码率极低的金属感失真&quot;],&quot;requires&quot;:&quot;判定对象是波形层面的失真&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅底噪偏高 → `噪声感知`；仅音量不当 → `音量异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;视觉上的扭曲闪烁 → 动态质量 `波动扭曲` / `明暗闪烁`（同为「失真」但不同感官）&quot;}]}]},{&quot;name&quot;:&quot;音画同步&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本维度只标质量好坏，指令遵循·音频指令遵循只标有无/类型匹配&quot;}],&quot;tags&quot;:[{&quot;n&quot;:&quot;口型不匹配&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;口型匹配度&quot;,&quot;why&quot;:&quot;去正面词——打标本质是记录缺陷，正面陈述会让标注员犹豫打标方向。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;人物口型与语音内容不对应。&quot;,&quot;symptoms&quot;:[&quot;说话时嘴没动&quot;,&quot;口型与音节对不上&quot;,&quot;闭嘴却有说话声&quot;],&quot;requires&quot;:&quot;判定对象是口型与语音的对应关系&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;整体音画时间轴错位而非仅口型 → `音画不同步`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;人声音色在镜头间改变 → `人声不一致`；语音不符 Prompt → 指令遵循 `语音指令未遵循`&quot;}]},{&quot;n&quot;:&quot;音画不同步&quot;,&quot;act&quot;:&quot;移入&quot;,&quot;from&quot;:&quot;动态美学·音画不同步&quot;,&quot;why&quot;:&quot;从动态美学彻底删除，强制归口至此，消除双归属。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;声音与画面动作的时间点错位。&quot;,&quot;symptoms&quot;:[&quot;嘴型动了两秒后声音才出&quot;,&quot;脚步落地声提前&quot;,&quot;音效与动作不对齐&quot;],&quot;requires&quot;:&quot;声音内容是对的，只是时间轴错位&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;声音内容与画面场景完全不符 → `音画不匹配`；仅口型对不上 → `口型不匹配`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;音效在 Prompt 要求的节点完全没出现 → 指令遵循 `音效指令未遵循`&quot;}],&quot;demoKey&quot;:&quot;音画不同步&quot;},{&quot;n&quot;:&quot;音画不匹配&quot;,&quot;act&quot;:&quot;移入&quot;,&quot;from&quot;:&quot;动态美学·音画不匹配&quot;,&quot;why&quot;:&quot;原在音画同步与动态美学下同时出现（P1 级硬重复），统一收到此处。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;声音内容与画面场景不符。&quot;,&quot;symptoms&quot;:[&quot;室内弹钢琴却有集市喧闹声&quot;,&quot;画面无雨却有雨声&quot;,&quot;声源与画面对不上&quot;],&quot;requires&quot;:&quot;判定对象是声音内容与画面内容的对应关系，与时间轴无关&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;内容对但时间点错位 → `音画不同步`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;声音类型不符 Prompt 指定 → 指令遵循 `音效指令未遵循` / `音乐指令未遵循`&quot;}]}]},{&quot;name&quot;:&quot;音频质量与表现力&quot;,&quot;rules&quot;:[],&quot;tags&quot;:[{&quot;n&quot;:&quot;人声语音&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;是内容类型（Vocal）而非缺陷，无法直接判定好坏，子维度整体删除。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;音效&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;是内容类型（SFX）而非缺陷，子维度整体删除。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;音乐&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;是内容类型（BGM）而非缺陷，子维度整体删除。&quot;,&quot;gone&quot;:true}]},{&quot;name&quot;:&quot;多模态综合表现力&quot;,&quot;rules&quot;:[],&quot;tags&quot;:[{&quot;n&quot;:&quot;音频一致性&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;why&quot;:&quot;子维度整体删除；时间一致性语义归入「音画同步」。&quot;,&quot;gone&quot;:true}]}]}];&#10;&#10;// 优先级直接来自数据（人工分级），不再按遍历顺序生成&#10;const prioOf = name =&gt; {&#10;  for (const d of TAX_AFTER) for (const s of d.subs) for (const t of s.tags)&#10;    if (t.n === name &amp;&amp; !t.gone) return t.prio || null;&#10;  return null;&#10;};&#10;&#10;const demosFor = t =&gt; DEMOS[t.demoKey || t.n] || null;&#10;&#10;/* 被父页 srcdoc 内联时的全屏放大握手：状态与常量 */&#10;// ── 全屏放大：当本图表被父页面以 iframe 内联（srcdoc）时，position:fixed 只能铺满&#10;//    iframe 自身视口（高仅 ~800px），modal 会被裁。打开 modal 时通知父页面把这个&#10;//    iframe 放大到全屏，关闭时还原。子页面无法拿到真实 URL，所以不能走「父页加载&#10;//    popup URL」的老路——只发消息，图表和 modal 都留在原 iframe 里运行。──&#10;const IN_IFRAME = (window !== window.top);&#10;let pendingOpen = null;   // 被内联时，等父页 iframe 放大到全屏(kc-expand-ack)后再开 modal&#10;let revealTimer = null;   // 关闭时，等父页把 iframe 缩回行内尺寸(kc-collapse-ack)后再放出图表&#10;&#10;// ── 「这一帧真的上屏了」才回调 ───────────────────────────────────────────────&#10;// rAF 的回调跑在绘制之「前」，所以在 rAF 里通知父页「我画好了」是错的：父页立刻&#10;// 显影，而跨进程合成器手上还是子页的上一帧（刚按全屏重排、但还没加 class 的标签树）&#10;// —— 那就是 flash.png 里那片「清晰的全屏标签树盖在模糊页面上」。&#10;// 连续两次 rAF 之间必然跨过一个完整的帧边界，即上一帧已提交合成；再挂一个&#10;// setTimeout 0 兜住「后台标签页 / 隐藏 iframe 里 rAF 根本不跑」的情况。&#10;function afterPaint(fn){&#10;  let done = false;&#10;  const go = () =&gt; { if (done) return; done = true; fn(); };&#10;  requestAnimationFrame(() =&gt; requestAnimationFrame(go));&#10;  setTimeout(go, 120);&#10;}&#10;&#10;/* 标签树构建 + chip 渲染（rulesFor / md / rulesHTML / chipEl） */&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// TREE BUILD&#10;// ══════════════════════════════════════════════════════════════════════════&#10;const tree  = document.getElementById('tree');&#10;const panel = document.getElementById('panel');&#10;const bodyEl = document.body;&#10;let selected = null;&#10;&#10;const norm = t =&gt; typeof t === 'string' ? {n:t} : t;&#10;&#10;// ── rubric 边界规则的归属 ─────────────────────────────────────────────────&#10;//   子维度的 rules 里，多数规则其实只约束其中一两个标签（「结构异常仅限运动形变」&#10;//   只跟 `合理性` 有关），整份 rules 直接铺给子维度下每个标签会让侧栏塞满与当前&#10;//   标签无关的内容。所以规则写成两种形态：&#10;//     &quot;……&quot;                          → 子维度通用，所有标签都显示&#10;//     {r:&quot;……&quot;, for:[&quot;标签A&quot;,&quot;标签B&quot;]} → 仅这些标签显示&#10;//   for 里写标签名（治理后的名字）。规则文本里的标签是简写或 facet 名（如&#10;//   `结构异常` 对应 `合理性` 的 facets），无法靠字符串匹配可靠推断，故显式声明。&#10;//   三级 rules 合并：L1 一级维度通用 → L2 子维度（for 可收窄到标签）→ L3 标签自有。&#10;//   同一动词下按层级从宽到窄排列，标签级排最后（最具体，判定时最先看）。&#10;function rulesFor(t, subRules, dimRules){&#10;  const out = [];&#10;  (dimRules || []).forEach(r =&gt; {&#10;    if (!r.for || r.for.includes(t.n)) out.push({kind: r.kind, r: r.r, lvl: '一级维度'});&#10;  });&#10;  (subRules || []).forEach(r =&gt; {&#10;    if (!r.for || r.for.includes(t.n)) out.push({kind: r.kind, r: r.r, lvl: '子维度'});&#10;  });&#10;  (t.rules || []).forEach(r =&gt; out.push({kind: r.kind, r: r.r, lvl: null}));&#10;  return out;&#10;}&#10;&#10;// `标签名` → &lt;code&gt;；面板全是字符串拼接，没有 markdown 渲染，反引号原样漏出过。&#10;const md = s =&gt; String(s == null ? '' : s)&#10;  .replace(/&amp;/g, '&amp;amp;').replace(/&lt;/g, '&amp;lt;').replace(/&gt;/g, '&amp;gt;')&#10;  .replace(/`([^`]+)`/g, '&lt;code&gt;$1&lt;/code&gt;');&#10;&#10;// 按动词分组渲染，动词顺序固定（判定强度从硬到软）&#10;const RULE_ORDER = ['需硬隔离', '需互斥', '需锚定', '需定优先级', '需降级', '需禁用'];&#10;function rulesHTML(rules){&#10;  const by = new Map();&#10;  rules.forEach(r =&gt; { if (!by.has(r.kind)) by.set(r.kind, []); by.get(r.kind).push(r); });&#10;  const kinds = [...by.keys()].sort((a, b) =&gt; {&#10;    const ia = RULE_ORDER.indexOf(a), ib = RULE_ORDER.indexOf(b);&#10;    return (ia &lt; 0 ? 99 : ia) - (ib &lt; 0 ? 99 : ib);&#10;  });&#10;  return kinds.map(k =&gt; '&lt;div class=&quot;rgrp&quot;&gt;&lt;span class=&quot;rv&quot;&gt;' + k + '&lt;/span&gt;&lt;ul&gt;'&#10;    + by.get(k).map(r =&gt; '&lt;li&gt;' + md(r.r)&#10;        + (r.lvl ? '&lt;span class=&quot;lvl&quot;&gt;· ' + r.lvl + '&lt;/span&gt;' : '') + '&lt;/li&gt;').join('')&#10;    + '&lt;/ul&gt;&lt;/div&gt;').join('');&#10;}&#10;&#10;function chipEl(tag, sub, dim, subjInherit, isAfter, subRules, dimRules){&#10;  const t = norm(tag);&#10;  const subj = t.subj != null ? t.subj : subjInherit;&#10;  // after 模式下已删除/已移出的标签不参与优先级（它们不在最终体系里）&#10;  // before 模式下优先级来自标签自身的 prio 字段（由 xlsx 导入）&#10;  const prio = isAfter&#10;    ? (!t.gone ? prioOf(t.n) : null)&#10;    : (t.prio || null);&#10;  // 优先级待产品输入的活标签：既不能着色，也不该跟已删除标签一样灰掉&#10;  const prioTBD = isAfter &amp;&amp; !t.gone &amp;&amp; !prio &amp;&amp; !!t.prioTBD;&#10;  const hasDemo = !!demosFor(t);&#10;  const isStmt = !isAfter &amp;&amp; STMT.has(t.n);&#10;  // 「ing」= 当前一轮正在标注的标签。只在 after 模式成立：ING 里写的是治理后的&#10;  // 名字，before 模式的同一概念叫法不同（`主体一致性` vs `主体不一致`），拿去匹配&#10;  // before 的 chip 只会零星命中几个没改名的，比不匹配更误导。&#10;  const isIng = isAfter &amp;&amp; ING.has(t.n);&#10;  const el = document.createElement('div');&#10;  el.className = 'chip' + (subj ? ' subj' : '') + (t.flag ? ' flag-'+t.flag : '')&#10;               + (isStmt ? ' flag-stmt' : '') + (hasDemo ? ' hasdemo' : '') + (t.gone ? ' gone' : '');&#10;  el.dataset.subj = subj ? '1' : '0';&#10;  el.dataset.flag = t.flag || '';&#10;  el.dataset.stmt = isStmt ? '1' : '0';&#10;  el.dataset.ing = isIng ? '1' : '0';&#10;  if (prio) el.dataset.p = prio;                 // drives after-mode coloring&#10;  else if (prioTBD) el.dataset.p = 'TBD';&#10;  const name = document.createElement('div');&#10;  name.className = 'name';&#10;  name.innerHTML = '&lt;span&gt;'+t.n+'&lt;/span&gt;';&#10;  if (prio) name.innerHTML += '&lt;span class=&quot;pbadge prio-only&quot; data-p=&quot;'+prio+'&quot;&gt;'+prio+'&lt;/span&gt;';&#10;  else if (prioTBD) name.innerHTML += '&lt;span class=&quot;pbadge prio-only&quot; data-p=&quot;TBD&quot;&gt;P 待补&lt;/span&gt;';&#10;  if (isAfter &amp;&amp; t.act &amp;&amp; t.act !== '维持')&#10;    name.innerHTML += '&lt;span class=&quot;badge '+(t.gone ? 'b-gone' : 'b-chg')+'&quot;&gt;'+t.act+'&lt;/span&gt;';&#10;  if (t.flag === 'confusion') name.innerHTML += '&lt;span class=&quot;badge b-warn flag-only&quot;&gt;边界不清晰&lt;/span&gt;';&#10;  if (t.flag === 'dup')       name.innerHTML += '&lt;span class=&quot;badge b-dup flag-only&quot;&gt;重复&lt;/span&gt;';&#10;  if (isStmt)                 name.innerHTML += '&lt;span class=&quot;badge b-stmt flag-only&quot;&gt;陈述式&lt;/span&gt;';&#10;  el.appendChild(name);&#10;  if (t.facets){&#10;    const f = document.createElement('div'); f.className = 'facets';&#10;    t.facets.forEach(x =&gt; { const s = document.createElement('span'); s.className='facet'; s.textContent='+'+x; f.appendChild(s); });&#10;    el.appendChild(f);&#10;  }&#10;  el.onclick = e =&gt; { e.stopPropagation(); selectChip(el, t, sub, dim, subj, prio, isAfter, subRules, dimRules); };&#10;  return el;&#10;}&#10;&#10;/* 右侧面板：selectChip —— Demo 置顶 → Rubric → Rules → 治理动作 */&#10;function selectChip(el, t, sub, dim, subj, prio, isAfter, subRules, dimRules){&#10;  document.querySelectorAll('.chip.sel').forEach(c =&gt; c.classList.remove('sel'));&#10;  el.classList.add('sel'); selected = el;&#10;  const type = subj ? '&lt;span class=&quot;badge b-subj&quot;&gt;主观&lt;/span&gt;' : '&lt;span class=&quot;badge b-obj&quot;&gt;客观&lt;/span&gt;';&#10;  let html = '&lt;h3&gt;'+t.n+' '+type;&#10;  if (bodyEl.classList.contains('after') &amp;&amp; prio)&#10;    html += '&lt;span class=&quot;pbadge&quot; data-p=&quot;'+prio+'&quot;&gt;'+prio+'&lt;/span&gt;';&#10;  else if (bodyEl.classList.contains('after') &amp;&amp; !t.gone &amp;&amp; t.prioTBD)&#10;    html += '&lt;span class=&quot;pbadge&quot; data-p=&quot;TBD&quot;&gt;P 待补&lt;/span&gt;';&#10;  html += '&lt;/h3&gt;';&#10;  html += '&lt;p class=&quot;path&quot;&gt;'+dim+' › '+sub+'&lt;/p&gt;';&#10;  if (t.facets){&#10;    html += '&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;k&quot;&gt;细分（facets）&lt;/div&gt;&lt;div class=&quot;rel&quot;&gt;'+&#10;            t.facets.map(x =&gt; '&lt;span class=&quot;r&quot;&gt;+'+x+'&lt;/span&gt;').join('')+'&lt;/div&gt;&lt;/div&gt;';&#10;  }&#10;  if (t.note){ html += '&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;k&quot;&gt;备注&lt;/div&gt;&lt;div&gt;'+t.note+'&lt;/div&gt;&lt;/div&gt;'; }&#10;  const demos = demosFor(t);&#10;  // Demo 置顶：多模态锚点比文字定义更快定调；91 个标签里只有 7 个有 demo，&#10;  // 没有的直接不占位（旧版在这里放一个 disabled 的空按钮，等于给 84 个标签开头塞了个死按钮）。&#10;  if (demos){&#10;    html += '&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;k&quot;&gt;多模态 Demo&lt;/div&gt;'&#10;          + '&lt;button class=&quot;demobtn&quot; id=&quot;open-demo&quot;&gt;▷ Play · '+demos.length+' 条标注数据&lt;/button&gt;&lt;/div&gt;';&#10;  }&#10;  // after 模式：Rubric（解释 + 常见 Case）→ Rules（三级合并、按动词分组）→ 治理动作&#10;  if (isAfter){&#10;    if (t.rubric &amp;&amp; !t.gone){&#10;      const todo = t.rubric.status === 'TODO';&#10;      html += '&lt;div class=&quot;card rub'+(todo ? ' rub-todo' : '')+'&quot;&gt;'&#10;            + '&lt;div class=&quot;ct&quot;&gt;Rubric'+(todo ? ' &lt;span class=&quot;todo&quot;&gt;待补写&lt;/span&gt;' : '')+'&lt;/div&gt;'&#10;            + '&lt;div&gt;&lt;b&gt;解释：&lt;/b&gt;'+md(t.rubric.what)+'&lt;/div&gt;';&#10;      if (t.rubric.symptoms &amp;&amp; t.rubric.symptoms.length)&#10;        html += '&lt;div style=&quot;margin-top:7px&quot;&gt;&lt;b&gt;常见 Case：&lt;/b&gt;&lt;div class=&quot;syms&quot;&gt;'&#10;              + t.rubric.symptoms.map(s =&gt; '&lt;span&gt;'+md(s)+'&lt;/span&gt;').join('') + '&lt;/div&gt;&lt;/div&gt;';&#10;      if (t.rubric.requires)&#10;        html += '&lt;div style=&quot;margin-top:7px&quot;&gt;&lt;b&gt;成立条件：&lt;/b&gt;'+md(t.rubric.requires)+'&lt;/div&gt;';&#10;      html += '&lt;/div&gt;';&#10;    }&#10;    const myRules = rulesFor(t, subRules, dimRules);&#10;    if (myRules.length){&#10;      html += '&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;k&quot;&gt;Rules&lt;/div&gt;' + rulesHTML(myRules) + '&lt;/div&gt;';&#10;    }&#10;    // 治理动作是给体系维护者看的留痕，不参与判定 → 沉到最底&#10;    if (t.act &amp;&amp; t.act !== '维持'){&#10;      html += '&lt;div class=&quot;card '+(t.gone ? 'dup' : 'stmt')+'&quot;&gt;'&#10;            + '&lt;div class=&quot;ct&quot;&gt;处理动作 · '+t.act+'&lt;/div&gt;';&#10;      if (t.from) html += '&lt;div&gt;原标签：'+md(t.from)+'&lt;/div&gt;';&#10;      if (t.why)  html += '&lt;div style=&quot;margin-top:7px;color:var(--ink-soft)&quot;&gt;'+md(t.why)+'&lt;/div&gt;';&#10;      if (t.gone) html += '&lt;div class=&quot;fix&quot;&gt;该标签&lt;b&gt;不在治理后体系中&lt;/b&gt;。&lt;/div&gt;';&#10;      html += '&lt;/div&gt;';&#10;    }&#10;  }&#10;  // 陈述式 note（仅 before：after 体系已把陈述式全部改写为缺陷式）&#10;  if (!isAfter &amp;&amp; STMT.has(t.n)){&#10;    html += '&lt;div class=&quot;card stmt&quot;&gt;'&#10;          + '&lt;div class=&quot;ct&quot;&gt;陈述式标签&lt;/div&gt;'&#10;          + '&lt;div&gt;该标签是对属性的陈述，而非缺陷描述——「'+t.n+'」本身不是问题，其&lt;b&gt;反面&lt;/b&gt;才是问题。&lt;/div&gt;'&#10;          + '&lt;div class=&quot;fix&quot;&gt;治理建议：改写为缺陷式表述（如 &lt;b&gt;音频一致性 → 音频不一致&lt;/b&gt;），标签直接对应可判定的问题。&lt;/div&gt;&lt;/div&gt;';&#10;  }&#10;  // boundary issue card（仅 before）&#10;  if (!isAfter &amp;&amp; t.flag &amp;&amp; t.g &amp;&amp; ISSUES[t.g]){&#10;    const iss = ISSUES[t.g];&#10;    const cls  = iss.kind === 'confusion' ? 'warn' : 'dup';&#10;    html += '&lt;div class=&quot;card '+cls+'&quot;&gt;'&#10;          + '&lt;div class=&quot;ct&quot;&gt;边界问题 · '+iss.label+'&lt;/div&gt;'&#10;          + '&lt;div&gt;'+iss.title+'&lt;/div&gt;'&#10;          + '&lt;div style=&quot;margin-top:7px;color:var(--ink-soft)&quot;&gt;'+iss.desc+'&lt;/div&gt;'&#10;          + '&lt;div class=&quot;kv&quot;&gt;&lt;div class=&quot;k&quot;&gt;相关标签&lt;/div&gt;&lt;div class=&quot;rel&quot;&gt;'&#10;          +   iss.members.map(m =&gt; '&lt;span class=&quot;r&quot;&gt;'+m+'&lt;/span&gt;').join('')&#10;          + '&lt;/div&gt;&lt;/div&gt;'&#10;          + '&lt;div class=&quot;fix&quot;&gt;治理建议：'+iss.fix+'&lt;/div&gt;&lt;/div&gt;';&#10;  } else if (!isAfter &amp;&amp; !STMT.has(t.n)) {&#10;    html += '&lt;p class=&quot;ph&quot;&gt;该标签边界清晰，无已知混淆 / 重复问题。&lt;/p&gt;';&#10;  }&#10;  panel.innerHTML = html;&#10;  const btn = document.getElementById('open-demo');&#10;  if (btn) btn.onclick = () =&gt; {&#10;    // DEMOS 以治理前的标签名为键，改名过的标签（崩坏 ← 明显崩坏）要用 demoKey 取数，&#10;    // 但标题仍显示当前名字。两者混用会让 modal 取到 undefined → 空白全屏。&#10;    const key = t.demoKey || t.n;&#10;    if (IN_IFRAME){&#10;      // 三阶段握手，任何一帧都不能画出「半成品」（闪烁的根因都在这里）：&#10;      //   ① 这里只发消息，不动 DOM —— 图表保持原样。曾经在这一步就加 .kc-expanded&#10;      //      把树藏掉，可那时 iframe 还是行内 820px，于是原地闪出一块白（flash.png）。&#10;      //   ② 父页铺 scrim、把 iframe 放大到全屏，但先 opacity:0 藏着（见 template.html）。&#10;      //   ③ 收到 kc-expand-ack 才加 class + 开 modal，再回 kc-modal-ready 让父页显影。&#10;      pendingOpen = {key, tag: t.n, dim, sub, prio};&#10;      window.parent.postMessage({type: 'kc-expand'}, '*');&#10;      // 兜底：若 300ms 内没收到父页 ack（父页不认这套协议），仍照常开 modal&#10;      setTimeout(() =&gt; { if (pendingOpen){ const p = pendingOpen; pendingOpen = null; openModal(p.key, p.dim, p.sub, p.prio, p.tag); } }, 300);&#10;    } else {&#10;      openModal(key, dim, sub, prio, t.n);&#10;    }&#10;  };&#10;}&#10;&#10;/* buildTree / countLeaves / 模式切换 */&#10;// 「带 ▷ 的标签有 demo」这半句只在真有 demo 时才说：独立分发副本把 DEMOS 置空、&#10;// 连播放器一起排掉（见 tools/gen-chart.mjs 的 caption/index.html 那条 build），&#10;// 那份文案里再提视频就是承诺一个点不开的功能。按数据判断，两份输出各自说对。&#10;const HAS_DEMOS = Object.keys(DEMOS).length &gt; 0;&#10;&#10;// after 模式的计数只算留在体系里的标签（gone 的不计入）&#10;const countLeaves = (sub, isAfter) =&gt;&#10;  isAfter ? sub.tags.filter(t =&gt; !norm(t).gone).length : sub.tags.length;&#10;&#10;function buildTree(isAfter){&#10;  const data = isAfter ? TAX_AFTER : TAX;&#10;  tree.innerHTML = '';&#10;  data.forEach((dim, i) =&gt; {&#10;    const n1 = document.createElement('div'); n1.className = 'n1 l1 node';&#10;    const total = dim.subs.reduce((a,s) =&gt; a + countLeaves(s, isAfter), 0);&#10;    const row = document.createElement('div'); row.className = 'row';&#10;    row.innerHTML = '&lt;span class=&quot;caret&quot;&gt;▶&lt;/span&gt;&lt;span class=&quot;lbl&quot;&gt;&lt;span class=&quot;idx&quot;&gt;'+(i+1)+'&lt;/span&gt; '+dim.name+'&lt;/span&gt;&lt;span class=&quot;count&quot;&gt;'+total+' 标签&lt;/span&gt;';&#10;    row.onclick = () =&gt; n1.classList.toggle('open');&#10;    n1.appendChild(row);&#10;    const kids = document.createElement('div'); kids.className = 'kids';&#10;    dim.subs.forEach(sub =&gt; {&#10;      const n2 = document.createElement('div'); n2.className = 'l2 node';&#10;      const r2 = document.createElement('div'); r2.className = 'row';&#10;      r2.innerHTML = '&lt;span class=&quot;caret&quot;&gt;▶&lt;/span&gt;&lt;span class=&quot;lbl&quot;&gt;'+sub.name+'&lt;/span&gt;&lt;span class=&quot;count&quot;&gt;'+countLeaves(sub, isAfter)+'&lt;/span&gt;';&#10;      r2.onclick = e =&gt; { e.stopPropagation(); n2.classList.toggle('open'); };&#10;      n2.appendChild(r2);&#10;      const kids2 = document.createElement('div'); kids2.className = 'kids';&#10;      const chips = document.createElement('div'); chips.className = 'chips';&#10;      // before-mode: sort by evaluation priority (P0 first, then P1, P2, unranked last)&#10;      const prioRank = p =&gt; p === 'P0' ? 0 : p === 'P1' ? 1 : p === 'P2' ? 2 : 3;&#10;      const tags = isAfter ? sub.tags : [...sub.tags].sort((a, b) =&gt; {&#10;        const pa = prioRank(norm(a).prio), pb = prioRank(norm(b).prio);&#10;        return pa - pb;&#10;      });&#10;      tags.forEach(tag =&gt; chips.appendChild(chipEl(tag, sub.name, dim.name, !!sub.subj, isAfter, sub.rules, dim.rules)));&#10;      kids2.appendChild(chips);&#10;      n2.appendChild(kids2);&#10;      kids.appendChild(n2);&#10;    });&#10;    n1.appendChild(kids);&#10;    tree.appendChild(n1);&#10;  });&#10;  document.querySelectorAll('.l1').forEach(n =&gt; n.classList.add('open'));&#10;  panel.innerHTML = isAfter&#10;    ? '&lt;p class=&quot;ph&quot;&gt;治理后的标签体系（依据 capiton-2.md 各维度 x.4）。点击标签查看处理动作、原标签与依据；虚线删除线的标签已从体系中删除或移出。&lt;/p&gt;'&#10;    : '&lt;p class=&quot;ph&quot;&gt;点击任意标签查看其定位' + (HAS_DEMOS&#10;        ? '；带 ▷ 的标签有标注 demo，点开可查看视频与帧级标注 JSON。'&#10;        : '、rubric 与治理动作。') + '&lt;/p&gt;';&#10;}&#10;buildTree(false);&#10;&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// MODE TABS (before / after)&#10;// ══════════════════════════════════════════════════════════════════════════&#10;document.getElementById('modetabs').addEventListener('click', e =&gt; {&#10;  const b = e.target.closest('.modetab'); if(!b) return;&#10;  const m = b.dataset.m;&#10;  document.querySelectorAll('.modetab').forEach(x =&gt; x.classList.remove('on'));&#10;  b.classList.add('on');&#10;  bodyEl.classList.toggle('after', m === 'after');&#10;  bodyEl.classList.toggle('before', m === 'before');&#10;  buildTree(m === 'after');          // 两个模式是两套标签体系，整棵树重建&#10;  resetFilters();                    // filters are before-only; clear dimming on switch&#10;  // after mode: expand everything so the colored subset is visible at a glance&#10;  if (m === 'after') document.querySelectorAll('.node').forEach(n =&gt; n.classList.add('open'));&#10;});&#10;&#10;/* 筛选：Before 按标记、After 按优先级；展开收起 */&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// FILTERS (multi-select union) + EXPAND / COLLAPSE&#10;// ══════════════════════════════════════════════════════════════════════════&#10;//   chip matches a filter when:  subj→dataset.subj==1 · obj→dataset.subj==0&#10;//   dup/confusion→dataset.flag · stmt→dataset.stmt==1.  A chip shows if it&#10;//   matches ANY selected filter (union). &quot;全部&quot; clears the selection.&#10;const active = new Set();&#10;const matches = (c, f) =&gt;&#10;  f === 'subj'      ? c.dataset.subj === '1' :&#10;  f === 'obj'       ? c.dataset.subj === '0' :&#10;  f === 'confusion' ? c.dataset.flag === 'confusion' :&#10;  f === 'dup'       ? c.dataset.flag === 'dup' :&#10;  f === 'stmt'      ? c.dataset.stmt === '1' :&#10;  // after-mode 优先级筛选；data-p 由 chipEl 写入（TBD = 待产品补充）&#10;  f === 'p0'        ? c.dataset.p === 'P0' :&#10;  f === 'p1'        ? c.dataset.p === 'P1' :&#10;  f === 'p2'        ? c.dataset.p === 'P2' :&#10;  f === 'ptbd'      ? c.dataset.p === 'TBD' :&#10;  // ing = 本轮正在标注的标签子集，跨维度跨优先级，来自 data/tag-system.json 的 ing&#10;  f === 'ing'       ? c.dataset.ing === '1' : false;&#10;&#10;document.getElementById('toolbar').addEventListener('click', e =&gt; {&#10;  const b = e.target.closest('.fbtn'); if(!b) return;&#10;  const f = b.dataset.f;&#10;  if (f === 'all'){ resetFilters(); return; }&#10;  active.has(f) ? active.delete(f) : active.add(f);&#10;  b.classList.toggle('on', active.has(f));&#10;  b.closest('.filters').querySelector('.fbtn[data-f=&quot;all&quot;]').classList.toggle('on', active.size === 0);&#10;  applyFilter();&#10;});&#10;function resetFilters(){&#10;  active.clear();&#10;  document.querySelectorAll('.fbtn').forEach(x =&gt; x.classList.remove('on'));&#10;  document.querySelectorAll('.fbtn[data-f=&quot;all&quot;]').forEach(x =&gt; x.classList.add('on'));&#10;  applyFilter();                     // 灰显、隐藏、计数三样都从这一条路还原&#10;}&#10;// 不匹配的标签怎么处理，分两种：&#10;//   优先级筛选（P0/P1/P2/待补）→ 灰显。要看的是「这一档在全景里占多少」，位置得留着。&#10;//   ing（本轮正在标注）        → 直接不渲染，空掉的二级 / 一级维度整层收掉，只剩这一批。&#10;function applyFilter(){&#10;  const any = active.size &gt; 0;&#10;  const focus = active.has('ing');&#10;  document.querySelectorAll('.chip').forEach(c =&gt; {&#10;    const show = !any || [...active].some(f =&gt; matches(c, f));&#10;    c.classList.toggle('dimmed', !show &amp;&amp; !focus);&#10;    c.classList.toggle('hidden', !show &amp;&amp; focus);&#10;  });&#10;  // 先二级再一级：一个 chip 都没剩的那层，标题连计数一起是纯噪声。&#10;  // 一级维度里数 .chip:not(.hidden) 不会重复计 —— 被收掉的二级本就没有可见 chip。&#10;  document.querySelectorAll('.l2.node').forEach(n =&gt; recount(n, focus));&#10;  document.querySelectorAll('.n1').forEach(n =&gt; recount(n, focus));&#10;  if (any) document.querySelectorAll('.node').forEach(n =&gt; n.classList.add('open'));&#10;}&#10;// 焦点模式下计数跟着可见集合走，否则会出现标题写「23 标签」、底下只剩 15 个 chip。&#10;// 原始文本存在 dataset.full 里，退出焦点模式原样写回（'N 标签' 与 'N' 两种格式都有）。&#10;function recount(node, focus){&#10;  const n = node.querySelectorAll('.chip:not(.hidden)').length;&#10;  node.classList.toggle('hidden', focus &amp;&amp; n === 0);&#10;  const el = node.querySelector(':scope &gt; .row &gt; .count');&#10;  if (!el) return;&#10;  if (el.dataset.full == null) el.dataset.full = el.textContent;&#10;  el.textContent = focus ? n + (el.dataset.full.endsWith('标签') ? ' 标签' : '') : el.dataset.full;&#10;}&#10;document.getElementById('expandAll').onclick   = () =&gt; document.querySelectorAll('.node').forEach(n =&gt; n.classList.add('open'));&#10;document.getElementById('collapseAll').onclick = () =&gt; document.querySelectorAll('.l2.node').forEach(n =&gt; n.classList.remove('open'));&#10;&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// 帧级标注播放器 · 核心&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// 视频 + 时间轴打点 + 画面 grounding 框 + 帧级 JSON。两个宿主共用这一份：&#10;//   · charts/tag-system.html   —— 包在 modal 里，点标签的「Play」打开&#10;//   · charts/annotation-demo.html —— 直接内联成一张卡片（Pointwise 数据示例）&#10;// 宿主只需提供同名 DOM 节点（见下方 refs）并调 mountDemos(demos)；&#10;// 壳的开关/标题/徽章各自实现，核心不关心自己是不是在 modal 里。&#10;//&#10;// 组件源自 skills/chart-blocks/templates/frame-annotation-modal。&#10;&#10;const overlay = document.getElementById('overlay');   // modal 宿主才有；内联宿主为 null&#10;const vEl     = document.getElementById('v-el');&#10;const vWrap   = document.getElementById('v-wrap');&#10;const vLayer  = document.getElementById('v-layer');&#10;const vFill   = document.getElementById('v-fill');&#10;const vTrack  = document.getElementById('v-track');&#10;const vTime   = document.getElementById('v-time');&#10;const vPlay   = document.getElementById('v-play');&#10;const vMute   = document.getElementById('v-mute');&#10;const vJumps  = document.getElementById('v-jumps');&#10;const vCtrls  = document.getElementById('v-controls');&#10;const jBody   = document.getElementById('j-body');&#10;&#10;// ── 素材路径：相对「项目根」而不是相对本文档 ─────────────────────────────────&#10;// demo.src 在 data/tag-system.json 里写成 `assets/videos/x.mp4`，即相对项目根。&#10;// 这份 HTML 有四种加载方式，各自的 baseURI 不同：&#10;//   · charts/tag-system.html            直接打开  → base 是 charts/&#10;//   · eval/charts/tag-system.html       直接打开  → base 是 eval/charts/&#10;//   · charts/annotation-demo.html       直接打开  → base 是 charts/&#10;//   · build.py 把上面任一份内联成 srcdoc → base 是父页 index.html（项目根）&#10;// srcdoc 文档没有自己的 URL（location 是 about:srcdoc），相对路径按父页解析，&#10;// 所以曾经写死的 `../assets/…` 在博客里会跑到项目根的上一层，视频 404、&#10;// video.error.code=4（Format error）——表现就是「视频不能播放」。&#10;// 这里统一把 base 归一到项目根：截到最后一个 / 为止，再剥掉 charts/、eval/。&#10;//&#10;// 注意：这段刻意不用正则，全用字符串操作。build.py 会把本文件内联进 index.html&#10;// 的 markdown，而 SPA 端 renderDoc 会把一行里成对的美元符号当成行内公式抽走再还原，&#10;// 还原时不解码 &amp;#10; —— 正则里的行尾锚点成对出现就会被吃掉，整段 JS 变成&#10;// SyntaxError，播放器直接不启动。tools/verify.mjs 有一条检查守着这件事。&#10;const ASSET_BASE = (() =&gt; {&#10;  const url = document.baseURI.split('#')[0].split('?')[0];&#10;  let dir = url.slice(0, url.lastIndexOf('/') + 1);&#10;  if (dir.endsWith('/charts/')) dir = dir.slice(0, -'charts/'.length);&#10;  if (dir.endsWith('/eval/'))   dir = dir.slice(0, -'eval/'.length);&#10;  return dir;&#10;})();&#10;const srcOf = d =&gt; (d.src.indexOf('//') === 0 || d.src.indexOf(':') &gt; -1 || d.src[0] === '/')&#10;                     ? d.src : ASSET_BASE + d.src;&#10;&#10;// 当前这组 demo。核心不查 DEMOS —— 由宿主调 mountDemos(demos) 传入，&#10;// 所以同一份核心既能被 modal 壳驱动，也能被内联卡片直接挂载。&#10;let curDemos = [], curIdx = 0, curFrame = -1, pendingSeek = null;&#10;const curDemo = () =&gt; curDemos[curIdx];&#10;const fmt = s =&gt; { if(!isFinite(s)) return '0:00'; const m=Math.floor(s/60), c=Math.floor(s%60); return m+':'+String(c).padStart(2,'0'); };&#10;const HOLD_DEFAULT = 1.2;&#10;const holdOf = f =&gt; (f.hold != null ? f.hold : HOLD_DEFAULT);&#10;const sevOf  = f =&gt; (f.severity != null ? f.severity : 2);&#10;&#10;&#10;const AUTOSELECT_FIRST = true;   // 打开即定位到第一个问题帧并暂停，首屏就有画面+框&#10;&#10;// ── json panel ────────────────────────────────────────────────────────────&#10;function groundingOf(f){&#10;  if (f.grounding) return f.grounding;&#10;  if (f.box) return 'bbox%: ['+f.box.x+','+f.box.y+','+(f.box.x+f.box.w)+','+(f.box.y+f.box.h)+']';&#10;  return undefined;&#10;}&#10;// 面板里吐的 JSON 必须与 data/data.md 里公布的标注协议同构 —— 那份是对外的&#10;// schema，demo 是它的实例，两边键名对不上就等于给了两套协议。&#10;// 所以这里只做换名与换算，不新增语义：&#10;//   frame / frame_range ← time、hold 按 FPS 换算&#10;//   bbox                ← grounding 的像素坐标，从 [x1,y1,x2,y2] 转成协议规定的 [y1,x1,y2,x2]&#10;//   observation         ← 帧上已有的客观描述&#10;//   instruction_expect  ← 协议规定「仅当存在参考素材或生成指令时填写」，demo 没有参考素材，故缺省不出现&#10;const FPS = 4;                       // 质检抽帧口径：4 fps&#10;function pxBox(f){                   // &quot;bbox: [x1,y1,x2,y2]&quot; -&gt; [y1,x1,y2,x2]&#10;  const m = /\\[([\\d\\s,.-]+)\\]/.exec(f.grounding || '');&#10;  if (!m) return undefined;&#10;  const n = m[1].split(',').map(v =&gt; Number(v.trim()));&#10;  if (n.length !== 4 || n.some(v =&gt; !isFinite(v))) return undefined;&#10;  return [n[1], n[0], n[3], n[2]];&#10;}&#10;// 真实数据集里这些字段本来就有（人工画框 / 模型标注都按同一份协议存），&#10;// 有就直接用，只有旧的手写 demo 才需要从 time/hold 反推。&#10;function frameObj(f, i){&#10;  const fr  = f.frame != null ? f.frame&#10;            : (f.time != null ? Math.round(f.time*FPS) : undefined);&#10;  const end = (fr!=null) ? fr + Math.max(1, Math.round(holdOf(f)*FPS)) : undefined;&#10;  return { evidence_id: f.evidence_id || String((i!=null?i:0)+1),&#10;           frame: fr,&#10;           bbox: f.bbox || pxBox(f),&#10;           frame_range: f.frame_range || ((fr!=null &amp;&amp; end!=null) ? [fr, end] : undefined),&#10;           instruction_expect: f.instruction_expect,&#10;           observation: f.observation || f.reasoning,&#10;           dimension: f.dimension };&#10;}&#10;function jsonHTML(f, i){&#10;  const obj = frameObj(f, i);&#10;  const lines = ['&lt;span class=&quot;jp&quot;&gt;{&lt;/span&gt;'];&#10;  const keys = Object.keys(obj).filter(k =&gt; obj[k] !== undefined);&#10;  keys.forEach((k,i) =&gt; {&#10;    const comma = i &lt; keys.length-1 ? '&lt;span class=&quot;jp&quot;&gt;,&lt;/span&gt;' : '';&#10;    const v = obj[k];&#10;    const val = typeof v==='number'&#10;      ? '&lt;span class=&quot;jn&quot;&gt;'+v+'&lt;/span&gt;'&#10;      : Array.isArray(v)&#10;        ? '&lt;span class=&quot;jp&quot;&gt;[&lt;/span&gt;&lt;span class=&quot;jn&quot;&gt;'+v.join('&lt;/span&gt;&lt;span class=&quot;jp&quot;&gt;, &lt;/span&gt;&lt;span class=&quot;jn&quot;&gt;')+'&lt;/span&gt;&lt;span class=&quot;jp&quot;&gt;]&lt;/span&gt;'&#10;        : '&lt;span class=&quot;js&quot;&gt;&quot;'+String(v).replace(/&lt;/g,'&amp;lt;')+'&quot;&lt;/span&gt;';&#10;    lines.push('  &lt;span class=&quot;jk&quot;&gt;&quot;'+k+'&quot;&lt;/span&gt;&lt;span class=&quot;jp&quot;&gt;: &lt;/span&gt;'+val+comma);&#10;  });&#10;  lines.push('&lt;span class=&quot;jp&quot;&gt;}&lt;/span&gt;');&#10;  return lines.join('\\n');&#10;}&#10;// ── timeline markers + jump chips ─────────────────────────────────────────&#10;const demoDur = d =&gt; Math.max(...d.frames.map(f=&gt;f.time)) + 3;&#10;&#10;function renderJumps(demo){&#10;  vJumps.innerHTML = '';&#10;  demo.frames.forEach((f,i) =&gt; {&#10;    const b = document.createElement('button');&#10;    b.className = 'jump'; b.dataset.i = i;&#10;    b.innerHTML = '&lt;span class=&quot;jd&quot; data-sev=&quot;'+sevOf(f)+'&quot;&gt;&lt;/span&gt;'+f.time.toFixed(1)+'s · '+f.dimension;&#10;    b.onclick = () =&gt; gotoFrame(i, true);&#10;    vJumps.appendChild(b);&#10;  });&#10;}&#10;function renderMarks(demo){&#10;  if (!demo) return;&#10;  vTrack.querySelectorAll('.mark').forEach(m =&gt; m.remove());&#10;  // duration isn't known until loadedmetadata — place provisionally, redo later&#10;  const dur = vEl.duration || demoDur(demo);&#10;  demo.frames.forEach((f,i) =&gt; {&#10;    const m = document.createElement('div');&#10;    m.className = 'mark'; m.dataset.sev = sevOf(f); m.dataset.i = i;&#10;    m.style.left = Math.min(99, (f.time/dur)*100) + '%';&#10;    m.title = f.time.toFixed(1)+'s · '+f.dimension;&#10;    m.onclick = e =&gt; { e.stopPropagation(); gotoFrame(i, true); };&#10;    vTrack.appendChild(m);&#10;  });&#10;  if (curFrame &gt;= 0) markActive(curFrame);&#10;}&#10;function markActive(i){&#10;  document.querySelectorAll('.jump').forEach(j =&gt; j.classList.toggle('act', +j.dataset.i === i));&#10;  document.querySelectorAll('.mark').forEach(m =&gt; m.classList.toggle('act', +m.dataset.i === i));&#10;}&#10;// ── grounding boxes ───────────────────────────────────────────────────────&#10;// Size the annotation layer to the video's real content rect. `object-fit:contain` letterboxes&#10;// the picture inside the wrapper, so box percentages are only meaningful against&#10;// that inner rect — measuring the wrapper instead offsets every box by the bars.&#10;function fitAnnotationLayer(){&#10;  const cw = vWrap.clientWidth, ch = vWrap.clientHeight;&#10;  const sw = vEl.videoWidth || 16, sh = vEl.videoHeight || 9;&#10;  if (!cw || !ch) return;                      // modal still display:none — nothing to fit&#10;  const scale = Math.min(cw/sw, ch/sh);&#10;  const w = sw*scale, h = sh*scale;&#10;  vLayer.style.width = w+'px';   vLayer.style.height = h+'px';&#10;  vLayer.style.left = (cw-w)/2+'px'; vLayer.style.top = (ch-h)/2+'px';&#10;}&#10;const esc = s =&gt; String(s).replace(/[&amp;&lt;&gt;&quot;']/g, c =&gt; ({'&amp;':'&amp;amp;','&lt;':'&amp;lt;','&gt;':'&amp;gt;','&quot;':'&amp;quot;',&quot;'&quot;:'&amp;#39;'}[c]));&#10;&#10;// A frame's box shows while the playhead is inside [time, time+hold). The selected&#10;// frame also stays boxed while paused, so clicking a marker always shows the box&#10;// even when hold has been scrubbed past.&#10;function activeFrames(){&#10;  const demo = curDemo(); if (!demo) return [];&#10;  const t = vEl.currentTime || 0;&#10;  const set = new Set();&#10;  demo.frames.forEach((f,i) =&gt; { if (t &gt;= f.time &amp;&amp; t &lt; f.time + holdOf(f)) set.add(i); });&#10;  if (vEl.paused &amp;&amp; curFrame &gt;= 0) set.add(curFrame);&#10;  return [...set];&#10;}&#10;function renderBoxes(){&#10;  const demo = curDemo(); if (!demo) return;&#10;  vLayer.innerHTML = activeFrames().map(i =&gt; {&#10;    const f = demo.frames[i]; if (!f.box) return '';     // no box → degrade to JSON-only&#10;    const b = f.box;&#10;    const nearTop = b.y &lt; 8 ? ' near-top' : '';&#10;    return '&lt;div class=&quot;annotation-box'+nearTop+'&quot; data-sev=&quot;'+sevOf(f)+'&quot;'&#10;         + ' style=&quot;left:'+b.x+'%;top:'+b.y+'%;width:'+b.w+'%;height:'+b.h+'%&quot;&gt;'&#10;         + '&lt;span&gt;'+esc(f.dimension + (f.target ? ' · '+f.target : ''))+'&lt;/span&gt;&lt;/div&gt;';&#10;  }).join('');&#10;}&#10;// ── navigation ────────────────────────────────────────────────────────────&#10;function gotoFrame(i, seek){&#10;  curFrame = i;&#10;  const f = curDemo().frames[i];&#10;  if (seek){&#10;    if (isFinite(vEl.duration)){ vEl.currentTime = f.time; vEl.pause(); }&#10;    else pendingSeek = f.time;   // metadata not in yet — replay the seek on load&#10;  }&#10;  jBody.innerHTML = jsonHTML(f, i);&#10;  markActive(i);&#10;  renderBoxes();&#10;}&#10;&#10;function loadDemo(idx){&#10;  curIdx = idx; curFrame = -1; pendingSeek = null;&#10;  const demo = curDemo();&#10;  document.querySelectorAll('.demopill').forEach(p =&gt; p.classList.toggle('on', +p.dataset.i === idx));&#10;  document.getElementById('v-cap').innerHTML = demo.caption || '';&#10;  jBody.innerHTML = '&lt;span class=&quot;jempty&quot;&gt;点击进度条上的问题帧标记查看该帧标注。&lt;/span&gt;';&#10;  // fade out before swapping src so the empty/black frame between demos doesn't flash&#10;  vEl.style.opacity = '0'; vLayer.style.opacity = '0';&#10;  vLayer.innerHTML = '';&#10;  vEl.src = srcOf(demo); vEl.load(); vEl.muted = true; vMute.textContent = '🔊';&#10;  vFill.style.width = '0%';&#10;  renderJumps(demo);&#10;  renderMarks(demo);                       // provisional; refined on loadedmetadata&#10;  if (AUTOSELECT_FIRST &amp;&amp; demo.frames.length) gotoFrame(0, true);&#10;}&#10;&#10;&#10;&#10;// ── 宿主入口 ──────────────────────────────────────────────────────────────&#10;// 换一组 demo 并渲染第一条。壳负责在调用前把自己显示出来（modal 加 .on / 内联无操作），&#10;// 否则 wrapper 尺寸为 0，fitAnnotationLayer 量不到东西。&#10;function mountDemos(demos){&#10;  curDemos = demos || [];&#10;  if (!curDemos.length) return false;&#10;  const strip = document.getElementById('m-strip');&#10;  if (strip){&#10;    strip.innerHTML = '';&#10;    curDemos.forEach((d, i) =&gt; {&#10;      const p = document.createElement('button');&#10;      p.className = 'demopill' + (i === 0 ? ' on' : '');&#10;      p.dataset.i = i; p.textContent = d.label;&#10;      p.onclick = () =&gt; loadDemo(i);&#10;      strip.appendChild(p);&#10;    });&#10;  }&#10;  loadDemo(0);&#10;  requestAnimationFrame(fitAnnotationLayer);   // 壳刚显示，布局完成后再量&#10;  return true;&#10;}&#10;&#10;// ── video wiring ──────────────────────────────────────────────────────────&#10;vEl.addEventListener('loadedmetadata', () =&gt; {&#10;  renderMarks(curDemo());&#10;  vTime.textContent = '0:00 / '+fmt(vEl.duration);&#10;  fitAnnotationLayer();&#10;  if (pendingSeek != null){ vEl.currentTime = pendingSeek; pendingSeek = null; vEl.pause(); }&#10;});&#10;vEl.addEventListener('loadeddata', () =&gt; { vEl.style.opacity='1'; vLayer.style.opacity='1'; fitAnnotationLayer(); renderBoxes(); });&#10;vEl.addEventListener('seeked', renderBoxes);&#10;vEl.addEventListener('timeupdate', () =&gt; {&#10;  const r = vEl.currentTime / (vEl.duration || 1);&#10;  vFill.style.width = (r*100)+'%';&#10;  vTime.textContent = fmt(vEl.currentTime)+' / '+fmt(vEl.duration);&#10;  renderBoxes();&#10;});&#10;vEl.addEventListener('play',  () =&gt; { vPlay.textContent='⏸'; vCtrls.classList.add('show'); });&#10;vEl.addEventListener('pause', () =&gt; { vPlay.textContent='▶'; vCtrls.classList.remove('show'); renderBoxes(); });&#10;vPlay.onclick = () =&gt; { vEl.paused ? vEl.play() : vEl.pause(); };&#10;vEl.onclick   = () =&gt; { vEl.paused ? vEl.play() : vEl.pause(); };&#10;vMute.onclick = () =&gt; { vEl.muted = !vEl.muted; vMute.textContent = vEl.muted ? '🔇' : '🔊'; };&#10;addEventListener('resize', fitAnnotationLayer);&#10;&#10;// ── draggable progress ────────────────────────────────────────────────────&#10;let dragging = false;&#10;function seekAt(e){&#10;  const rect = vTrack.getBoundingClientRect();&#10;  const x = (e.touches ? e.touches[0].clientX : e.clientX);&#10;  const r = Math.max(0, Math.min(1, (x - rect.left)/rect.width));&#10;  if (isFinite(vEl.duration)) vEl.currentTime = r * vEl.duration;&#10;}&#10;vTrack.addEventListener('mousedown', e =&gt; { if(e.target.classList.contains('mark')) return; dragging=true; vCtrls.classList.add('show'); seekAt(e); });&#10;document.addEventListener('mousemove', e =&gt; { if(dragging) seekAt(e); });&#10;document.addEventListener('mouseup',   () =&gt; { if(dragging){ dragging=false; vCtrls.classList.remove('show'); } });&#10;// ── copy json ─────────────────────────────────────────────────────────────&#10;document.getElementById('j-copy').onclick = () =&gt; {&#10;  if (curFrame &lt; 0) return;&#10;  const obj = frameObj(curDemo().frames[curFrame], curFrame);&#10;  Object.keys(obj).forEach(k =&gt; obj[k] === undefined &amp;&amp; delete obj[k]);&#10;  navigator.clipboard.writeText(JSON.stringify(obj, null, 2)).then(() =&gt; {&#10;    const c = document.getElementById('j-copy'); c.classList.add('copied'); c.textContent='✓';&#10;    setTimeout(() =&gt; { c.classList.remove('copied'); c.textContent='⧉'; }, 1600);&#10;  });&#10;};&#10;&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// 标注 MODAL 壳 —— 把播放器核心包进一个 macOS 风格的弹窗&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// 只做三件事：填标题栏、开关 overlay、被 iframe 内联时跟父页协商全屏。&#10;// 播放逻辑全在 60-player.js，内联版（annotation-demo）共用同一份。&#10;&#10;// 宿主入口。key 查 DEMOS，dim/sub 作面包屑，prio 染色标题徽章。&#10;function openModal(key, dim, sub, prio, title){&#10;  document.getElementById('m-title').textContent = title || key;&#10;  document.getElementById('m-path').textContent  = dim + ' › ' + sub;&#10;  const mb = document.getElementById('m-badge');&#10;  if (prio){&#10;    mb.style.display = ''; mb.textContent = prio;&#10;    mb.className = 'mbadge pbadge'; mb.dataset.p = prio;&#10;    mb.style.background = getComputedStyle(document.documentElement)&#10;                            .getPropertyValue('--' + prio.toLowerCase());&#10;    mb.style.color = '#fff';&#10;  } else mb.style.display = 'none';&#10;&#10;  // overlay 先显示，再 mount —— 否则 video wrapper 尺寸为 0，框会量歪。&#10;  // 被内联时这两个 class 必须与 .overlay.on 落在同一帧：.kc-expanded 单独在场会&#10;  // 让 body 露白底，两者齐备才走 background:transparent（见 50-modal.css）。&#10;  if (IN_IFRAME){&#10;    document.body.classList.add('kc-expanded');&#10;    document.body.classList.add('kc-modal-open');&#10;  }&#10;  overlay.classList.add('on');&#10;  document.body.style.overflow = 'hidden';&#10;&#10;  if (!mountDemos(DEMOS[key])){&#10;    // 没数据就别开：此时 .kc-expanded 已经把图表藏了，开出来是一片空白全屏&#10;    console.warn('[tag-system] 没有 demo 数据：' + key);&#10;    closeModal();&#10;    return;&#10;  }&#10;  // modal 已成形。必须等这一帧真正提交给合成器之后再通知父页显影 —— 在 rAF 里发&#10;  // 消息等于「绘制前」就喊好了，父页显影时合成器手上还是上一帧的全屏标签树。&#10;  if (IN_IFRAME) afterPaint(() =&gt; {&#10;    window.parent.postMessage({type: 'kc-modal-ready'}, '*');&#10;  });&#10;}&#10;&#10;function closeModal(){&#10;  overlay.classList.remove('on'); vEl.pause(); vEl.removeAttribute('src'); vEl.load();&#10;  document.body.style.overflow = '';&#10;  if (IN_IFRAME){&#10;    // 关键：先别摘 .kc-expanded / .kc-modal-open。&#10;    // 这两个 class 一摘，.wrap 立刻恢复 visible、body 立刻恢复白底。而父页此刻&#10;    // 可能已经把 iframe 缩回行内尺寸 —— 于是要么图表以全屏尺寸画一两帧（旧 bug），&#10;    // 要么行内尺寸的 iframe 里是一片空白矩形（第一次修完后剩下的那半个 bug）。&#10;    // 两边靠 kc-collapse / kc-collapse-ack / kc-revealed 三次握手对齐，&#10;    // 所有中间态都发生在父页 opacity:0 之下，一帧都不上屏。&#10;    window.parent.postMessage({type: 'kc-collapse'}, '*');&#10;    clearTimeout(revealTimer);&#10;    revealTimer = setTimeout(reveal, 400);   // 父页不认这套协议时的兜底&#10;  }&#10;}&#10;&#10;// 收回全屏后才恢复图表可见性。两个 class 一起摘：只摘 .kc-expanded 会让 body 恢复&#10;// 白底（transparent 规则要求两者同时在场），那就是一整屏白色盖在 scrim 上。&#10;function reveal(){&#10;  clearTimeout(revealTimer);&#10;  document.body.classList.remove('kc-modal-open');&#10;  document.body.classList.remove('kc-expanded');&#10;  // 图表已经恢复，但此刻父页把 iframe 按在 opacity:0，什么都没上屏。等这一帧真的&#10;  // 提交之后再回一条，父页才能在「子页已经是行内尺寸的图表」这一帧上撤遮罩+显影。&#10;  if (IN_IFRAME) afterPaint(() =&gt; {&#10;    window.parent.postMessage({type: 'kc-revealed'}, '*');&#10;  });&#10;}&#10;window.addEventListener('message', e =&gt; {&#10;  if (e.data &amp;&amp; e.data.type === 'kc-collapse-ack') reveal();&#10;});&#10;&#10;document.getElementById('m-close').onclick = closeModal;&#10;overlay.addEventListener('click', e =&gt; { if (e.target === overlay) closeModal(); });&#10;document.addEventListener('keydown', e =&gt; { if (e.key === 'Escape') closeModal(); });&#10;&#10;// Parent confirms the iframe is now fullscreen. Its viewport update is cross-process&#10;// and async, so poll our own innerWidth until it catches up before opening — otherwise&#10;// the modal still draws small and then jumps.&#10;//&#10;// But rAF may never fire in a background tab / hidden iframe / headless capture, and&#10;// this is the ONLY path that opens the modal once .kc-expanded has hidden our content.&#10;// Without the setTimeout backstop that case is a permanent white screen.&#10;//&#10;// pendingOpen 是 selectChip 存下的 {key, tag, dim, sub, prio}（skill 原版是个布尔，&#10;// 因为它只有一组固定数据；这里必须把参数带回来，否则开出来的是标题为空的 modal）。&#10;window.addEventListener('message', e =&gt; {&#10;  if (!e.data || e.data.type !== 'kc-expand-ack' || !pendingOpen) return;&#10;  const p = pendingOpen;&#10;  pendingOpen = null;&#10;  // 立刻藏掉图表本体。父页此刻已经把 iframe 放大到全屏，我们的布局正在按全屏重排；&#10;  // 这两个 class 晚一帧加上，合成器就会先提交一帧「清晰的全屏标签树」（flash.png）。&#10;  // 父页仍是 opacity:0，所以这里藏起来不会被看见，只是保证下一帧上屏时已经是空的。&#10;  document.body.classList.add('kc-expanded');&#10;  document.body.classList.add('kc-modal-open');&#10;  let opened = false;&#10;  const go = () =&gt; { if (opened) return; opened = true; openModal(p.key, p.dim, p.sub, p.prio, p.tag); };&#10;  const targetW = (e.data.vw || 0) * 0.9;      // allow 10% slack&#10;  let tries = 0;&#10;  (function tryOpen(){&#10;    if (opened) return;&#10;    if (++tries &gt; 30 || !targetW || window.innerWidth &gt;= targetW) go();&#10;    else requestAnimationFrame(tryOpen);&#10;  })();&#10;  setTimeout(go, 250);                          // hard backstop when rAF doesn't run&#10;});&#10;&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// 内联播放器启动 —— Pointwise 数据示例（charts/annotation-demo.html）&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// 用的是与标签体系完全相同的 modal 组件（html/50-modal.html），只是被&#10;// 60-inline.css 摊平成静态卡片：没有开关弹窗那一层，页面加载完直接挂 demo。&#10;// 数据取自 data/tag-system.json 的 demos —— 与标签体系同一份，不再像旧版那样&#10;// 在 HTML 里另抄一份 3 条子集。&#10;&#10;// 展示顺序固定：先崩坏（结构类），再六指（局部结构），再字幕（文字类），&#10;// 覆盖三种不同的缺陷形态和三段不同素材。DEMOS 的键就是标签名。&#10;const INLINE_KEYS = [&quot;文字不可读&quot;, &quot;崩坏&quot;, &quot;生物类结构异常&quot;, &quot;主体未响应&quot;];&#10;&#10;const inlineDemos = INLINE_KEYS.flatMap(k =&gt; (DEMOS[k] || []).map(d =&gt; ({&#10;  ...d,&#10;  // 内联版没有标题栏可放标签名，把它并进 pill 文案里&#10;  // An empty label means the tag name says it all (public-set clips had a&#10;  // redundant &quot;VideoFeedback · &lt;id&gt;&quot; tail); otherwise append the demo's own name.&#10;  label: d.label ? k + ' · ' + d.label.replace(/^demo-\\d+\\s*·\\s*/, '') : k,&#10;})));&#10;&#10;// modal 的标题栏在这里成了卡片头：填成这份 demo 的说明，而不是某个标签名。&#10;document.getElementById('m-title').textContent = 'Pointwise 帧级标注';&#10;document.getElementById('m-path').textContent  = '点击进度条问题帧或时间戳查看该帧 JSON';&#10;&#10;if (!mountDemos(inlineDemos)) {&#10;  document.getElementById('j-body').innerHTML =&#10;    '&lt;span class=&quot;jempty&quot;&gt;data/tag-system.json 的 demos 里没有这几个键：'&#10;    + INLINE_KEYS.join(' / ') + '&lt;/span&gt;';&#10;}&#10;&lt;/script&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;&#10;\"></iframe>\n</div>\n\ntag 暂时不会全部进入机评，取舍主要看：根据历史统计的人评一致性，判断该 tag 是否过于主观。以及与其它 tag 边界是否清晰。\n\n**优先执行高人评一致性 tag**\n- **客观标签**：有明确物理或事实判据（结构崩坏、纹理抖动、指令遗漏、音画不同步），标注员人评应高度一致（方差小），机评更容易替代人评。\n- **主观标签**：与审美、叙事、情绪相关，人评一致性天然较低：\n  - **画面美学**：材质质感、空间层次与构图布局、色彩搭配与光影表现、环境布景、主体美感全部依赖标注员审美，方差过大。\n  - **动态美学与视听叙事**：叙事节奏、运镜节奏、剪辑节奏、创意性等纯主观视听项留在体系内，依赖成对偏好与多人聚合，不追求逐条硬判。\n\n**边界划分**\n\n让同一个现象稳定落到唯一 tag\n\n按是否改动标签结构，治理动作分两类：\n\n- **改体系**：增减标签本身，包括合并、重命名、移出、删除。\n- **划范围**：不动标签，只划定适用范围，包括需硬隔离、需锚定、需互斥、需禁用、需降级。\n\n| 治理动作 | 解决的边界问题 | 实例 |\n| :--- | :--- | :--- |\n| 合并 | 程度副词当标签用，阈值随标注员漂移 | 明显崩坏与轻微崩坏合并为崩坏，程度改由严重度字段承载 |\n| 重命名 | 陈述式标签描述属性而非缺陷，标注员无法判断打标方向 | 动态时序一致性改为动态时序不一致，动作文本响应改为动作未响应 |\n| 移出 | 同一缺陷在两个维度各留一份 | 动态美学下的全部音频标签（音频基础质量差、音画不同步、音画不匹配、声音融合与切换等）移出，统一归音频评测维度 |\n| 删除 | 缺少客观锚点，或与既有标签高度重叠 | 镜头连贯性与指令遵循的镜头时序问题重叠，删除 |\n| 需硬隔离 | 两个标签的表象经常同时出现，标注员双打 | 细节纹理抖动只判帧间位移与闪烁，纹理虚假只判单帧渲染错误 |\n| 需锚定 | 灰色案例没有归口判据 | 速度违反物理规律归动态质量的速度异常，速度符合物理但违反 prompt 归指令遵循的播放速度不符 |\n| 需互斥 | 长程问题与微观问题同时触发 | 动态时序不一致管 3 秒以上的长程逻辑，卡顿掉帧感管帧间插值平滑度 |\n| 需禁用 | 缺陷来自输入条件而非模型 | prompt 本身叙事碎片化时停用叙事不连贯，不因剧本混乱惩罚模型 |\n| 需降级 | 兜底标签抢占具体标签 | 复杂文本理解错误仅在无法拆解为具体标签时启用 |\n\n处理顺序固定：先合并归一，再补各档锚点示例，最后才纳入训练集。\n\n### Open Source\n\n<div align=\"center\">\n  <iframe\n          data-src=\"surveys/benchmark-2.html\"\n          data-name=\"Video Generation Benchmarks\"\n          data-path=\"surveys/benchmark-2.html\"\n          style=\"width:100%;height:620px;border:1px solid #e4e7ec;border-radius:12px;\" title=\"Video Generation Benchmarks · 预览\" srcdoc=\"&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;zh&quot;&gt;&#10;&lt;head&gt;&#10;&lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#10;&lt;title&gt;文档预览&lt;/title&gt;&#10;&lt;style&gt;&#10;  :root{&#10;    --bg:#ffffff; --bg-soft:#f6f7f9; --ink:#111418; --ink-soft:#5b636e; --ink-faint:#8b929c;&#10;    --line:#e4e7ec; --brand:#2f6bff; --brand-soft:#eaf0ff;&#10;    --sans:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,&quot;PingFang SC&quot;,&quot;Hiragino Sans GB&quot;,&quot;Microsoft YaHei&quot;,sans-serif;&#10;    --mono:&quot;SF Mono&quot;,ui-monospace,Menlo,Consolas,monospace;&#10;  }&#10;  *{box-sizing:border-box}&#10;  html,body{margin:0;height:100%}&#10;  body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:14px;&#10;       -webkit-font-smoothing:antialiased;display:flex;flex-direction:column}&#10;&#10;  /* ── toolbar ── */&#10;  .bar{flex:none;display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid var(--line);&#10;       background:var(--bg-soft)}&#10;  .file{display:flex;align-items:center;gap:8px;min-width:0}&#10;  .ico{width:22px;height:22px;border-radius:5px;background:var(--brand);color:#fff;font-size:10px;font-weight:800;&#10;       display:flex;align-items:center;justify-content:center;flex:none}&#10;  .name{font-size:13px;font-weight:700;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}&#10;  .path{font-family:var(--mono);font-size:10.5px;color:var(--ink-faint);white-space:nowrap}&#10;  .spacer{flex:1 1 auto}&#10;  .zoom{display:flex;align-items:center;gap:4px;flex:none}&#10;  .zoom button{appearance:none;width:26px;height:26px;border:1px solid var(--line);background:#fff;border-radius:7px;&#10;        font-family:inherit;font-size:14px;font-weight:700;color:var(--ink-soft);cursor:pointer;padding:0;&#10;        display:flex;align-items:center;justify-content:center;transition:.12s}&#10;  .zoom button:hover{border-color:var(--brand);color:var(--brand)}&#10;  .zval{font-family:var(--mono);font-size:11px;color:var(--ink-soft);min-width:42px;text-align:center}&#10;  .open{font-size:12px;font-weight:700;color:#fff;background:var(--brand);text-decoration:none;&#10;        padding:6px 13px;border-radius:8px;white-space:nowrap;flex:none;transition:.14s}&#10;  .open:hover{background:#1f57d8}&#10;&#10;  /* ── page viewport ──────────────────────────────────────────────────────&#10;     预览 = 真实页面装在一个「桌面视口」大小的 iframe 里，再整体缩小，跟&#10;     PDF/PPT 预览窗一个意思。&#10;     iframe 高度必须是一个真实视口高度（900px），不能按文档总高去撑：survey 那边&#10;     有 min-height:100vh 的区块，iframe 高 16000px 时这些区块就跟着变成 16000px，&#10;     第一屏把正文全顶到看不见的地方，预览里只剩一根侧栏目录。 */&#10;  .view{flex:1 1 auto;min-height:0;overflow:auto;background:#eceef1;padding:14px;position:relative}&#10;  /* transform:scale 不改变布局占位，所以缩放要分两层：外层 .wrap 拿缩放后的&#10;     实际尺寸（决定居中与滚动条），内层 .sheet 保持 1240px 原始宽度再整体缩小。&#10;     只用一层的话，元素照 1240px 占位，容器窄于它就会往右溢出被裁掉。 */&#10;  .wrap{margin:0 auto;overflow:hidden;background:#fff;box-shadow:0 2px 14px rgba(17,20,24,.13);border-radius:3px}&#10;  .sheet{transform-origin:top left;position:relative}&#10;  .sheet iframe{display:block;width:100%;border:0;background:#fff}&#10;  .loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;&#10;           color:var(--ink-faint);font-size:12.5px;background:#eceef1;z-index:4}&#10;  @media (max-width:640px){ .path{display:none} }&#10;&lt;/style&gt;&#10;&lt;/head&gt;&#10;&lt;body&gt;&#10;  &lt;div class=&quot;bar&quot;&gt;&#10;    &lt;div class=&quot;file&quot;&gt;&#10;      &lt;span class=&quot;ico&quot;&gt;HTML&lt;/span&gt;&#10;      &lt;span class=&quot;name&quot; id=&quot;fname&quot;&gt;…&lt;/span&gt;&#10;    &lt;/div&gt;&#10;    &lt;span class=&quot;path&quot; id=&quot;fpath&quot;&gt;&lt;/span&gt;&#10;    &lt;span class=&quot;spacer&quot;&gt;&lt;/span&gt;&#10;    &lt;div class=&quot;zoom&quot;&gt;&#10;      &lt;button id=&quot;zo&quot; title=&quot;缩小&quot;&gt;−&lt;/button&gt;&#10;      &lt;span class=&quot;zval&quot; id=&quot;zv&quot;&gt;45%&lt;/span&gt;&#10;      &lt;button id=&quot;zi&quot; title=&quot;放大&quot;&gt;＋&lt;/button&gt;&#10;    &lt;/div&gt;&#10;    &lt;a class=&quot;open&quot; id=&quot;open&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;打开完整页面 ↗&lt;/a&gt;&#10;  &lt;/div&gt;&#10;&#10;  &lt;div class=&quot;view&quot; id=&quot;view&quot;&gt;&#10;    &lt;div class=&quot;wrap&quot; id=&quot;wrap&quot;&gt;&#10;      &lt;div class=&quot;sheet&quot; id=&quot;sheet&quot;&gt;&#10;        &lt;iframe id=&quot;frame&quot; title=&quot;预览&quot; scrolling=&quot;yes&quot;&gt;&lt;/iframe&gt;&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;&#10;    &lt;div class=&quot;loading&quot; id=&quot;loading&quot;&gt;正在载入预览…&lt;/div&gt;&#10;  &lt;/div&gt;&#10;&#10;&lt;script&gt;&#10;// 目标页面与显示名可以外部传入，同一个壳复用给多个文档。&#10;// 取值顺序：宿主 &lt;iframe&gt; 上的 data-* → URL query → 缺省。&#10;// data-* 这条是主路径：build.py 会把本文件整个内联成 srcdoc，srcdoc 没有&#10;// query string，但 srcdoc 与父页同源，所以能从 window.frameElement 读属性。&#10;const host = (()=&gt;{ try { return window.frameElement || null; } catch(e) { return null; } })();&#10;const ds   = (host &amp;&amp; host.dataset) || {};&#10;const q    = new URLSearchParams(location.search);&#10;const SRC  = ds.src  || q.get('src')  || 'surveys/survey.html';&#10;const NAME = ds.name || q.get('name') || 'RL for Spatio-Temporal Video Grounding';&#10;const PATH = ds.path || q.get('path') || SRC;&#10;&#10;// 按桌面视口渲染再整体缩小 —— 否则窄容器里页面会走响应式布局，&#10;// 预览出来的不是真实版式。高度取真实视口高度，见上面样式里的说明。&#10;const PAGE_W = 1240, PAGE_H = 900;&#10;const STEPS = [0.35,0.45,0.6,0.75,0.9,1];&#10;let si = 2;&#10;&#10;const view=document.getElementById('view'), sheet=document.getElementById('sheet'),&#10;      wrap=document.getElementById('wrap'), frame=document.getElementById('frame'),&#10;      loading=document.getElementById('loading');&#10;&#10;document.getElementById('fname').textContent = NAME;&#10;document.getElementById('fpath').textContent = PATH;&#10;document.getElementById('open').href = SRC;&#10;&#10;sheet.style.width = PAGE_W + 'px';&#10;frame.style.height = PAGE_H + 'px';&#10;frame.src = SRC;&#10;&#10;function applyZoom(){&#10;  const k = STEPS[si];&#10;  document.getElementById('zv').textContent = Math.round(k*100) + '%';&#10;  sheet.style.transform = 'scale(' + k + ')';&#10;  wrap.style.width  = (PAGE_W * k) + 'px';&#10;  wrap.style.height = (PAGE_H * k) + 'px';&#10;}&#10;document.getElementById('zi').onclick = ()=&gt;{ if(si&lt;STEPS.length-1){si++;applyZoom();} };&#10;document.getElementById('zo').onclick = ()=&gt;{ if(si&gt;0){si--;applyZoom();} };&#10;&#10;frame.addEventListener('load', ()=&gt;{ loading.style.display='none'; });&#10;// 页签从 display:none 变可见时重摆一次（隐藏时容器宽度是 0，居中算不准）&#10;if (window.ResizeObserver) new ResizeObserver(applyZoom).observe(view);&#10;window.addEventListener('resize', applyZoom);&#10;applyZoom();&#10;&lt;/script&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;&#10;\"></iframe>\n</div>\n"}, {"id": "data", "label": "Data", "tab": true, "parent": null, "md": "## Contents\n\n- [Data Distribution](#data-distribution)\n- [Perception Data](#perception-data)\n  - [Pre / Mid Training](#pre-mid-training)\n  - [Human Labeled](#human-labeled)\n- [Aligment Data](#aligment-data)\n\n历史标注数据粒度是视频级结论：一条视频被判为阳性或阴性，标注只给出是否存在问题，不给出问题发生在哪一帧、画面中的哪个位置、为什么被判定为该问题。视频级标注存在的问题：\n- **训练信号缺失**：critic 需要提供监督信号是\"哪一帧、哪个位置、为什么\"，只给结论的标注提供不了这个信号，无法用于 grounding 与 reasoning 训练。\n- **无法失败归因**：critic 的失败模式无法归因分析，无法针对性补强此部分能力持续优化。\n\n### Data Distribution\n\nomini 参考素材分布：从 ABC 线上真实用户数据回捞多模态 omni 生成数据。视频质检不局限于单参考场景的T2V / I2V 等简单场景。数据分布需要呈现真实用户生产场景的视频生成，因此我们需要构造难度分级的训练数据 & 评测数据，且评测数据横跨不同模态，不同参考素材量级，不同复杂程度的指令等维度。\n\n多难度分布：疑似存在问题的样本需要保留，否则将拉低模型的召回能力。\n\n感知与偏好对齐解耦：\n- **解耦业务与模型**：评测体系可随业务需求动态迭代，VLM 底层感知的原子能力保持稳定建设。\n- **失败模式归因**：模型在某个维度表现差，可回溯到具体原子能力不足，针对性补充预训练 / 中训练数据。\n\n因此质检数据集按训练阶段分为两类：**Perception Data** 驱动模型基础感知能力的 Pre/Mid Training，**Alignment Data** 驱动偏好判别规则的 SFT/RFT。\n\n<table>\n<thead>\n<tr>\n<th>训练阶段</th>\n<th>数据类型</th>\n<th>核心标注字段</th>\n<th>关键注意事项</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td rowspan=\"3\"><strong>Perception</strong><br><small>Pre / Mid Training</small></td>\n<td>正例（命中标签，真实 Badcase）</td>\n<td>维度、帧区间、bbox、严重度、observation、evidence</td>\n<td>允许单条视频标注多个问题；须帧级 grounding</td>\n</tr>\n<tr>\n<td>负例</td>\n<td>无缺陷判断、关键正常证据、不可误判边界</td>\n<td>防止模型只会挑错；正负例比例需合理配比，控制误报</td>\n</tr>\n<tr>\n<td>反事实</td>\n<td>缺陷类型、修改时段与区域、修改前后对照</td>\n<td>单变量修改为原则；避免篡改痕迹（压缩块、颜色断层）成为模型的识别捷径</td>\n</tr>\n<tr>\n<td rowspan=\"2\"><strong>Alignment</strong><br><small>SFT / RFT</small></td>\n<td>Pointwise</td>\n<td>reasoning、severity、label</td>\n<td>依赖 Agentic Critic 上线后的人机协同复核：Critic 召回疑似问题 → 人工复核修正 → 回流难负样本</td>\n</tr>\n<tr>\n<td>Pairwise / Listwise</td>\n<td>glb-rank、glb-reasoning、l2-rank、l2-reasoning</td>\n<td>优先构建难度接近的对组；避免模型只学习明显质量差异，忽略细粒度判别能力</td>\n</tr>\n</tbody>\n</table>\n\n### Perception Data\n\n基础感知数据，本质是将 VLM 的复杂世界知识对齐到视频的像素空间中，从而得到对疑似有问题的视频段进行时空定位。\n\n#### Pre / Mid Training\n评测所需的原子感知能力，指导基础模型的能力补强：\n\n| 质检原子感知能力 | 核心任务 | 主要覆盖的现有评测维度 |\n| :--- | :--- | :--- |\n| 条件与约束理解 | 解析主体、动作、属性、空间关系、运镜、时序、音频及参考条件 | 指令遵循、人图一致性、音频一致性 |\n| 静态视觉质量感知 | 识别曝光、清晰度、伪影、边缘、纹理、材质、文字和局部结构异常 | 画面基础质量、清晰度、部分结构崩坏 |\n| 对象身份与属性追踪 | 跨帧、跨镜头绑定主体，判断身份、数量、颜色、服饰和场景变化 | 主体一致性、场景一致性、颜色与风格一致性 |\n| 运动与时序稳定性感知 | 识别跳变、抖动、闪烁、扭曲、卡顿、异常静止和速度异常 | 动态基础质量、动态幅度 |\n| 空间、交互与物理判断 | 判断位置、方向、遮挡、接触、支撑、轨迹、结构和现实常识 | 合理性、主体交互、运动真实性、空间关系 |\n| 动作、事件与多镜头理解 | 识别动作阶段、事件顺序、镜头结构及跨镜头叙事 | 动作响应、多镜头遵循、叙事完整性与连贯性 |\n| 音频与跨模态理解 | 识别语音、音乐、音效、音质及音画同步和匹配 | 音频质量、音频遵循、音画叙事 |\n| 审美与专家偏好判断 | 判断构图、光影、服化、表演、节奏、创意和整体表现力 | 画面美学、动态美学、视听叙事 |\n| 证据化质检推理 | 定位对象、时间和区域，给出证据、理由、置信度和不可判定判断 | 所有评测维度的质检输出 |\n\n\n#### Human Labeled\n感知数据的标注规范清晰，对于模型基础能力缺失部分，依赖于人标。\n标注规范：每条视频质检数据，需要以帧级别标注其存在的所有质检标签。以下是单条视频质检数据 Demo：\n\n<div align=\"center\">\n  <iframe style=\"width:100%;height:600px;border:1px solid #e4e7ec;border-radius:12px;\" title=\"统一标注数据格式 · Pointwise Demo\" srcdoc=\"&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;zh&quot;&gt;&#10;&lt;head&gt;&#10;&lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#10;&lt;title&gt;ABC-Critic 帧级标注 Demo&lt;/title&gt;&#10;&lt;style&gt;&#10;/* 设计令牌 + reset：颜色、优先级调色板 P0–P4、字体栈 */&#10;  :root{&#10;    --bg:#ffffff; --bg-soft:#f6f7f9; --ink:#111418; --ink-soft:#5b636e; --ink-faint:#8b929c;&#10;    --line:#e4e7ec; --brand:#2f6bff; --brand-soft:#eaf0ff;&#10;    --subj:#8b5cf6; --subj-soft:#f3ecff; --subj-line:#e0d0ff;&#10;    --warn:#e0701a; --warn-soft:#fff3e6; --warn-line:#ffd9b0;&#10;    --dup:#d92c6a;  --dup-soft:#ffe9f1;  --dup-line:#ffc3d8;&#10;    --stmt:#0ea5a3; --stmt-soft:#e2f7f6; --stmt-line:#a9e6e3;&#10;    /* priority palette P0..P4 */&#10;    --p0:#e5484d; --p0-soft:#ffeaea; --p0-line:#ffc9cb;&#10;    --p1:#e0701a; --p1-soft:#fff1e3; --p1-line:#ffd6ac;&#10;    --p2:#d4a017; --p2-soft:#fdf6e3; --p2-line:#f0e0a8;&#10;    --p3:#2f6bff; --p3-soft:#eaf0ff; --p3-line:#cbdcff;&#10;    --p4:#5b636e; --p4-soft:#eef1f4; --p4-line:#d8dde3;&#10;    --sans:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,&quot;PingFang SC&quot;,&quot;Hiragino Sans GB&quot;,&quot;Microsoft YaHei&quot;,sans-serif;&#10;    --mono:&quot;SF Mono&quot;,ui-monospace,Menlo,Consolas,monospace;&#10;  }&#10;  *{box-sizing:border-box}&#10;  html,body{margin:0;height:100%}&#10;  body{background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.55;-webkit-font-smoothing:antialiased;font-size:14px}&#10;  .wrap{display:flex;flex-direction:column;height:100%}&#10;&#10;/* 播放器主体样式：demo 选择条、视频列、grounding 框叠加层、时间轴、&#10;   时间戳跳转芯片、深色 JSON 卡。modal 宿主与内联宿主共用这一份。&#10;   组件源自 skills/chart-blocks/templates/frame-annotation-modal。&#10;   仅依赖宿主的 --mono 令牌，其余颜色自带。 */&#10;  .demostrip{display:flex;gap:7px;padding:11px 20px 0;flex-wrap:wrap;flex:none;background:#fff}&#10;  .demopill{appearance:none;border:1px solid #d0d0d0;background:#f2f2f4;color:#555;&#10;            font-family:inherit;font-size:11.5px;font-weight:650;padding:5px 12px;border-radius:999px;cursor:pointer;transition:.12s}&#10;  .demopill:hover{border-color:#aaa;color:#1c1c1e}&#10;  .demopill.on{background:#2f6bff;border-color:#2f6bff;color:#fff}&#10;  /* two-column body: video left, json right — minmax(0,..) lets both columns shrink&#10;     so neither can push its content past the modal frame */&#10;  .mbody{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:0;min-height:0;overflow:auto}&#10;  .vcol{padding:18px 20px;border-right:1px solid #e0e0e0;min-width:0;background:#fff;display:flex;flex-direction:column;min-height:0}&#10;  .jcol{padding:16px;min-width:0;background:#f5f5f7;overflow:auto;display:flex}&#10;  .vcap{font-size:12px;color:#6b6b6b;margin:0 0 10px}&#10;  .vcap b{color:#1c1c1e;font-weight:700}&#10;  /* stable 16:9 box: swapping demo src can no longer collapse/resize the frame (kills flicker) */&#10;  .video-wrapper{position:relative;border-radius:11px;overflow:hidden;background:#000;line-height:0;aspect-ratio:16/9;max-height:56vh;flex:none}&#10;  .video-wrapper video{width:100%;height:100%;display:block;object-fit:contain;cursor:pointer;opacity:1;transition:opacity .18s ease}&#10;&#10;  /* ── frame-level grounding boxes, laid over the video ──&#10;     The layer is sized/positioned by fitAnnotationLayer() to the video's OWN&#10;     letterboxed content rect, not the wrapper — otherwise every box drifts by&#10;     the size of the black bars. */&#10;  .annotation-layer{position:absolute;z-index:2;pointer-events:none;overflow:visible;opacity:1;transition:opacity .18s ease}&#10;  .annotation-box{position:absolute;border:2px solid #ff3b30;border-radius:3px;&#10;                  box-shadow:0 0 0 1px rgba(0,0,0,.65),0 0 12px rgba(255,59,48,.38);&#10;                  animation:annotationPulse 1.15s ease-in-out infinite alternate}&#10;  .annotation-box[data-sev=&quot;2&quot;]{border-color:#e0701a;box-shadow:0 0 0 1px rgba(0,0,0,.65),0 0 12px rgba(224,112,26,.38);animation:none}&#10;  .annotation-box[data-sev=&quot;1&quot;]{border-color:#d4a017;box-shadow:0 0 0 1px rgba(0,0,0,.65),0 0 12px rgba(212,160,23,.38);animation:none}&#10;  .annotation-box span{position:absolute;left:-2px;top:-23px;max-width:260px;overflow:hidden;text-overflow:ellipsis;&#10;                       white-space:nowrap;padding:3px 6px;border-radius:3px 3px 3px 0;background:rgba(155,18,15,.92);&#10;                       color:#ffcbc7;font-size:11px;line-height:1.25;font-weight:700;letter-spacing:.2px;&#10;                       text-shadow:0 1px 1px #000;box-shadow:0 1px 5px rgba(0,0,0,.5)}&#10;  .annotation-box[data-sev=&quot;2&quot;] span{background:rgba(150,72,10,.92);color:#ffe0c4}&#10;  .annotation-box[data-sev=&quot;1&quot;] span{background:rgba(133,99,8,.92);color:#ffeec0}&#10;  /* box hugging the top edge — flip the label inside so it isn't clipped away */&#10;  .annotation-box.near-top span{top:2px;left:2px;border-radius:3px}&#10;  @keyframes annotationPulse{&#10;    from{border-color:#ff3b30}&#10;    to{border-color:#ff7b72;box-shadow:0 0 0 1px rgba(0,0,0,.65),0 0 18px rgba(255,59,48,.62)}&#10;  }&#10;&#10;  .vcontrols{position:absolute;left:0;right:0;bottom:0;z-index:3;padding:12px 14px 10px;&#10;             background:linear-gradient(transparent,rgba(0,0,0,.72));display:flex;flex-direction:column;gap:9px;&#10;             opacity:0;transition:opacity .2s}&#10;  .video-wrapper:hover .vcontrols,.vcontrols.show{opacity:1}&#10;  /* timeline / progress with problem-frame markers */&#10;  .track{position:relative;height:22px;display:flex;align-items:center;cursor:pointer}&#10;  .rail{position:absolute;left:0;right:0;height:5px;border-radius:3px;background:rgba(255,255,255,.25)}&#10;  .rfill{position:absolute;left:0;height:5px;border-radius:3px;background:#3b82f6;width:0;pointer-events:none}&#10;  .mark{position:absolute;top:50%;width:13px;height:13px;border-radius:50%;transform:translate(-50%,-50%);&#10;        border:2px solid #fff;cursor:pointer;transition:.12s;z-index:2}&#10;  .mark:hover{transform:translate(-50%,-50%) scale(1.25)}&#10;  .mark.act{box-shadow:0 0 0 3px rgba(255,255,255,.5)}&#10;  .mark[data-sev=&quot;3&quot;]{background:#e5484d}&#10;  .mark[data-sev=&quot;2&quot;]{background:#e0701a}&#10;  .mark[data-sev=&quot;1&quot;]{background:#d4a017}&#10;  .crow{display:flex;align-items:center;gap:11px}&#10;  .cbtn{background:none;border:0;padding:0;cursor:pointer;color:#fff;font-size:16px;line-height:1;flex:none;transition:opacity .2s}&#10;  .cbtn:hover{opacity:.8}&#10;  .ctime{font-size:11.5px;color:#e8e8ea;font-variant-numeric:tabular-nums;flex:none;text-shadow:0 1px 2px rgba(0,0,0,.6)}&#10;  .cspacer{flex:1}&#10;  .jumpwrap{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}&#10;  .jump{appearance:none;border:1px solid #d0d0d0;background:#f2f2f4;color:#555;&#10;        font-family:var(--mono);font-size:11px;font-weight:600;padding:4px 9px;border-radius:7px;cursor:pointer;transition:.12s;&#10;        display:inline-flex;align-items:center;gap:6px}&#10;  .jump:hover{border-color:#aaa;color:#1c1c1e}&#10;  .jump.act{border-color:#3b82f6;color:#2f6bff;background:rgba(59,130,246,.1)}&#10;  .jump .jd{width:7px;height:7px;border-radius:50%}&#10;  .jump .jd[data-sev=&quot;3&quot;]{background:#e5484d}.jump .jd[data-sev=&quot;2&quot;]{background:#e0701a}.jump .jd[data-sev=&quot;1&quot;]{background:#d4a017}&#10;  /* json panel — dark editor card */&#10;  .jcard{display:flex;flex-direction:column;width:100%;min-width:0;background:#1a1d24;border-radius:10px;&#10;         overflow:hidden;box-shadow:0 4px 12px rgba(0,0,0,.18);align-self:flex-start;max-height:100%}&#10;  .jhead{display:flex;align-items:center;gap:8px;margin:0;padding:10px 14px;background:#0f1117;&#10;         border-bottom:1px solid rgba(255,255,255,.08);flex:none}&#10;  .jhead .jt{font-size:12.5px;font-weight:600;color:#9CA3AF;font-family:var(--mono)}&#10;  .jhead .jc{margin-left:auto;font-size:15px;color:#9CA3AF;cursor:pointer;transition:.2s}&#10;  .jhead .jc:hover{color:#F8FAFC}&#10;  .jhead .jc.copied{color:#10B981}&#10;  .jbodywrap{padding:14px 16px;overflow:auto;min-height:0}&#10;  /* pre-wrap, not pre: `reasoning` is a full sentence and would otherwise run off&#10;     the card into a horizontal scrollbar nobody finds */&#10;  pre.json{margin:0;font-family:var(--mono);font-size:12.5px;line-height:1.7;color:#E5E7EB;white-space:pre-wrap;word-break:break-word}&#10;  .json .jk{color:#60A5FA}.json .js{color:#34D399}.json .jn{color:#F59E0B}.json .jp{color:#6B7280}&#10;  .jempty{color:#6B7280;font-size:12px;font-family:var(--mono);white-space:normal}&#10;  @media(max-width:760px){.mbody{grid-template-columns:1fr}.vcol{border-right:0;border-bottom:1px solid #e0e0e0}}&#10;&#10;/* 标注 modal 的壳：遮罩、窗口、macOS 标题栏与红黄绿灯。&#10;   播放器主体样式在 45-player.css（与内联宿主共用），这里只管「弹窗」这层。&#10;   body.kc-expanded 那几条是被父页 srcdoc 内联时的全屏协商，见 00-iframe.js。&#10;   黄/绿灯是纯装饰，没有 handler —— 只有红灯接了 closeModal。 */&#10;  .overlay{position:fixed;inset:0;background:rgba(12,15,20,.55);backdrop-filter:blur(3px);&#10;           display:none;align-items:center;justify-content:center;z-index:50;padding:24px}&#10;  .overlay.on{display:flex}&#10;  /* when a parent page has blown this iframe up to fullscreen, the host card is&#10;     hidden and the overlay goes transparent — the parent dims+blurs the REAL page&#10;     behind us, so the modal floats over the (blurred) page, not over our own card. */&#10;  body.kc-expanded .wrap{visibility:hidden}&#10;  /* background:transparent only takes effect once the modal is actually open (same&#10;     frame as .overlay.on). Going transparent on button-click would land BEFORE the&#10;     parent's scrim and flash the white page through. */&#10;  body.kc-expanded.kc-modal-open{background:transparent}&#10;  body.kc-expanded.kc-modal-open .overlay{background:transparent;backdrop-filter:none;padding:0}&#10;  .modal{width:min(1240px,100%);max-height:92vh;background:#ffffff;color:#1c1c1e;border-radius:12px;&#10;         overflow:hidden;display:flex;flex-direction:column;box-shadow:0 24px 70px rgba(0,0,0,.45)}&#10;  .mhead{display:flex;align-items:center;gap:10px;padding:13px 20px;background:#ebebeb;&#10;         border-bottom:1px solid #d0d0d0;flex:none;min-height:44px}&#10;  .mhead .mt{font-size:15px;font-weight:700;color:#1c1c1e}&#10;  .mhead .mp{font-family:var(--mono);font-size:11px;color:#8e8e93}&#10;  .mhead .mbadge{font-size:9.5px;font-weight:800;padding:2px 7px;border-radius:6px;letter-spacing:.03em;color:#fff}&#10;  /* macOS traffic-light close/min/max buttons */&#10;  .traflights{display:flex;align-items:center;gap:8px;margin-right:10px;flex:none}&#10;  .tfl{appearance:none;border:0;padding:0;width:13px;height:13px;border-radius:50%;cursor:pointer;transition:.1s;flex:none}&#10;  .tfl-r{background:#ff5f57}.tfl-r:hover{background:#e0443e}&#10;  .tfl-y{background:#febc2e}.tfl-y:hover{background:#e0a325}&#10;  .tfl-g{background:#28c840}.tfl-g:hover{background:#1eab32}&#10;  /* demo selector strip */&#10;&#10;/* 内联播放器宿主：把「标签体系里点 ▷ Play 弹出的那个 modal」原样摊平成页面里的&#10;   一张静态卡片（Pointwise 数据示例用）。&#10;&#10;   关键点：DOM 与样式都不另起一套 —— 内联版直接复用 html/50-modal.html 的 modal&#10;   本体和 45-player.css / 50-modal.css 的全部样式，这里只做三件事：&#10;     ① 解除 .overlay 的 fixed 定位，让它退化成普通文档流容器；&#10;     ② 去掉弹窗特征（大投影、92vh 限高、圆角裁切保留）；&#10;     ③ 隐藏只在弹窗里有意义的红黄绿灯（这里没有「关闭」这回事）。&#10;   旧版这里是一套深色 .card/.head 外壳 + 逐条覆盖播放器颜色，等于把同一个组件&#10;   维护了两遍（浅色一份、深色一份），两边样式已经开始漂移 —— 那正是要消掉的重复。 */&#10;.inline-player{background:#f0f2f5;padding:18px}&#10;/* overlay 退化：不再 fixed 铺满、不再变暗模糊，就是个居中的块 */&#10;.inline-player .overlay{position:static;inset:auto;display:block;background:none;&#10;  -webkit-backdrop-filter:none;backdrop-filter:none;padding:0;z-index:auto}&#10;.inline-player .modal{margin:0 auto;max-height:none;&#10;  box-shadow:0 1px 3px rgba(0,0,0,.06),0 8px 24px rgba(0,0,0,.08)}&#10;/* 红黄绿灯是弹窗语义（关闭/最小化/最大化），静态卡片里没有对应动作 */&#10;.inline-player .traflights{display:none}&#10;/* 摊平后卡片高度由内容决定，副标题（原 modal 的面包屑）推到行尾更像页面标题栏 */&#10;.inline-player .mhead .mp{margin-left:auto}&#10;/* JSON 列：弹窗里是 92vh 高的固定框，摊平后没有那个高度约束，&#10;   jcard 用 align-self:flex-start 就只包住文字，右侧留一大片空白。&#10;   这里让它撑满整列，与左侧视频列齐高。 */&#10;.inline-player .jcard{align-self:stretch}&#10;.inline-player .jhint{max-width:1240px;margin:12px auto 0;font-size:11.5px;color:#6b7787;line-height:1.6}&#10;&lt;/style&gt;&#10;&lt;/head&gt;&#10;&lt;body class=&quot;inline-player&quot;&gt;&#10;&lt;!-- 这里内联的就是 html/50-modal.html 那一份 modal 本体（含播放器），不另写一套：&#10;     「Pointwise 数据实际呈现」与标签体系里点 ▷ Play 弹出的，必须是同一个组件。&#10;     区别只在 60-inline.css 把它从悬浮弹窗摊平成页面里的静态卡片。 --&gt;&#10;&lt;!-- 标注 modal：视频 + 帧级 grounding 框 + 帧级 JSON&#10;     组件来自 skills/chart-blocks/templates/frame-annotation-modal，&#10;     相比旧版新增：画面上的 grounding 框叠加层（#v-layer）与 #v-wrap 定位锚点。&#10;     黄/绿灯为装饰，无 handler（macOS 观感），只有红灯关闭。 --&gt;&#10;&lt;div class=&quot;overlay&quot; id=&quot;overlay&quot;&gt;&#10;  &lt;div class=&quot;modal&quot; role=&quot;dialog&quot; aria-modal=&quot;true&quot;&gt;&#10;    &lt;div class=&quot;mhead&quot;&gt;&#10;      &lt;div class=&quot;traflights&quot;&gt;&#10;        &lt;button class=&quot;tfl tfl-r&quot; id=&quot;m-close&quot; aria-label=&quot;关闭&quot; title=&quot;关闭&quot;&gt;&lt;/button&gt;&#10;        &lt;button class=&quot;tfl tfl-y&quot; aria-label=&quot;最小化&quot; title=&quot;最小化&quot;&gt;&lt;/button&gt;&#10;        &lt;button class=&quot;tfl tfl-g&quot; aria-label=&quot;最大化&quot; title=&quot;最大化&quot;&gt;&lt;/button&gt;&#10;      &lt;/div&gt;&#10;      &lt;span class=&quot;mt&quot; id=&quot;m-title&quot;&gt;标注数据&lt;/span&gt;&#10;      &lt;span class=&quot;mbadge&quot; id=&quot;m-badge&quot; style=&quot;display:none&quot;&gt;&lt;/span&gt;&#10;      &lt;span class=&quot;mp&quot; id=&quot;m-path&quot;&gt;&lt;/span&gt;&#10;    &lt;/div&gt;&#10;    &lt;div class=&quot;demostrip&quot; id=&quot;m-strip&quot;&gt;&lt;/div&gt;&#10;    &lt;!-- 播放器主体：视频列（含 grounding 框叠加层）+ 帧级 JSON 列。&#10;     modal 壳与内联卡片壳共用这一段，DOM id 是两者的契约。 --&gt;&#10;&lt;div class=&quot;mbody&quot;&gt;&#10;  &lt;div class=&quot;vcol&quot;&gt;&#10;    &lt;p class=&quot;vcap&quot; id=&quot;v-cap&quot;&gt;&lt;/p&gt;&#10;    &lt;div class=&quot;video-wrapper&quot; id=&quot;v-wrap&quot;&gt;&#10;      &lt;video id=&quot;v-el&quot; playsinline preload=&quot;metadata&quot;&gt;&lt;/video&gt;&#10;      &lt;div class=&quot;annotation-layer&quot; id=&quot;v-layer&quot; aria-hidden=&quot;true&quot;&gt;&lt;/div&gt;&#10;      &lt;div class=&quot;vcontrols&quot; id=&quot;v-controls&quot;&gt;&#10;        &lt;div class=&quot;track&quot; id=&quot;v-track&quot;&gt;&#10;          &lt;div class=&quot;rail&quot;&gt;&lt;/div&gt;&#10;          &lt;div class=&quot;rfill&quot; id=&quot;v-fill&quot;&gt;&lt;/div&gt;&#10;        &lt;/div&gt;&#10;        &lt;div class=&quot;crow&quot;&gt;&#10;          &lt;button class=&quot;cbtn&quot; id=&quot;v-play&quot; aria-label=&quot;播放/暂停&quot;&gt;▶&lt;/button&gt;&#10;          &lt;span class=&quot;ctime&quot; id=&quot;v-time&quot;&gt;0:00 / 0:00&lt;/span&gt;&#10;          &lt;span class=&quot;cspacer&quot;&gt;&lt;/span&gt;&#10;          &lt;button class=&quot;cbtn&quot; id=&quot;v-mute&quot; aria-label=&quot;静音&quot;&gt;🔊&lt;/button&gt;&#10;        &lt;/div&gt;&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;&#10;    &lt;div class=&quot;jumpwrap&quot; id=&quot;v-jumps&quot;&gt;&lt;/div&gt;&#10;  &lt;/div&gt;&#10;  &lt;div class=&quot;jcol&quot;&gt;&#10;    &lt;div class=&quot;jcard&quot;&gt;&#10;      &lt;div class=&quot;jhead&quot;&gt;&#10;        &lt;span class=&quot;jt&quot;&gt;frame-annotation.json&lt;/span&gt;&#10;        &lt;span class=&quot;jc&quot; id=&quot;j-copy&quot; title=&quot;复制&quot;&gt;⧉&lt;/span&gt;&#10;      &lt;/div&gt;&#10;      &lt;div class=&quot;jbodywrap&quot;&gt;&#10;        &lt;pre class=&quot;json&quot; id=&quot;j-body&quot;&gt;&lt;span class=&quot;jempty&quot;&gt;点击进度条上的问题帧标记查看该帧标注。&lt;/span&gt;&lt;/pre&gt;&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;&#10;  &lt;/div&gt;&lt;/div&gt;&#10;  &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;p class=&quot;jhint&quot;&gt;每条 5–15s 视频标注它存在的所有质检问题。核心字段：dimension（命中三级标签）、time（问题帧时刻）、grounding（画面坐标）、severity（严重度）、reasoning（判定理由，强制字段）。&lt;/p&gt;&#10;&lt;script&gt;&#10;// ── 数据块：由 tools/gen-chart.mjs 从 data/tag-system.json 生成，勿手改 ──&#10;//   要改标签、优先级、rubric、边界规则 → 改 data/tag-system.json 后重跑生成器。&#10;//   故意压成单行：美化缩进会让本文件膨胀到 4000+ 行，可读的是 JSON 源文件。&#10;const ISSUES = {&quot;collapse&quot;:{&quot;kind&quot;:&quot;confusion&quot;,&quot;label&quot;:&quot;混淆&quot;,&quot;title&quot;:&quot;崩坏 ↔ 合理性·结构异常 / 主体间交互&quot;,&quot;desc&quot;:&quot;「明显 / 轻微崩坏」与「合理性」下的结构异常（生物 / 非生物）、主体间交互，都在描述“画面内容坏掉”。标注员难以稳定区分：整体不可辨识算崩坏，还是主体可辨识但局部结构 / 交互错误。&quot;,&quot;members&quot;:[&quot;明显崩坏&quot;,&quot;轻微崩坏&quot;,&quot;生物类结构异常&quot;,&quot;非生物结构异常&quot;,&quot;主体间交互&quot;],&quot;fix&quot;:&quot;约定判定优先级：主体已不可辨识 → &lt;b&gt;崩坏&lt;/b&gt;；主体可辨识但结构 / 交互错误 → &lt;b&gt;合理性·结构异常 / 主体间交互&lt;/b&gt;。两者互斥、不可并存，并补充各档锚点示例视频。&quot;},&quot;temporal&quot;:{&quot;kind&quot;:&quot;dup&quot;,&quot;label&quot;:&quot;重复&quot;,&quot;title&quot;:&quot;动态时序一致性 / 光影风格时序一致性 ↔ 一致性·(时序 / 风格)&quot;,&quot;desc&quot;:&quot;动态质量下的「动态时序一致性」「光影风格时序一致性」与一致性维度下的时序连贯 / 风格一致性语义重叠，同一现象可能被同时打到两个维度。&quot;,&quot;members&quot;:[&quot;动态时序一致性&quot;,&quot;光影风格时序一致性&quot;,&quot;风格一致性&quot;,&quot;叙事连贯性&quot;,&quot;镜头连贯性&quot;],&quot;fix&quot;:&quot;按作用范围收敛到单一归属：&lt;b&gt;跨镜头 / 长程&lt;/b&gt;一致性归「一致性」维度；&lt;b&gt;单镜头内逐帧&lt;/b&gt;抖动 / 风格漂移归「动态质量」。避免同一 trial 双记。&quot;},&quot;audio&quot;:{&quot;kind&quot;:&quot;dup&quot;,&quot;label&quot;:&quot;重复&quot;,&quot;title&quot;:&quot;动态美学·音频项 ↔ 音频评测维度&quot;,&quot;desc&quot;:&quot;「动态美学及视听叙事」下的 音频基础质量差 / 音画不同步 / 音画不匹配，与独立的「音频评测维度」（音质、音画同步·音画不匹配）重复。&quot;,&quot;members&quot;:[&quot;音频基础质量差&quot;,&quot;音画不同步&quot;,&quot;音画不匹配&quot;,&quot;失真感知&quot;,&quot;口型匹配度&quot;],&quot;fix&quot;:&quot;音频客观判定统一收到「&lt;b&gt;音频评测维度&lt;/b&gt;」；「动态美学」仅保留与叙事 / 情绪耦合的纯主观视听项，删除与音频维度重复的客观项。&quot;}};&#10;const STMT = new Set([&quot;音频一致性&quot;,&quot;音乐音效一致连贯性&quot;,&quot;人声一致连贯性&quot;,&quot;动作或表演连贯性&quot;,&quot;方位连贯性&quot;,&quot;空间位置连贯性&quot;,&quot;镜头连贯性&quot;,&quot;叙事连贯性&quot;,&quot;场景一致性&quot;,&quot;主体一致性&quot;,&quot;颜色一致性&quot;,&quot;风格一致性&quot;,&quot;动态时序一致性&quot;,&quot;光影风格时序一致性&quot;,&quot;运动真实性&quot;,&quot;表演真实性&quot;,&quot;口型匹配度&quot;]);&#10;const ING = new Set([&quot;主体不一致&quot;,&quot;动作或表演不连贯&quot;,&quot;动作缺失&quot;,&quot;动作细节不足&quot;,&quot;表情不符&quot;,&quot;动作时序遗漏&quot;,&quot;动作时序顺序错误&quot;,&quot;动作速度不符&quot;,&quot;动作未响应&quot;,&quot;运镜类型错误&quot;,&quot;运镜速度不符&quot;,&quot;运镜时序遗漏&quot;,&quot;运镜时序顺序错误&quot;,&quot;景别与拍摄视角错误&quot;,&quot;运镜未响应&quot;,&quot;主体未响应&quot;,&quot;环境未响应&quot;,&quot;崩坏&quot;,&quot;不符合物理规律&quot;,&quot;生物结构异常&quot;,&quot;不符合现实常识&quot;,&quot;油腻感&quot;,&quot;曝光光影或色彩异常&quot;,&quot;画面文字不可读&quot;]);&#10;const DEMOS = {&quot;主体一致性&quot;:[{&quot;label&quot;:&quot;demo-01 · 换脸&quot;,&quot;badge&quot;:&quot;负例&quot;,&quot;src&quot;:&quot;assets/videos/sintel10.mp4&quot;,&quot;caption&quot;:&quot;素材：&lt;b&gt;同一角色多镜头&lt;/b&gt;。切镜后主体身份漂移。&quot;,&quot;frames&quot;:[{&quot;time&quot;:5.5,&quot;dimension&quot;:&quot;主体一致性&quot;,&quot;target&quot;:&quot;主角人物&quot;,&quot;grounding&quot;:&quot;bbox: [260,120,560,460]&quot;,&quot;severity&quot;:3,&quot;reasoning&quot;:&quot;切镜后角色发色、脸型与首镜头明显不一致，跨镜头主体身份未保持，判定主体一致性问题。&quot;,&quot;box&quot;:{&quot;x&quot;:20.31,&quot;y&quot;:16.67,&quot;w&quot;:23.44,&quot;h&quot;:47.22}}]}],&quot;曝光光影或色彩异常&quot;:[{&quot;label&quot;:&quot;demo-01 · 过曝&quot;,&quot;badge&quot;:&quot;负例&quot;,&quot;src&quot;:&quot;assets/videos/jelly10.mp4&quot;,&quot;caption&quot;:&quot;素材：&lt;b&gt;水下光照场景&lt;/b&gt;。高光区域整体过曝。&quot;,&quot;frames&quot;:[{&quot;time&quot;:1.1,&quot;dimension&quot;:&quot;曝光光影或色彩异常&quot;,&quot;target&quot;:&quot;水母及周边水体&quot;,&quot;grounding&quot;:&quot;bbox: [300,150,700,480]&quot;,&quot;severity&quot;:2,&quot;reasoning&quot;:&quot;高光区域溢出成纯白块，丢失纹理细节，且冷暖色温在同帧内冲突，属曝光/色彩异常。&quot;,&quot;box&quot;:{&quot;x&quot;:23.44,&quot;y&quot;:20.83,&quot;w&quot;:31.25,&quot;h&quot;:45.83}}]}],&quot;波动扭曲&quot;:[{&quot;label&quot;:&quot;demo-01 · 水面扭曲&quot;,&quot;badge&quot;:&quot;负例&quot;,&quot;src&quot;:&quot;assets/videos/jelly10.mp4&quot;,&quot;caption&quot;:&quot;素材：&lt;b&gt;水下漂浮场景&lt;/b&gt;。主体表面出现非物理波动。&quot;,&quot;frames&quot;:[{&quot;time&quot;:3.3,&quot;dimension&quot;:&quot;波动扭曲&quot;,&quot;target&quot;:&quot;水母伞体表面&quot;,&quot;grounding&quot;:&quot;bbox: [180,220,620,430]&quot;,&quot;severity&quot;:2,&quot;reasoning&quot;:&quot;伞体表面在平移中出现周期性扭曲，超出正常水体折射可解释范围，判定波动扭曲。&quot;,&quot;box&quot;:{&quot;x&quot;:14.06,&quot;y&quot;:30.56,&quot;w&quot;:34.38,&quot;h&quot;:29.17}}]}],&quot;音画不同步&quot;:[{&quot;label&quot;:&quot;demo-01 · 口型延迟&quot;,&quot;badge&quot;:&quot;负例&quot;,&quot;src&quot;:&quot;assets/videos/sintel10.mp4&quot;,&quot;caption&quot;:&quot;素材：&lt;b&gt;人物说话镜头&lt;/b&gt;。口型与语音存在延迟。&quot;,&quot;frames&quot;:[{&quot;time&quot;:6,&quot;dimension&quot;:&quot;音画不同步&quot;,&quot;target&quot;:&quot;说话人口部&quot;,&quot;grounding&quot;:&quot;bbox: [380,300,520,420]&quot;,&quot;severity&quot;:2,&quot;reasoning&quot;:&quot;语音已发出音节，口型闭合滞后约 0.3s，音画时间轴未对齐，判定音画不同步。&quot;,&quot;box&quot;:{&quot;x&quot;:29.69,&quot;y&quot;:41.67,&quot;w&quot;:10.94,&quot;h&quot;:16.67}}]}],&quot;文字不可读&quot;:[{&quot;label&quot;:&quot;&quot;,&quot;badge&quot;:&quot;负例 · 公开集视频 + 机检框&quot;,&quot;src&quot;:&quot;assets/videos/vf_6004655.mp4&quot;,&quot;caption&quot;:&quot;素材：&lt;b&gt;The revolution begins, the peasants rise up against the government, th&lt;/b&gt;　公开集人工评分 visual quality 1/4 · temporal 1/4 · factual 1/4&quot;,&quot;frames&quot;:[{&quot;evidence_id&quot;:&quot;1&quot;,&quot;frame&quot;:2,&quot;time&quot;:0.4,&quot;bbox&quot;:[269,0,591,634],&quot;box&quot;:{&quot;x&quot;:0,&quot;y&quot;:26.88,&quot;w&quot;:63.44,&quot;h&quot;:32.19},&quot;frame_range&quot;:[2,6],&quot;dimension&quot;:&quot;文字不可读&quot;,&quot;observation&quot;:&quot;画面文字为无意义字形（RKEGILVE / RJUTIK）（EAST 检出，conf 1.0）&quot;},{&quot;evidence_id&quot;:&quot;2&quot;,&quot;frame&quot;:4,&quot;time&quot;:1,&quot;bbox&quot;:[262,0,588,653],&quot;box&quot;:{&quot;x&quot;:0,&quot;y&quot;:26.25,&quot;w&quot;:65.31,&quot;h&quot;:32.5},&quot;frame_range&quot;:[2,6],&quot;dimension&quot;:&quot;文字不可读&quot;,&quot;observation&quot;:&quot;画面文字为无意义字形（RKEGILVE / RJUTIK）（EAST 检出，conf 1.0）&quot;},{&quot;evidence_id&quot;:&quot;3&quot;,&quot;frame&quot;:6,&quot;time&quot;:1.6,&quot;bbox&quot;:[256,3,619,653],&quot;box&quot;:{&quot;x&quot;:0.31,&quot;y&quot;:25.63,&quot;w&quot;:65,&quot;h&quot;:36.25},&quot;frame_range&quot;:[2,6],&quot;dimension&quot;:&quot;文字不可读&quot;,&quot;observation&quot;:&quot;画面文字为无意义字形（RKEGILVE / RJUTIK）（EAST 检出，conf 1.0）&quot;}]}],&quot;崩坏&quot;:[{&quot;label&quot;:&quot;&quot;,&quot;badge&quot;:&quot;负例 · 公开集视频 + 机检框&quot;,&quot;src&quot;:&quot;assets/videos/vf_1003674.mp4&quot;,&quot;caption&quot;:&quot;素材：&lt;b&gt;Joe Biden, red lazer eyes, surging with power&lt;/b&gt;　公开集人工评分 visual quality 1/4 · temporal 1/4 · factual 1/4&quot;,&quot;frames&quot;:[{&quot;evidence_id&quot;:&quot;1&quot;,&quot;frame&quot;:2,&quot;time&quot;:0.4,&quot;bbox&quot;:[96,32,489,338],&quot;box&quot;:{&quot;x&quot;:3.21,&quot;y&quot;:9.57,&quot;w&quot;:30.62,&quot;h&quot;:39.35},&quot;frame_range&quot;:[2,6],&quot;dimension&quot;:&quot;崩坏&quot;,&quot;observation&quot;:&quot;人脸区域结构溶解为色块（OWL-ViT 检出，conf 0.518）&quot;},{&quot;evidence_id&quot;:&quot;2&quot;,&quot;frame&quot;:4,&quot;time&quot;:1,&quot;bbox&quot;:[72,0,488,318],&quot;box&quot;:{&quot;x&quot;:0,&quot;y&quot;:7.19,&quot;w&quot;:31.77,&quot;h&quot;:41.63},&quot;frame_range&quot;:[2,6],&quot;dimension&quot;:&quot;崩坏&quot;,&quot;observation&quot;:&quot;人脸区域结构溶解为色块（OWL-ViT 检出，conf 0.536）&quot;},{&quot;evidence_id&quot;:&quot;3&quot;,&quot;frame&quot;:6,&quot;time&quot;:1.6,&quot;bbox&quot;:[175,42,606,379],&quot;box&quot;:{&quot;x&quot;:4.22,&quot;y&quot;:17.52,&quot;w&quot;:33.65,&quot;h&quot;:43.06},&quot;frame_range&quot;:[2,6],&quot;dimension&quot;:&quot;崩坏&quot;,&quot;observation&quot;:&quot;人脸区域结构溶解为色块（OWL-ViT 检出，conf 0.689）&quot;}]}],&quot;生物类结构异常&quot;:[{&quot;label&quot;:&quot;&quot;,&quot;badge&quot;:&quot;负例 · 公开集视频 + 机检框&quot;,&quot;src&quot;:&quot;assets/videos/vf_3005976.mp4&quot;,&quot;caption&quot;:&quot;素材：&lt;b&gt;cinematic,very detailed,people dancing in the background&lt;/b&gt;　公开集人工评分 visual quality 1/4 · temporal 1/4 · fa