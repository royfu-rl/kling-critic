t;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;模型忽视了 Prompt 中的否定表述。&quot;,&quot;symptoms&quot;:[&quot;「不要有树木」仍生成树木&quot;,&quot;忽视「没有」「除了」等否定词&quot;],&quot;requires&quot;:&quot;Prompt 含明确的否定约束&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;并非否定约束、只是主体属性错 → `主体未响应`&quot;}]},{&quot;n&quot;:&quot;环境未响应&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;环境文本响应&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;背景环境不符 Prompt 设定。&quot;,&quot;symptoms&quot;:[&quot;天气不符（要雨天给晴天）&quot;,&quot;地形错误&quot;,&quot;室内外装饰不符&quot;,&quot;时间点错误（要黄昏给正午）&quot;],&quot;requires&quot;:&quot;Prompt 明确描述了环境要素&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体本身不符 → `主体未响应`；整体美学风格跑偏 → `风格错误`&quot;}]},{&quot;n&quot;:&quot;风格错误&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;视觉美学风格跑偏，不符 Prompt 指定。&quot;,&quot;symptoms&quot;:[&quot;要求赛博朋克生成写实摄影&quot;,&quot;要求水墨风生成 3D 渲染&quot;,&quot;风格与指令不符&quot;],&quot;requires&quot;:&quot;Prompt 明确指定了风格&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签管整体风格是否符合指令；镜头间风格突变 → 一致性 `风格不一致`。两者允许共存&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;多镜头之间风格突变（各镜头风格都对但互不一致）→ 一致性 `风格不一致`；两者可同时打&quot;}]},{&quot;n&quot;:&quot;空间关系与方向错误&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;物体相对位置或运动方向出错。&quot;,&quot;symptoms&quot;:[&quot;左右前后上下关系颠倒&quot;,&quot;要求向左走实际向右&quot;,&quot;方向指令未遵循&quot;],&quot;requires&quot;:&quot;主宾语识别正确，仅方位数值 / 方向错误&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;仅距离 / 角度 / 左右数值错 → 本标签；主宾语被交换 → `响应混淆与指代错误`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;交换了主语 / 宾语 → `响应混淆与指代错误`；正确识别主宾语但方位错 → 本标签&quot;}]},{&quot;n&quot;:&quot;复杂文本理解错误&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;复杂文字理解&quot;,&quot;why&quot;:&quot;陈述式改缺陷式，并降级为兜底标签。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;兜底标签：复杂 Prompt 整体跑偏且无法拆解到具体标签。&quot;,&quot;symptoms&quot;:[&quot;多重逻辑长从句整体未理解&quot;,&quot;抽象比喻完全落空&quot;],&quot;requires&quot;:&quot;仅当 Prompt 无法拆解为具体标签、且模型整体跑偏时启用&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需降级&quot;,&quot;r&quot;:&quot;仅当 Prompt 无法拆解为具体标签、且模型整体跑偏时启用，不作为常规兜底&quot;},{&quot;kind&quot;:&quot;需降级&quot;,&quot;r&quot;:&quot;能归入任何具体标签时一律不打本标签，不作为常规兜底&quot;}]}]},{&quot;name&quot;:&quot;多镜头指令遵循&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;镜头混乱仅限单镜头内无意义突变；镜头时序问题 / 镜头间内容混淆 / 切镜时间点错误仅限镜头间衔接。四者禁止同时打标&quot;,&quot;for&quot;:[&quot;镜头混乱&quot;,&quot;镜头时序问题&quot;,&quot;镜头间内容混淆&quot;,&quot;切镜时间点错误&quot;]}],&quot;tags&quot;:[{&quot;n&quot;:&quot;shot数量遗漏&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;实际生成的镜头数少于 Prompt 要求。&quot;,&quot;symptoms&quot;:[&quot;要求 3 个镜头只生成 2 个&quot;,&quot;镜头数量不足&quot;],&quot;requires&quot;:&quot;Prompt 明确要求了镜头数量&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;完全没有切镜、一镜到底 → `无切镜`；多生成了镜头 → `shot数量新增`&quot;}]},{&quot;n&quot;:&quot;shot数量新增&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;模型多生成了 Prompt 未要求的镜头。&quot;,&quot;symptoms&quot;:[&quot;未要求多镜头却切了镜&quot;,&quot;超出指定数量&quot;],&quot;requires&quot;:&quot;Prompt 未要求或指定了更少的镜头数&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;镜头数不足 → `shot数量遗漏`&quot;}]},{&quot;n&quot;:&quot;无切镜&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;Prompt 要求多镜头叙事，实际输出一镜到底。&quot;,&quot;symptoms&quot;:[&quot;要求多镜头但全程单镜头&quot;,&quot;完全没有镜头切换&quot;],&quot;requires&quot;:&quot;一次切镜都没有发生&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;有切镜但数量不足 → `shot数量遗漏`&quot;}]},{&quot;n&quot;:&quot;切镜时间点错误&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P2&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;镜头切换的时间点过早或过晚。&quot;,&quot;symptoms&quot;:[&quot;要求「3 秒后切换」实际 1 秒就切&quot;,&quot;切换时机未对齐 Prompt&quot;],&quot;requires&quot;:&quot;Prompt 指定了切镜时间点&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;仅限镜头与镜头之间的接续问题，不与 `镜头混乱` 同时打标&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;镜头停留时长与信息量不匹配但 Prompt 未指定时间点 → 动态质量 `剪辑节奏较差`&quot;},{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;本标签管镜头之间的接续时机；单镜头内无意义突变 → `镜头混乱`&quot;}]},{&quot;n&quot;:&quot;镜头时序问题&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;多个镜头的叙事顺序混乱。&quot;,&quot;symptoms&quot;:[&quot;先发生的事放在了后面的镜头里&quot;,&quot;镜头顺序与剧本顺序不符&quot;],&quot;requires&quot;:&quot;各镜头内容都对，只是排列顺序错了&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;仅限镜头与镜头之间的接续问题，不与 `镜头混乱` 同时打标&quot;},{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;本标签管镜头之间的顺序；单镜头内无意义突变 → `镜头混乱`。两者互斥&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;A 镜头的主体错误出现在 B → `镜头间内容混淆`&quot;}]},{&quot;n&quot;:&quot;转场方式错误&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;转场手法不符 Prompt 指定。&quot;,&quot;symptoms&quot;:[&quot;要求淡入淡出生成硬切&quot;,&quot;要求瞬间切换生成缓慢溶解&quot;],&quot;requires&quot;:&quot;Prompt 明确指定了转场方式&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;单镜头内主体无理由突变 → 动态质量 `转场异变`&quot;}]},{&quot;n&quot;:&quot;镜头间内容混淆&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;镜头 A 的主体 / 道具错误地出现在镜头 B 中。&quot;,&quot;symptoms&quot;:[&quot;跳轴&quot;,&quot;道具穿帮&quot;,&quot;前一镜的主体串到后一镜&quot;],&quot;requires&quot;:&quot;判定对象是镜头之间的内容串台&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;仅限镜头与镜头之间的接续问题，不与 `镜头混乱` 同时打标&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;变化由切镜导致且属穿帮 → 本标签；单镜头内无理由突现 → 动态质量 `转场异变`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;变化发生在单镜头内且无理由突现 → 动态质量 `转场异变`&quot;},{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;本标签管镜头之间；单镜头内无意义突变 → `镜头混乱`&quot;}]},{&quot;n&quot;:&quot;尾镜叙事缺失&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P2&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;最后一个镜头没有完成 Prompt 要求的收尾。&quot;,&quot;symptoms&quot;:[&quot;结局动作未出现&quot;,&quot;叙事戛然而止&quot;,&quot;尾镜提前结束&quot;],&quot;requires&quot;:&quot;仅限最后一个镜头的收尾问题&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;整段事件逻辑断裂而非仅尾镜 → 动态质量 `叙事混乱与不完整`&quot;}]},{&quot;n&quot;:&quot;镜头混乱&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;单镜头内出现无意义突变，整体无法理解。&quot;,&quot;symptoms&quot;:[&quot;镜头之间毫无逻辑关联&quot;,&quot;跳跃性过大无法理解剧情&quot;],&quot;requires&quot;:&quot;仅用于单镜头内的无意义突变&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;仅限单镜头内无意义突变；镜头间衔接问题 → `镜头时序问题` / `镜头间内容混淆` / `切镜时间点错误`。四者禁止同时打标&quot;},{&quot;kind&quot;:&quot;需互斥&quot;,&quot;r&quot;:&quot;与 `镜头时序问题` / `镜头间内容混淆` / `切镜时间点错误` 四者互斥，禁止同时打标——那三个管镜头与镜头之间的接续&quot;}]}]},{&quot;name&quot;:&quot;音频指令遵循&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本子维度管「有无/类型匹配」，音频评测维度管「质量好不好」，两者互不替代、允许共存&quot;}],&quot;tags&quot;:[{&quot;n&quot;:&quot;通用指令未遵循&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;通用指令&quot;,&quot;why&quot;:&quot;原标签是检查对象而非缺陷，统一加「未遵循」后缀。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;整体音频氛围、音量或有无声音不符 Prompt。&quot;,&quot;symptoms&quot;:[&quot;要求有声音实际静音&quot;,&quot;整体氛围与指令不符&quot;,&quot;音量大小要求未遵循&quot;],&quot;requires&quot;:&quot;判定对象是「有没有按指令生成」，不是音质好坏&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本子维度管有无 / 类型匹配；声音质量好坏 → 音频评测维度。两者互不替代、允许共存&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;声音存在且类型对、只是质量差 → 音频评测维度 `噪声感知` / `音量异常` / `音频失真（爆音/断音）`。两者互不替代，允许同时打&quot;}]},{&quot;n&quot;:&quot;语音指令未遵循&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;语音指令&quot;,&quot;why&quot;:&quot;同上。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;人声旁白 / 对话不符 Prompt 要求。&quot;,&quot;symptoms&quot;:[&quot;要求旁白实际无人声&quot;,&quot;语种错误&quot;,&quot;语速或情绪不符&quot;],&quot;requires&quot;:&quot;Prompt 明确要求了语音内容或属性；判定存在性与类型匹配&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本子维度管有无 / 类型匹配；声音质量好坏 → 音频评测维度。两者互不替代、允许共存&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;人声存在但音质差 → 音频评测维度对应标签；口型与声音不同步 → `口型不匹配`&quot;}]},{&quot;n&quot;:&quot;音效指令未遵循&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;音效指令&quot;,&quot;why&quot;:&quot;同上。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;环境音 / 拟音缺失或未在正确节点响起。&quot;,&quot;symptoms&quot;:[&quot;要求脚步声实际无&quot;,&quot;关门声未在关门瞬间响起&quot;,&quot;雨声爆炸声缺失&quot;],&quot;requires&quot;:&quot;Prompt 明确要求了音效；判定存在性与触发节点&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本子维度管有无 / 类型匹配；声音质量好坏 → 音频评测维度。两者互不替代、允许共存&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;音效存在但与画面动作时间点错位 → 音频评测维度 `音画不同步`&quot;}]},{&quot;n&quot;:&quot;音乐指令未遵循&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;音乐指令&quot;,&quot;why&quot;:&quot;同上。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;BGM 的流派、情绪或乐器不匹配 Prompt。&quot;,&quot;symptoms&quot;:[&quot;要求钢琴实际吉他&quot;,&quot;要求欢快实际低沉&quot;,&quot;流派不符&quot;],&quot;requires&quot;:&quot;Prompt 明确要求了音乐属性；判定类型匹配，与音质无关&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本子维度管有无 / 类型匹配；声音质量好坏 → 音频评测维度。两者互不替代、允许共存&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;即使音质极好，只要类型不符指令仍打本标签；音质问题另归音频评测维度&quot;}]}]}]},{&quot;name&quot;:&quot;一致性&quot;,&quot;rules&quot;:[],&quot;subs&quot;:[{&quot;name&quot;:&quot;输入图一致性（I2V）&quot;,&quot;rules&quot;:[],&quot;tags&quot;:[{&quot;n&quot;:&quot;首帧画风偏离&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;from&quot;:&quot;首帧画风明显偏离 + 首帧画风轻微偏离&quot;,&quot;why&quot;:&quot;明显/轻微作标签区隔导致阈值主观漂移，合并为单一缺陷标签，程度另记。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;生成首帧的画风偏离输入参考图。&quot;,&quot;symptoms&quot;:[&quot;输入写实图生成动漫感首帧&quot;,&quot;笔触质感与参考图不符&quot;],&quot;requires&quot;:&quot;I2V 场景；对照物是用户输入的参考图。程度轻重不再用标签区分，另记严重度分数&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;色调偏移为主 → `首帧色偏`；人物身份特征偏离 → `首帧ID偏离`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;风格不符 Prompt 文本描述 → 指令遵循 `风格错误`；镜头之间风格突变 → `风格不一致`&quot;}]},{&quot;n&quot;:&quot;首帧色偏&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;from&quot;:&quot;首帧明显色偏 + 首帧轻微色偏&quot;,&quot;why&quot;:&quot;同上。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;生成首帧的色调偏离输入参考图。&quot;,&quot;symptoms&quot;:[&quot;参考图暖调生成冷调&quot;,&quot;整体色温漂移&quot;,&quot;饱和度明显不符&quot;],&quot;requires&quot;:&quot;I2V 场景；对照物是输入参考图。程度轻重不再用标签区分，另记严重度分数&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;画风整体不符而非仅色调 → `首帧画风偏离`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;与参考图无关的过曝 / 白平衡问题 → 画面质量 `曝光光影或色彩异常`&quot;}]},{&quot;n&quot;:&quot;首帧ID偏离&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;首帧ID明显偏离&quot;,&quot;why&quot;:&quot;去掉程度副词，与其余两项对齐。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;生成首帧的人物身份特征偏离输入参考图。&quot;,&quot;symptoms&quot;:[&quot;脸型五官与参考图不同&quot;,&quot;发色发型改变&quot;,&quot;看起来换了个人&quot;],&quot;requires&quot;:&quot;I2V 场景；对照物是输入参考图的主体身份&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;首帧 ID 对但后续镜头漂移 → `主体不一致`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;偏离的是画风而非身份 → `首帧画风偏离`&quot;}]},{&quot;n&quot;:&quot;首帧画风明显偏离&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;why&quot;:&quot;并入「首帧画风偏离」。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;首帧画风轻微偏离&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;why&quot;:&quot;并入「首帧画风偏离」。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;首帧明显色偏&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;why&quot;:&quot;并入「首帧色偏」。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;首帧轻微色偏&quot;,&quot;act&quot;:&quot;合并&quot;,&quot;why&quot;:&quot;并入「首帧色偏」。&quot;,&quot;gone&quot;:true}]},{&quot;name&quot;:&quot;多镜头间连贯性（逻辑层）&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;方位不连贯限左右前后朝向，空间位置不连贯限主体间相对坐标/距离，两者不合并&quot;,&quot;for&quot;:[&quot;方位不连贯&quot;,&quot;空间位置不连贯&quot;]},{&quot;kind&quot;:&quot;需禁用&quot;,&quot;r&quot;:&quot;若 Prompt 自身叙事碎片化，叙事不连贯禁用（不因剧本混乱惩罚模型）&quot;,&quot;for&quot;:[&quot;叙事不连贯&quot;]},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;动作或表演不连贯仅管跨镜头动作是否接得上；单镜头内「动作像不像真的」归动态质量&quot;,&quot;for&quot;:[&quot;动作或表演不连贯&quot;]}],&quot;tags&quot;:[{&quot;n&quot;:&quot;动作或表演不连贯&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;动作或表演连贯性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式，仅加否定词，语义不动。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;跨镜头的动作或表演衔接断裂。&quot;,&quot;symptoms&quot;:[&quot;前一镜跑步后一镜瞬移到终点&quot;,&quot;动作在切镜处跳跃&quot;,&quot;表演情绪在镜头间断层&quot;],&quot;requires&quot;:&quot;判定对象是镜头之间的动作衔接逻辑&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅管跨镜头主体动作是否接得上（镜头 A 到 B）；单镜头内动作像不像真的 → 动态质量 `运动不真实`&quot;},{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;瞬移等违反物理的现象若发生在单镜头内 → 动态质量 `不符合物理规律`；跨镜头衔接断裂 → 本标签&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;同一镜头内运动不平滑 → 动态质量 `卡顿掉帧感`&quot;}]},{&quot;n&quot;:&quot;方位不连贯&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;方位连贯性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;主体的朝向 / 方位在镜头之间发生无理由改变。&quot;,&quot;symptoms&quot;:[&quot;前一镜面朝左后一镜面朝右&quot;,&quot;朝向在切镜处翻转&quot;],&quot;requires&quot;:&quot;判定对象是主体自身的朝向；与其在场景中的坐标无关&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签仅限左右前后朝向；主体间相对坐标 / 距离 → `空间位置不连贯`。两者不合并&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体在场景中的相对坐标改变 → `空间位置不连贯`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;方向不符 Prompt 指定 → 指令遵循 `空间关系与方向错误`&quot;}]},{&quot;n&quot;:&quot;空间位置不连贯&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;空间位置连贯性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;主体在场景中的相对位置在镜头之间跳变。&quot;,&quot;symptoms&quot;:[&quot;前一镜在门口后一镜突然在窗边&quot;,&quot;主体间相对坐标改变&quot;],&quot;requires&quot;:&quot;判定对象是主体在场景内的位置关系；与主体自身朝向无关&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签仅限主体间相对坐标 / 距离；左右前后朝向 → `方位不连贯`。两者不合并&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体自身朝向改变 → `方位不连贯`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;位置跳变发生在单镜头内 → 动态质量 `动态时序不一致`&quot;}]},{&quot;n&quot;:&quot;叙事不连贯&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;叙事连贯性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;跨镜头的事件因果链断裂。&quot;,&quot;symptoms&quot;:[&quot;镜头之间事件无承接关系&quot;,&quot;因果逻辑跳跃&quot;],&quot;requires&quot;:&quot;Prompt 本身有连贯剧本时才判定&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需禁用&quot;,&quot;r&quot;:&quot;若 Prompt 自身叙事碎片化，本标签禁用——不因剧本混乱惩罚模型&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;Prompt 本身就是碎片化、无因果的剧本，模型如实生成不算缺陷，不打本标签&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;同时涉及事件不完整 / 无收束 → 动态质量 `叙事混乱与不完整`&quot;}]},{&quot;n&quot;:&quot;镜头连贯性&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;与指令遵循·镜头时序问题 / 镜头间内容混淆高度重叠，且与叙事不连贯强耦合。&quot;,&quot;gone&quot;:true}]},{&quot;name&quot;:&quot;多镜头间一致性（不变性）&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;风格不一致管镜头间是否突变，指令遵循·风格错误管整体风格是否符合指令，两者允许共存&quot;,&quot;for&quot;:[&quot;风格不一致&quot;]}],&quot;tags&quot;:[{&quot;n&quot;:&quot;场景不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;场景一致性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式，仅加否定词，不合并、不改语义。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;同一场景在不同镜头间发生无理由改变。&quot;,&quot;symptoms&quot;:[&quot;同一房间的家具布局变了&quot;,&quot;场景陈设在镜头间改变&quot;,&quot;地点特征不一致&quot;],&quot;requires&quot;:&quot;Prompt 未要求场景变化&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;环境不符 Prompt 设定 → 指令遵循 `环境未响应`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体身份改变 → `主体不一致`&quot;}]},{&quot;n&quot;:&quot;主体不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;主体一致性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;同一主体的身份特征在镜头间漂移。&quot;,&quot;symptoms&quot;:[&quot;切镜后换脸&quot;,&quot;发色服装改变&quot;,&quot;同一角色看起来是两个人&quot;],&quot;requires&quot;:&quot;跨镜头判定；对照物是该主体在前序镜头中的样子&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;首帧就偏离输入参考图 → `首帧ID偏离`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体属性不符 Prompt → 指令遵循 `主体未响应`；单镜头内主体突变 → 动态质量 `转场异变`&quot;}],&quot;demoKey&quot;:&quot;主体一致性&quot;},{&quot;n&quot;:&quot;颜色不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;颜色一致性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;画面整体色调在镜头之间跳变。&quot;,&quot;symptoms&quot;:[&quot;镜头 A 暖调镜头 B 冷调&quot;,&quot;同一物体颜色在镜头间改变&quot;],&quot;requires&quot;:&quot;Prompt 未要求色调变化&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;色调在单镜头内随时间漂移 → 动态质量 `光影风格时序不一致`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;单帧的白平衡 / 过曝问题 → 画面质量 `曝光光影或色彩异常`&quot;}]},{&quot;n&quot;:&quot;风格不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;风格一致性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;画面美学风格在镜头之间突变。&quot;,&quot;symptoms&quot;:[&quot;镜头 A 水墨风镜头 B 赛博朋克&quot;,&quot;风格在切镜处改变&quot;],&quot;requires&quot;:&quot;各镜头自身风格可能都对，问题在互不一致&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本标签管镜头间是否突变；整体风格是否符合指令 → 指令遵循 `风格错误`。两者允许共存&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;所有镜头风格一致但都不符 Prompt → 指令遵循 `风格错误`。两者可同时打&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;风格在单镜头内逐渐漂移 → 动态质量 `光影风格时序不一致`&quot;}]},{&quot;n&quot;:&quot;音乐音效不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;音乐音效一致连贯性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;音乐或音效在镜头 / 场景切换时突变。&quot;,&quot;symptoms&quot;:[&quot;BGM 在切镜处突然换曲&quot;,&quot;音效音色突变&quot;,&quot;从室内切室外混响突然消失&quot;],&quot;requires&quot;:&quot;判定对象是音乐 / 音效的跨镜头连贯性&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;音乐类型不符 Prompt → 指令遵循 `音乐指令未遵循`；音质本身有缺陷 → 音频评测维度对应标签&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;人声的连贯性问题 → `人声不一致`&quot;}]},{&quot;n&quot;:&quot;人声不一致&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;人声一致连贯性&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;同一角色的音色在镜头之间改变。&quot;,&quot;symptoms&quot;:[&quot;同一角色前后音色不同&quot;,&quot;像换了配音演员&quot;,&quot;语调特征在镜头间跳变&quot;],&quot;requires&quot;:&quot;判定对象是人声音色的跨镜头一致性&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;语音不符 Prompt 要求 → 指令遵循 `语音指令未遵循`；人声与口型不同步 → `口型不匹配`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;音乐音效的连贯性问题 → `音乐音效不一致`&quot;}]}]}]},{&quot;name&quot;:&quot;音频评测维度&quot;,&quot;rules&quot;:[],&quot;subs&quot;:[{&quot;name&quot;:&quot;音质（底层物理）&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;凡音频类物理缺陷仅归此维度；动态维度的音频基础质量差已移出并归入此处&quot;}],&quot;tags&quot;:[{&quot;n&quot;:&quot;噪声感知&quot;,&quot;act&quot;:&quot;维持&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;音频存在可察觉的底噪。&quot;,&quot;symptoms&quot;:[&quot;持续的嘶嘶底噪&quot;,&quot;电流声&quot;,&quot;环境噪声本底过高&quot;],&quot;requires&quot;:&quot;判定对象是音频的物理质量，与内容是否符合指令无关&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;凡音频类物理缺陷仅归本子维度，不与视觉失真（`波动扭曲` / `明暗闪烁`）混打&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;声音类型 / 有无不符 Prompt → 指令遵循 `通用指令未遵循`。两者互不替代，允许同时打&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;爆音 / 断音 → `音频失真（爆音/断音）`；音量整体过大过小 → `音量异常`&quot;}]},{&quot;n&quot;:&quot;音量异常&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;音量感知&quot;,&quot;why&quot;:&quot;「感知」不指向缺陷，改为可判定的异常表述。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;音频整体音量过大、过小或忽高忽低。&quot;,&quot;symptoms&quot;:[&quot;音量过小几乎听不见&quot;,&quot;音量爆表&quot;,&quot;音量无理由起伏&quot;],&quot;requires&quot;:&quot;判定对象是音量的物理表现&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;Prompt 明确要求了音量大小而未遵循 → 指令遵循 `通用指令未遵循`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;削波导致的爆音 → `音频失真（爆音/断音）`；切换时的音量突变 → `音乐音效不一致`&quot;}]},{&quot;n&quot;:&quot;音频失真（爆音/断音）&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;失真感知&quot;,&quot;why&quot;:&quot;明确失真的具体表现，避免与视觉失真类标签混淆。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;音频出现削波爆音、断音或码率过低的失真。&quot;,&quot;symptoms&quot;:[&quot;爆音削波&quot;,&quot;突然断音&quot;,&quot;码率极低的金属感失真&quot;],&quot;requires&quot;:&quot;判定对象是波形层面的失真&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅底噪偏高 → `噪声感知`；仅音量不当 → `音量异常`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;视觉上的扭曲闪烁 → 动态质量 `波动扭曲` / `明暗闪烁`（同为「失真」但不同感官）&quot;}]}]},{&quot;name&quot;:&quot;音画同步&quot;,&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;本维度只标质量好坏，指令遵循·音频指令遵循只标有无/类型匹配&quot;}],&quot;tags&quot;:[{&quot;n&quot;:&quot;口型不匹配&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;口型匹配度&quot;,&quot;why&quot;:&quot;去正面词——打标本质是记录缺陷，正面陈述会让标注员犹豫打标方向。&quot;,&quot;prioTBD&quot;:true,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;人物口型与语音内容不对应。&quot;,&quot;symptoms&quot;:[&quot;说话时嘴没动&quot;,&quot;口型与音节对不上&quot;,&quot;闭嘴却有说话声&quot;],&quot;requires&quot;:&quot;判定对象是口型与语音的对应关系&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;整体音画时间轴错位而非仅口型 → `音画不同步`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;人声音色在镜头间改变 → `人声不一致`；语音不符 Prompt → 指令遵循 `语音指令未遵循`&quot;}]},{&quot;n&quot;:&quot;音画不同步&quot;,&quot;act&quot;:&quot;移入&quot;,&quot;from&quot;:&quot;动态美学·音画不同步&quot;,&quot;why&quot;:&quot;从动态美学彻底删除，强制归口至此，消除双归属。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;声音与画面动作的时间点错位。&quot;,&quot;symptoms&quot;:[&quot;嘴型动了两秒后声音才出&quot;,&quot;脚步落地声提前&quot;,&quot;音效与动作不对齐&quot;],&quot;requires&quot;:&quot;声音内容是对的，只是时间轴错位&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;声音内容与画面场景完全不符 → `音画不匹配`；仅口型对不上 → `口型不匹配`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;音效在 Prompt 要求的节点完全没出现 → 指令遵循 `音效指令未遵循`&quot;}],&quot;demoKey&quot;:&quot;音画不同步&quot;},{&quot;n&quot;:&quot;音画不匹配&quot;,&quot;act&quot;:&quot;移入&quot;,&quot;from&quot;:&quot;动态美学·音画不匹配&quot;,&quot;why&quot;:&quot;原在音画同步与动态美学下同时出现（P1 级硬重复），统一收到此处。&quot;,&quot;prio&quot;:&quot;P0&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;声音内容与画面场景不符。&quot;,&quot;symptoms&quot;:[&quot;室内弹钢琴却有集市喧闹声&quot;,&quot;画面无雨却有雨声&quot;,&quot;声源与画面对不上&quot;],&quot;requires&quot;:&quot;判定对象是声音内容与画面内容的对应关系，与时间轴无关&quot;,&quot;derived&quot;:true},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;内容对但时间点错位 → `音画不同步`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;声音类型不符 Prompt 指定 → 指令遵循 `音效指令未遵循` / `音乐指令未遵循`&quot;}]}]},{&quot;name&quot;:&quot;音频质量与表现力&quot;,&quot;rules&quot;:[],&quot;tags&quot;:[{&quot;n&quot;:&quot;人声语音&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;是内容类型（Vocal）而非缺陷，无法直接判定好坏，子维度整体删除。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;音效&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;是内容类型（SFX）而非缺陷，子维度整体删除。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;音乐&quot;,&quot;act&quot;:&quot;删除&quot;,&quot;why&quot;:&quot;是内容类型（BGM）而非缺陷，子维度整体删除。&quot;,&quot;gone&quot;:true}]},{&quot;name&quot;:&quot;多模态综合表现力&quot;,&quot;rules&quot;:[],&quot;tags&quot;:[{&quot;n&quot;:&quot;音频一致性&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;why&quot;:&quot;子维度整体删除；时间一致性语义归入「音画同步」。&quot;,&quot;gone&quot;:true}]}]}];&#10;&#10;// 优先级直接来自数据（人工分级），不再按遍历顺序生成&#10;const prioOf = name =&gt; {&#10;  for (const d of TAX_AFTER) for (const s of d.subs) for (const t of s.tags)&#10;    if (t.n === name &amp;&amp; !t.gone) return t.prio || null;&#10;  return null;&#10;};&#10;&#10;const demosFor = t =&gt; DEMOS[t.demoKey || t.n] || null;&#10;&#10;/* 被父页 srcdoc 内联时的全屏放大握手：状态与常量 */&#10;// ── 全屏放大：当本图表被父页面以 iframe 内联（srcdoc）时，position:fixed 只能铺满&#10;//    iframe 自身视口（高仅 ~800px），modal 会被裁。打开 modal 时通知父页面把这个&#10;//    iframe 放大到全屏，关闭时还原。子页面无法拿到真实 URL，所以不能走「父页加载&#10;//    popup URL」的老路——只发消息，图表和 modal 都留在原 iframe 里运行。──&#10;const IN_IFRAME = (window !== window.top);&#10;let pendingOpen = null;   // 被内联时，等父页 iframe 放大到全屏(kc-expand-ack)后再开 modal&#10;let revealTimer = null;   // 关闭时，等父页把 iframe 缩回行内尺寸(kc-collapse-ack)后再放出图表&#10;&#10;// ── 「这一帧真的上屏了」才回调 ───────────────────────────────────────────────&#10;// rAF 的回调跑在绘制之「前」，所以在 rAF 里通知父页「我画好了」是错的：父页立刻&#10;// 显影，而跨进程合成器手上还是子页的上一帧（刚按全屏重排、但还没加 class 的标签树）&#10;// —— 那就是 flash.png 里那片「清晰的全屏标签树盖在模糊页面上」。&#10;// 连续两次 rAF 之间必然跨过一个完整的帧边界，即上一帧已提交合成；再挂一个&#10;// setTimeout 0 兜住「后台标签页 / 隐藏 iframe 里 rAF 根本不跑」的情况。&#10;function afterPaint(fn){&#10;  let done = false;&#10;  const go = () =&gt; { if (done) return; done = true; fn(); };&#10;  requestAnimationFrame(() =&gt; requestAnimationFrame(go));&#10;  setTimeout(go, 120);&#10;}&#10;&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// 帧级标注播放器 · 核心&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// 视频 + 时间轴打点 + 画面 grounding 框 + 帧级 JSON。两个宿主共用这一份：&#10;//   · charts/tag-system.html   —— 包在 modal 里，点标签的「Play」打开&#10;//   · charts/annotation-demo.html —— 直接内联成一张卡片（Pointwise 数据示例）&#10;// 宿主只需提供同名 DOM 节点（见下方 refs）并调 mountDemos(demos)；&#10;// 壳的开关/标题/徽章各自实现，核心不关心自己是不是在 modal 里。&#10;//&#10;// 组件源自 skills/chart-blocks/templates/frame-annotation-modal。&#10;&#10;const overlay = document.getElementById('overlay');   // modal 宿主才有；内联宿主为 null&#10;const vEl     = document.getElementById('v-el');&#10;const vWrap   = document.getElementById('v-wrap');&#10;const vLayer  = document.getElementById('v-layer');&#10;const vFill   = document.getElementById('v-fill');&#10;const vTrack  = document.getElementById('v-track');&#10;const vTime   = document.getElementById('v-time');&#10;const vPlay   = document.getElementById('v-play');&#10;const vMute   = document.getElementById('v-mute');&#10;const vJumps  = document.getElementById('v-jumps');&#10;const vCtrls  = document.getElementById('v-controls');&#10;const jBody   = document.getElementById('j-body');&#10;&#10;// ── 素材路径：相对「项目根」而不是相对本文档 ─────────────────────────────────&#10;// demo.src 在 data/tag-system.json 里写成 `assets/videos/x.mp4`，即相对项目根。&#10;// 这份 HTML 有四种加载方式，各自的 baseURI 不同：&#10;//   · charts/tag-system.html            直接打开  → base 是 charts/&#10;//   · eval/charts/tag-system.html       直接打开  → base 是 eval/charts/&#10;//   · charts/annotation-demo.html       直接打开  → base 是 charts/&#10;//   · build.py 把上面任一份内联成 srcdoc → base 是父页 index.html（项目根）&#10;// srcdoc 文档没有自己的 URL（location 是 about:srcdoc），相对路径按父页解析，&#10;// 所以曾经写死的 `../assets/…` 在博客里会跑到项目根的上一层，视频 404、&#10;// video.error.code=4（Format error）——表现就是「视频不能播放」。&#10;// 这里统一把 base 归一到项目根：截到最后一个 / 为止，再剥掉 charts/、eval/。&#10;//&#10;// 注意：这段刻意不用正则，全用字符串操作。build.py 会把本文件内联进 index.html&#10;// 的 markdown，而 SPA 端 renderDoc 会把一行里成对的美元符号当成行内公式抽走再还原，&#10;// 还原时不解码 &amp;#10; —— 正则里的行尾锚点成对出现就会被吃掉，整段 JS 变成&#10;// SyntaxError，播放器直接不启动。tools/verify.mjs 有一条检查守着这件事。&#10;const ASSET_BASE = (() =&gt; {&#10;  const url = document.baseURI.split('#')[0].split('?')[0];&#10;  let dir = url.slice(0, url.lastIndexOf('/') + 1);&#10;  if (dir.endsWith('/charts/')) dir = dir.slice(0, -'charts/'.length);&#10;  if (dir.endsWith('/eval/'))   dir = dir.slice(0, -'eval/'.length);&#10;  return dir;&#10;})();&#10;const srcOf = d =&gt; (d.src.indexOf('//') === 0 || d.src.indexOf(':') &gt; -1 || d.src[0] === '/')&#10;                     ? d.src : ASSET_BASE + d.src;&#10;&#10;// 当前这组 demo。核心不查 DEMOS —— 由宿主调 mountDemos(demos) 传入，&#10;// 所以同一份核心既能被 modal 壳驱动，也能被内联卡片直接挂载。&#10;let curDemos = [], curIdx = 0, curFrame = -1, pendingSeek = null;&#10;const curDemo = () =&gt; curDemos[curIdx];&#10;const fmt = s =&gt; { if(!isFinite(s)) return '0:00'; const m=Math.floor(s/60), c=Math.floor(s%60); return m+':'+String(c).padStart(2,'0'); };&#10;const HOLD_DEFAULT = 1.2;&#10;const holdOf = f =&gt; (f.hold != null ? f.hold : HOLD_DEFAULT);&#10;const sevOf  = f =&gt; (f.severity != null ? f.severity : 2);&#10;&#10;&#10;const AUTOSELECT_FIRST = true;   // 打开即定位到第一个问题帧并暂停，首屏就有画面+框&#10;&#10;// ── json panel ────────────────────────────────────────────────────────────&#10;function groundingOf(f){&#10;  if (f.grounding) return f.grounding;&#10;  if (f.box) return 'bbox%: ['+f.box.x+','+f.box.y+','+(f.box.x+f.box.w)+','+(f.box.y+f.box.h)+']';&#10;  return undefined;&#10;}&#10;// 面板里吐的 JSON 必须与 data/data.md 里公布的标注协议同构 —— 那份是对外的&#10;// schema，demo 是它的实例，两边键名对不上就等于给了两套协议。&#10;// 所以这里只做换名与换算，不新增语义：&#10;//   frame / frame_range ← time、hold 按 FPS 换算&#10;//   bbox                ← grounding 的像素坐标，从 [x1,y1,x2,y2] 转成协议规定的 [y1,x1,y2,x2]&#10;//   observation         ← 帧上已有的客观描述&#10;//   instruction_expect  ← 协议规定「仅当存在参考素材或生成指令时填写」，demo 没有参考素材，故缺省不出现&#10;const FPS = 4;                       // 质检抽帧口径：4 fps&#10;function pxBox(f){                   // &quot;bbox: [x1,y1,x2,y2]&quot; -&gt; [y1,x1,y2,x2]&#10;  const m = /\\[([\\d\\s,.-]+)\\]/.exec(f.grounding || '');&#10;  if (!m) return undefined;&#10;  const n = m[1].split(',').map(v =&gt; Number(v.trim()));&#10;  if (n.length !== 4 || n.some(v =&gt; !isFinite(v))) return undefined;&#10;  return [n[1], n[0], n[3], n[2]];&#10;}&#10;// 真实数据集里这些字段本来就有（人工画框 / 模型标注都按同一份协议存），&#10;// 有就直接用，只有旧的手写 demo 才需要从 time/hold 反推。&#10;function frameObj(f, i){&#10;  const fr  = f.frame != null ? f.frame&#10;            : (f.time != null ? Math.round(f.time*FPS) : undefined);&#10;  const end = (fr!=null) ? fr + Math.max(1, Math.round(holdOf(f)*FPS)) : undefined;&#10;  return { evidence_id: f.evidence_id || String((i!=null?i:0)+1),&#10;           frame: fr,&#10;           bbox: f.bbox || pxBox(f),&#10;           frame_range: f.frame_range || ((fr!=null &amp;&amp; end!=null) ? [fr, end] : undefined),&#10;           instruction_expect: f.instruction_expect,&#10;           observation: f.observation || f.reasoning,&#10;           dimension: f.dimension };&#10;}&#10;function jsonHTML(f, i){&#10;  const obj = frameObj(f, i);&#10;  const lines = ['&lt;span class=&quot;jp&quot;&gt;{&lt;/span&gt;'];&#10;  const keys = Object.keys(obj).filter(k =&gt; obj[k] !== undefined);&#10;  keys.forEach((k,i) =&gt; {&#10;    const comma = i &lt; keys.length-1 ? '&lt;span class=&quot;jp&quot;&gt;,&lt;/span&gt;' : '';&#10;    const v = obj[k];&#10;    const val = typeof v==='number'&#10;      ? '&lt;span class=&quot;jn&quot;&gt;'+v+'&lt;/span&gt;'&#10;      : Array.isArray(v)&#10;        ? '&lt;span class=&quot;jp&quot;&gt;[&lt;/span&gt;&lt;span class=&quot;jn&quot;&gt;'+v.join('&lt;/span&gt;&lt;span class=&quot;jp&quot;&gt;, &lt;/span&gt;&lt;span class=&quot;jn&quot;&gt;')+'&lt;/span&gt;&lt;span class=&quot;jp&quot;&gt;]&lt;/span&gt;'&#10;        : '&lt;span class=&quot;js&quot;&gt;&quot;'+String(v).replace(/&lt;/g,'&amp;lt;')+'&quot;&lt;/span&gt;';&#10;    lines.push('  &lt;span class=&quot;jk&quot;&gt;&quot;'+k+'&quot;&lt;/span&gt;&lt;span class=&quot;jp&quot;&gt;: &lt;/span&gt;'+val+comma);&#10;  });&#10;  lines.push('&lt;span class=&quot;jp&quot;&gt;}&lt;/span&gt;');&#10;  return lines.join('\\n');&#10;}&#10;// ── timeline markers + jump chips ─────────────────────────────────────────&#10;const demoDur = d =&gt; Math.max(...d.frames.map(f=&gt;f.time)) + 3;&#10;&#10;function renderJumps(demo){&#10;  vJumps.innerHTML = '';&#10;  demo.frames.forEach((f,i) =&gt; {&#10;    const b = document.createElement('button');&#10;    b.className = 'jump'; b.dataset.i = i;&#10;    b.innerHTML = '&lt;span class=&quot;jd&quot; data-sev=&quot;'+sevOf(f)+'&quot;&gt;&lt;/span&gt;'+f.time.toFixed(1)+'s · '+f.dimension;&#10;    b.onclick = () =&gt; gotoFrame(i, true);&#10;    vJumps.appendChild(b);&#10;  });&#10;}&#10;function renderMarks(demo){&#10;  if (!demo) return;&#10;  vTrack.querySelectorAll('.mark').forEach(m =&gt; m.remove());&#10;  // duration isn't known until loadedmetadata — place provisionally, redo later&#10;  const dur = vEl.duration || demoDur(demo);&#10;  demo.frames.forEach((f,i) =&gt; {&#10;    const m = document.createElement('div');&#10;    m.className = 'mark'; m.dataset.sev = sevOf(f); m.dataset.i = i;&#10;    m.style.left = Math.min(99, (f.time/dur)*100) + '%';&#10;    m.title = f.time.toFixed(1)+'s · '+f.dimension;&#10;    m.onclick = e =&gt; { e.stopPropagation(); gotoFrame(i, true); };&#10;    vTrack.appendChild(m);&#10;  });&#10;  if (curFrame &gt;= 0) markActive(curFrame);&#10;}&#10;function markActive(i){&#10;  document.querySelectorAll('.jump').forEach(j =&gt; j.classList.toggle('act', +j.dataset.i === i));&#10;  document.querySelectorAll('.mark').forEach(m =&gt; m.classList.toggle('act', +m.dataset.i === i));&#10;}&#10;// ── grounding boxes ───────────────────────────────────────────────────────&#10;// Size the annotation layer to the video's real content rect. `object-fit:contain` letterboxes&#10;// the picture inside the wrapper, so box percentages are only meaningful against&#10;// that inner rect — measuring the wrapper instead offsets every box by the bars.&#10;function fitAnnotationLayer(){&#10;  const cw = vWrap.clientWidth, ch = vWrap.clientHeight;&#10;  const sw = vEl.videoWidth || 16, sh = vEl.videoHeight || 9;&#10;  if (!cw || !ch) return;                      // modal still display:none — nothing to fit&#10;  const scale = Math.min(cw/sw, ch/sh);&#10;  const w = sw*scale, h = sh*scale;&#10;  vLayer.style.width = w+'px';   vLayer.style.height = h+'px';&#10;  vLayer.style.left = (cw-w)/2+'px'; vLayer.style.top = (ch-h)/2+'px';&#10;}&#10;const esc = s =&gt; String(s).replace(/[&amp;&lt;&gt;&quot;']/g, c =&gt; ({'&amp;':'&amp;amp;','&lt;':'&amp;lt;','&gt;':'&amp;gt;','&quot;':'&amp;quot;',&quot;'&quot;:'&amp;#39;'}[c]));&#10;&#10;// A frame's box shows while the playhead is inside [time, time+hold). The selected&#10;// frame also stays boxed while paused, so clicking a marker always shows the box&#10;// even when hold has been scrubbed past.&#10;function activeFrames(){&#10;  const demo = curDemo(); if (!demo) return [];&#10;  const t = vEl.currentTime || 0;&#10;  const set = new Set();&#10;  demo.frames.forEach((f,i) =&gt; { if (t &gt;= f.time &amp;&amp; t &lt; f.time + holdOf(f)) set.add(i); });&#10;  if (vEl.paused &amp;&amp; curFrame &gt;= 0) set.add(curFrame);&#10;  return [...set];&#10;}&#10;function renderBoxes(){&#10;  const demo = curDemo(); if (!demo) return;&#10;  vLayer.innerHTML = activeFrames().map(i =&gt; {&#10;    const f = demo.frames[i]; if (!f.box) return '';     // no box → degrade to JSON-only&#10;    const b = f.box;&#10;    const nearTop = b.y &lt; 8 ? ' near-top' : '';&#10;    return '&lt;div class=&quot;annotation-box'+nearTop+'&quot; data-sev=&quot;'+sevOf(f)+'&quot;'&#10;         + ' style=&quot;left:'+b.x+'%;top:'+b.y+'%;width:'+b.w+'%;height:'+b.h+'%&quot;&gt;'&#10;         + '&lt;span&gt;'+esc(f.dimension + (f.target ? ' · '+f.target : ''))+'&lt;/span&gt;&lt;/div&gt;';&#10;  }).join('');&#10;}&#10;// ── navigation ────────────────────────────────────────────────────────────&#10;function gotoFrame(i, seek){&#10;  curFrame = i;&#10;  const f = curDemo().frames[i];&#10;  if (seek){&#10;    if (isFinite(vEl.duration)){ vEl.currentTime = f.time; vEl.pause(); }&#10;    else pendingSeek = f.time;   // metadata not in yet — replay the seek on load&#10;  }&#10;  jBody.innerHTML = jsonHTML(f, i);&#10;  markActive(i);&#10;  renderBoxes();&#10;}&#10;&#10;function loadDemo(idx){&#10;  curIdx = idx; curFrame = -1; pendingSeek = null;&#10;  const demo = curDemo();&#10;  document.querySelectorAll('.demopill').forEach(p =&gt; p.classList.toggle('on', +p.dataset.i === idx));&#10;  document.getElementById('v-cap').innerHTML = demo.caption || '';&#10;  jBody.innerHTML = '&lt;span class=&quot;jempty&quot;&gt;点击进度条上的问题帧标记查看该帧标注。&lt;/span&gt;';&#10;  // fade out before swapping src so the empty/black frame between demos doesn't flash&#10;  vEl.style.opacity = '0'; vLayer.style.opacity = '0';&#10;  vLayer.innerHTML = '';&#10;  vEl.src = srcOf(demo); vEl.load(); vEl.muted = true; vMute.textContent = '🔊';&#10;  vFill.style.width = '0%';&#10;  renderJumps(demo);&#10;  renderMarks(demo);                       // provisional; refined on loadedmetadata&#10;  if (AUTOSELECT_FIRST &amp;&amp; demo.frames.length) gotoFrame(0, true);&#10;}&#10;&#10;&#10;&#10;// ── 宿主入口 ──────────────────────────────────────────────────────────────&#10;// 换一组 demo 并渲染第一条。壳负责在调用前把自己显示出来（modal 加 .on / 内联无操作），&#10;// 否则 wrapper 尺寸为 0，fitAnnotationLayer 量不到东西。&#10;function mountDemos(demos){&#10;  curDemos = demos || [];&#10;  if (!curDemos.length) return false;&#10;  const strip = document.getElementById('m-strip');&#10;  if (strip){&#10;    strip.innerHTML = '';&#10;    curDemos.forEach((d, i) =&gt; {&#10;      const p = document.createElement('button');&#10;      p.className = 'demopill' + (i === 0 ? ' on' : '');&#10;      p.dataset.i = i; p.textContent = d.label;&#10;      p.onclick = () =&gt; loadDemo(i);&#10;      strip.appendChild(p);&#10;    });&#10;  }&#10;  loadDemo(0);&#10;  requestAnimationFrame(fitAnnotationLayer);   // 壳刚显示，布局完成后再量&#10;  return true;&#10;}&#10;&#10;// ── video wiring ──────────────────────────────────────────────────────────&#10;vEl.addEventListener('loadedmetadata', () =&gt; {&#10;  renderMarks(curDemo());&#10;  vTime.textContent = '0:00 / '+fmt(vEl.duration);&#10;  fitAnnotationLayer();&#10;  if (pendingSeek != null){ vEl.currentTime = pendingSeek; pendingSeek = null; vEl.pause(); }&#10;});&#10;vEl.addEventListener('loadeddata', () =&gt; { vEl.style.opacity='1'; vLayer.style.opacity='1'; fitAnnotationLayer(); renderBoxes(); });&#10;vEl.addEventListener('seeked', renderBoxes);&#10;vEl.addEventListener('timeupdate', () =&gt; {&#10;  const r = vEl.currentTime / (vEl.duration || 1);&#10;  vFill.style.width = (r*100)+'%';&#10;  vTime.textContent = fmt(vEl.currentTime)+' / '+fmt(vEl.duration);&#10;  renderBoxes();&#10;});&#10;vEl.addEventListener('play',  () =&gt; { vPlay.textContent='⏸'; vCtrls.classList.add('show'); });&#10;vEl.addEventListener('pause', () =&gt; { vPlay.textContent='▶'; vCtrls.classList.remove('show'); renderBoxes(); });&#10;vPlay.onclick = () =&gt; { vEl.paused ? vEl.play() : vEl.pause(); };&#10;vEl.onclick   = () =&gt; { vEl.paused ? vEl.play() : vEl.pause(); };&#10;vMute.onclick = () =&gt; { vEl.muted = !vEl.muted; vMute.textContent = vEl.muted ? '🔇' : '🔊'; };&#10;addEventListener('resize', fitAnnotationLayer);&#10;&#10;// ── draggable progress ────────────────────────────────────────────────────&#10;let dragging = false;&#10;function seekAt(e){&#10;  const rect = vTrack.getBoundingClientRect();&#10;  const x = (e.touches ? e.touches[0].clientX : e.clientX);&#10;  const r = Math.max(0, Math.min(1, (x - rect.left)/rect.width));&#10;  if (isFinite(vEl.duration)) vEl.currentTime = r * vEl.duration;&#10;}&#10;vTrack.addEventListener('mousedown', e =&gt; { if(e.target.classList.contains('mark')) return; dragging=true; vCtrls.classList.add('show'); seekAt(e); });&#10;document.addEventListener('mousemove', e =&gt; { if(dragging) seekAt(e); });&#10;document.addEventListener('mouseup',   () =&gt; { if(dragging){ dragging=false; vCtrls.classList.remove('show'); } });&#10;// ── copy json ─────────────────────────────────────────────────────────────&#10;document.getElementById('j-copy').onclick = () =&gt; {&#10;  if (curFrame &lt; 0) return;&#10;  const obj = frameObj(curDemo().frames[curFrame], curFrame);&#10;  Object.keys(obj).forEach(k =&gt; obj[k] === undefined &amp;&amp; delete obj[k]);&#10;  navigator.clipboard.writeText(JSON.stringify(obj, null, 2)).then(() =&gt; {&#10;    const c = document.getElementById('j-copy'); c.classList.add('copied'); c.textContent='✓';&#10;    setTimeout(() =&gt; { c.classList.remove('copied'); c.textContent='⧉'; }, 1600);&#10;  });&#10;};&#10;&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// 内联播放器启动 —— Pointwise 数据示例（charts/annotation-demo.html）&#10;// ══════════════════════════════════════════════════════════════════════════&#10;// 用的是与标签体系完全相同的 modal 组件（html/50-modal.html），只是被&#10;// 60-inline.css 摊平成静态卡片：没有开关弹窗那一层，页面加载完直接挂 demo。&#10;// 数据取自 data/tag-system.json 的 demos —— 与标签体系同一份，不再像旧版那样&#10;// 在 HTML 里另抄一份 3 条子集。&#10;&#10;// 展示顺序固定：先崩坏（结构类），再六指（局部结构），再字幕（文字类），&#10;// 覆盖三种不同的缺陷形态和三段不同素材。DEMOS 的键就是标签名。&#10;const INLINE_KEYS = [&quot;文字不可读&quot;, &quot;崩坏&quot;, &quot;生物类结构异常&quot;, &quot;主体未响应&quot;];&#10;&#10;const inlineDemos = INLINE_KEYS.flatMap(k =&gt; (DEMOS[k] || []).map(d =&gt; ({&#10;  ...d,&#10;  // 内联版没有标题栏可放标签名，把它并进 pill 文案里&#10;  // An empty label means the tag name says it all (public-set clips had a&#10;  // redundant &quot;VideoFeedback · &lt;id&gt;&quot; tail); otherwise append the demo's own name.&#10;  label: d.label ? k + ' · ' + d.label.replace(/^demo-\\d+\\s*·\\s*/, '') : k,&#10;})));&#10;&#10;// modal 的标题栏在这里成了卡片头：填成这份 demo 的说明，而不是某个标签名。&#10;document.getElementById('m-title').textContent = 'Pointwise 帧级标注';&#10;document.getElementById('m-path').textContent  = '点击进度条问题帧或时间戳查看该帧 JSON';&#10;&#10;if (!mountDemos(inlineDemos)) {&#10;  document.getElementById('j-body').innerHTML =&#10;    '&lt;span class=&quot;jempty&quot;&gt;data/tag-system.json 的 demos 里没有这几个键：'&#10;    + INLINE_KEYS.join(' / ') + '&lt;/span&gt;';&#10;}&#10;&lt;/script&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;&#10;\"></iframe>\n</div>\n\n```json\n{\n  \"evidence_id\": \"1\",\n  \"frame\": 7,\n  \"bbox\": [y1, x1, y2, x2],\n  \"frame_range\": [4, 10],\n  \"instruction_expect\": \"参考或指令在本帧所要求的文字, 仅当存在参考素材或生成指令时填写\",\n  \"observation\": \"一句客观描述: 什么载体上的文字, 位置大小如何, 出现了什么现象\",\n  \"dimension\": \"命中的三级标签\"\n}\n```\n\n##### 标注平台\n\n这批数据产自 critic-studio 的双人盲标平台。下面是平台的 demo：左侧切换角色，中间是帧级证据框与采纳 / 驳回 / 轻微三种标注动作，右侧实时算出该条视频的终态与质检指标。\n\n切到「标注员 A」会看到盲标状态——看不到另一名标注员，也看不到终态；切到「复核员」才会显示两人的结论。三条样本分别走通了三条终态路径：两人一致、两人分歧交复核、评测员推翻复核。\n\n<div align=\"center\">\n  <iframe style=\"width:100%;height:700px;border:1px solid #e4e7ec;border-radius:12px;\" title=\"标注平台 · 双人盲标 Demo\" srcdoc=\"&lt;!doctype html&gt;&#10;&lt;html lang=&quot;zh-CN&quot;&gt;&#10;&lt;head&gt;&#10;&lt;meta charset=&quot;utf-8&quot;&gt;&#10;&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width,initial-scale=1&quot;&gt;&#10;&lt;title&gt;标注平台 · 双人盲标 Demo&lt;/title&gt;&#10;&lt;style&gt;&#10;  :root{--bg:#fff;--soft:#f6f7f9;--band:#f0f2f5;--ink:#111418;--mute:#5b636e;--faint:#8a929e;&#10;    --line:#e4e7ec;--brand:#2f6bff;--ok:#1a7f45;--no:#c0392b;--mild:#b8860b;&#10;    --mono:&quot;SF Mono&quot;,ui-monospace,&quot;JetBrains Mono&quot;,Menlo,monospace;&#10;    --sans:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif}&#10;  *{box-sizing:border-box}&#10;  body{margin:0;background:var(--bg);color:var(--ink);font:13.5px/1.6 var(--sans);-webkit-font-smoothing:antialiased}&#10;  .wrap{display:grid;grid-template-columns:208px minmax(0,1fr) 290px;height:100vh;min-height:560px}&#10;  @media(max-width:900px){.wrap{grid-template-columns:1fr;height:auto}}&#10;&#10;  /* ── 左：账号与样本 ── */&#10;  .side{border-right:1px solid var(--line);background:var(--soft);padding:14px;overflow:auto}&#10;  .kick{font:600 10.5px/1 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--faint);margin:0 0 8px}&#10;  .who{background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px 11px;margin-bottom:14px}&#10;  .who b{display:block;font-size:14px}&#10;  .who span{color:var(--mute);font-size:12px}&#10;  .roles{display:grid;gap:5px;margin-top:9px}&#10;  .roles button{font:inherit;font-size:12px;text-align:left;padding:6px 9px;border-radius:7px;&#10;    border:1px solid var(--line);background:#fff;color:var(--mute);cursor:pointer;transition:.12s}&#10;  .roles button:hover{border-color:#c5cad3;color:var(--ink)}&#10;  .roles button.on{background:var(--ink);border-color:var(--ink);color:#fff}&#10;  .cases{list-style:none;margin:0;padding:0;display:grid;gap:5px}&#10;  .cases button{width:100%;font:inherit;font-size:12.5px;text-align:left;padding:8px 10px;border-radius:8px;&#10;    border:1px solid var(--line);background:#fff;cursor:pointer;transition:.12s}&#10;  .cases button:hover{border-color:#c5cad3}&#10;  .cases button.on{border-color:var(--brand);background:#eef3ff}&#10;  .cases .u{display:block;font-family:var(--mono);font-size:11px;color:var(--faint)}&#10;&#10;  /* ── 中：视频与证据框 ── */&#10;  .main{padding:16px 18px;overflow:auto;min-width:0}&#10;  .head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin-bottom:3px}&#10;  .head h2{margin:0;font-size:17px;letter-spacing:-.01em}&#10;  .chip{font:600 10.5px/1.7 var(--mono);letter-spacing:.05em;text-transform:uppercase;&#10;    padding:1px 8px;border-radius:999px;background:var(--band);color:var(--mute)}&#10;  .sub{margin:0 0 12px;color:var(--mute);font-size:12.5px}&#10;  .stage{position:relative;background:#0b0d10;border-radius:10px;overflow:hidden;aspect-ratio:16/9;max-height:330px}&#10;  .stage video{width:100%;height:100%;object-fit:contain;display:block}&#10;  .box{position:absolute;border:2px solid #ff4d4f;border-radius:3px;box-shadow:0 0 0 1px #0006;pointer-events:none;&#10;    opacity:0;transition:opacity .15s}&#10;  .box.on{opacity:1}&#10;  .box i{position:absolute;left:0;top:-19px;font:600 10.5px/16px var(--mono);font-style:normal;&#10;    background:#ff4d4f;color:#fff;padding:0 6px;border-radius:3px;white-space:nowrap}&#10;  .track{position:relative;height:5px;border-radius:3px;background:var(--band);margin:9px 0 2px}&#10;  .track i{position:absolute;top:0;height:100%;border-radius:3px;background:#ff4d4f;opacity:.75}&#10;  .tmeta{display:flex;justify-content:space-between;font:11px var(--mono);color:var(--faint)}&#10;&#10;  .evs{margin-top:14px;display:grid;gap:9px}&#10;  .ev{border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:#fff;transition:.12s}&#10;  .ev.sel{border-color:var(--brand);box-shadow:0 0 0 3px #2f6bff14}&#10;  .ev-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap}&#10;  .ev-top b{font-family:var(--mono);font-size:11.5px;color:var(--faint);font-weight:600}&#10;  .ev-obs{margin:5px 0 0;font-size:13px}&#10;  .acts{display:flex;gap:6px;margin-top:9px;flex-wrap:wrap}&#10;  .acts button{font:inherit;font-size:12px;padding:4px 11px;border-radius:999px;border:1px solid var(--line);&#10;    background:#fff;cursor:pointer;color:var(--mute);transition:.12s}&#10;  .acts button:hover{border-color:#c5cad3;color:var(--ink)}&#10;  .acts button.on[data-v=&quot;采纳&quot;]{background:#e8f6ee;border-color:#8fcfa9;color:var(--ok)}&#10;  .acts button.on[data-v=&quot;驳回&quot;]{background:#fdecea;border-color:#eda79e;color:var(--no)}&#10;  .acts button.on[data-v=&quot;轻微&quot;]{background:#fdf5e3;border-color:#e3c97f;color:var(--mild)}&#10;  .seen{margin-top:8px;display:flex;gap:7px;flex-wrap:wrap;font-size:11.5px;color:var(--faint)}&#10;  .seen span{background:var(--soft);border:1px solid var(--line);border-radius:999px;padding:1px 8px}&#10;  .blind{color:var(--faint);font-style:italic}&#10;&#10;  /* ── 右：仲裁与指标 ── */&#10;  .aside{border-left:1px solid var(--line);background:var(--soft);padding:14px;overflow:auto}&#10;  .card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:11px 12px;margin-bottom:12px}&#10;  .lad{display:grid;gap:6px;margin:0;padding:0;list-style:none;counter-reset:s}&#10;  .lad li{display:grid;grid-template-columns:18px 1fr;gap:8px;font-size:12.5px;color:var(--faint)}&#10;  .lad li b{font-weight:600}&#10;  .lad li.hit{color:var(--ink)}&#10;  .lad li.hit .n{background:var(--ink);color:#fff;border-color:var(--ink)}&#10;  .lad .n{display:grid;place-items:center;width:18px;height:18px;border-radius:50%;&#10;    border:1px solid var(--line);font:600 10px var(--mono);background:#fff}&#10;  .verdict{display:flex;align-items:baseline;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid var(--line)}&#10;  .verdict b{font-size:20px;letter-spacing:-.02em}&#10;  .verdict.yes b{color:var(--no)} .verdict.no b{color:var(--ok)}&#10;  .mx{width:100%;border-collapse:collapse;font-size:12px;margin-top:4px}&#10;  .mx th,.mx td{border:1px solid var(--line);padding:4px 7px;text-align:center}&#10;  .mx th{background:var(--soft);color:var(--mute);font-weight:600;font-size:11px}&#10;  .mx td.hi{background:#eef3ff;font-weight:700}&#10;  .nums{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}&#10;  .num{background:var(--soft);border:1px solid var(--line);border-radius:8px;padding:7px 9px}&#10;  .num b{display:block;font-size:18px;letter-spacing:-.02em;font-variant-numeric:tabular-nums}&#10;  .num span{font-size:11px;color:var(--faint)}&#10;  .foot{color:var(--faint);font-size:11.5px;margin:10px 0 0}&#10;&lt;/style&gt;&#10;&lt;/head&gt;&#10;&lt;body&gt;&#10;&lt;div class=&quot;wrap&quot;&gt;&#10;  &lt;aside class=&quot;side&quot;&gt;&#10;    &lt;p class=&quot;kick&quot;&gt;当前标注账号&lt;/p&gt;&#10;    &lt;div class=&quot;who&quot;&gt;&#10;      &lt;b id=&quot;whoName&quot;&gt;—&lt;/b&gt;&lt;span id=&quot;whoRole&quot;&gt;—&lt;/span&gt;&#10;      &lt;div class=&quot;roles&quot; id=&quot;roles&quot;&gt;&lt;/div&gt;&#10;    &lt;/div&gt;&#10;    &lt;p class=&quot;kick&quot;&gt;我的样本&lt;/p&gt;&#10;    &lt;ul class=&quot;cases&quot; id=&quot;cases&quot;&gt;&lt;/ul&gt;&#10;  &lt;/aside&gt;&#10;&#10;  &lt;main class=&quot;main&quot;&gt;&#10;    &lt;div class=&quot;head&quot;&gt;&lt;h2 id=&quot;caseTitle&quot;&gt;—&lt;/h2&gt;&lt;span class=&quot;chip&quot; id=&quot;caseTag&quot;&gt;—&lt;/span&gt;&lt;/div&gt;&#10;    &lt;p class=&quot;sub&quot; id=&quot;casePrompt&quot;&gt;—&lt;/p&gt;&#10;    &lt;div class=&quot;stage&quot;&gt;&#10;      &lt;video id=&quot;vid&quot; muted playsinline loop&gt;&lt;/video&gt;&#10;      &lt;div id=&quot;boxes&quot;&gt;&lt;/div&gt;&#10;    &lt;/div&gt;&#10;    &lt;div class=&quot;track&quot; id=&quot;track&quot;&gt;&lt;/div&gt;&#10;    &lt;div class=&quot;tmeta&quot;&gt;&lt;span id=&quot;tnow&quot;&gt;0.0s&lt;/span&gt;&lt;span id=&quot;tdur&quot;&gt;—&lt;/span&gt;&lt;/div&gt;&#10;    &lt;div class=&quot;evs&quot; id=&quot;evs&quot;&gt;&lt;/div&gt;&#10;  &lt;/main&gt;&#10;&#10;  &lt;aside class=&quot;aside&quot;&gt;&#10;    &lt;div class=&quot;card&quot;&gt;&#10;      &lt;p class=&quot;kick&quot;&gt;终态怎么定 &lt;span id=&quot;ladderNote&quot; style=&quot;text-transform:none;letter-spacing:0;font-weight:400&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#10;      &lt;ul class=&quot;lad&quot; id=&quot;ladder&quot;&gt;&lt;/ul&gt;&#10;      &lt;div class=&quot;verdict&quot; id=&quot;verdict&quot;&gt;&lt;span&gt;视频级结论&lt;/span&gt;&lt;b&gt;—&lt;/b&gt;&lt;/div&gt;&#10;    &lt;/div&gt;&#10;    &lt;div class=&quot;card&quot;&gt;&#10;      &lt;p class=&quot;kick&quot;&gt;人评一致性&lt;/p&gt;&#10;      &lt;table class=&quot;mx&quot; id=&quot;mx&quot;&gt;&lt;/table&gt;&#10;      &lt;p class=&quot;foot&quot; id=&quot;agree&quot;&gt;—&lt;/p&gt;&#10;    &lt;/div&gt;&#10;    &lt;div class=&quot;card&quot;&gt;&#10;      &lt;p class=&quot;kick&quot;&gt;抽检标注准召&lt;/p&gt;&#10;      &lt;div class=&quot;nums&quot; id=&quot;prf&quot;&gt;&lt;/div&gt;&#10;      &lt;p class=&quot;foot&quot;&gt;以评测员终审为真值，统计标注员提交的证据。&lt;/p&gt;&#10;    &lt;/div&gt;&#10;  &lt;/aside&gt;&#10;&lt;/div&gt;&#10;&#10;&lt;script&gt;&#10;const ROLES = [{&quot;id&quot;: &quot;annotator_1&quot;, &quot;name&quot;: &quot;标注员 A&quot;, &quot;role&quot;: &quot;盲标槽位 1&quot;, &quot;sees&quot;: [&quot;annotator_1&quot;]}, {&quot;id&quot;: &quot;annotator_2&quot;, &quot;name&quot;: &quot;标注员 B&quot;, &quot;role&quot;: &quot;盲标槽位 2&quot;, &quot;sees&quot;: [&quot;annotator_2&quot;]}, {&quot;id&quot;: &quot;reviewer_3&quot;, &quot;name&quot;: &quot;复核员&quot;, &quot;role&quot;: &quot;分歧仲裁&quot;, &quot;sees&quot;: [&quot;annotator_1&quot;, &quot;annotator_2&quot;, &quot;reviewer_3&quot;]}, {&quot;id&quot;: &quot;admin&quot;, &quot;name&quot;: &quot;评测员&quot;, &quot;role&quot;: &quot;终审&quot;, &quot;sees&quot;: [&quot;annotator_1&quot;, &quot;annotator_2&quot;, &quot;reviewer_3&quot;, &quot;admin&quot;]}], CASES = [{&quot;uid&quot;: &quot;vf_6004655&quot;, &quot;video&quot;: &quot;vf_6004655.mp4&quot;, &quot;tag&quot;: &quot;文字不可读&quot;, &quot;prompt&quot;: &quot;街边霓虹灯牌缓缓亮起，镜头推近&quot;, &quot;truth&quot;: &quot;有&quot;, &quot;path&quot;: &quot;两人一致 · 直接采纳&quot;, &quot;evidences&quot;: [{&quot;id&quot;: &quot;e1&quot;, &quot;tr&quot;: [1.2, 2.8], &quot;bbox&quot;: [0.41, 0.28, 0.33, 0.17], &quot;obs&quot;: &quot;灯牌文字笔画粘连，第 2 秒起无法辨认&quot;, &quot;marks&quot;: {&quot;annotator_1&quot;: &quot;采纳&quot;, &quot;annotator_2&quot;: &quot;采纳&quot;}, &quot;sev&quot;: 2}], &quot;video_marks&quot;: {&quot;annotator_1&quot;: &quot;有&quot;, &quot;annotator_2&quot;: &quot;有&quot;}}, {&quot;uid&quot;: &quot;vf_1003674&quot;, &quot;video&quot;: &quot;vf_1003674.mp4&quot;, &quot;tag&quot;: &quot;崩坏&quot;, &quot;prompt&quot;: &quot;舞者旋转，裙摆展开&quot;, &quot;truth&quot;: &quot;有&quot;, &quot;path&quot;: &quot;两人分歧 · 复核员定终态&quot;, &quot;evidences&quot;: [{&quot;id&quot;: &quot;e1&quot;, &quot;tr&quot;: [0.6, 1.4], &quot;bbox&quot;: [0.52, 0.33, 0.2, 0.3], &quot;obs&quot;: &quot;右手在转身瞬间出现第六指&quot;, &quot;marks&quot;: {&quot;annotator_1&quot;: &quot;采纳&quot;, &quot;annotator_2&quot;: null, &quot;reviewer_3&quot;: &quot;采纳&quot;}, &quot;sev&quot;: 3}, {&quot;id&quot;: &quot;e2&quot;, &quot;tr&quot;: [2.1, 2.6], &quot;bbox&quot;: [0.18, 0.55, 0.16, 0.2], &quot;obs&quot;: &quot;裙摆边缘闪烁&quot;, &quot;marks&quot;: {&quot;annotator_1&quot;: &quot;采纳&quot;, &quot;reviewer_3&quot;: &quot;驳回&quot;}, &quot;sev&quot;: 1}], &quot;video_marks&quot;: {&quot;annotator_1&quot;: &quot;有&quot;, &quot;annotator_2&quot;: &quot;无&quot;, &quot;reviewer_3&quot;: &quot;有&quot;}}, {&quot;uid&quot;: &quot;vf_3005976&quot;, &quot;video&quot;: &quot;vf_3005976.mp4&quot;, &quot;tag&quot;: &quot;生物类结构异常&quot;, &quot;prompt&quot;: &quot;一只鹿走过雪地&quot;, &quot;truth&quot;: &quot;无&quot;, &quot;path&quot;: &quot;评测员改判 · 推翻复核&quot;, &quot;evidences&quot;: [{&quot;id&quot;: &quot;e1&quot;, &quot;tr&quot;: [1.0, 1.9], &quot;bbox&quot;: [0.3, 0.4, 0.26, 0.28], &quot;obs&quot;: &quot;后腿关节方向可疑&quot;, &quot;marks&quot;: {&quot;annotator_1&quot;: &quot;采纳&quot;, &quot;reviewer_3&quot;: &quot;采纳&quot;, &quot;admin&quot;: &quot;驳回&quot;}, &quot;sev&quot;: 1}], &quot;video_marks&quot;: {&quot;annotator_1&quot;: &quot;有&quot;, &quot;annotator_2&quot;: &quot;无&quot;, &quot;reviewer_3&quot;: &quot;有&quot;, &quot;admin&quot;: &quot;无&quot;}}], MEDIA = &quot;assets/videos/&quot;;&#10;const MARKS = ['采纳', '驳回', '轻微'];&#10;let me = ROLES[0], cur = CASES[0], sel = null;&#10;// 本地改动只活在这一次会话里；线上平台写的是服务端标注日志&#10;const edits = {};&#10;&#10;// Keep this script free of dollar signs: build.py lifts LaTeX out of the&#10;// markdown before marked runs, and a dollar pair here would be mangled.&#10;const el = id =&gt; document.getElementById(id);&#10;const key = (c, e) =&gt; c.uid + '|' + e.id;&#10;const markOf = (c, e, who) =&gt; (edits[key(c, e)] || {})[who] ?? (e.marks[who] ?? null);&#10;&#10;// ── 终态：评测员 &gt; 复核员 &gt; 两人一致 &gt; 未定（与线上同一口径）&#10;function settle(c) {&#10;  const v = c.video_marks;&#10;  if (v.admin) return { by: 'admin', step: 0, value: v.admin };&#10;  if (v.annotator_1 &amp;&amp; v.annotator_2 &amp;&amp; v.annotator_1 === v.annotator_2)&#10;    return { by: 'agree', step: 1, value: v.annotator_1 };&#10;  if (v.reviewer_3) return { by: 'reviewer_3', step: 2, value: v.reviewer_3 };&#10;  return { by: null, step: 3, value: null };&#10;}&#10;function evSettle(c, e) {&#10;  for (const who of ['admin', 'reviewer_3', 'annotator_1', 'annotator_2']) {&#10;    const m = markOf(c, e, who);&#10;    if (m) return { who, value: m };&#10;  }&#10;  return { who: null, value: null };&#10;}&#10;&#10;function renderRoles() {&#10;  el('roles').innerHTML = '';&#10;  ROLES.forEach(r =&gt; {&#10;    const b = document.createElement('button');&#10;    b.textContent = r.name + ' · ' + r.role;&#10;    b.className = r.id === me.id ? 'on' : '';&#10;    b.onclick = () =&gt; { me = r; renderAll(); };&#10;    el('roles').appendChild(b);&#10;  });&#10;  el('whoName').textContent = me.name;&#10;  el('whoRole').textContent = me.role + ' · 可见 ' + me.sees.length + ' 人的标注';&#10;}&#10;&#10;function renderCases() {&#10;  el('cases').innerHTML = '';&#10;  CASES.forEach(c =&gt; {&#10;    const li = document.createElement('li'), b = document.createElement('button');&#10;    b.className = c.uid === cur.uid ? 'on' : '';&#10;    b.innerHTML = '&lt;span class=&quot;u&quot;&gt;' + c.uid + '&lt;/span&gt;' + c.tag;&#10;    b.onclick = () =&gt; { cur = c; sel = null; renderAll(); };&#10;    li.appendChild(b); el('cases').appendChild(li);&#10;  });&#10;}&#10;&#10;function renderCase() {&#10;  el('caseTitle').textContent = cur.uid;&#10;  el('caseTag').textContent = cur.tag;&#10;  el('casePrompt').textContent = '提示词：' + cur.prompt + ' · ' + cur.path;&#10;  const v = el('vid');&#10;  if (!v.src.endsWith(cur.video)) { v.src = MEDIA + cur.video; v.load(); v.play().catch(() =&gt; {}); }&#10;&#10;  el('boxes').innerHTML = '';&#10;  cur.evidences.forEach((e, i) =&gt; {&#10;    const d = document.createElement('div');&#10;    d.className = 'box'; d.dataset.ev = e.id;&#10;    d.style.cssText = 'left:' + e.bbox[0] * 100 + '%;top:' + e.bbox[1] * 100&#10;      + '%;width:' + e.bbox[2] * 100 + '%;height:' + e.bbox[3] * 100 + '%';&#10;    d.innerHTML = '&lt;i&gt;' + cur.tag + ' #' + (i + 1) + '&lt;/i&gt;';&#10;    el('boxes').appendChild(d);&#10;  });&#10;&#10;  el('evs').innerHTML = '';&#10;  cur.evidences.forEach((e, i) =&gt; {&#10;    const card = document.createElement('div');&#10;    card.className = 'ev' + (sel === e.id ? ' sel' : '');&#10;    card.onmouseenter = () =&gt; { sel = e.id; paintBoxes(); };&#10;    const mine = markOf(cur, e, me.id);&#10;    const others = me.sees.filter(w =&gt; w !== me.id)&#10;      .map(w =&gt; [w, markOf(cur, e, w)]).filter(([, m]) =&gt; m);&#10;    const fin = evSettle(cur, e);&#10;&#10;    card.innerHTML =&#10;      '&lt;div class=&quot;ev-top&quot;&gt;&lt;b&gt;#' + (i + 1) + '&lt;/b&gt;'&#10;      + '&lt;span class=&quot;chip&quot;&gt;' + e.tr[0].toFixed(1) + 's – ' + e.tr[1].toFixed(1) + 's&lt;/span&gt;'&#10;      + '&lt;span class=&quot;chip&quot;&gt;severity ' + e.sev + '&lt;/span&gt;&lt;/div&gt;'&#10;      + '&lt;p class=&quot;ev-obs&quot;&gt;' + e.obs + '&lt;/p&gt;';&#10;&#10;    const acts = document.createElement('div');&#10;    acts.className = 'acts';&#10;    MARKS.forEach(m =&gt; {&#10;      const b = document.createElement('button');&#10;      b.dataset.v = m; b.textContent = m;&#10;      b.className = mine === m ? 'on' : '';&#10;      b.onclick = () =&gt; {&#10;        const k = key(cur, e);&#10;        edits[k] = Object.assign({}, edits[k]);&#10;        edits[k][me.id] = mine === m ? null : m;&#10;        renderAll();&#10;      };&#10;      acts.appendChild(b);&#10;    });&#10;    card.appendChild(acts);&#10;&#10;    const seen = document.createElement('div');&#10;    seen.className = 'seen';&#10;    if (others.length) {&#10;      seen.innerHTML = others.map(([w, m]) =&gt;&#10;        '&lt;span&gt;' + (ROLES.find(r =&gt; r.id === w) || {}).name + '：' + m + '&lt;/span&gt;').join('');&#10;    } else {&#10;      seen.innerHTML = '&lt;span class=&quot;blind&quot;&gt;盲标中 · 看不到其他标注员&lt;/span&gt;';&#10;    }&#10;    // 终态由他人判断推出，盲标槽位看不到&#10;    if (fin.value &amp;&amp; me.sees.length &gt; 1) {&#10;      seen.innerHTML += '&lt;span&gt;终态：' + fin.value + '（'&#10;        + (ROLES.find(r =&gt; r.id === fin.who) || {}).name + '）&lt;/span&gt;';&#10;    }&#10;    card.appendChild(seen);&#10;    el('evs').appendChild(card);&#10;  });&#10;  paintBoxes();&#10;}&#10;&#10;function paintBoxes() {&#10;  const t = el('vid').currentTime || 0;&#10;  document.querySelectorAll('.box').forEach(d =&gt; {&#10;    const e = cur.evidences.find(x =&gt; x.id === d.dataset.ev);&#10;    d.classList.toggle('on', !!e &amp;&amp; ((t &gt;= e.tr[0] &amp;&amp; t &lt;= e.tr[1]) || sel === e.id));&#10;  });&#10;  document.querySelectorAll('.ev').forEach((c, i) =&gt;&#10;    c.classList.toggle('sel', cur.evidences[i] &amp;&amp; sel === cur.evidences[i].id));&#10;}&#10;&#10;function renderTrack() {&#10;  const d = el('vid').duration;&#10;  el('track').innerHTML = '';&#10;  if (!d || !isFinite(d)) return;&#10;  cur.evidences.forEach(e =&gt; {&#10;    const i = document.createElement('i');&#10;    i.style.left = (e.tr[0] / d * 100) + '%';&#10;    i.style.width = Math.max(1.5, (e.tr[1] - e.tr[0]) / d * 100) + '%';&#10;    el('track').appendChild(i);&#10;  });&#10;  el('tdur').textContent = d.toFixed(1) + 's';&#10;}&#10;&#10;function renderLadder() {&#10;  const s = settle(cur);&#10;  el('ladderNote').textContent = me.sees.length &gt; 1 ? '' : '· 盲标槽位看不到这一栏';&#10;  el('ladderNote').style.opacity = me.sees.length &gt; 1 ? '1' : '.7';&#10;  const steps = [&#10;    ['评测员终审', 'admin'], ['两名标注员一致', 'agree'],&#10;    ['复核员仲裁', 'reviewer_3'], ['不交付 · 分歧未复核', null],&#10;  ];&#10;  el('ladder').innerHTML = steps.map(([label], i) =&gt;&#10;    '&lt;li class=&quot;' + (i === s.step ? 'hit' : '') + '&quot;&gt;&lt;span class=&quot;n&quot;&gt;' + (i + 1) + '&lt;/span&gt;'&#10;    + '&lt;span&gt;' + (i === s.step ? '&lt;b&gt;' + label + '&lt;/b&gt;' : label) + '&lt;/span&gt;&lt;/li&gt;').join('');&#10;  const v = el('verdict');&#10;  v.className = 'verdict ' + (s.value === '有' ? 'yes' : s.value === '无' ? 'no' : '');&#10;  v.innerHTML = '&lt;span&gt;视频级结论&lt;/span&gt;&lt;b&gt;' + (s.value || '未定') + '&lt;/b&gt;';&#10;}&#10;&#10;// 人评一致性：两名标注员在视频级结论上的一致率&#10;function renderMetrics() {&#10;  let same = 0, both = 0;&#10;  const cm = { '有有': 0, '有无': 0, '无有': 0, '无无': 0 };&#10;  CASES.forEach(c =&gt; {&#10;    const a = c.video_marks.annotator_1, b = c.video_marks.annotator_2;&#10;    if (!a || !b) return;&#10;    both++; if (a === b) same++;&#10;    cm[a + b] = (cm[a + b] || 0) + 1;&#10;  });&#10;  el('mx').innerHTML =&#10;    '&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;B 判有&lt;/th&gt;&lt;th&gt;B 判无&lt;/th&gt;&lt;/tr&gt;'&#10;    + '&lt;tr&gt;&lt;th&gt;A 判有&lt;/th&gt;&lt;td class=&quot;hi&quot;&gt;' + cm['有有'] + '&lt;/td&gt;&lt;td&gt;' + cm['有无'] + '&lt;/td&gt;&lt;/tr&gt;'&#10;    + '&lt;tr&gt;&lt;th&gt;A 判无&lt;/th&gt;&lt;td&gt;' + cm['无有'] + '&lt;/td&gt;&lt;td class=&quot;hi&quot;&gt;' + cm['无无'] + '&lt;/td&gt;&lt;/tr&gt;';&#10;  el('agree').textContent = both&#10;    ? '一致 ' + same + ' / ' + both + '，一致率 ' + (same / both * 100).toFixed(0) + '%；不一致的进复核。'&#10;    : '样本不足。';&#10;&#10;  // 抽检准召：以终审为真值，看标注员提交的证据被采纳的比例&#10;  let tp = 0, fp = 0, fn = 0;&#10;  CASES.forEach(c =&gt; c.evidences.forEach(e =&gt; {&#10;    const claimed = ['annotator_1', 'annotator_2'].some(w =&gt; markOf(c, e, w) === '采纳' || markOf(c, e, w) === '轻微');&#10;    const truth = evSettle(c, e).value;&#10;    const kept = truth === '采纳' || truth === '轻微';&#10;    if (claimed &amp;&amp; kept) tp++; else if (claimed &amp;&amp; !kept) fp++; else if (!claimed &amp;&amp; kept) fn++;&#10;  }));&#10;  const P = tp + fp ? tp / (tp + fp) : 0, R = tp + fn ? tp / (tp + fn) : 0;&#10;  const F = P + R ? 2 * P * R / (P + R) : 0;&#10;  el('prf').innerHTML =&#10;    '&lt;div class=&quot;num&quot;&gt;&lt;b&gt;' + (P * 100).toFixed(0) + '%&lt;/b&gt;&lt;span&gt;准确率 · ' + tp + '/' + (tp + fp) + '&lt;/span&gt;&lt;/div&gt;'&#10;    + '&lt;div class=&quot;num&quot;&gt;&lt;b&gt;' + (R * 100).toFixed(0) + '%&lt;/b&gt;&lt;span&gt;召回率 · ' + tp + '/' + (tp + fn) + '&lt;/span&gt;&lt;/div&gt;'&#10;    + '&lt;div class=&quot;num&quot;&gt;&lt;b&gt;' + F.toFixed(2) + '&lt;/b&gt;&lt;span&gt;F1&lt;/span&gt;&lt;/div&gt;'&#10;    + '&lt;div class=&quot;num&quot;&gt;&lt;b&gt;' + (tp + fp + fn) + '&lt;/b&gt;&lt;span&gt;抽检证据数&lt;/span&gt;&lt;/div&gt;';&#10;}&#10;&#10;function renderAll() { renderRoles(); renderCases(); renderCase(); renderLadder(); renderMetrics(); }&#10;&#10;el('vid').addEventListener('timeupdate', () =&gt; {&#10;  paintBoxes();&#10;  el('tnow').textContent = (el('vid').currentTime || 0).toFixed(1) + 's';&#10;});&#10;el('vid').addEventListener('loadedmetadata', renderTrack);&#10;renderAll();&#10;&lt;/script&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;&#10;\"></iframe>\n</div>\n\n##### 标注规则\n\n角色与账号隔离、视频级与证据级的终态优先级、什么情况不交付，以及两项质检指标的口径：\n\n<div align=\"center\">\n  <iframe style=\"width:100%;height:620px;border:1px solid #e4e7ec;border-radius:12px;\" title=\"标注规则 · 双人盲标\" srcdoc=\"&lt;!doctype html&gt;&#10;&lt;html lang=&quot;zh-CN&quot;&gt;&#10;&lt;head&gt;&#10;&lt;meta charset=&quot;utf-8&quot;&gt;&#10;&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width,initial-scale=1&quot;&gt;&#10;&lt;title&gt;标注规则 · 双人盲标&lt;/title&gt;&#10;&lt;style&gt;&#10;  :root{--bg:#fff;--soft:#f6f7f9;--band:#f0f2f5;--ink:#111418;--mute:#5b636e;--faint:#8a929e;&#10;    --line:#e4e7ec;--brand:#2f6bff;--ok:#1a7f45;--no:#c0392b;&#10;    --mono:&quot;SF Mono&quot;,ui-monospace,&quot;JetBrains Mono&quot;,Menlo,monospace;&#10;    --sans:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif}&#10;  *{box-sizing:border-box}&#10;  body{margin:0;background:var(--bg);color:var(--ink);font:13.5px/1.7 var(--sans);-webkit-font-smoothing:antialiased}&#10;  .doc{max-width:860px;margin:0 auto;padding:26px 28px 40px}&#10;  .kick{font:600 10.5px/1 var(--mono);letter-spacing:.11em;text-transform:uppercase;color:var(--faint);margin:0 0 7px}&#10;  h1{font-size:21px;letter-spacing:-.015em;margin:0 0 4px}&#10;  .lede{color:var(--mute);margin:0 0 22px}&#10;  h2{font-size:15px;margin:26px 0 9px;letter-spacing:-.01em}&#10;  p{margin:9px 0}&#10;  ol,ul{margin:9px 0;padding-left:21px}&#10;  li{margin:4px 0}&#10;  code{font-family:var(--mono);font-size:.9em;background:var(--band);padding:1px 5px;border-radius:4px}&#10;  table{border-collapse:collapse;width:100%;margin:12px 0;font-size:12.5px}&#10;  th,td{border:1px solid var(--line);padding:7px 10px;text-align:left;vertical-align:top}&#10;  th{background:var(--soft);color:var(--mute);font-weight:600;font-size:11px;&#10;    letter-spacing:.04em;text-transform:uppercase}&#10;  .roles{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:9px;margin:12px 0}&#10;  .role{border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:var(--soft)}&#10;  .role b{display:block;font-size:13.5px}&#10;  .role span{color:var(--mute);font-size:12px}&#10;  .role em{display:block;margin-top:5px;font-style:normal;font:11px var(--mono);color:var(--faint)}&#10;  .note{border-left:3px solid var(--brand);background:#eef3ff;border-radius:0 8px 8px 0;&#10;    padding:9px 14px;margin:14px 0;color:var(--mute)}&#10;  .warn{border-left-color:#e8a87c;background:#fff4ed}&#10;  .tag{display:inline-block;font:600 10.5px/1.7 var(--mono);padding:1px 8px;border-radius:999px;&#10;    background:var(--band);color:var(--mute)}&#10;  .no{color:var(--no);font-weight:600}&#10;  .ok{color:var(--ok);font-weight:600}&#10;&lt;/style&gt;&#10;&lt;/head&gt;&#10;&lt;body&gt;&#10;&lt;div class=&quot;doc&quot;&gt;&#10;  &lt;p class=&quot;kick&quot;&gt;Annotation Protocol&lt;/p&gt;&#10;  &lt;h1&gt;双人盲标 · 复核 · 评测员终审&lt;/h1&gt;&#10;  &lt;p class=&quot;lede&quot;&gt;一条视频要进训练集，必须先在这套流程里拿到一个没有争议的结论。规则分三块：谁来标、怎么定终态、什么情况不交付。&lt;/p&gt;&#10;&#10;  &lt;h2&gt;一 · 角色与账号&lt;/h2&gt;&#10;  &lt;div class=&quot;roles&quot;&gt;&#10;    &lt;div class=&quot;role&quot;&gt;&lt;b&gt;标注员 A&lt;/b&gt;&lt;span&gt;盲标槽位 1&lt;/span&gt;&lt;em&gt;annotator_1&lt;/em&gt;&lt;/div&gt;&#10;    &lt;div class=&quot;role&quot;&gt;&lt;b&gt;标注员 B&lt;/b&gt;&lt;span&gt;盲标槽位 2&lt;/span&gt;&lt;em&gt;annotator_2&lt;/em&gt;&lt;/div&gt;&#10;    &lt;div class=&quot;role&quot;&gt;&lt;b&gt;复核员&lt;/b&gt;&lt;span&gt;两人分歧时仲裁，可多人&lt;/span&gt;&lt;em&gt;reviewer_3&lt;/em&gt;&lt;/div&gt;&#10;    &lt;div class=&quot;role&quot;&gt;&lt;b&gt;评测员&lt;/b&gt;&lt;span&gt;终审，共享一个槽位&lt;/span&gt;&lt;em&gt;admin&lt;/em&gt;&lt;/div&gt;&#10;  &lt;/div&gt;&#10;  &lt;p&gt;槽位由服务端在登录后分配，同一条视频的两个标注槽位不会落到同一个人。&lt;/p&gt;&#10;  &lt;div class=&quot;note warn&quot;&gt;&#10;    &lt;b&gt;账号隔离。&lt;/b&gt;两名标注员互相看不到对方的结论、证据框和备注，也看不到当前视频的终态——&#10;    终态是从别人的判断推出来的，露出来盲标就失效了。复核员能看到两名标注员；评测员能看到所有人。&#10;  &lt;/div&gt;&#10;&#10;  &lt;h2&gt;二 · 视频级终态&lt;/h2&gt;&#10;  &lt;p&gt;按优先级往下走，命中即停：&lt;/p&gt;&#10;  &lt;ol&gt;&#10;    &lt;li&gt;评测员标了 → 用评测员的结论&lt;/li&gt;&#10;    &lt;li&gt;两名标注员一致 → 用该结论&lt;/li&gt;&#10;    &lt;li&gt;不一致 → 用复核员的结论；多名复核员按 &lt;code&gt;sha256&lt;/code&gt; 稳定挑一个，避免每次回放结果不同&lt;/li&gt;&#10;    &lt;li&gt;以上都拿不到 → &lt;span class=&quot;no&quot;&gt;不交付&lt;/span&gt;（&lt;code&gt;分歧未复核&lt;/code&gt; / &lt;code&gt;标注未完成&lt;/code&gt;）&lt;/li&gt;&#10;  &lt;/ol&gt;&#10;&#10;  &lt;h2&gt;三 · 证据级终态&lt;/h2&gt;&#10;  &lt;p&gt;每条人工框单独定，优先级同上：评测员 &amp;gt; 复核员 &amp;gt; 画框的标注员。&lt;/p&gt;&#10;  &lt;table&gt;&#10;    &lt;tr&gt;&lt;th&gt;情形&lt;/th&gt;&lt;th&gt;结果&lt;/th&gt;&lt;/tr&gt;&#10;    &lt;tr&gt;&lt;td&gt;评测员显式标了 ✅❎⭐️，或自己补了框&lt;/td&gt;&lt;td class=&quot;ok&quot;&gt;按评测员&lt;/td&gt;&lt;/tr&gt;&#10;    &lt;tr&gt;&lt;td&gt;复核员显式标了&lt;/td&gt;&lt;td class=&quot;ok&quot;&gt;按复核员&lt;/td&gt;&lt;/tr&gt;&#10;    &lt;tr&gt;&lt;td&gt;视频级终审判「无」&lt;/td&gt;&lt;td&gt;没被单独标过的框，随视频一并不采纳&lt;/td&gt;&lt;/tr&gt;&#10;    &lt;tr&gt;&lt;td&gt;标注员画了框，无人改判&lt;/td&gt;&lt;td class=&quot;ok&quot;&gt;采纳（画框本身就是认定）&lt;/td&gt;&lt;/tr&gt;&#10;    &lt;tr&gt;&lt;td&gt;⭐️（轻微）&lt;/td&gt;&lt;td class=&quot;ok&quot;&gt;采纳，按轻微处理&lt;/td&gt;&lt;/tr&gt;&#10;  &lt;/table&gt;&#10;  &lt;p&gt;只有采纳的证据进交付件；不采纳的留在报告里记 &lt;code&gt;不采纳·&amp;lt;谁定的&amp;gt;&lt;/code&gt;，不进训练数据。&lt;/p&gt;&#10;&#10;  &lt;div class=&quot;note&quot;&gt;&#10;    &lt;b&gt;一条容易踩的边界。&lt;/b&gt;视频级判「有」、却没有任何一条被采纳的证据 → &lt;span class=&quot;no&quot;&gt;不交付&lt;/span&gt;。&#10;    这种样本按 &lt;code&gt;verdict=无异常&lt;/code&gt; 交出去就是错标签，宁可丢掉。&#10;  &lt;/div&gt;&#10;&#10;  &lt;h2&gt;四 · 质检指标&lt;/h2&gt;&#10;  &lt;table&gt;&#10;    &lt;tr&gt;&lt;th&gt;指标&lt;/th&gt;&lt;th&gt;口径&lt;/th&gt;&lt;th&gt;看什么&lt;/th&gt;&lt;/tr&gt;&#10;    &lt;tr&gt;&lt;td&gt;&lt;b&gt;人评一致性&lt;/b&gt;&lt;/td&gt;&#10;        &lt;td&gt;两名标注员在视频级结论上的一致率，配 2×2 混淆矩阵&lt;/td&gt;&#10;        &lt;td&gt;一致率低说明标注规范本身有歧义，要回头改规则而不是压标注员&lt;/td&gt;&lt;/tr&gt;&#10;    &lt;tr&gt;&lt;td&gt;&lt;b&gt;抽检标注准召&lt;/b&gt;&lt;/td&gt;&#10;        &lt;td&gt;以评测员终审为真值，统计标注员提交证据的准确率 / 召回率 / F1&lt;/td&gt;&#10;        &lt;td&gt;准确率低 = 乱framing；召回率低 = 漏标，两者要分开治&lt;/td&gt;&lt;/tr&gt;&#10;  &lt;/table&gt;&#10;  &lt;p&gt;两项都按批次、按 L3 标签切片看——总体达标但某个垂类塌陷是常态。&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;&#10;\"></iframe>\n</div>\n\n### Aligment Data\n\n偏好对齐，本质是将评测人员的标注偏好进行蒸馏，沉淀成一套可执行的判别规则。\n- 依赖于下文 Agentic Critic 评测提效系统的上线，前期通过人机协同的方式（质检平台召回疑似有问题的证据，评测人员复核修正机评的判别），持续回流真实线上数据 & 难负样本。\n\n**Pointwise**\n```json\n{\n  \"reasoning\": \"参考图同位置横幅标语本就不可读, 生成与其一致, 依规则一判否\",\n   \"severity\": 0,\n   \"label\": 0\n}\n```\n\n**Pairwise / Listwise**\n```json\n{\n  \"glb-rank\": \"\",\n  \"glb-reasoning\": \"\",\n  \"l2-reasoning\": \"\",\n  \"l2-rank\": [0, 1, 2, 3],\n}\n```\n"}, {"id": "harness", "label": "Harness", "tab": true, "parent": null, "md": "## Contents\n\n- [Goal](#goal)\n- [Survey](#survey)\n- [Method](#method)\n- [Workflow](#workflow)\n- [Harness](#harness)\n  - [Tools](#tools)\n  - [Rubric](#rubric)\n  - [Trajectory](#trajectory)\n- [Insights](#insights)\n\n### Goal\n构建一套针对多模态 omni 生成任务的[视频质检系统](https://kml-dtmachine-20133-prod-1.kmlhb2az1l3-2.corp.kuaishou.com/studio.html)，支持输出帧粒度 Reasoning 与 Grounding 质检结果；优化迭代 Harness 环境资产，回流高质量轨迹。\n\n### Survey\n\n同行把「评测 agent」做成什么样、工具怎么接进去、判定粒度切到多细，先看这篇调研：\n\n<div align=\"center\">\n  <iframe\n          data-src=\"surveys/agent-eval.html#granularity\"\n          data-name=\"Video Evaluation Agents\"\n          data-path=\"surveys/agent-eval.html\"\n          style=\"width:100%;height:620px;border:1px solid #e4e7ec;border-radius:12px;\" title=\"Video Evaluation Agents · 预览\" srcdoc=\"&lt;!DOCTYPE html&gt;&#10;&lt;html lang=&quot;zh&quot;&gt;&#10;&lt;head&gt;&#10;&lt;meta charset=&quot;UTF-8&quot;&gt;&#10;&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;&#10;&lt;title&gt;文档预览&lt;/title&gt;&#10;&lt;style&gt;&#10;  :root{&#10;    --bg:#ffffff; --bg-soft:#f6f7f9; --ink:#111418; --ink-soft:#5b636e; --ink-faint:#8b929c;&#10;    --line:#e4e7ec; --brand:#2f6bff; --brand-soft:#eaf0ff;&#10;    --sans:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,&quot;PingFang SC&quot;,&quot;Hiragino Sans GB&quot;,&quot;Microsoft YaHei&quot;,sans-serif;&#10;    --mono:&quot;SF Mono&quot;,ui-monospace,Menlo,Consolas,monospace;&#10;  }&#10;  *{box-sizing:border-box}&#10;  html,body{margin:0;height:100%}&#10;  body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:14px;&#10;       -webkit-font-smoothing:antialiased;display:flex;flex-direction:column}&#10;&#10;  /* ── toolbar ── */&#10;  .bar{flex:none;display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid var(--line);&#10;       background:var(--bg-soft)}&#10;  .file{display:flex;align-items:center;gap:8px;min-width:0}&#10;  .ico{width:22px;height:22px;border-radius:5px;background:var(--brand);color:#fff;font-size:10px;font-weight:800;&#10;       display:flex;align-items:center;justify-content:center;flex:none}&#10;  .name{font-size:13px;font-weight:700;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}&#10;  .path{font-family:var(--mono);font-size:10.5px;color:var(--ink-faint);white-space:nowrap}&#10;  .spacer{flex:1 1 auto}&#10;  .zoom{display:flex;align-items:center;gap:4px;flex:none}&#10;  .zoom button{appearance:none;width:26px;height:26px;border:1px solid var(--line);background:#fff;border-radius:7px;&#10;        font-family:inherit;font-size:14px;font-weight:700;color:var(--ink-soft);cursor:pointer;padding:0;&#10;        display:flex;align-items:center;justify-content:center;transition:.12s}&#10;  .zoom button:hover{border-color:var(--brand);color:var(--brand)}&#10;  .zval{font-family:var(--mono);font-size:11px;color:var(--ink-soft);min-width:42px;text-align:center}&#10;  .open{font-size:12px;font-weight:700;color:#fff;background:var(--brand);text-decoration:none;&#10;        padding:6px 13px;border-radius:8px;white-space:nowrap;flex:none;transition:.14s}&#10;  .open:hover{background:#1f57d8}&#10;&#10;  /* ── page viewport ──────────────────────────────────────────────────────&#10;     预览 = 真实页面装在一个「桌面视口」大小的 iframe 里，再整体缩小，跟&#10;     PDF/PPT 预览窗一个意思。&#10;     iframe 高度必须是一个真实视口高度（900px），不能按文档总高去撑：survey 那边&#10;     有 min-height:100vh 的区块，iframe 高 16000px 时这些区块就跟着变成 16000px，&#10;     第一屏把正文全顶到看不见的地方，预览里只剩一根侧栏目录。 */&#10;  .view{flex:1 1 auto;min-height:0;overflow:auto;background:#eceef1;padding:14px;position:relative}&#10;  /* transform:scale 不改变布局占位，所以缩放要分两层：外层 .wrap 拿缩放后的&#10;     实际尺寸（决定居中与滚动条），内层 .sheet 保持 1240px 原始宽度再整体缩小。&#10;     只用一层的话，元素照 1240px 占位，容器窄于它就会往右溢出被裁掉。 */&#10;  .wrap{margin:0 auto;overflow:hidden;background:#fff;box-shadow:0 2px 14px rgba(17,20,24,.13);border-radius:3px}&#10;  .sheet{transform-origin:top left;position:relative}&#10;  .sheet iframe{display:block;width:100%;border:0;background:#fff}&#10;  .loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;&#10;           color:var(--ink-faint);font-size:12.5px;background:#eceef1;z-index:4}&#10;  @media (max-width:640px){ .path{display:none} }&#10;&lt;/style&gt;&#10;&lt;/head&gt;&#10;&lt;body&gt;&#10;  &lt;div class=&quot;bar&quot;&gt;&#10;    &lt;div class=&quot;file&quot;&gt;&#10;      &lt;span class=&quot;ico&quot;&gt;HTML&lt;/span&gt;&#10;      &lt;span class=&quot;name&quot; id=&quot;fname&quot;&gt;…&lt;/span&gt;&#10;    &lt;/div&gt;&#10;    &lt;span class=&quot;path&quot; id=&quot;fpath&quot;&gt;&lt;/span&gt;&#10;    &lt;span class=&quot;spacer&quot;&gt;&lt;/span&gt;&#10;    &lt;div class=&quot;zoom&quot;&gt;&#10;      &lt;button id=&quot;zo&quot; title=&quot;缩小&quot;&gt;−&lt;/button&gt;&#10;      &lt;span class=&quot;zval&quot; id=&quot;zv&quot;&gt;45%&lt;/span&gt;&#10;      &lt;button id=&quot;zi&quot; title=&quot;放大&quot;&gt;＋&lt;/button&gt;&#10;    &lt;/div&gt;&#10;    &lt;a class=&quot;open&quot; id=&quot;open&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;打开完整页面 ↗&lt;/a&gt;&#10;  &lt;/div&gt;&#10;&#10;  &lt;div class=&quot;view&quot; id=&quot;view&quot;&gt;&#10;    &lt;div class=&quot;wrap&quot; id=&quot;wrap&quot;&gt;&#10;      &lt;div class=&quot;sheet&quot; id=&quot;sheet&quot;&gt;&#10;        &lt;iframe id=&quot;frame&quot; title=&quot;预览&quot; scrolling=&quot;yes&quot;&gt;&lt;/iframe&gt;&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;&#10;    &lt;div class=&quot;loading&quot; id=&quot;loading&quot;&gt;正在载入预览…&lt;/div&gt;&#10;  &lt;/div&gt;&#10;&#10;&lt;script&gt;&#10;// 目标页面与显示名可以外部传入，同一个壳复用给多个文档。&#10;// 取值顺序：宿主 &lt;iframe&gt; 上的 data-* → URL query → 缺省。&#10;// data-* 这条是主路径：build.py 会把本文件整个内联成 srcdoc，srcdoc 没有&#10;// query string，但 srcdoc 与父页同源，所以能从 window.frameElement 读属性。&#10;const host = (()=&gt;{ try { return window.frameElement || null; } catch(e) { return null; } })();&#10;const ds   = (host &amp;&amp; host.dataset) || {};&#10;const q    = new URLSearchParams(location.search);&#10;const SRC  = ds.src  || q.get('src')  || 'surveys/survey.html';&#10;const NAME = ds.name || q.get('name') || 'RL for Spatio-Temporal Video Grounding';&#10;const PATH = ds.path || q.get('path') || SRC;&#10;&#10;// 按桌面视口渲染再整体缩小 —— 否则窄容器里页面会走响应式布局，&#10;// 预览出来的不是真实版式。高度取真实视口高度，见上面样式里的说明。&#10;const PAGE_W = 1240, PAGE_H = 900;&#10;const STEPS = [0.35,0.45,0.6,0.75,0.9,1];&#10;let si = 2;&#10;&#10;const view=document.getElementById('view'), sheet=document.getElementById('sheet'),&#10;      wrap=document.getElementById('wrap'), frame=document.getElementById('frame'),&#10;      loading=document.getElementById('loading');&#10;&#10;document.getElementById('fname').textContent = NAME;&#10;document.getElementById('fpath').textContent = PATH;&#10;document.getElementById('open').href = SRC;&#10;&#10;sheet.style.width = PAGE_W + 'px';&#10;frame.style.height = PAGE_H + 'px';&#10;frame.src = SRC;&#10;&#10;function applyZoom(){&#10;  const k = STEPS[si];&#10;  document.getElementById('zv').textContent = Math.round(k*100) + '%';&#10;  sheet.style.transform = 'scale(' + k + ')';&#10;  wrap.style.width  = (PAGE_W * k) + 'px';&#10;  wrap.style.height = (PAGE_H * k) + 'px';&#10;}&#10;document.getElementById('zi').onclick = ()=&gt;{ if(si&lt;STEPS.length-1){si++;applyZoom();} };&#10;document.getElementById('zo').onclick = ()=&gt;{ if(si&gt;0){si--;applyZoom();} };&#10;&#10;frame.addEventListener('load', ()=&gt;{ loading.style.display='none'; });&#10;// 页签从 display:none 变可见时重摆一次（隐藏时容器宽度是 0，居中算不准）&#10;if (window.ResizeObserver) new ResizeObserver(applyZoom).observe(view);&#10;window.addEventListener('resize', applyZoom);&#10;applyZoom();&#10;&lt;/script&gt;&#10;&lt;/body&gt;&#10;&lt;/html&gt;&#10;\"></iframe>\n</div>\n\n### Method\n核心思想是基础感知（召回证据）和偏好对齐（证据判别）解耦, 从可能形成能够 scaling 的方案, 偏好对齐阶段受不同业务时期模型的关注程度，评测规则的动态演化影响，无法形成稳定的规则。\n\n另外在复杂庞大的评测体系下，需要先测验不同尺寸 / 不同类别的模型能力可达边界，预先建立基础认知。什么维度的评测感知适用于 VLM（以及多大尺寸的 VLM 能做这个事），什么维度的感知应该用 yolo-world 之类的传统 CV 方法。\n这也是需要明确的，不可能所有的维度都用 T 级别 VLM 模型，成本无法 handle，general model 对某些特定领域的效果也不好。传统 CV 模型对部分需要强世界知识的领域也有局限性等\n\n在 Recall + Verifier 两阶段的主干思想下，进行一定程度的延拓，同步探索：\n- **Workflow**：工具与流程编排先验确定，执行路径固定，适合成熟稳定的质检维度\n- **Auto Planning**：原子能力封装为工具，Agent 在 Harness 中自主规划工具调用，适合探索新维度与复杂场景\n两种模式共享同一套 Harness 环境资产。\n\n### Workflow\n\n主干五个阶段从左到右串起来；虚线框里的两种 MoE 拆分是备选增强，尚未确定是否采用。图可以直接在页面里改，改完下载 `.drawio` 放回 `assets/figures/` 重新生成。\n\n<div align=\"center\">\n  <iframe style=\"width:100%;height:700px;border:none;border-radius:12px;\" title=\"ABC-Critic Workflow · draw.io\" srcdoc=\"&lt;!doctype html&gt;&#10;&lt;html lang=&quot;zh&quot;&gt;&#10;&lt;head&gt;&#10;&lt;meta charset=&quot;utf-8&quot;&gt;&#10;&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width,initial-scale=1&quot;&gt;&#10;&lt;title&gt;ABC-Critic Workflow&lt;/title&gt;&#10;&lt;style&gt;&#10;  :root{--bg:#fff;--bg-soft:#f6f7f9;--ink:#111418;--ink-soft:#5b636e;--line:#e4e7ec;--brand:#2f6bff;--warn:#b45309}&#10;  *{box-sizing:border-box}&#10;  html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);&#10;    font:13px/1.4 -apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif}&#10;  .wrap{display:flex;flex-direction:column;height:100%;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--bg)}&#10;  body.full .wrap{border-radius:0;border:0}&#10;  .bar{display:flex;align-items:center;gap:6px;padding:7px 10px;background:var(--bg-soft);border-bottom:1px solid var(--line);flex-wrap:wrap}&#10;  .bar b{font-weight:700;margin-right:6px}&#10;  .st{color:var(--ink-soft);margin-right:auto;min-width:0}&#10;  .st.dirty{color:var(--warn)}&#10;  button{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:4px 12px;cursor:pointer}&#10;  button:hover{border-color:var(--brand);color:var(--brand)}&#10;  button:disabled{opacity:.45;cursor:default;border-color:var(--line);color:var(--ink)}&#10;  .stage{position:relative;flex:1;min-height:0}&#10;  .stage iframe{position:absolute;inset:0;width:100%;height:100%;border:0}&#10;  .fallback{position:absolute;inset:0;display:none;overflow:auto;padding:12px;background:var(--bg)}&#10;  .fallback p{margin:0 0 10px;color:var(--warn)}&#10;  .fallback img{width:100%;height:auto;display:block}&#10;  body.offline .fallback{display:block}&#10;&lt;/style&gt;&#10;&lt;/head&gt;&#10;&lt;body&gt;&#10;&lt;div class=&quot;wrap&quot;&gt;&#10;  &lt;div class=&quot;bar&quot;&gt;&#10;    &lt;b&gt;ABC-Critic Workflow&lt;/b&gt;&#10;    &lt;span class=&quot;st&quot; id=&quot;st&quot;&gt;正在加载 draw.io 编辑器…&lt;/span&gt;&#10;    &lt;button id=&quot;full&quot;&gt;全屏编辑&lt;/button&gt;&#10;    &lt;button id=&quot;dl&quot; disabled&gt;下载 .drawio&lt;/button&gt;&#10;    &lt;button id=&quot;png&quot; disabled&gt;导出 PNG&lt;/button&gt;&#10;    &lt;button id=&quot;svg&quot; disabled&gt;导出 SVG&lt;/button&gt;&#10;    &lt;button id=&quot;reset&quot; disabled&gt;恢复原图&lt;/button&gt;&#10;  &lt;/div&gt;&#10;  &lt;div class=&quot;stage&quot;&gt;&#10;    &lt;iframe id=&quot;ed&quot; title=&quot;draw.io 编辑器&quot; allow=&quot;clipboard-read; clipboard-write&quot;&#10;      src=&quot;https://embed.diagrams.net/?embed=1&amp;proto=json&amp;spin=1&amp;ui=min&amp;lang=zh&amp;saveAndExit=0&amp;noExitBtn=1&amp;libraries=1&quot;&gt;&lt;/iframe&gt;&#10;    &lt;div class=&quot;fallback&quot;&gt;&#10;      &lt;p&gt;draw.io 编辑器还没加载出来（需要浏览器能访问 embed.diagrams.net；网络慢时要一两分钟，好了会自动切换），下面是静态预览。&lt;/p&gt;&#10;      &lt;img alt=&quot;ABC-Critic Workflow&quot; src=&quot;data:image/jpeg;base64,&quot; &gt;&#10;    &lt;/div&gt;&#10;  &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;script&gt;&#10;(function () {&#10;  var NAME = &quot;critic-workflow&quot;;&#10;  var ORIGINAL = &quot;&lt;mxfile host=\\&quot;app.diagrams.net\\&quot; type=\\&quot;device\\&quot;&gt;\\n  &lt;diagram name=\\&quot;ABC-Critic Workflow\\&quot; id=\\&quot;critic-workflow\\&quot;&gt;\\n    &lt;mxGraphModel dx=\\&quot;1640\\&quot; dy=\\&quot;900\\&quot; grid=\\&quot;0\\&quot; gridSize=\\&quot;10\\&quot; guides=\\&quot;1\\&quot; tooltips=\\&quot;1\\&quot; connect=\\&quot;1\\&quot; arrows=\\&quot;1\\&quot; fold=\\&quot;1\\&quot; page=\\&quot;1\\&quot; pageScale=\\&quot;1\\&quot; pageWidth=\\&quot;1700\\&quot; pageHeight=\\&quot;860\\&quot; math=\\&quot;0\\&quot; shadow=\\&quot;0\\&quot;&gt;\\n      &lt;root&gt;\\n        &lt;mxCell id=\\&quot;0\\&quot; /&gt;\\n        &lt;mxCell id=\\&quot;1\\&quot; parent=\\&quot;0\\&quot; /&gt;\\n        &lt;mxCell id=\\&quot;lane0\\&quot; value=\\&quot;主干：五个阶段，左到右\\&quot; style=\\&quot;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#e4e7ec;dashed=0;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=12;fontColor=#8a929e;fontStyle=1\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;40\\&quot; y=\\&quot;60\\&quot; width=\\&quot;1620\\&quot; height=\\&quot;280\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;lane1\\&quot; value=\\&quot;备选增强：尚未确定是否采用\\&quot; style=\\&quot;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c7ccd4;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=12;fontColor=#8a929e;fontStyle=1\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;40\\&quot; y=\\&quot;400\\&quot; width=\\&quot;1620\\&quot; height=\\&quot;300\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;input\\&quot; value=\\&quot;&amp;lt;b&amp;gt;Input&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#5b636e&amp;quot;&amp;gt;生成视频 + Caption Prompt&amp;lt;br&amp;gt;参考图 / 音轨&amp;lt;/font&amp;gt;\\&quot; style=\\&quot;rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7ccd4;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;70\\&quot; y=\\&quot;150\\&quot; width=\\&quot;170\\&quot; height=\\&quot;86\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;s1\\&quot; value=\\&quot;&amp;lt;b&amp;gt;1 · Preprocess&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#5b636e&amp;quot;&amp;gt;Prompt 结构化为可验证约束&amp;lt;br&amp;gt;CV tool 预处理出结构化信息&amp;lt;/font&amp;gt;\\&quot; style=\\&quot;rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#2f6bff;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;300\\&quot; y=\\&quot;150\\&quot; width=\\&quot;210\\&quot; height=\\&quot;86\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;s2\\&quot; value=\\&quot;&amp;lt;b&amp;gt;2 · Recall&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#5b636e&amp;quot;&amp;gt;VLM 结合结构化信息做时空定位&amp;lt;br&amp;gt;召回疑似问题片段 + 推理解释&amp;lt;/font&amp;gt;\\&quot; style=\\&quot;rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#2f6bff;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;570\\&quot; y=\\&quot;150\\&quot; width=\\&quot;230\\&quot; height=\\&quot;86\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;s3\\&quot; value=\\&quot;&amp;lt;b&amp;gt;3 · Postprocess&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#5b636e&amp;quot;&amp;gt;对召回证据做后处理&amp;lt;br&amp;gt;CV tool 提取增强信息&amp;lt;/font&amp;gt;\\&quot; style=\\&quot;rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#2f6bff;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;860\\&quot; y=\\&quot;150\\&quot; width=\\&quot;200\\&quot; height=\\&quot;86\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;s4\\&quot; value=\\&quot;&amp;lt;b&amp;gt;4 · Verifier&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#5b636e&amp;quot;&amp;gt;逐条复核校验证据&amp;lt;br&amp;gt;采纳 / 驳回 + 严重度&amp;lt;/font&amp;gt;\\&quot; style=\\&quot;rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#2f6bff;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;1120\\&quot; y=\\&quot;150\\&quot; width=\\&quot;200\\&quot; height=\\&quot;86\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;s5\\&quot; value=\\&quot;&amp;lt;b&amp;gt;5 · Aggregate&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#5b636e&amp;quot;&amp;gt;Rubric 聚合，给出结论&amp;lt;br&amp;gt;分数 / status / 证据图&amp;lt;/font&amp;gt;\\&quot; style=\\&quot;rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#111418;strokeColor=#111418;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacing=6\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;1380\\&quot; y=\\&quot;150\\&quot; width=\\&quot;200\\&quot; height=\\&quot;86\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;moeR\\&quot; value=\\&quot;&amp;lt;b&amp;gt;MoE Recall&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#5b636e&amp;quot;&amp;gt;把一个大问题拆给多个召回专家&amp;lt;/font&amp;gt;\\&quot; style=\\&quot;rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6bff;dashed=1;dashPattern=8 5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;570\\&quot; y=\\&quot;450\\&quot; width=\\&quot;230\\&quot; height=\\&quot;74\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;moeV\\&quot; value=\\&quot;&amp;lt;b&amp;gt;MoE Verifier&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font color=&amp;quot;#5b636e&amp;quot;&amp;gt;按缺陷类型拆给多个复核专家&amp;lt;/font&amp;gt;\\&quot; style=\\&quot;rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6bff;dashed=1;dashPattern=8 5;fontSize=13;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;1105\\&quot; y=\\&quot;450\\&quot; width=\\&quot;230\\&quot; height=\\&quot;74\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;split\\&quot; value=\\&quot;&amp;lt;b&amp;gt;崩坏&amp;lt;/b&amp;gt;\\&quot; style=\\&quot;rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7ccd4;dashed=1;dashPattern=8 5;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;1130\\&quot; y=\\&quot;568\\&quot; width=\\&quot;90\\&quot; height=\\&quot;34\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;hum\\&quot; value=\\&quot;&amp;lt;b&amp;gt;人体崩坏&amp;lt;/b&amp;gt;\\&quot; style=\\&quot;rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7ccd4;dashed=1;dashPattern=8 5;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;1290\\&quot; y=\\&quot;536\\&quot; width=\\&quot;104\\&quot; height=\\&quot;32\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;bio\\&quot; value=\\&quot;&amp;lt;b&amp;gt;生物崩坏&amp;lt;/b&amp;gt;\\&quot; style=\\&quot;rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7ccd4;dashed=1;dashPattern=8 5;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;1290\\&quot; y=\\&quot;584\\&quot; width=\\&quot;104\\&quot; height=\\&quot;32\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;obj\\&quot; value=\\&quot;&amp;lt;b&amp;gt;非生物崩坏&amp;lt;/b&amp;gt;\\&quot; style=\\&quot;rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7ccd4;dashed=1;dashPattern=8 5;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontColor=#111418\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;1290\\&quot; y=\\&quot;632\\&quot; width=\\&quot;104\\&quot; height=\\&quot;32\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;note820\\&quot; value=\\&quot;代价：成本上升\\&quot; style=\\&quot;rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff4ed;strokeColor=#e8a87c;fontSize=11;fontColor=#9a5b2a;align=center;verticalAlign=middle\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;820\\&quot; y=\\&quot;474\\&quot; width=\\&quot;132\\&quot; height=\\&quot;26\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;note1355\\&quot; value=\\&quot;不增加成本，准召双升\\&quot; style=\\&quot;rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#edf7f0;strokeColor=#7cc49a;fontSize=11;fontColor=#2b6b45;align=center;verticalAlign=middle\\&quot; vertex=\\&quot;1\\&quot; parent=\\&quot;1\\&quot;&gt;\\n          &lt;mxGeometry x=\\&quot;1355\\&quot; y=\\&quot;474\\&quot; width=\\&quot;170\\&quot; height=\\&quot;26\\&quot; as=\\&quot;geometry\\&quot; /&gt;\\n        &lt;\\/mxCell&gt;\\n        &lt;mxCell id=\\&quot;cap405_253\\&quot; value=\\&quot;CV tools：抽帧 · OCR · 检测 · 光流 · 深度\\&quot; style=\\&quot;text;html=1;align=center;verticalAlign