oms&quot;:[&quot;要求特写实际全景&quot;,&quot;要求俯视实际平视&quot;,&quot;第一人称视角未实现&quot;],&quot;requires&quot;:&quot;Prompt 明确指定了景别或视角&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需定优先级&quot;,&quot;r&quot;:&quot;Prompt 无构图要求、纯粹裁切怪异 → 画面质量 `异常构图`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;Prompt 未指定、纯粹艺术选择欠佳 → 动态质量 `景别视角不当`&quot;}]},{&quot;n&quot;:&quot;运镜未响应&quot;,&quot;act&quot;:&quot;拆分&quot;,&quot;why&quot;:&quot;facet 提升为独立三级标签，与 `动作未响应` 同步拆平。&quot;,&quot;gone&quot;:true},{&quot;n&quot;:&quot;动作与运镜时序错位&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;动作与运镜时序&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P1&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;动作发生点与镜头变化点没有在同一时间戳对齐。&quot;,&quot;symptoms&quot;:[&quot;要求「人物转身时镜头同时拉远」实际转身后镜头才动&quot;,&quot;动作与运镜不同步&quot;],&quot;requires&quot;:&quot;动作和运镜都实现了、顺序也对，问题只在两者的时间戳对齐&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;本标签判同步性（动作发生点与镜头变化点是否在同一时间戳对齐）；先后顺序颠倒一律归 `动作时序顺序错误` / `运镜时序顺序错误`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;判同步性；先后顺序颠倒一律归 `动作时序顺序错误` / `运镜时序顺序错误`&quot;}]},{&quot;n&quot;:&quot;播放速度不符&quot;,&quot;act&quot;:&quot;重命名&quot;,&quot;from&quot;:&quot;播放速度响应&quot;,&quot;why&quot;:&quot;陈述式改缺陷式。&quot;,&quot;prio&quot;:&quot;P2&quot;,&quot;rubric&quot;:{&quot;status&quot;:&quot;OK&quot;,&quot;what&quot;:&quot;整体视频的播放速率不符 Prompt。&quot;,&quot;symptoms&quot;:[&quot;要求慢动作实际正常速率&quot;,&quot;要求延时摄影实际正常&quot;,&quot;全局帧率抽帧 / 插帧效果错误&quot;],&quot;requires&quot;:&quot;判定对象是全局帧率效果，不是主体动作速率&quot;},&quot;rules&quot;:[{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;仅限全局帧率抽帧 / 插帧效果；主体关节运动速率 → `动作速度不符`；镜头移动速率 → `运镜速度不符`&quot;},{&quot;kind&quot;:&quot;需硬隔离&quot;,&quot;r&quot;:&quot;主体关节运动速率 → `动作速度不符`；镜头移动速率 → `运镜速度不符`&quot;},{&quot;kind&quot;:&quot;需锚定&quot;,&quot;r&quot;:&quot;速度符合物理但违反 Prompt → 本标签；速度违反物理规律 → 动态质量 `速度异常`&quot;}]},{&quot;n&quot;:&quot;响应混淆与指代错误&quot;,&quot;act&quot;:&quot;维持&quot;